# Local release environment
#
# Copy this file to .env.local and fill in real values. Do not commit .env.local.
# The local release scripts load .env.local automatically and do not print secret
# values.

# GitHub repository used for release publishing and desktop updater metadata.
ACE_DESKTOP_UPDATE_REPOSITORY=owner/repo

# Required for signed macOS desktop releases.
ACE_DESKTOP_SIGNED=true

# Use either a base64-encoded Developer ID Application .p12 bundle or an
# installed Keychain identity. CSC_LINK is the most portable option for local
# and CI releases.
CSC_LINK=base64-encoded-developer-id-application-p12
CSC_KEY_PASSWORD=p12-export-password
# CSC_NAME=Developer ID Application: Example Team (TEAMID)

# Local releases expect APPLE_API_KEY to point to the App Store Connect .p8 key
# file. GitHub Actions secrets use the raw .p8 contents instead.
APPLE_API_KEY=/absolute/path/to/AuthKey_KEYID.p8
APPLE_API_KEY_ID=KEYID
APPLE_API_ISSUER=issuer-id-uuid

# Optional but useful for consistency with GitHub Actions and Apple logs.
APPLE_TEAM_ID=TEAMID1234
ACE_DESKTOP_MAC_TEAM_ID=TEAMID1234

# Optional Windows signing. If these are omitted, Windows installers are built
# but not Authenticode-signed.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TRUSTED_SIGNING_ENDPOINT=
# AZURE_TRUSTED_SIGNING_ACCOUNT_NAME=
# AZURE_TRUSTED_SIGNING_CERTIFICATE_PROFILE_NAME=
# AZURE_TRUSTED_SIGNING_PUBLISHER_NAME=
