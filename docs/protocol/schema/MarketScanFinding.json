{
  "$id": "https://ace.local/protocol/v1/MarketScanFinding.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "check": {
      "$ref": "https://ace.local/protocol/v1/MarketScanCheckId.json"
    },
    "level": {
      "$ref": "https://ace.local/protocol/v1/MarketScanLevel.json"
    },
    "line": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "message": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "maxLength": 512,
      "type": "string"
    },
    "rule": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "strict": {
      "type": "boolean"
    }
  },
  "required": [
    "check",
    "rule",
    "level",
    "message"
  ],
  "type": "object"
}
