{
  "$id": "https://ace.local/protocol/v1/ScreenOpenedApp.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "bundleId": {
      "$ref": "https://ace.local/protocol/v1/ScreenBundle.json"
    },
    "mode": {
      "const": "background",
      "type": "string"
    },
    "pid": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "bundleId",
    "pid",
    "mode"
  ],
  "type": "object"
}
