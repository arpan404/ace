{
  "$id": "https://ace.local/protocol/v1/ContextMeter.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agentId": {
      "$ref": "https://ace.local/protocol/v1/AgentId.json"
    },
    "epoch": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "model": {
      "type": "string"
    },
    "source": {
      "enum": [
        "provider",
        "catalog",
        "unknown"
      ],
      "type": "string"
    },
    "usedTokens": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "windowTokens": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "agentId",
    "epoch",
    "usedTokens",
    "windowTokens",
    "source"
  ],
  "type": "object"
}
