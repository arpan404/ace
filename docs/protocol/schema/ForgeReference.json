{
  "$id": "https://ace.local/protocol/v1/ForgeReference.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "kind": {
      "enum": [
        "issue",
        "pr"
      ],
      "type": "string"
    },
    "number": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "state": {
      "enum": [
        "open",
        "draft",
        "closed",
        "merged"
      ],
      "type": "string"
    },
    "title": {
      "maxLength": 65536,
      "type": "string"
    }
  },
  "required": [
    "number",
    "title",
    "kind",
    "state"
  ],
  "type": "object"
}
