{
  "$id": "https://ace.local/protocol/v1/ModelEffort.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "label": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "level": {
      "anyOf": [
        {
          "$ref": "https://ace.local/protocol/v1/EffortLevel.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "level",
    "label"
  ],
  "type": "object"
}
