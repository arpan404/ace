{
  "$id": "https://ace.local/protocol/v1/ForgePrRow.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "author": {
      "maxLength": 65536,
      "type": "string"
    },
    "labels": {
      "items": {
        "maxLength": 65536,
        "type": "string"
      },
      "maxItems": 100,
      "type": "array"
    },
    "raw": {},
    "ref": {
      "$ref": "https://ace.local/protocol/v1/ForgePrRef.json"
    },
    "state": {
      "enum": [
        "open",
        "draft",
        "closed",
        "merged"
      ],
      "type": "string"
    },
    "title": {
      "maxLength": 65536,
      "type": "string"
    },
    "updatedAt": {
      "maxLength": 65536,
      "type": "string"
    },
    "url": {
      "maxLength": 65536,
      "type": "string"
    }
  },
  "required": [
    "ref",
    "title",
    "url",
    "author",
    "state",
    "labels",
    "updatedAt"
  ],
  "type": "object"
}
