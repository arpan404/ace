{
  "$id": "https://ace.local/protocol/v1/ThreadDetails.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "ahead": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "base": {
      "$ref": "https://ace.local/protocol/v1/WorktreeBaseRecord.json"
    },
    "baseBranch": {
      "maxLength": 1024,
      "type": "string"
    },
    "behind": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "branch": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "diff": {
      "properties": {
        "additions": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "deletions": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "files",
        "additions",
        "deletions"
      ],
      "type": "object"
    },
    "head": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{40,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "linkedPr": {
      "anyOf": [
        {
          "properties": {
            "number": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "state": {
              "enum": [
                "open",
                "closed",
                "merged"
              ],
              "type": "string"
            },
            "url": {
              "format": "ace-whatwg-url",
              "type": "string",
              "x-ace-constraint": "Accept strings whose trimmed value is an absolute WHATWG URL. Whitespace, Unicode hosts, opaque schemes and parser-normalized URLs are allowed. x-ace-url-minLength and x-ace-url-maxLength apply after trimming whitespace and removing ASCII tab, CR and LF characters, using UTF-16 code units. Install the ace-whatwg-url format validator or enforce this rule in application code.",
              "x-ace-url-maxLength": 4096
            }
          },
          "required": [
            "number",
            "state"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "machine": {
      "properties": {
        "host": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "icon": {
          "$ref": "https://ace.local/protocol/v1/MachineIcon.json"
        },
        "name": {
          "maxLength": 256,
          "type": "string"
        }
      },
      "required": [
        "host",
        "name"
      ],
      "type": "object"
    },
    "mode": {
      "enum": [
        "local",
        "worktree"
      ],
      "type": "string"
    },
    "repository": {
      "$ref": "https://ace.local/protocol/v1/ForgeRepository.json"
    },
    "workspace": {
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "path"
      ],
      "type": "object"
    },
    "workspaceChange": {
      "properties": {
        "at": {
          "$ref": "https://ace.local/protocol/v1/Timestamp.json"
        },
        "commandId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "error": {
          "maxLength": 128,
          "type": "string"
        },
        "lossy": {
          "default": true,
          "type": "boolean"
        },
        "state": {
          "enum": [
            "preparing",
            "applied",
            "failed"
          ],
          "type": "string"
        },
        "uncertain": {
          "type": "boolean"
        }
      },
      "required": [
        "commandId",
        "state",
        "at"
      ],
      "type": "object"
    },
    "worktree": {
      "maxLength": 4096,
      "type": "string"
    },
    "worktreeCreation": {
      "$ref": "https://ace.local/protocol/v1/WorktreeCreationProgress.json"
    }
  },
  "type": "object"
}
