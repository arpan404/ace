{
  "$id": "https://ace.local/protocol/v1/ThreadReadStateResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "lastSeenSeq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "requestId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "type": {
      "const": "thread.readState",
      "type": "string"
    },
    "updatedAt": {
      "anyOf": [
        {
          "$ref": "https://ace.local/protocol/v1/Timestamp.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "type",
    "requestId",
    "threadId",
    "lastSeenSeq",
    "updatedAt"
  ],
  "type": "object"
}
