{
  "$id": "https://ace.local/protocol/v1/ForgeInboxWrite.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "action": {
          "const": "read",
          "type": "string"
        },
        "id": {
          "$ref": "https://ace.local/protocol/v1/ForgeInboxThreadId.json"
        }
      },
      "required": [
        "action",
        "id"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "const": "done",
          "type": "string"
        },
        "id": {
          "$ref": "https://ace.local/protocol/v1/ForgeInboxThreadId.json"
        }
      },
      "required": [
        "action",
        "id"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "const": "unsubscribe",
          "type": "string"
        },
        "id": {
          "$ref": "https://ace.local/protocol/v1/ForgeInboxThreadId.json"
        }
      },
      "required": [
        "action",
        "id"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "const": "read-all",
          "type": "string"
        },
        "before": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "repository": {
          "$ref": "https://ace.local/protocol/v1/ForgeRepository.json"
        }
      },
      "required": [
        "action",
        "before"
      ],
      "type": "object"
    }
  ]
}
