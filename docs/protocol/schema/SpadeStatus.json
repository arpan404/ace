{
  "$id": "https://ace.local/protocol/v1/SpadeStatus.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "grant": {
      "properties": {
        "lastUsedAt": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "present",
            "revoked"
          ],
          "type": "string"
        }
      },
      "required": [
        "state",
        "lastUsedAt"
      ],
      "type": "object"
    },
    "reason": {
      "maxLength": 1024,
      "type": "string"
    },
    "setup": {
      "properties": {
        "platform": {
          "maxLength": 32,
          "type": "string"
        },
        "reason": {
          "maxLength": 256,
          "type": "string"
        }
      },
      "required": [
        "reason",
        "platform"
      ],
      "type": "object"
    },
    "state": {
      "$ref": "https://ace.local/protocol/v1/SpadeState.json"
    },
    "thread": {
      "properties": {
        "busy": {
          "type": "boolean"
        },
        "id": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        }
      },
      "required": [
        "id",
        "busy"
      ],
      "type": "object"
    },
    "version": {
      "maxLength": 64,
      "type": "string"
    }
  },
  "required": [
    "state"
  ],
  "type": "object"
}
