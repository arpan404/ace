{
  "$id": "https://ace.local/protocol/v1/HostedRepositoriesRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "operation": {
      "oneOf": [
        {
          "properties": {
            "input": {
              "$ref": "https://ace.local/protocol/v1/RepositoryListInput.json"
            },
            "op": {
              "const": "list",
              "type": "string"
            }
          },
          "required": [
            "op",
            "input"
          ],
          "type": "object"
        },
        {
          "properties": {
            "op": {
              "const": "publication",
              "type": "string"
            },
            "workspaceId": {
              "$ref": "https://ace.local/protocol/v1/WorkspaceId.json"
            }
          },
          "required": [
            "op",
            "workspaceId"
          ],
          "type": "object"
        },
        {
          "properties": {
            "op": {
              "const": "publication.cancel",
              "type": "string"
            },
            "workspaceId": {
              "$ref": "https://ace.local/protocol/v1/WorkspaceId.json"
            }
          },
          "required": [
            "op",
            "workspaceId"
          ],
          "type": "object"
        }
      ]
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "repositories.request",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "operation"
  ],
  "type": "object"
}
