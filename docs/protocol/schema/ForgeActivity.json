{
  "$id": "https://ace.local/protocol/v1/ForgeActivity.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actor": {
      "maxLength": 65536,
      "type": "string"
    },
    "actorAvatarUrl": {
      "maxLength": 65536,
      "type": "string"
    },
    "at": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "commitSha": {
      "pattern": "^[a-fA-F0-9]{40,64}$",
      "type": "string"
    },
    "event": {
      "maxLength": 65536,
      "type": "string"
    },
    "id": {
      "maxLength": 256,
      "type": "string"
    },
    "raw": {},
    "subject": {
      "maxLength": 65536,
      "type": "string"
    }
  },
  "required": [
    "id",
    "event",
    "actor",
    "at",
    "raw"
  ],
  "type": "object"
}
