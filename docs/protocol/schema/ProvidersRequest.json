{
  "$id": "https://ace.local/protocol/v1/ProvidersRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "operation": {
      "default": "list",
      "enum": [
        "list",
        "refresh"
      ],
      "type": "string"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "providers.request",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId"
  ],
  "type": "object"
}
