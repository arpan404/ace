{
  "$id": "https://ace.local/protocol/v1/AppUpdateResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "error": {
      "enum": [
        "forbidden"
      ],
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "appUpdate.result",
      "type": "string"
    },
    "update": {
      "$ref": "https://ace.local/protocol/v1/AppUpdate.json"
    }
  },
  "required": [
    "type",
    "requestId",
    "ok"
  ],
  "type": "object"
}
