{
  "$id": "https://ace.local/protocol/v1/SpadeSubscription.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "accounts": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "label"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "type": "array"
    },
    "models": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    }
  },
  "required": [
    "provider",
    "name",
    "accounts",
    "models"
  ],
  "type": "object"
}
