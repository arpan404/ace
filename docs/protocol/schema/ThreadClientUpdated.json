{
  "$id": "https://ace.local/protocol/v1/ThreadClientUpdated.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "changes": {
      "properties": {
        "activityAt": {
          "$ref": "https://ace.local/protocol/v1/Timestamp.json"
        },
        "autoSettleAt": {
          "anyOf": [
            {
              "$ref": "https://ace.local/protocol/v1/Timestamp.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "deletedAt": {
          "$ref": "https://ace.local/protocol/v1/Timestamp.json"
        },
        "details": {
          "$ref": "https://ace.local/protocol/v1/ThreadDetails.json"
        },
        "live": {
          "$ref": "https://ace.local/protocol/v1/ThreadRunMetadata.json"
        },
        "pinOrder": {
          "anyOf": [
            {
              "description": "Place among pinned threads, higher first. Set on pin (the daemon's clock when the command names none, so a new pin leads) and cleared on unpin.",
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "pinned": {
          "type": "boolean"
        },
        "readAt": {
          "$ref": "https://ace.local/protocol/v1/Timestamp.json"
        },
        "settledAt": {
          "anyOf": [
            {
              "$ref": "https://ace.local/protocol/v1/Timestamp.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "settledReason": {
          "anyOf": [
            {
              "enum": [
                "manual",
                "inactivity",
                "pr_merged",
                "pr_closed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "snoozedUntil": {
          "anyOf": [
            {
              "$ref": "https://ace.local/protocol/v1/Timestamp.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "unread": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "type": {
      "const": "thread.client.updated",
      "type": "string"
    }
  },
  "required": [
    "type",
    "changes"
  ],
  "type": "object"
}
