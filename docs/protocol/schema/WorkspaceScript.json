{
  "$id": "https://ace.local/protocol/v1/WorkspaceScript.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "command": {
      "maxLength": 8192,
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "maxLength": 256,
      "type": "string"
    },
    "source": {
      "enum": [
        "package.json",
        "Procfile",
        "Makefile",
        "justfile"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "source",
    "command"
  ],
  "type": "object"
}
