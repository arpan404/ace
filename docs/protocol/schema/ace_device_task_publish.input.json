{
  "$id": "https://ace.local/protocol/v1/ace_device_task_publish.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attachments": {
      "default": [],
      "items": {
        "$ref": "https://ace.local/protocol/v1/BlobHash.json"
      },
      "maxItems": 8,
      "type": "array"
    },
    "files": {
      "default": [],
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "type": "array"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    }
  },
  "required": [
    "requestId"
  ],
  "type": "object"
}
