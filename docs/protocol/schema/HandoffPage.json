{
  "$id": "https://ace.local/protocol/v1/HandoffPage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "items": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/Item.json"
      },
      "maxItems": 50,
      "type": "array"
    },
    "itemsBefore": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    }
  },
  "required": [
    "threadId",
    "items",
    "itemsBefore"
  ],
  "type": "object"
}
