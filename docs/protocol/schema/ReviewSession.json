{
  "$id": "https://ace.local/protocol/v1/ReviewSession.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "createdAt": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "$ref": "https://ace.local/protocol/v1/ReviewSource.json"
    },
    "status": {
      "enum": [
        "open",
        "changes-requested",
        "approved"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "source",
    "status",
    "createdAt"
  ],
  "type": "object"
}
