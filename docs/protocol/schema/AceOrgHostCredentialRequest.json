{
  "$id": "https://ace.local/protocol/v1/AceOrgHostCredentialRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "at": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "credential": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "hostKey": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "proof": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    }
  },
  "required": [
    "hostKey",
    "credential",
    "at",
    "proof"
  ],
  "type": "object"
}
