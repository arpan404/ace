{
  "$id": "https://ace.local/protocol/v1/ForgeCheckAnnotation.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "endLine": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "level": {
      "enum": [
        "notice",
        "warning",
        "failure"
      ],
      "type": "string"
    },
    "message": {
      "maxLength": 65536,
      "type": "string"
    },
    "path": {
      "maxLength": 65536,
      "type": "string"
    },
    "startLine": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "maxLength": 65536,
      "type": "string"
    }
  },
  "required": [
    "path",
    "startLine",
    "endLine",
    "level",
    "title",
    "message"
  ],
  "type": "object"
}
