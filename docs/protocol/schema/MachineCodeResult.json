{
  "$id": "https://ace.local/protocol/v1/MachineCodeResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "result": {
      "oneOf": [
        {
          "properties": {
            "ok": {
              "const": true,
              "type": "boolean"
            },
            "status": {
              "$ref": "https://ace.local/protocol/v1/MachineAccountStatus.json"
            }
          },
          "required": [
            "ok",
            "status"
          ],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "$ref": "https://ace.local/protocol/v1/MachineCodeFailure.json"
            },
            "message": {
              "maxLength": 256,
              "type": "string"
            },
            "ok": {
              "const": false,
              "type": "boolean"
            }
          },
          "required": [
            "ok",
            "error",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "type": {
      "const": "machine.code.result",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "result"
  ],
  "type": "object"
}
