{
  "$id": "https://ace.local/protocol/v1/SpadeHttpRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "body": {
      "maxLength": 524288,
      "type": "string"
    },
    "method": {
      "$ref": "https://ace.local/protocol/v1/SpadeMethod.json"
    },
    "path": {
      "maxLength": 2048,
      "minLength": 4,
      "type": "string"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "spade.http",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "method",
    "path"
  ],
  "type": "object"
}
