{
  "$id": "https://ace.local/protocol/v1/ForgeNewPrContext.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "base": {
      "properties": {
        "branches": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/ForgeBranch.json"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "defaultBranch": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "repository": {
          "$ref": "https://ace.local/protocol/v1/ForgeRepository.json"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "repository",
        "defaultBranch",
        "branches",
        "truncated"
      ],
      "type": "object"
    },
    "head": {
      "properties": {
        "branches": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/ForgeBranch.json"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "repository": {
          "$ref": "https://ace.local/protocol/v1/ForgeRepository.json"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "repository",
        "branches",
        "truncated"
      ],
      "type": "object"
    },
    "template": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "base",
    "head",
    "template"
  ],
  "type": "object"
}
