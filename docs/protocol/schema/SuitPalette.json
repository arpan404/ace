      "pattern": "^#[0-9a-fA-F]{6}$",
      "type": "string"
    },
    "faint": {
      "pattern": "^#[0-9a-fA-F]{6}$",
      "type": "string"
    },
    "glass": {
      "anyOf": [
        {
          "properties": {
            "blur": {
              "maximum": 64,
              "minimum": 0,
              "type": "number"
            },
            "saturate": {
              "maximum": 300,
              "minimum": 100,
              "type": "number"
            }
          },
          "required": [
            "blur",
            "saturate"
          ],
          "type": "object"
        },
        {
