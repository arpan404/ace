{
  "$id": "https://ace.local/protocol/v1/ApiKeySupport.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "reason": {
      "maxLength": 256,
      "type": "string"
    },
    "supported": {
      "type": "boolean"
    },
    "upstreams": {
      "items": {
        "maxLength": 64,
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    }
  },
  "required": [
    "supported"
  ],
  "type": "object"
}
