{
  "$id": "https://ace.local/protocol/v1/McpNoticeInput.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "level": {
      "default": "info",
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "text": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "text"
  ],
  "type": "object"
}
