{
  "$id": "https://ace.local/protocol/v1/ForgeCompareHead.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "branch": {
      "$ref": "https://ace.local/protocol/v1/ForgeBranchName.json"
    },
    "name": {
      "$ref": "https://ace.local/protocol/v1/ForgeRepositoryName.json"
    },
    "owner": {
      "maxLength": 512,
      "not": {
        "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
      },
      "pattern": "^[\\w.-]+(?:\\/[\\w.-]+)*$",
      "type": "string",
      "x-ace-constraint": "Every owner path segment must differ from . and .."
    }
  },
  "required": [
    "owner",
    "name",
    "branch"
  ],
  "type": "object"
}
