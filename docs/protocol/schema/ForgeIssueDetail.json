{
  "$id": "https://ace.local/protocol/v1/ForgeIssueDetail.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assignees": {
      "items": {
        "maxLength": 65536,
        "type": "string"
      },
      "maxItems": 100,
      "type": "array"
    },
    "author": {
      "maxLength": 65536,
      "type": "string"
    },
    "body": {
      "maxLength": 65536,
      "type": "string"
    },
    "createdAt": {
      "maxLength": 65536,
      "type": "string"
    },
    "labels": {
      "items": {
        "maxLength": 65536,
        "type": "string"
      },
      "maxItems": 100,
      "type": "array"
    },
    "milestone": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "permissions": {
      "properties": {
        "close": {
          "type": "boolean"
        },
        "comment": {
          "type": "boolean"
        },
        "edit": {
          "type": "boolean"
        },
        "reason": {
          "maxLength": 256,
          "type": "string"
        },
        "reopen": {
          "type": "boolean"
        }
      },
      "required": [
        "edit",
        "close",
        "reopen",
        "comment",
        "reason"
      ],
      "type": "object"
    },
    "raw": {},
    "ref": {
      "$ref": "https://ace.local/protocol/v1/ForgeIssueRef.json"
    },
    "relatedThreads": {
      "items": {
        "properties": {
          "archived": {
            "type": "boolean"
          },
          "id": {
            "$ref": "https://ace.local/protocol/v1/ThreadId.json"
          },
          "title": {
            "maxLength": 65536,
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "archived"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "type": "array"
    },
    "relatedThreadsTruncated": {
      "type": "boolean"
    },
    "state": {
      "enum": [
        "open",
        "closed"
      ],
      "type": "string"
    },
    "title": {
      "maxLength": 65536,
      "type": "string"
    },
    "updatedAt": {
      "maxLength": 65536,
      "type": "string"
    },
    "url": {
      "maxLength": 65536,
      "type": "string"
    }
  },
  "required": [
    "ref",
    "title",
    "url",
    "author",
    "state",
    "labels",
    "assignees",
    "milestone",
    "createdAt",
    "updatedAt",
    "body",
    "permissions",
    "relatedThreads",
    "relatedThreadsTruncated"
  ],
  "type": "object"
}
