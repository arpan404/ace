{
  "$id": "https://ace.local/protocol/v1/automation_run.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "default": "run",
      "enum": [
        "run",
        "pause",
        "resume"
      ],
      "type": "string"
    },
    "id": {
      "description": "The automation's id, as you named it in automation_put.",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "requestId": {
      "description": "run: any stable id; repeats run once.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    },
    "variables": {
      "$ref": "https://ace.local/protocol/v1/TriggerVariables.json",
      "default": {},
      "description": "run: values for {{name}} placeholders in its prompt."
    }
  },
  "required": [
    "id"
  ],
  "type": "object",
  "x-ace-constraint": "run needs requestId."
}
