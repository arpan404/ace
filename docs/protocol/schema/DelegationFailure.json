{
  "$id": "https://ace.local/protocol/v1/DelegationFailure.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "accountId": {
      "maxLength": 256,
      "type": "string"
    },
    "accountLabel": {
      "maxLength": 256,
      "type": "string"
    },
    "code": {
      "enum": [
        "usage_limited",
        "provider_failed"
      ],
      "type": "string"
    },
    "message": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "resetsAt": {
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "type": "object"
}
