{
  "$id": "https://ace.local/protocol/v1/question_answer.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answers": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "Question id to chosen option ids, or free text where other is allowed.",
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "dismissed": {
      "description": "Decline; the agent continues without.",
      "type": "boolean"
    },
    "feedback": {
      "maxLength": 8192,
      "type": "string"
    },
    "interactionId": {
      "$ref": "https://ace.local/protocol/v1/InteractionId.json"
    },
    "requestId": {
      "description": "Any stable id; a repeat with it runs once.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    },
    "threadId": {
      "description": "This thread, one you started or, with full access, any.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "requestId",
    "interactionId",
    "answers"
  ],
  "type": "object"
}
