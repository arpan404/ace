{
  "$id": "https://ace.local/protocol/v1/AgentSelection.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "access": {
      "$ref": "https://ace.local/protocol/v1/AccessRequest.json"
    },
    "accountId": {
      "$ref": "https://ace.local/protocol/v1/AccountInstanceId.json"
    },
    "acpAgentId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "effort": {
      "anyOf": [
        {
          "const": "inherit",
          "type": "string"
        },
        {
          "$ref": "https://ace.local/protocol/v1/AgentEffort.json"
        }
      ]
    },
    "installationId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "instanceId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "model": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "options": {
      "$ref": "https://ace.local/protocol/v1/AgentServiceOptions.json"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    }
  },
  "required": [
    "provider"
  ],
  "type": "object"
}
