{
  "$id": "https://ace.local/protocol/v1/MarketClientMessage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "operation": {
      "$ref": "https://ace.local/protocol/v1/MarketOperation.json"
    },
    "personGrant": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "requestId": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
    },
    "thread": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "type": {
      "const": "marketplace.request",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "operation"
  ],
  "type": "object"
}
