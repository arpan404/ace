      "type": "integer"
    },
    "path": {
      "maxLength": 4096,
      "type": "string"
    },
    "size": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "type": {
      "enum": [
        "file",
        "directory",
        "symlink",
        "other"
      ],
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "$ref": "https://ace.local/protocol/v1/FileVersion.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
