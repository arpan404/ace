{
  "$id": "https://ace.local/protocol/v1/AceAccountHandover.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "properties": {
        "origin": {
          "$ref": "https://ace.local/protocol/v1/AceAccountOrigin.json"
        },
        "ticket": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "ticket"
      ],
      "type": "object"
    },
    {
      "properties": {
        "origin": {
          "$ref": "https://ace.local/protocol/v1/AceAccountOrigin.json"
        },
        "token": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "token"
      ],
      "type": "object"
    }
  ]
}
