{
  "$id": "https://ace.local/protocol/v1/Capabilities.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "approvals": {
      "enum": [
        "interactive",
        "sandbox-only",
        "none"
      ],
      "type": "string"
    },
    "backgroundTaskControl": {
      "type": "boolean"
    },
    "backgroundVisibility": {
      "enum": [
        "full",
        "partial",
        "none"
      ],
      "type": "string"
    },
    "childControls": {
      "enum": [
        "native",
        "read-only"
      ],
      "type": "string"
    },
    "childFidelity": {
      "enum": [
        "full",
        "summary",
        "placeholder"
      ],
      "type": "string"
    },
    "fork": {
      "type": "boolean"
    },
    "forkMode": {
      "enum": [
        "native",
        "context-handoff",
        "none"
      ],
      "type": "string"
    },
    "forkPoints": {
      "items": {
        "enum": [
          "turn",
          "item",
          "end"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "type": "array"
    },
    "forkSubagents": {
      "type": "boolean"
    },
    "imageInput": {
      "type": "boolean"
    },
    "interruptCascades": {
      "type": "boolean"
    },
    "launchOptions": {
      "items": {
        "enum": [
          "effort",
          "serviceTier"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "type": "array"
    },
    "planMode": {
      "type": "boolean"
    },
    "resume": {
      "type": "boolean"
    },
    "rewindFiles": {
      "type": "boolean"
    },
    "sessionOptions": {
      "type": "boolean"
    },
    "steer": {
      "type": "boolean"
    },
    "steeringMode": {
      "enum": [
        "native",
        "interrupt-restart",
        "queue"
      ],
      "type": "string"
    },
    "subagentTranscripts": {
      "type": "boolean"
    },
    "tokenUsage": {
      "type": "boolean"
    }
  },
  "required": [
    "steer",
    "interruptCascades",
    "resume",
    "fork",
    "subagentTranscripts",
    "backgroundTaskControl",
    "backgroundVisibility",
    "planMode",
    "tokenUsage",
    "imageInput",
    "rewindFiles"
  ],
  "type": "object"
}
