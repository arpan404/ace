{
  "$id": "https://ace.local/protocol/v1/PluginResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "https://ace.local/protocol/v1/PluginAvailability.json"
        },
        "type": {
          "const": "plugins.availability",
          "type": "string"
        }
      },
      "required": [
        "type",
        "availability"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/PluginComponent.json"
          },
          "maxItems": 50,
          "type": "array"
        },
        "nextOffset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "plugins.catalog",
          "type": "string"
        }
      },
      "required": [
        "type",
        "components"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "hash": {
          "$ref": "https://ace.local/protocol/v1/PluginHash.json"
        },
        "nextOffset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "maxLength": 4096,
          "type": "string"
        },
        "readonly": {
          "const": true,
          "type": "boolean"
        },
        "text": {
          "maxLength": 65536,
          "type": "string"
        },
        "type": {
          "const": "plugins.source",
          "type": "string"
        }
      },
      "required": [
        "type",
        "path",
        "hash",
        "bytes",
        "offset",
        "nextOffset",
        "text",
        "readonly"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9-]{1,80}$",
          "type": "string"
        },
        "type": {
          "const": "plugins.cancelled",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "review": {
          "$ref": "https://ace.local/protocol/v1/PluginReview.json"
        },
        "type": {
          "const": "plugins.review",
          "type": "string"
        }
      },
      "required": [
        "type",
        "review"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "install": {
          "$ref": "https://ace.local/protocol/v1/PluginInstall.json"
        },
        "type": {
          "const": "plugins.installed",
          "type": "string"
        }
      },
      "required": [
        "type",
        "install"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/PluginAvailability.json"
          },
          "maxItems": 256,
          "type": "array"
        },
        "installs": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/PluginInstall.json"
          },
          "maxItems": 256,
          "type": "array"
        },
        "reviews": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/PluginReviewSummary.json"
          },
          "maxItems": 32,
          "type": "array"
        },
        "type": {
          "const": "plugins.list",
          "type": "string"
        }
      },
      "required": [
        "type",
        "installs",
        "reviews"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "https://ace.local/protocol/v1/PluginName.json"
        },
        "type": {
          "const": "plugins.removed",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/PluginReviewEntry.json"
          },
          "maxItems": 1024,
          "type": "array"
        },
        "nextOffset": {
          "maximum": 1024,
          "minimum": 1,
          "type": "integer"
        },
        "review": {
          "$ref": "https://ace.local/protocol/v1/PluginReviewSummary.json"
        },
        "type": {
          "const": "plugins.reviewPage",
          "type": "string"
        }
      },
      "required": [
        "type",
        "review",
        "entries"
      ],
      "type": "object"
    }
  ]
}
