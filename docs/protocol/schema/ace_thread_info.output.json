                  "type": "string"
                },
                "state": {
                  "const": "waiting",
                  "type": "string"
                }
              },
              "required": [
                "state",
                "on"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "failed",
                  "type": "string"
                }
              },
              "required": [
                "state"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "unresponsive",
                  "type": "string"
                }
              },
              "required": [
                "state"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "done",
                  "type": "string"
                }
              },
              "required": [
                "state"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "new",
                  "type": "string"
                }
              },
              "required": [
                "state"
              ],
              "type": "object"
            }
          ]
        },
        "switch": {
          "additionalProperties": false,
          "properties": {
            "at": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "error": {
              "maxLength": 2048,
              "type": "string"
            },
            "lossy": {
              "type": "boolean"
            },
            "recommendation": {
              "const": "delegate_task",
              "type": "string"
            },
            "selection": {
              "additionalProperties": false,
              "properties": {
                "instanceId": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                "model": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                "options": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "maxLength": 1024,
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "default": {},
                  "propertyNames": {
                    "maxLength": 128,
                    "type": "string"
                  },
                  "type": "object",
                  "x-ace-constraint": "At most 32 provider option entries."
                },
                "provider": {
                  "enum": [
                    "claude",
                    "codex",
                    "opencode",
                    "cursor",
                    "antigravity",
                    "acp"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "provider",
                "options"
              ],
              "type": "object"
            },
            "state": {
              "enum": [
                "queued",
                "applied",
                "failed"
              ],
              "type": "string"
            }
          },
          "required": [
            "selection",
            "state",
            "lossy",
            "at"
          ],
          "type": "object"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "workspaceId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "title",
        "provider",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    }
  },
  "required": [
    "thread"
  ],
  "type": "object"
}
