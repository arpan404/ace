{
  "$id": "https://ace.local/protocol/v1/ace_thread_info.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "thread": {
      "additionalProperties": false,
      "properties": {
        "archivedAt": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "createdAt": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "execution": {
          "additionalProperties": false,
          "properties": {
            "instanceId": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "model": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "options": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "maxLength": 1024,
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "default": {},
              "propertyNames": {
                "maxLength": 128,
                "type": "string"
              },
              "type": "object",
              "x-ace-constraint": "At most 32 provider option entries."
            },
            "provider": {
              "enum": [
                "claude",
                "codex",
                "opencode",
                "cursor",
                "antigravity",
                "acp"
              ],
              "type": "string"
            }
          },
          "required": [
            "provider",
            "options"
          ],
          "type": "object"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "imported": {
          "additionalProperties": false,
          "properties": {
            "importedAt": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "instanceId": {
              "minLength": 1,
              "type": "string"
            },
            "native": {
              "additionalProperties": false,
              "properties": {
                "aliases": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "forkedFromNativeId": {
                  "maxLength": 1024,
                  "minLength": 1,
                  "type": "string"
                },
                "nativeId": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "provider": {
                  "enum": [
                    "claude",
                    "codex",
                    "opencode",
                    "cursor",
                    "antigravity",
                    "acp"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "provider"
              ],
              "type": "object"
            },
            "sourceId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "sourceId",
            "instanceId",
            "native",
            "importedAt"
          ],
          "type": "object"
        },
        "lineage": {
          "additionalProperties": false,
          "properties": {
            "lossy": {
              "type": "boolean"
            },
            "mode": {
              "enum": [
                "native",
                "portable"
              ],
              "type": "string"
            },
            "parentAgentId": {
              "minLength": 1,
              "type": "string"
            },
            "parentThreadId": {
              "minLength": 1,
              "type": "string"
            },
            "point": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "runId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "type": {
                      "const": "turn",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "runId"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "itemId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "type": {
                      "const": "item",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "itemId"
                  ],
                  "type": "object"
                }
              ]
            }
          },
          "required": [
            "parentThreadId",
            "parentAgentId",
            "point",
            "mode",
            "lossy"
          ],
          "type": "object"
        },
        "provider": {
          "enum": [
            "claude",
            "codex",
            "opencode",
            "cursor",
            "antigravity",
            "acp"
          ],
          "type": "string"
        },
        "rootAgentId": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "interactions": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "state": {
                  "const": "needs_you",
                  "type": "string"
                }
              },
              "required": [
                "state",
                "interactions"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "agents": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "state": {
                  "const": "working",
                  "type": "string"
                }
              },
              "required": [
                "state",
                "agents"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "on": {
                  "enum": [
                    "background_task",
                    "rate_limit",
                    "network",
                    "upstream",
                    "queue"
