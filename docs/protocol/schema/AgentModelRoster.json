{
  "$id": "https://ace.local/protocol/v1/AgentModelRoster.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "caller": {
      "properties": {
        "access": {
          "anyOf": [
            {
              "$ref": "https://ace.local/protocol/v1/AccessMode.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
        }
      },
      "required": [
        "provider",
        "access"
      ],
      "type": "object"
    },
    "efforts": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "noModels": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
      },
      "maxItems": 16,
      "type": "array"
    },
    "providers": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/AgentModelsProvider.json"
      },
      "maxItems": 16,
      "type": "array"
    }
  },
  "required": [
    "providers",
    "caller"
  ],
  "type": "object"
}
