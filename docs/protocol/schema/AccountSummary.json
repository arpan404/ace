{
  "$id": "https://ace.local/protocol/v1/AccountSummary.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "acpAgentId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "authMethod": {
      "enum": [
        "browser",
        "api_key",
        "unknown"
      ],
      "type": "string"
    },
    "availability": {
      "$ref": "https://ace.local/protocol/v1/AccountAvailability.json"
    },
    "badgeColor": {
      "$ref": "https://ace.local/protocol/v1/AccountBadgeColor.json"
    },
    "badgeUsesInitial": {
      "type": "boolean"
    },
    "blockedUntil": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "cliHome": {
      "maxLength": 4096,
      "type": "string"
    },
    "homeStrategy": {
      "const": "default_cli",
      "type": "string"
    },
    "id": {
      "$ref": "https://ace.local/protocol/v1/AccountInstanceId.json"
    },
    "implicit": {
      "type": "boolean"
    },
    "installationId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "installationVersion": {
      "maxLength": 256,
      "type": "string"
    },
    "instanceId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "isDefault": {
      "type": "boolean"
    },
    "isolation": {
      "const": "unsupported",
      "type": "string"
    },
    "label": {
      "maxLength": 128,
      "type": "string"
    },
    "loginRevision": {
      "maxLength": 128,
      "type": "string"
    },
    "profileRevision": {
      "maxLength": 256,
      "type": "string"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/AccountProvider.json"
    },
    "quota": {
      "$ref": "https://ace.local/protocol/v1/AccountQuota.json"
    },
    "shortLabel": {
      "$ref": "https://ace.local/protocol/v1/AccountShortLabel.json"
    },
    "signedInAs": {
      "maxLength": 256,
      "type": "string"
    }
  },
  "required": [
    "id",
    "provider",
    "label",
    "quota",
    "availability"
  ],
  "type": "object"
}
