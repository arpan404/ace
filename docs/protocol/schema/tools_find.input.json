{
  "$id": "https://ace.local/protocol/v1/tools_find.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "family": {
      "enum": [
        "ace-agents",
        "ace-browser",
        "visualize",
        "ace-threads",
        "ace-computer-use",
        "offshift"
      ],
      "type": "string"
    },
    "limit": {
      "default": 5,
      "maximum": 10,
      "minimum": 1,
      "type": "integer"
    },
    "query": {
      "description": "In plain words, e.g. \"click a button in Safari\".",
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "query"
  ],
  "type": "object"
}
