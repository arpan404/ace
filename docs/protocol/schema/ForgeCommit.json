{
  "$id": "https://ace.local/protocol/v1/ForgeCommit.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "author": {
      "maxLength": 65536,
      "type": "string"
    },
    "date": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "maxLength": 65536,
      "type": "string"
    },
    "raw": {},
    "sha": {
      "pattern": "^[a-fA-F0-9]{40,64}$",
      "type": "string"
    },
    "url": {
      "maxLength": 65536,
      "type": "string"
    }
  },
  "required": [
    "sha",
    "message",
    "author",
    "date",
    "url"
  ],
  "type": "object"
}
