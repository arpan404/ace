{
  "$id": "https://ace.local/protocol/v1/delegate_task.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "unsupported",
        "forbidden",
        "not_found",
        "limit",
        "not_ready",
        "invalid",
        "unavailable"
      ],
      "type": "string"
    },
    "data": {
      "additionalProperties": {},
      "properties": {
        "outcome": {
          "additionalProperties": false,
          "properties": {
            "before": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "outcome": {
              "enum": [
                "completed",
                "failed",
                "cancelled"
              ],
              "type": "string"
            },
            "result": {
              "maxLength": 4096,
              "type": "string"
            },
            "threadId": {
              "minLength": 1,
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "threadId",
            "outcome",
            "result",
            "truncated",
            "before"
          ],
          "type": "object"
        },
        "threadId": {
          "minLength": 1,
          "type": "string"
        },
        "threadIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "wait": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "any",
                "all"
              ],
              "type": "string"
            },
            "status": {
              "enum": [
                "ready",
                "needs_you",
                "timeout",
                "interrupted"
              ],
              "type": "string"
            },
            "threads": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "elapsedSeconds": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "last": {
                    "maxLength": 160,
                    "type": "string"
                  },
                  "machine": {
                    "maxLength": 64,
                    "type": "string"
                  },
                  "needs": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "interactionId": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "kind": {
                          "maxLength": 64,
                          "type": "string"
                        },
                        "prompt": {
                          "maxLength": 240,
                          "type": "string"
                        }
                      },
                      "required": [
                        "interactionId",
                        "kind",
                        "prompt"
                      ],
                      "type": "object"
                    },
                    "maxItems": 8,
                    "type": "array"
                  },
                  "result": {
                    "maxLength": 4096,
                    "type": "string"
                  },
                  "state": {
                    "enum": [
                      "working",
                      "needs_you",
                      "done",
                      "failed",
                      "cancelled"
                    ],
                    "type": "string"
                  },
                  "step": {
                    "maxLength": 120,
                    "type": "string"
                  },
                  "threadId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "title": {
                    "maxLength": 120,
                    "type": "string"
                  },
                  "truncated": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "threadId",
                  "state",
                  "title",
                  "elapsedSeconds"
                ],
                "type": "object"
              },
              "maxItems": 16,
              "type": "array"
            }
          },
          "required": [
            "status",
            "mode",
            "threads"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "hint": {
      "maxLength": 512,
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    }
  },
  "required": [
    "ok"
  ],
  "type": "object"
}
