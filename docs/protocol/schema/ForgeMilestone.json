{
  "$id": "https://ace.local/protocol/v1/ForgeMilestone.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "dueOn": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "number": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "state": {
      "enum": [
        "open",
        "closed"
      ],
      "type": "string"
    },
    "title": {
      "maxLength": 65536,
      "type": "string"
    }
  },
  "required": [
    "number",
    "title",
    "state",
    "dueOn"
  ],
  "type": "object"
}
