{
  "$id": "https://ace.local/protocol/v1/ForgeReviewDraft.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "anchor": {
      "$ref": "https://ace.local/protocol/v1/ForgeReviewAnchor.json"
    },
    "body": {
      "maxLength": 60000,
      "type": "string"
    },
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "outdated": {
      "properties": {
        "code": {
          "items": {
            "maxLength": 2000,
            "type": "string"
          },
          "maxItems": 12,
          "type": "array"
        },
        "headSha": {
          "pattern": "^[a-fA-F0-9]{40,64}$",
          "type": "string"
        }
      },
      "required": [
        "headSha",
        "code"
      ],
      "type": "object"
    }
  },
  "required": [
    "id",
    "body",
    "anchor"
  ],
  "type": "object"
}
