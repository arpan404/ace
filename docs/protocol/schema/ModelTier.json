{
  "$id": "https://ace.local/protocol/v1/ModelTier.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "parameters": {
      "additionalProperties": {
        "anyOf": [
          {
            "maxLength": 256,
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "default": {},
      "maxProperties": 16,
      "propertyNames": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "type": "object",
      "x-ace-constraint": "At most 16 entries."
    },
    "speed": {
      "enum": [
        "standard",
        "fast"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "type": "object"
}
