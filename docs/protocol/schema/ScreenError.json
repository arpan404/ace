{
  "$id": "https://ace.local/protocol/v1/ScreenError.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "code": {
      "enum": [
        "permission_denied",
        "approval_required",
        "screen_disabled",
        "denied",
        "read_only",
        "target_gone",
        "not_supported",
        "bounds",
        "busy",
        "timeout",
        "internal",
        "target_busy",
        "foreground_required",
        "focus_changed",
        "window_minimized",
        "window_offscreen",
        "secure_input_required",
        "clipboard_changed"
      ],
      "type": "string"
    },
    "message": {
      "maxLength": 1024,
      "type": "string"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "type": "object"
}
