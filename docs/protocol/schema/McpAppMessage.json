{
  "$id": "https://ace.local/protocol/v1/McpAppMessage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "content": {
      "anyOf": [
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "items": {
            "properties": {
              "text": {
                "type": "string"
              },
              "type": {
                "const": "text",
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      ]
    },
    "role": {
      "const": "user",
      "type": "string"
    }
  },
  "required": [
    "role",
    "content"
  ],
  "type": "object"
}
