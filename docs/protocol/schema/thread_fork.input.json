{
  "$id": "https://ace.local/protocol/v1/thread_fork.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "effort": {
      "description": "With model.",
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "model": {
      "description": "Same provider and account: id from models, or a name (\"opus 5.5\").",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "requestId": {
      "description": "Any stable id; a repeat with it runs once.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    },
    "runId": {
      "description": "Fork after this finished run instead.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "text": {
      "description": "The other approach, standing on its own.",
      "maxLength": 262144,
      "minLength": 1,
      "type": "string"
    },
    "threadId": {
      "description": "Default: this thread.",
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "description": "Sidebar title.",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "requestId",
    "text"
  ],
  "type": "object"
}
