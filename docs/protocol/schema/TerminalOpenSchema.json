{
  "$id": "https://ace.local/protocol/v1/TerminalOpenSchema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cols": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "cwd": {
      "minLength": 1,
      "type": "string"
    },
    "env": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "rows": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "shell": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "cwd",
    "cols",
    "rows",
    "name"
  ],
  "type": "object"
}
