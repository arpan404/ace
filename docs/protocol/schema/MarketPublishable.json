{
  "$id": "https://ace.local/protocol/v1/MarketPublishable.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "face": {
      "additionalProperties": {},
      "propertyNames": {
        "maxLength": 40,
        "type": "string"
      },
      "type": "object"
    },
    "from": {
      "enum": [
        "spade",
        "ace",
        "plugin"
      ],
      "type": "string"
    },
    "line": {
      "maxLength": 300,
      "type": "string"
    },
    "name": {
      "$ref": "https://ace.local/protocol/v1/MarketEntryName.json"
    },
    "source": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "kind": {
              "const": "spade-bot",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "kind": {
              "const": "spade-skill",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "https://ace.local/protocol/v1/SkillId.json"
            },
            "kind": {
              "const": "ace-skill",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "plugin",
              "type": "string"
            },
            "name": {
              "$ref": "https://ace.local/protocol/v1/MarketEntryName.json"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "$ref": "https://ace.local/protocol/v1/MarketPickType.json"
    }
  },
  "required": [
    "type",
    "name",
    "title",
    "line",
    "from",
    "source"
  ],
  "type": "object"
}
