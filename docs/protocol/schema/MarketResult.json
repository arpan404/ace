{
  "$id": "https://ace.local/protocol/v1/MarketResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "sources",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/MarketSource.json"
          },
          "maxItems": 32,
          "type": "array"
        }
      },
      "required": [
        "op",
        "sources"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/MarketEntrySummary.json"
          },
          "maxItems": 100,
          "type": "array"
        },
        "op": {
          "const": "search",
          "type": "string"
        },
        "readAt": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "op",
        "entries",
        "total"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "entries": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "$ref": "https://ace.local/protocol/v1/MarketCategoryId.json"
              },
              "title": {
                "maxLength": 60,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "entries"
            ],
            "type": "object"
          },
          "maxItems": 32,
          "type": "array"
        },
        "featured": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/MarketEntrySummary.json"
          },
          "maxItems": 24,
          "type": "array"
        },
        "installed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "op": {
          "const": "home",
          "type": "string"
        },
        "updates": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "op",
        "featured",
        "categories",
        "installed",
        "updates"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "entry": {
          "$ref": "https://ace.local/protocol/v1/MarketEntryDetail.json"
        },
        "op": {
          "const": "read",
          "type": "string"
        }
      },
      "required": [
        "op",
        "entry"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "review",
          "type": "string"
        },
        "review": {
          "$ref": "https://ace.local/protocol/v1/MarketReview.json"
        }
      },
      "required": [
        "op",
        "review"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/MarketReviewItem.json"
          },
          "maxItems": 512,
          "type": "array"
        },
        "nextOffset": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "op": {
          "const": "reviewPage",
          "type": "string"
        },
        "review": {
          "$ref": "https://ace.local/protocol/v1/MarketReview.json"
        }
      },
      "required": [
        "op",
        "review",
        "items"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "installed": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/MarketInstalled.json"
          },
          "maxItems": 1024,
          "type": "array"
        },
        "op": {
          "const": "installed",
          "type": "string"
        }
      },
      "required": [
        "op",
        "installed"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "installed": {
          "$ref": "https://ace.local/protocol/v1/MarketInstalled.json"
        },
        "op": {
          "const": "done",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "spadeSkills",
          "type": "string"
        },
        "skills": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/MarketSpadeSkill.json"
          },
          "maxItems": 1024,
          "type": "array"
        }
      },
      "required": [
        "op",
        "skills"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 6000000,
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/MarketSpadeFile.json"
          },
          "maxItems": 512,
          "type": "array"
        },
        "op": {
          "const": "spadeSkillFiles",
          "type": "string"
        }
      },
      "required": [
        "op",
        "files"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "https://ace.local/protocol/v1/MarketErrorCode.json"
        },
        "message": {
          "maxLength": 2000,
          "type": "string"
        },
        "op": {
          "const": "error",
          "type": "string"
        },
        "problems": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/MarketProblem.json"
          },
          "maxItems": 200,
          "type": "array"
        }
      },
      "required": [
        "op",
        "code",
        "message"
      ],
      "type": "object"
    }
  ]
}
