{
  "$id": "https://ace.local/protocol/v1/RemoteContextManifest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attachments": {
      "items": {
        "properties": {
          "aliases": {
            "items": {
              "maxLength": 1024,
              "type": "string"
            },
            "maxItems": 16,
            "type": "array"
          },
          "bytes": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "delivery": {
            "enum": [
              "native_image",
              "native_pdf",
              "native_resource",
              "inline_text",
              "inline_text_and_path",
              "file_path"
            ],
            "type": "string"
          },
          "height": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "kind": {
            "enum": [
              "image",
              "pdf",
              "text",
              "binary"
            ],
            "type": "string"
          },
          "mimeType": {
            "maxLength": 128,
            "type": "string"
          },
          "name": {
            "maxLength": 255,
            "type": "string"
          },
          "sha256": {
            "$ref": "https://ace.local/protocol/v1/BlobHash.json"
          },
          "sourcePath": {
            "maxLength": 1024,
            "type": "string"
          },
          "thumbnailAvailable": {
            "type": "boolean"
          },
          "width": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "sha256",
          "bytes",
          "mimeType",
          "name"
        ],
        "type": "object"
      },
      "maxItems": 16,
      "type": "array"
    },
    "before": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceHostId": {
      "$ref": "https://ace.local/protocol/v1/HostId.json"
    },
    "sourceThreadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "summary": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "sourceHostId",
    "sourceThreadId",
    "summary",
    "before",
    "attachments"
  ],
  "type": "object"
}
