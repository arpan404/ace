{
  "$id": "https://ace.local/protocol/v1/thread_read.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "unsupported",
        "forbidden",
        "not_found",
        "limit",
        "not_ready",
        "invalid",
        "unavailable"
      ],
      "type": "string"
    },
    "data": {
      "additionalProperties": {},
      "properties": {
        "eof": {
          "description": "With streamId: true when the text ends with this page.",
          "type": "boolean"
        },
        "items": {
          "items": {
            "additionalProperties": {},
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "itemsBefore": {
          "description": "Pass as before for the previous page; null when nothing is earlier.",
          "type": [
            "number",
            "null"
          ]
        },
        "linkedPrs": {
          "items": {},
          "type": "array"
        },
        "nextOffset": {
          "description": "With streamId: pass back unchanged as offset for the next page.",
          "type": "number"
        },
        "omitted": {
          "description": "Items too large for a page: shown without raw payloads (dropped raw) or only summarized (dropped item).",
          "items": {
            "additionalProperties": {},
            "properties": {
              "dropped": {
                "type": "string"
              },
              "itemId": {
                "type": "string"
              }
            },
            "required": [
              "itemId",
              "dropped"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "previews": {
          "items": {},
          "type": "array"
        },
        "queue": {
          "description": "Messages waiting for the thread, oldest first."
        },
        "text": {
          "description": "With streamId: this page of the part's text, decoded.",
          "type": "string"
        },
        "thread": {
          "additionalProperties": {},
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "title"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "hint": {
      "maxLength": 512,
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    }
  },
  "required": [
    "ok"
  ],
  "type": "object"
}
