{
  "$id": "https://ace.local/protocol/v1/AdmissionResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "admission": {
      "$ref": "https://ace.local/protocol/v1/Admission.json"
    },
    "error": {
      "enum": [
        "forbidden",
        "unavailable"
      ],
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "admission.result",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "ok"
  ],
  "type": "object"
}
