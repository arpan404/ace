{
  "$id": "https://ace.local/protocol/v1/HelloEarly.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compression": {
      "items": {
        "maxLength": 32,
        "type": "string"
      },
      "maxItems": 8,
      "type": "array"
    },
    "deviceId": {
      "$ref": "https://ace.local/protocol/v1/DeviceId.json"
    },
    "flowControl": {
      "items": {
        "maxLength": 32,
        "type": "string"
      },
      "maxItems": 8,
      "type": "array"
    },
    "framing": {
      "items": {
        "maxLength": 32,
        "type": "string"
      },
      "maxItems": 8,
      "type": "array"
    },
    "grant": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "protocolVersion": {
      "const": 1,
      "type": "number"
    },
    "subscribes": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/EarlySubscribe.json"
      },
      "maxItems": 6,
      "type": "array"
    },
    "ticket": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "trims": {
      "items": {
        "maxLength": 32,
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "type": {
      "const": "hello.early",
      "type": "string"
    }
  },
  "required": [
    "type",
    "protocolVersion",
    "deviceId"
  ],
  "type": "object",
  "x-ace-constraint": "Exactly one of ticket and grant; at most 4 thread subscribes and 2 sidebar windows, with distinct subscription ids; a threads scope needs its window."
}
