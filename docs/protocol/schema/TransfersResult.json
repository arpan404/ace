{
  "$id": "https://ace.local/protocol/v1/TransfersResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "result": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "list",
              "type": "string"
            },
            "transfers": {
              "items": {
                "$ref": "https://ace.local/protocol/v1/Transfer.json"
              },
              "maxItems": 100,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "transfers"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "cancelled",
              "type": "string"
            },
            "transfer": {
              "$ref": "https://ace.local/protocol/v1/Transfer.json"
            }
          },
          "required": [
            "kind",
            "transfer"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "kind": {
              "const": "error",
              "type": "string"
            },
            "message": {
              "maxLength": 512,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "code",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "type": {
      "const": "transfers.result",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "result"
  ],
  "type": "object"
}
