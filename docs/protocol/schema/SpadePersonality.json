{
  "$id": "https://ace.local/protocol/v1/SpadePersonality.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "emoji": {
      "default": false,
      "type": "boolean"
    },
    "humour": {
      "default": false,
      "type": "boolean"
    },
    "tone": {
      "enum": [
        "concise",
        "warm",
        "formal",
        "playful"
      ],
      "type": "string"
    }
  },
  "type": "object"
}
