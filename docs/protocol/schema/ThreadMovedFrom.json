{
  "$id": "https://ace.local/protocol/v1/ThreadMovedFrom.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "links": {
      "properties": {
        "linkedIssues": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/ForgeIssueRef.json"
          },
          "maxItems": 100,
          "type": "array"
        },
        "linkedPr": {
          "anyOf": [
            {
              "properties": {
                "draft": {
                  "type": "boolean"
                },
                "number": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "state": {
                  "enum": [
                    "open",
                    "closed",
                    "merged"
                  ],
                  "type": "string"
                },
                "url": {
                  "format": "ace-whatwg-url",
                  "type": "string",
                  "x-ace-constraint": "Accept strings whose trimmed value is an absolute WHATWG URL. Whitespace, Unicode hosts, opaque schemes and parser-normalized URLs are allowed. x-ace-url-minLength and x-ace-url-maxLength apply after trimming whitespace and removing ASCII tab, CR and LF characters, using UTF-16 code units. Install the ace-whatwg-url format validator or enforce this rule in application code.",
                  "x-ace-url-maxLength": 4096
                }
              },
              "required": [
                "number",
                "state"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "linkedPrs": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/LinkedPullRequest.json"
          },
          "maxItems": 100,
          "type": "array"
        },
        "repository": {
          "$ref": "https://ace.local/protocol/v1/ForgeRepository.json"
        }
      },
      "type": "object"
    },
    "workspaceId": {
      "$ref": "https://ace.local/protocol/v1/WorkspaceId.json"
    }
  },
  "required": [
    "workspaceId",
    "links"
  ],
  "type": "object"
}
