{
  "$id": "https://ace.local/protocol/v1/ace_device_task_wait.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "taskId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    }
  },
  "required": [
    "taskId"
  ],
  "type": "object"
}
