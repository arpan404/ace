{
  "$id": "https://ace.local/protocol/v1/Run.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agentId": {
      "$ref": "https://ace.local/protocol/v1/AgentId.json"
    },
    "checkpoints": {
      "$ref": "https://ace.local/protocol/v1/RunCheckpoints.json"
    },
    "endedAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "error": {
      "$ref": "https://ace.local/protocol/v1/AgentError.json"
    },
    "executionSource": {
      "$ref": "https://ace.local/protocol/v1/ExecutionSource.json"
    },
    "id": {
      "$ref": "https://ace.local/protocol/v1/RunId.json"
    },
    "nativeId": {
      "type": "string"
    },
    "ordinal": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "startedAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "state": {
      "enum": [
        "active",
        "completed",
        "interrupted",
        "failed"
      ],
      "type": "string"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "trigger": {
      "$ref": "https://ace.local/protocol/v1/RunTrigger.json"
    }
  },
  "required": [
    "id",
    "threadId",
    "agentId",
    "trigger",
    "state",
    "startedAt"
  ],
  "type": "object"
}
