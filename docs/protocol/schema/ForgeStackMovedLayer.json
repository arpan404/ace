{
  "$id": "https://ace.local/protocol/v1/ForgeStackMovedLayer.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "branch": {
      "maxLength": 65536,
      "type": "string"
    },
    "current": {
      "pattern": "^[a-fA-F0-9]{40,64}$",
      "type": "string"
    },
    "number": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "reviewed": {
      "pattern": "^[a-fA-F0-9]{40,64}$",
      "type": "string"
    }
  },
  "required": [
    "number",
    "branch",
    "reviewed",
    "current"
  ],
  "type": "object"
}
