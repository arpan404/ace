{
  "$id": "https://ace.local/protocol/v1/MachineCall.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "describe",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "op": {
          "const": "delegate",
          "type": "string"
        },
        "project": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "type": "string"
        },
        "role": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "task": {
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "op",
        "requestId",
        "task",
        "role",
        "provider"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "status",
          "type": "string"
        },
        "threadIds": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/ThreadId.json"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "op",
        "threadIds"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "cancel",
          "type": "string"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        }
      },
      "required": [
        "op",
        "threadId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "interactionId": {
          "$ref": "https://ace.local/protocol/v1/InteractionId.json"
        },
        "op": {
          "const": "respond",
          "type": "string"
        },
        "resolution": {
          "$ref": "https://ace.local/protocol/v1/InteractionResolution.json"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        }
      },
      "required": [
        "op",
        "threadId",
        "interactionId",
        "resolution"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "browser.session",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "args": {
          "additionalProperties": {},
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "op": {
          "const": "browser",
          "type": "string"
        },
        "tool": {
          "pattern": "^ace_browser_[a-z_]{1,64}$",
          "type": "string"
        }
      },
      "required": [
        "op",
        "tool",
        "args"
      ],
      "type": "object"
    }
  ]
}
