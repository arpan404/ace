{
  "$id": "https://ace.local/protocol/v1/MachineCallOrigin.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "hostId": {
      "$ref": "https://ace.local/protocol/v1/HostId.json"
    },
    "hostName": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "threadTitle": {
      "maxLength": 256,
      "type": "string"
    }
  },
  "required": [
    "hostId",
    "hostName",
    "threadId",
    "threadTitle"
  ],
  "type": "object"
}
