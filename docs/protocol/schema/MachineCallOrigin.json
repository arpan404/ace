{
  "$id": "https://ace.local/protocol/v1/MachineCallOrigin.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "accepts": {
      "items": {
        "maxLength": 32,
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "agentId": {
      "$ref": "https://ace.local/protocol/v1/AgentId.json"
    },
    "ceiling": {
      "enum": [
        "read",
        "operate"
      ],
      "type": "string"
    },
    "hostId": {
      "$ref": "https://ace.local/protocol/v1/HostId.json"
    },
    "hostName": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "provider": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "threadTitle": {
      "maxLength": 256,
      "type": "string"
    }
  },
  "required": [
    "hostId",
    "hostName",
    "threadId",
    "threadTitle"
  ],
  "type": "object"
}
