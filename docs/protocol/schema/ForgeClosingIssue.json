{
  "$id": "https://ace.local/protocol/v1/ForgeClosingIssue.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "manual": {
      "type": "boolean"
    },
    "ref": {
      "properties": {
        "number": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "repository": {
          "$ref": "https://ace.local/protocol/v1/ForgeRepository.json"
        }
      },
      "required": [
        "repository",
        "number"
      ],
      "type": "object"
    },
    "state": {
      "enum": [
        "open",
        "closed"
      ],
      "type": "string"
    },
    "title": {
      "maxLength": 65536,
      "type": "string"
    },
    "url": {
      "maxLength": 65536,
      "type": "string"
    }
  },
  "required": [
    "ref",
    "title",
    "state",
    "url",
    "manual"
  ],
  "type": "object"
}
