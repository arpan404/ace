{
  "$id": "https://ace.local/protocol/v1/ForgePrSearch.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assignee": {
      "$ref": "https://ace.local/protocol/v1/ForgeSearchLogin.json"
    },
    "author": {
      "$ref": "https://ace.local/protocol/v1/ForgeSearchLogin.json"
    },
    "ci": {
      "default": "any",
      "enum": [
        "any",
        "failure",
        "success"
      ],
      "type": "string"
    },
    "labels": {
      "default": [],
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    },
    "order": {
      "default": "desc",
      "enum": [
        "asc",
        "desc"
      ],
      "type": "string"
    },
    "page": {
      "default": 1,
      "maximum": 40,
      "minimum": 1,
      "type": "integer"
    },
    "review": {
      "default": "any",
      "enum": [
        "any",
        "approved",
        "changes_requested",
        "required",
        "none"
      ],
      "type": "string"
    },
    "reviewer": {
      "$ref": "https://ace.local/protocol/v1/ForgeSearchLogin.json"
    },
    "search": {
      "default": "",
      "maxLength": 256,
      "type": "string"
    },
    "sort": {
      "default": "updated",
      "enum": [
        "created",
        "updated",
        "comments"
      ],
      "type": "string"
    },
    "state": {
      "default": "open",
      "enum": [
        "open",
        "draft",
        "closed",
        "merged",
        "active",
        "all"
      ],
      "type": "string"
    }
  },
  "type": "object"
}
