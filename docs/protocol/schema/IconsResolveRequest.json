{
  "$id": "https://ace.local/protocol/v1/IconsResolveRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "itemIds": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/ItemId.json"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "requestId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "type": {
      "const": "icons.resolve",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "threadId",
    "itemIds"
  ],
  "type": "object"
}
