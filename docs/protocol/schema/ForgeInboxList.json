{
  "$id": "https://ace.local/protocol/v1/ForgeInboxList.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "host": {
      "maxLength": 253,
      "pattern": "^[a-zA-Z0-9.-]+$",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/ForgeInboxRow.json"
      },
      "maxItems": 50,
      "type": "array"
    },
    "nextPage": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "pollSeconds": {
      "maximum": 3600,
      "minimum": 1,
      "type": "integer"
    },
    "unchanged": {
      "type": "boolean"
    }
  },
  "required": [
    "host",
    "items",
    "pollSeconds",
    "unchanged"
  ],
  "type": "object"
}
