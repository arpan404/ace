{
  "$id": "https://ace.local/protocol/v1/PluginRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "$ref": "https://ace.local/protocol/v1/PluginName.json"
        },
        "providers": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
          },
          "maxItems": 7,
          "type": "array"
        },
        "type": {
          "const": "plugins.availability",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "enabled",
        "providers"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 50,
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "maximum": 262144,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "plugins.catalog",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 65536,
          "maximum": 65536,
          "minimum": 4,
          "type": "integer"
        },
        "name": {
          "$ref": "https://ace.local/protocol/v1/PluginName.json"
        },
        "offset": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "plugins.source",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "path"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "expectedHash": {
          "$ref": "https://ace.local/protocol/v1/PluginHash.json"
        },
        "name": {
          "$ref": "https://ace.local/protocol/v1/PluginName.json"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "text": {
          "maxLength": 262144,
          "type": "string"
        },
        "type": {
          "const": "plugins.edit",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "path",
        "expectedHash",
        "text"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "https://ace.local/protocol/v1/PluginName.json"
        },
        "type": {
          "const": "plugins.update",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "maxLength": 8192,
          "type": "string"
        },
        "repository": {
          "maxLength": 8192,
          "type": "string"
        },
        "type": {
          "const": "plugins.marketplace",
          "type": "string"
        }
      },
      "required": [
        "type",
        "repository"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9-]{1,80}$",
          "type": "string"
        },
        "type": {
          "const": "plugins.cancel",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "https://ace.local/protocol/v1/PluginName.json"
        },
        "ref": {
          "maxLength": 8192,
          "type": "string"
        },
        "repository": {
          "maxLength": 8192,
          "type": "string"
        },
        "type": {
          "const": "plugins.prepare",
          "type": "string"
        }
      },
      "required": [
        "type",
        "repository",
        "ref",
        "name"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "https://ace.local/protocol/v1/PluginCommit.json"
        },
        "hash": {
          "$ref": "https://ace.local/protocol/v1/PluginHash.json"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9-]{1,80}$",
          "type": "string"
        },
        "type": {
          "const": "plugins.accept",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "commit",
        "hash"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "https://ace.local/protocol/v1/PluginName.json"
        },
        "type": {
          "const": "plugins.remove",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "plugins.list",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9-]{1,80}$",
          "type": "string"
        },
        "offset": {
          "$ref": "https://ace.local/protocol/v1/PluginReviewOffset.json",
          "default": 0
        },
        "type": {
          "const": "plugins.readReview",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    }
  ]
}
