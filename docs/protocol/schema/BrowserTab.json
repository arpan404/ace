{
  "$id": "https://ace.local/protocol/v1/BrowserTab.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "drivenBy": {
      "$ref": "https://ace.local/protocol/v1/BrowserTabActor.json"
    },
    "favicon": {
      "maxLength": 8192,
      "type": "string"
    },
    "inUse": {
      "$ref": "https://ace.local/protocol/v1/BrowserTabActor.json"
    },
    "label": {
      "maxLength": 64,
      "type": "string"
    },
    "lifecycle": {
      "$ref": "https://ace.local/protocol/v1/BrowserTabLifecycle.json"
    },
    "loading": {
      "type": "boolean"
    },
    "openedBy": {
      "$ref": "https://ace.local/protocol/v1/BrowserTabActor.json"
    },
    "pending_dialog": {
      "$ref": "https://ace.local/protocol/v1/BrowserDialog.json"
    },
    "playing": {
      "type": "boolean"
    },
    "pointer": {
      "$ref": "https://ace.local/protocol/v1/BrowserAgentPointer.json"
    },
    "private": {
      "type": "boolean"
    },
    "tabId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "maxLength": 1024,
      "type": "string"
    },
    "url": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "tabId",
    "url",
    "title"
  ],
  "type": "object"
}
