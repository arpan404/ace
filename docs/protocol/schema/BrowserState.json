{
  "$id": "https://ace.local/protocol/v1/BrowserState.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "activeTabId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "annotation": {
      "properties": {
        "owner": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "owner"
      ],
      "type": "object"
    },
    "backend": {
      "enum": [
        "embedded",
        "headless",
        "user"
      ],
      "type": "string"
    },
    "blocked": {
      "$ref": "https://ace.local/protocol/v1/BrowserOriginBlock.json"
    },
    "closed": {
      "type": "boolean"
    },
    "downloads": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/BrowserDownload.json"
      },
      "maxItems": 128,
      "type": "array"
    },
    "features": {
      "items": {
        "maxLength": 64,
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "loadError": {
      "maxLength": 2048,
      "type": "string"
    },
    "loading": {
      "type": "boolean"
    },
    "pageStateLost": {
      "type": "boolean"
    },
    "pending_dialog": {
      "$ref": "https://ace.local/protocol/v1/BrowserDialog.json"
    },
    "permissionDenied": {
      "properties": {
        "origin": {
          "maxLength": 8192,
          "type": "string"
        },
        "permission": {
          "maxLength": 256,
          "type": "string"
        }
      },
      "required": [
        "permission",
        "origin"
      ],
      "type": "object"
    },
    "reason": {
      "maxLength": 2048,
      "type": "string"
    },
    "recording": {
      "properties": {
        "by": {
          "$ref": "https://ace.local/protocol/v1/BrowserTabActor.json"
        }
      },
      "required": [
        "by"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "ready",
        "paused",
        "recovering"
      ],
      "type": "string"
    },
    "tabs": {
      "$ref": "https://ace.local/protocol/v1/BrowserTabList.json"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "url": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "url",
    "closed"
  ],
  "type": "object"
}
