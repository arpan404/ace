{
  "$id": "https://ace.local/protocol/v1/BrowserState.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "backend": {
      "enum": [
        "embedded",
        "headless"
      ],
      "type": "string"
    },
    "blocked": {
      "$ref": "https://ace.local/protocol/v1/BrowserOriginBlock.json"
    },
    "closed": {
      "type": "boolean"
    },
    "controller": {
      "enum": [
        "agent",
        "human",
        "none"
      ],
      "type": "string"
    },
    "owner": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "pageStateLost": {
      "type": "boolean"
    },
    "reason": {
      "maxLength": 2048,
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "paused",
        "recovering"
      ],
      "type": "string"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "url": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "controller",
    "url",
    "closed"
  ],
  "type": "object"
}
