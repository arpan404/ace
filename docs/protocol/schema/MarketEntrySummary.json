{
  "$id": "https://ace.local/protocol/v1/MarketEntrySummary.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "byAce": {
      "type": "boolean"
    },
    "categories": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/MarketCategoryId.json"
      },
      "maxItems": 3,
      "type": "array"
    },
    "downloads": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "from": {
      "maxLength": 2048,
      "type": "string"
    },
    "keywords": {
      "items": {
        "maxLength": 40,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "line": {
      "maxLength": 300,
      "type": "string"
    },
    "name": {
      "$ref": "https://ace.local/protocol/v1/MarketEntryName.json"
    },
    "publisher": {
      "$ref": "https://ace.local/protocol/v1/MarketPublisher.json"
    },
    "reviewed": {
      "type": "boolean"
    },
    "source": {
      "$ref": "https://ace.local/protocol/v1/MarketSourceId.json"
    },
    "supported": {
      "type": "boolean"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
    },
    "updated": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "version": {
      "$ref": "https://ace.local/protocol/v1/MarketVersion.json"
    }
  },
  "required": [
    "source",
    "type",
    "name",
    "title",
    "line",
    "categories",
    "keywords",
    "reviewed",
    "byAce",
    "updated",
    "downloads",
    "supported"
  ],
  "type": "object"
}
