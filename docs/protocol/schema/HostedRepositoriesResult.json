{
  "$id": "https://ace.local/protocol/v1/HostedRepositoriesResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "result": {
      "oneOf": [
        {
          "properties": {
            "account": {
              "$ref": "https://ace.local/protocol/v1/GitHubAccount.json"
            },
            "host": {
              "$ref": "https://ace.local/protocol/v1/GitHubHost.json"
            },
            "kind": {
              "const": "repositories",
              "type": "string"
            },
            "repositories": {
              "items": {
                "$ref": "https://ace.local/protocol/v1/HostedRepository.json"
              },
              "maxItems": 2000,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "repositories",
            "account",
            "host"
          ],
          "type": "object"
        },
        {
          "properties": {
            "canStop": {
              "default": false,
              "type": "boolean"
            },
            "kind": {
              "const": "publication",
              "type": "string"
            },
            "publication": {
              "anyOf": [
                {
                  "$ref": "https://ace.local/protocol/v1/RepositoryPublication.json"
                },
                {
                  "type": "null"
                }
              ]
            },
            "running": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "publication"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "maxLength": 100,
              "type": "string"
            },
            "kind": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "code"
          ],
          "type": "object"
        }
      ]
    },
    "type": {
      "const": "repositories.result",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "result"
  ],
  "type": "object"
}
