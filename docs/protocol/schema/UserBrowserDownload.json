{
  "$id": "https://ace.local/protocol/v1/UserBrowserDownload.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "bytes": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "filename": {
      "maxLength": 256,
      "type": "string"
    },
    "id": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "mimeType": {
      "maxLength": 256,
      "type": "string"
    },
    "path": {
      "maxLength": 4096,
      "type": "string"
    },
    "state": {
      "enum": [
        "in_progress",
        "complete",
        "interrupted"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "filename",
    "path",
    "state",
    "bytes",
    "mimeType"
  ],
  "type": "object"
}
