{
  "$id": "https://ace.local/protocol/v1/ForgeLifecycleAction.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "changes": {
          "properties": {
            "assignees": {
              "items": {
                "maxLength": 100,
                "pattern": "^[\\w-]+$",
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            "baseBranch": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "body": {
              "maxLength": 65536,
              "type": "string"
            },
            "labels": {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            "title": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "kind": {
          "const": "edit",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "changes"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "ready",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "draft",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "close",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "reopen",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "update.merge",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "update.rebase",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "body": {
          "maxLength": 60000,
          "type": "string"
        },
        "kind": {
          "const": "revert",
          "type": "string"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "body"
      ],
      "type": "object"
    }
  ]
}
