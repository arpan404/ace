{
  "$id": "https://ace.local/protocol/v1/ForgeLifecycleAction.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "changes": {
          "properties": {
            "assignees": {
              "items": {
                "maxLength": 100,
                "pattern": "^[\\w-]+$",
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            "baseBranch": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "body": {
              "maxLength": 65536,
              "type": "string"
            },
            "labels": {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            "milestone": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "kind": {
          "const": "edit",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "changes"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "ready",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "draft",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "close",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "reopen",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "update.merge",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "update.rebase",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "body": {
          "maxLength": 60000,
          "type": "string"
        },
        "kind": {
          "const": "revert",
          "type": "string"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "body"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "lock",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "https://ace.local/protocol/v1/ForgeLockReason.json"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "unlock",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "branch.delete",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "branch.restore",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "issue": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "kind": {
          "const": "issue.link",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "issue"
      ],
      "type": "object"
    },
    {
      "properties": {
        "issue": {
          "properties": {
            "number": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "repository": {
              "$ref": "https://ace.local/protocol/v1/ForgeRepository.json"
            }
          },
          "required": [
            "repository",
            "number"
          ],
          "type": "object"
        },
        "kind": {
          "const": "issue.unlink",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "issue"
      ],
      "type": "object"
    }
  ]
}
