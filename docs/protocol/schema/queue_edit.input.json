{
  "$id": "https://ace.local/protocol/v1/queue_edit.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "description": "edit: entryId, text. cancel, steer: entryId. reorder: order.",
      "enum": [
        "edit",
        "cancel",
        "steer",
        "reorder"
      ],
      "type": "string"
    },
    "entryId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "order": {
      "description": "Entry ids, in their new order.",
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "requestId": {
      "description": "Any stable id; a repeat with it runs once.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    },
    "text": {
      "$ref": "https://ace.local/protocol/v1/MessageText.json"
    },
    "threadId": {
      "description": "This thread, one you started or, with full access, any.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "requestId",
    "action"
  ],
  "type": "object",
  "x-ace-constraint": "edit needs entryId and text; cancel and steer need entryId; reorder needs order."
}
