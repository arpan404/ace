{
  "$id": "https://ace.local/protocol/v1/StorageResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "result": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "usage",
              "type": "string"
            },
            "usage": {
              "$ref": "https://ace.local/protocol/v1/StorageUsage.json"
            }
          },
          "required": [
            "kind",
            "usage"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "plan",
              "type": "string"
            },
            "plan": {
              "$ref": "https://ace.local/protocol/v1/StoragePlan.json"
            }
          },
          "required": [
            "kind",
            "plan"
          ],
          "type": "object"
        },
        {
          "properties": {
            "apply": {
              "$ref": "https://ace.local/protocol/v1/StorageApply.json"
            },
            "kind": {
              "const": "apply",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "apply"
          ],
          "type": "object"
        },
        {
          "properties": {
            "compaction": {
              "$ref": "https://ace.local/protocol/v1/StorageCompaction.json"
            },
            "kind": {
              "const": "compaction",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "compaction"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "enum": [
                "forbidden",
                "busy",
                "not_found",
                "invalid_request",
                "unavailable"
              ],
              "type": "string"
            },
            "kind": {
              "const": "error",
              "type": "string"
            },
            "message": {
              "maxLength": 256,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "code",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "type": {
      "const": "storage.result",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "result"
  ],
  "type": "object"
}
