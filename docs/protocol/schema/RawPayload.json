{
  "$id": "https://ace.local/protocol/v1/RawPayload.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "https://ace.local/protocol/v1/InlineRawPayload.json"
    },
    {
      "properties": {
        "blobRef": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "preview": {
          "type": "string",
          "x-ace-constraint": "UTF-8 encoding must be at most 2048 bytes."
        },
        "size": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "blobRef",
        "size",
        "preview"
      ],
      "type": "object"
    }
  ]
}
