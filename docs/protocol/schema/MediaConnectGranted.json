{
  "$id": "https://ace.local/protocol/v1/MediaConnectGranted.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "connection": {
      "$ref": "https://ace.local/protocol/v1/MediaConnectionId.json"
    },
    "expiresAt": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "ok": {
      "const": true,
      "type": "boolean"
    },
    "ticket": {
      "$ref": "https://ace.local/protocol/v1/MediaTicket.json"
    },
    "url": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "ok",
    "connection",
    "ticket",
    "expiresAt"
  ],
  "type": "object"
}
