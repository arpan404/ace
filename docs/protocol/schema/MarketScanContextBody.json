{
  "$id": "https://ace.local/protocol/v1/MarketScanContextBody.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "entries": {
      "items": {
        "properties": {
          "downloads": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "$ref": "https://ace.local/protocol/v1/MarketEntryName.json"
          },
          "publisher": {
            "$ref": "https://ace.local/protocol/v1/MarketPublisherName.json"
          },
          "type": {
            "maxLength": 40,
            "type": "string"
          }
        },
        "required": [
          "type",
          "name",
          "publisher",
          "downloads"
        ],
        "type": "object"
      },
      "maxItems": 50000,
      "type": "array"
    },
    "newPublishers": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/MarketPublisherName.json"
      },
      "maxItems": 50000,
      "type": "array"
    },
    "verified": {
      "items": {
        "properties": {
          "displayName": {
            "maxLength": 60,
            "type": "string"
          },
          "handle": {
            "$ref": "https://ace.local/protocol/v1/MarketPublisherName.json"
          }
        },
        "required": [
          "handle",
          "displayName"
        ],
        "type": "object"
      },
      "maxItems": 5000,
      "type": "array"
    }
  },
  "required": [
    "entries",
    "verified",
    "newPublishers"
  ],
  "type": "object"
}
