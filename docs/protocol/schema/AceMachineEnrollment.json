{
  "$id": "https://ace.local/protocol/v1/AceMachineEnrollment.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "expiresAt": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "ticket": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    }
  },
  "required": [
    "ticket",
    "expiresAt"
  ],
  "type": "object"
}
