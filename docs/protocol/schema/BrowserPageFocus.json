{
  "$id": "https://ace.local/protocol/v1/BrowserPageFocus.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "caret": {
      "$ref": "https://ace.local/protocol/v1/BrowserPageRect.json"
    },
    "enterKeyHint": {
      "maxLength": 32,
      "type": "string"
    },
    "inputMode": {
      "maxLength": 32,
      "type": "string"
    },
    "rect": {
      "$ref": "https://ace.local/protocol/v1/BrowserPageRect.json"
    },
    "type": {
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "type",
    "rect"
  ],
  "type": "object"
}
