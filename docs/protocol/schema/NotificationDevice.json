{
  "$id": "https://ace.local/protocol/v1/NotificationDevice.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "address": {
      "$ref": "https://ace.local/protocol/v1/NotificationAddress.json"
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://ace.local/protocol/v1/DeviceId.json"
        },
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "preferences": {
      "$ref": "https://ace.local/protocol/v1/NotificationPreferences.json"
    }
  },
  "required": [
    "id",
    "address",
    "preferences"
  ],
  "type": "object"
}
