{
  "$id": "https://ace.local/protocol/v1/ImageShowInput.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alt": {
      "$ref": "https://ace.local/protocol/v1/SharedImageAlt.json"
    },
    "caption": {
      "$ref": "https://ace.local/protocol/v1/SharedImageCaption.json"
    },
    "data": {
      "maxLength": 22369624,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$",
      "type": "string"
    },
    "mimeType": {
      "$ref": "https://ace.local/protocol/v1/SharedImageType.json"
    },
    "path": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "alt"
  ],
  "type": "object"
}
