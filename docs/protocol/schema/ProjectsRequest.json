{
  "$id": "https://ace.local/protocol/v1/ProjectsRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "operation": {
      "oneOf": [
        {
          "properties": {
            "op": {
              "const": "workspace.inspect",
              "type": "string"
            },
            "path": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ],
          "type": "object"
        },
        {
          "properties": {
            "limit": {
              "default": 30,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            "op": {
              "const": "fs.search",
              "type": "string"
            },
            "query": {
              "maxLength": 256,
              "type": "string"
            },
            "showHidden": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "query"
          ],
          "type": "object"
        },
        {
          "properties": {
            "limit": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            "op": {
              "const": "fs.complete",
              "type": "string"
            },
            "path": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "showHidden": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "path"
          ],
          "type": "object"
        },
        {
          "properties": {
            "op": {
              "const": "workspace.clone.validate",
              "type": "string"
            },
            "url": {
              "maxLength": 4096,
              "type": "string"
            }
          },
          "required": [
            "op",
            "url"
          ],
          "type": "object"
        },
        {
          "properties": {
            "op": {
              "const": "fs.home",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "properties": {
            "limit": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            "op": {
              "const": "fs.recentFolders",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "properties": {
            "after": {
              "$ref": "https://ace.local/protocol/v1/ProjectDirectoryName.json"
            },
            "limit": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            "op": {
              "const": "fs.browse",
              "type": "string"
            },
            "path": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "showHidden": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "path"
          ],
          "type": "object"
        },
        {
          "properties": {
            "commandId": {
              "$ref": "https://ace.local/protocol/v1/CommandId.json"
            },
            "op": {
              "const": "workspace.clone.cancel",
              "type": "string"
            }
          },
          "required": [
            "op",
            "commandId"
          ],
          "type": "object"
        }
      ]
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "projects.request",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "operation"
  ],
  "type": "object"
}
