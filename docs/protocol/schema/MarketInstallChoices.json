{
  "$id": "https://ace.local/protocol/v1/MarketInstallChoices.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bots": {
      "default": [],
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    },
    "needs": {
      "additionalProperties": {
        "type": "boolean"
      },
      "default": {},
      "propertyNames": {
        "maxLength": 2100,
        "type": "string"
      },
      "type": "object"
    },
    "startRoutines": {
      "default": false,
      "type": "boolean"
    }
  },
  "type": "object"
}
