  "maxLength": 200,
  "minLength": 1,
  "pattern": "^assets\\/[A-Za-z0-9._/-]*\\.(?:[mM][pP]4|[mM]4[vV]|[mM][oO][vV]|[wW][eE][bB][mM])$",
