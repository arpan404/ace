{
  "$id": "https://ace.local/protocol/v1/MediaConnectResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "requestId": {
      "maxLength": 128,
      "type": "string"
    },
    "result": {
      "oneOf": [
        {
          "$ref": "https://ace.local/protocol/v1/MediaConnectGranted.json"
        },
        {
          "$ref": "https://ace.local/protocol/v1/MediaConnectFailure.json"
        }
      ]
    },
    "type": {
      "const": "media.connect.result",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "result"
  ],
  "type": "object"
}
