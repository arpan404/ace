{
  "$id": "https://ace.local/protocol/v1/AgentMachine.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "hostId": {
      "$ref": "https://ace.local/protocol/v1/HostId.json"
    },
    "machine": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "machine",
    "name"
  ],
  "type": "object"
}
