{
  "$id": "https://ace.local/protocol/v1/SettingsValues.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "approvals.policy": {
      "enum": [
        "ask",
        "on-failure",
        "never"
      ],
      "type": "string"
    },
    "automations.enabled": {
      "type": "boolean"
    },
    "automations.maxConcurrent": {
      "maximum": 32,
      "minimum": 1,
      "type": "integer"
    },
    "automations.timezone": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "clients.keybindings": {
      "$ref": "https://ace.local/protocol/v1/SharedDefinitions.json#/$defs/schema4"
    },
    "clients.theme": {
      "$ref": "https://ace.local/protocol/v1/SharedDefinitions.json#/$defs/schema3"
    },
    "conductor.maxFixRounds": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "conductor.mergePolicy": {
      "enum": [
        "manual",
        "after-review",
        "after-checks"
      ],
      "type": "string"
    },
    "conductor.planApproval": {
      "enum": [
        "required",
        "optional"
      ],
      "type": "string"
    },
    "notifications.enabled": {
      "type": "boolean"
    },
    "notifications.onApproval": {
      "type": "boolean"
    },
    "notifications.onCompletion": {
      "type": "boolean"
    },
    "notifications.sound": {
      "type": "boolean"
    },
    "notifications.suppressWhenActive": {
      "type": "boolean"
    },
    "plugins.enabled": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "plugins.preferences": {
      "additionalProperties": {
        "$ref": "https://ace.local/protocol/v1/SharedDefinitions.json#/$defs/schema2"
      },
      "propertyNames": {
        "maxLength": 256,
        "type": "string"
      },
      "type": "object"
    },
    "providers.coder.model": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "providers.coder.provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "providers.coder.reasoningEffort": {
      "enum": [
        "default",
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "type": "string"
    },
    "providers.coder.tier": {
      "enum": [
        "default",
        "standard",
        "fast",
        "flex",
        "priority"
      ],
      "type": "string"
    },
    "providers.default": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "providers.planner.model": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "providers.planner.provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "providers.planner.reasoningEffort": {
      "enum": [
        "default",
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "type": "string"
    },
    "providers.planner.tier": {
      "enum": [
        "default",
        "standard",
        "fast",
        "flex",
        "priority"
      ],
      "type": "string"
    },
    "providers.reviewer.model": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "providers.reviewer.provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "providers.reviewer.reasoningEffort": {
      "enum": [
        "default",
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "type": "string"
    },
    "providers.reviewer.tier": {
      "enum": [
        "default",
        "standard",
        "fast",
        "flex",
        "priority"
      ],
      "type": "string"
    },
    "remote.enabled": {
      "type": "boolean"
    },
    "remote.transport": {
      "enum": [
        "local",
        "lan",
        "tailscale",
        "relay"
      ],
      "type": "string"
    },
    "threads.continueAfterRestart": {
      "type": "boolean"
    },
    "threads.followUpBehavior": {
      "enum": [
        "steer",
        "queue"
      ],
      "type": "string"
    },
    "threads.limitPolicy": {
      "enum": [
        "manual",
        "resume_at_reset",
        "snooze_until_reset",
        "migrate_now"
      ],
      "type": "string"
    }
  },
  "required": [
    "threads.followUpBehavior",
    "threads.continueAfterRestart",
    "threads.limitPolicy",
    "providers.default",
    "providers.coder.provider",
    "providers.coder.model",
    "providers.coder.tier",
    "providers.coder.reasoningEffort",
    "providers.reviewer.provider",
    "providers.reviewer.model",
    "providers.reviewer.tier",
    "providers.reviewer.reasoningEffort",
    "providers.planner.provider",
    "providers.planner.model",
    "providers.planner.tier",
    "providers.planner.reasoningEffort",
    "approvals.policy",
    "notifications.enabled",
    "notifications.sound",
    "notifications.onCompletion",
    "notifications.onApproval",
    "notifications.suppressWhenActive",
    "remote.enabled",
    "remote.transport",
    "conductor.planApproval",
    "conductor.mergePolicy",
    "conductor.maxFixRounds",
    "automations.enabled",
    "automations.timezone",
    "automations.maxConcurrent",
    "plugins.enabled",
    "plugins.preferences",
    "clients.theme",
    "clients.keybindings"
  ],
  "type": "object"
}
