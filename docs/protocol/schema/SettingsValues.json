{
  "$id": "https://ace.local/protocol/v1/SettingsValues.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "app.openAtLogin": {
      "type": "boolean"
    },
    "approvals.policy": {
      "enum": [
        "ask",
        "on-failure",
        "never"
      ],
      "type": "string"
    },
    "automations.enabled": {
      "type": "boolean"
    },
    "automations.maxConcurrent": {
      "maximum": 32,
      "minimum": 1,
      "type": "integer"
    },
    "automations.timezone": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "browser.allowedOrigins": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/BrowserOrigin.json"
      },
      "maxItems": 256,
      "type": "array"
    },
    "browser.backend": {
      "enum": [
        "auto",
        "embedded",
        "headless"
      ],
      "type": "string"
    },
    "browser.backendLoss": {
      "enum": [
        "pause",
        "headless"
      ],
      "type": "string"
    },
    "clients.keybindings": {
      "$ref": "https://ace.local/protocol/v1/SharedDefinitions.json#/$defs/schema5"
    },
    "clients.theme": {
      "$ref": "https://ace.local/protocol/v1/SharedDefinitions.json#/$defs/schema4"
    },
    "conductor.maxFixRounds": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "conductor.mergePolicy": {
      "enum": [
        "manual",
        "after-review",
        "after-checks"
      ],
      "type": "string"
    },
    "conductor.planApproval": {
      "enum": [
        "required",
        "optional"
      ],
      "type": "string"
    },
    "host.displayName": {
      "maxLength": 256,
      "type": "string"
    },
    "logs.retention": {
      "enum": [
        "7d",
        "30d",
        "forever"
      ],
      "type": "string"
    },
    "notifications.enabled": {
      "type": "boolean"
    },
    "notifications.onApproval": {
      "type": "boolean"
    },
    "notifications.onCompletion": {
      "type": "boolean"
    },
    "notifications.onFailure": {
      "type": "boolean"
    },
    "notifications.onMention": {
      "type": "boolean"
    },
    "notifications.quietHours": {
      "anyOf": [
        {
          "properties": {
            "end": {
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            "start": {
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "notifications.sound": {
      "type": "boolean"
    },
    "notifications.suppressWhenActive": {
      "type": "boolean"
    },
    "permissions.defaultMode": {
      "anyOf": [
        {
          "$ref": "https://ace.local/protocol/v1/PermissionMode.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "permissions.providerModes": {
      "additionalProperties": {
        "$ref": "https://ace.local/protocol/v1/PermissionMode.json"
      },
      "propertyNames": {
        "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
      },
      "type": "object"
    },
    "plugins.enabled": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "plugins.preferences": {
      "additionalProperties": {
        "$ref": "https://ace.local/protocol/v1/SharedDefinitions.json#/$defs/schema3"
      },
      "propertyNames": {
        "maxLength": 256,
        "type": "string"
      },
      "type": "object"
    },
    "projects.roots": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "providers.coder.model": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "providers.coder.provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "providers.coder.reasoningEffort": {
      "enum": [
        "default",
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "type": "string"
    },
    "providers.coder.tier": {
      "enum": [
        "default",
        "standard",
        "fast",
        "flex",
        "priority"
      ],
      "type": "string"
    },
    "providers.configuration": {
      "$ref": "https://ace.local/protocol/v1/ProviderConfigurations.json"
    },
    "providers.default": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "providers.planner.model": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "providers.planner.provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "providers.planner.reasoningEffort": {
      "enum": [
        "default",
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "type": "string"
    },
    "providers.planner.tier": {
      "enum": [
        "default",
        "standard",
        "fast",
        "flex",
        "priority"
      ],
      "type": "string"
    },
    "providers.reviewer.model": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "providers.reviewer.provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "providers.reviewer.reasoningEffort": {
      "enum": [
        "default",
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "type": "string"
    },
    "providers.reviewer.tier": {
      "enum": [
        "default",
        "standard",
        "fast",
        "flex",
        "priority"
      ],
      "type": "string"
    },
    "remote.enabled": {
      "type": "boolean"
    },
    "remote.transport": {
      "enum": [
        "local",
        "lan",
        "tailscale",
        "relay"
      ],
      "type": "string"
    },
    "threads.autoSettleAfter": {
      "enum": [
        "1d",
        "2d",
        "1w",
        "never"
      ],
      "type": "string"
    },
    "threads.continueAfterRestart": {
      "type": "boolean"
    },
    "threads.followUpBehavior": {
      "enum": [
        "steer",
        "queue"
      ],
      "type": "string"
    },
    "threads.limitPolicy": {
      "enum": [
        "manual",
        "resume_at_reset",
        "snooze_until_reset",
        "migrate_now"
      ],
      "type": "string"
    },
    "threads.settleOnClose": {
      "type": "boolean"
    },
    "threads.settleOnMerge": {
      "type": "boolean"
    },
    "threads.unresponsiveAfter": {
      "enum": [
        "2m",
        "5m",
        "15m"
      ],
      "type": "string"
    },
    "threads.useWorktree": {
      "type": "boolean"
    }
  },
  "required": [
    "providers.configuration",
    "host.displayName",
    "projects.roots",
    "threads.followUpBehavior",
    "threads.continueAfterRestart",
    "threads.limitPolicy",
    "providers.default",
    "providers.coder.provider",
    "providers.coder.model",
    "providers.coder.tier",
    "providers.coder.reasoningEffort",
    "providers.reviewer.provider",
    "providers.reviewer.model",
    "providers.reviewer.tier",
    "providers.reviewer.reasoningEffort",
    "providers.planner.provider",
    "providers.planner.model",
    "providers.planner.tier",
    "providers.planner.reasoningEffort",
    "browser.allowedOrigins",
    "browser.backend",
    "browser.backendLoss",
    "permissions.defaultMode",
    "permissions.providerModes",
    "approvals.policy",
    "notifications.enabled",
    "notifications.sound",
    "notifications.onCompletion",
    "notifications.onApproval",
    "notifications.suppressWhenActive",
    "notifications.onFailure",
    "notifications.onMention",
    "notifications.quietHours",
    "threads.useWorktree",
    "threads.autoSettleAfter",
    "threads.unresponsiveAfter",
    "threads.settleOnMerge",
    "threads.settleOnClose",
    "app.openAtLogin",
    "logs.retention",
    "remote.enabled",
    "remote.transport",
    "conductor.planApproval",
    "conductor.mergePolicy",
    "conductor.maxFixRounds",
    "automations.enabled",
    "automations.timezone",
    "automations.maxConcurrent",
    "plugins.enabled",
    "plugins.preferences",
    "clients.theme",
    "clients.keybindings"
  ],
  "type": "object"
}
