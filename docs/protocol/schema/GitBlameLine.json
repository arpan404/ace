{
  "$id": "https://ace.local/protocol/v1/GitBlameLine.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "line": {
      "exclusiveMinimum": 0,
      "maximum": 10000000,
      "type": "integer"
    },
    "sha": {
      "anyOf": [
        {
          "$ref": "https://ace.local/protocol/v1/CommitSha.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "line",
    "sha"
  ],
  "type": "object"
}
