{
  "$id": "https://ace.local/protocol/v1/ConductorModel.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cost": {
      "minimum": 0,
      "type": "number"
    },
    "model": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$",
      "type": "string"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "quota": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "tier": {
      "enum": [
        "fast",
        "normal"
      ],
      "type": "string"
    }
  },
  "required": [
    "provider",
    "model",
    "tier",
    "cost",
    "quota"
  ],
  "type": "object"
}
