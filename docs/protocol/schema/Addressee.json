{
  "$id": "https://ace.local/protocol/v1/Addressee.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "avatar": {
          "$ref": "https://ace.local/protocol/v1/SpadeFaceJson.json"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "bot",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "name"
      ],
      "type": "object"
    },
    {
      "properties": {
        "faces": {
          "default": [],
          "items": {
            "properties": {
              "avatar": {
                "$ref": "https://ace.local/protocol/v1/SpadeFaceJson.json"
              },
              "id": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "maxItems": 3,
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "club",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "name"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "agent",
          "type": "string"
        },
        "provider": {
          "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        },
        "title": {
          "maxLength": 256,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "threadId",
        "title"
      ],
      "type": "object"
    }
  ]
}
