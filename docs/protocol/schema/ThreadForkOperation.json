{
  "$id": "https://ace.local/protocol/v1/ThreadForkOperation.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "effort": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "model": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "op": {
      "const": "thread.fork",
      "type": "string"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    },
    "runId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    },
    "text": {
      "$ref": "https://ace.local/protocol/v1/MessageText.json"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "title": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "op",
    "threadId",
    "requestId",
    "text"
  ],
  "type": "object"
}
