        },
        "body": {
          "maxLength": 64000,
          "minLength": 1,
          "type": "string"
        },
        "number": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "action",
        "number",
        "body"
      ],
      "type": "object"
    },
    {
