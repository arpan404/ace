          "maxLength": 65536,
          "type": "string"
        },
        "number": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "action",
        "number",
        "expectedUpdatedAt",
        "title",
        "body"
      ],
      "type": "object"
    },
    {
