            "open",
            "closed"
          ],
          "type": "string"
        }
      },
      "required": [
        "action",
        "number",
        "expectedUpdatedAt",
        "state"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "const": "labels",
          "type": "string"
        },
        "add": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        },
        "number": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "remove": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        }
      },
      "required": [
        "action",
        "number"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "const": "assignees",
          "type": "string"
        },
        "add": {
          "default": [],
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "number": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "remove": {
          "default": [],
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        }
      },
