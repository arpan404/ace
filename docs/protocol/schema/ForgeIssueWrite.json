  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "action": {
          "const": "create",
          "type": "string"
        },
        "body": {
          "maxLength": 64000,
          "type": "string"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "action",
        "title",
        "body"
      ],
      "type": "object"
    },
    {
