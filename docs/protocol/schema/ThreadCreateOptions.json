{
  "$id": "https://ace.local/protocol/v1/ThreadCreateOptions.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "https://ace.local/protocol/v1/ExecutionOptions.json"
    },
    {
      "properties": {
        "effort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "type": "string"
        },
        "serviceTier": {
          "enum": [
            "default",
            "priority",
            "flex"
          ],
          "type": "string"
        }
      },
      "type": "object"
    }
  ]
}
