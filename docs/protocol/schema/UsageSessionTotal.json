{
  "$id": "https://ace.local/protocol/v1/UsageSessionTotal.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "at": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "cacheWrite1hTokens": {
      "default": 0,
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "cacheWriteTokens": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "cachedInputTokens": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "costUsd": {
      "minimum": 0,
      "type": "number"
    },
    "counterKey": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "inputTokens": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "model": {
      "maxLength": 8192,
      "type": "string"
    },
    "outputTokens": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "scope": {
      "enum": [
        "provider_session",
        "model_session"
      ],
      "type": "string"
    }
  },
  "required": [
    "counterKey",
    "scope",
    "model",
    "at",
    "inputTokens",
    "outputTokens",
    "cachedInputTokens",
    "cacheWriteTokens",
    "costUsd"
  ],
  "type": "object"
}
