{
  "$id": "https://ace.local/protocol/v1/ProviderInstallPlan.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acpAgentId": {
      "maxLength": 256,
      "pattern": "^official:[a-z0-9-]+$",
      "type": "string"
    },
    "action": {
      "$ref": "https://ace.local/protocol/v1/InstallAction.json"
    },
    "agent": {
      "$ref": "https://ace.local/protocol/v1/InstallAgent.json"
    },
    "commands": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/InstallCommand.json"
      },
      "maxItems": 4,
      "type": "array"
    },
    "downloadOnly": {
      "const": true,
      "type": "boolean"
    },
    "installedVersion": {
      "maxLength": 256,
      "type": "string"
    },
    "latestVersion": {
      "maxLength": 256,
      "type": "string"
    },
    "message": {
      "maxLength": 1024,
      "type": "string"
    },
    "method": {
      "$ref": "https://ace.local/protocol/v1/InstallMethod.json"
    },
    "methods": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/InstallMethod.json"
      },
      "maxItems": 5,
      "type": "array"
    },
    "needsAdmin": {
      "type": "boolean"
    },
    "prerequisite": {
      "properties": {
        "name": {
          "maxLength": 128,
          "type": "string"
        },
        "sourceUrl": {
          "format": "ace-whatwg-url",
          "type": "string",
          "x-ace-constraint": "Accept strings whose trimmed value is an absolute WHATWG URL. Whitespace, Unicode hosts, opaque schemes and parser-normalized URLs are allowed. x-ace-url-minLength and x-ace-url-maxLength apply after trimming whitespace and removing ASCII tab, CR and LF characters, using UTF-16 code units. Install the ace-whatwg-url format validator or enforce this rule in application code.",
          "x-ace-url-maxLength": 2048
        }
      },
      "required": [
        "name",
        "sourceUrl"
      ],
      "type": "object"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "registryPlan": {
      "$ref": "https://ace.local/protocol/v1/RegistryInstallPlan.json"
    },
    "sourceUrl": {
      "format": "ace-whatwg-url",
      "type": "string",
      "x-ace-constraint": "Accept strings whose trimmed value is an absolute WHATWG URL. Whitespace, Unicode hosts, opaque schemes and parser-normalized URLs are allowed. x-ace-url-minLength and x-ace-url-maxLength apply after trimming whitespace and removing ASCII tab, CR and LF characters, using UTF-16 code units. Install the ace-whatwg-url format validator or enforce this rule in application code.",
      "x-ace-url-maxLength": 2048
    },
    "status": {
      "enum": [
        "ready",
        "manual",
        "sign_in",
        "unavailable"
      ],
      "type": "string"
    },
    "updateAvailable": {
      "type": "boolean"
    },
    "verify": {
      "$ref": "https://ace.local/protocol/v1/InstallCommand.json"
    },
    "versionCheckedAt": {
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "provider",
    "action",
    "status",
    "methods",
    "commands",
    "sourceUrl",
    "needsAdmin"
  ],
  "type": "object"
}
