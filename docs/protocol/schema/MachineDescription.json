{
  "$id": "https://ace.local/protocol/v1/MachineDescription.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "access": {
      "enum": [
        "read",
        "operate"
      ],
      "type": "string"
    },
    "grants": {
      "$ref": "https://ace.local/protocol/v1/MachineGrants.json"
    },
    "hostId": {
      "$ref": "https://ace.local/protocol/v1/HostId.json"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "projects": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/MachineProject.json"
      },
      "maxItems": 32,
      "type": "array"
    },
    "providers": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
      },
      "maxItems": 16,
      "type": "array"
    },
    "tools": {
      "items": {
        "maxLength": 64,
        "type": "string"
      },
      "maxItems": 16,
      "type": "array",
      "x-ace-constraint": "Unknown tool groups are accepted and omitted from the decoded list."
    },
    "transfers": {
      "type": "boolean"
    }
  },
  "required": [
    "hostId",
    "name",
    "access",
    "projects",
    "tools",
    "providers"
  ],
  "type": "object"
}
