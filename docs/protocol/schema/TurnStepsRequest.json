{
  "$id": "https://ace.local/protocol/v1/TurnStepsRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "after": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "limit": {
      "default": 100,
      "maximum": 200,
      "minimum": 1,
      "type": "integer"
    },
    "requestId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "turnOrdinal": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "type": {
      "const": "turn.steps",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "threadId",
    "turnOrdinal"
  ],
  "type": "object"
}
