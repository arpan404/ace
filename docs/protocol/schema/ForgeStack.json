{
  "$id": "https://ace.local/protocol/v1/ForgeStack.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "canMerge": {
      "type": "boolean"
    },
    "id": {
      "maxLength": 65536,
      "type": "string"
    },
    "layers": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/ForgeStackLayer.json"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "number": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "raw": {},
    "trunk": {
      "maxLength": 65536,
      "type": "string"
    }
  },
  "required": [
    "id",
    "number",
    "trunk",
    "layers",
    "canMerge",
    "raw"
  ],
  "type": "object"
}
