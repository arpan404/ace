{
  "$id": "https://ace.local/protocol/v1/MarketTermsNotice.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "note": {
      "maxLength": 500,
      "type": "string"
    },
    "provider": {
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "allowed",
        "unclear",
        "refused"
      ],
      "type": "string"
    }
  },
  "required": [
    "provider",
    "status",
    "note",
    "at"
  ],
  "type": "object"
}
