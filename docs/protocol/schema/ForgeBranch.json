{
  "$id": "https://ace.local/protocol/v1/ForgeBranch.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "sha": {
      "pattern": "^[a-fA-F0-9]{40,64}$",
      "type": "string"
    }
  },
  "required": [
    "name",
    "sha"
  ],
  "type": "object"
}
