{
  "$id": "https://ace.local/protocol/v1/ComputerUsing.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "threads": {
      "items": {
        "properties": {
          "apps": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array"
          },
          "threadId": {
            "$ref": "https://ace.local/protocol/v1/ThreadId.json"
          }
        },
        "required": [
          "threadId",
          "apps"
        ],
        "type": "object"
      },
      "maxItems": 512,
      "type": "array"
    },
    "type": {
      "const": "computer.using",
      "type": "string"
    }
  },
  "required": [
    "type",
    "threads"
  ],
  "type": "object"
}
