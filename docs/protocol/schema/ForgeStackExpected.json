{
  "$id": "https://ace.local/protocol/v1/ForgeStackExpected.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "maxLength": 65536,
      "type": "string"
    },
    "layers": {
      "items": {
        "properties": {
          "headSha": {
            "pattern": "^[a-fA-F0-9]{40,64}$",
            "type": "string"
          },
          "number": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "number",
          "headSha"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "local": {
      "anyOf": [
        {
          "properties": {
            "branches": {
              "items": {
                "properties": {
                  "base": {
                    "pattern": "^[a-fA-F0-9]{40,64}$",
                    "type": "string"
                  },
                  "head": {
                    "pattern": "^[a-fA-F0-9]{40,64}$",
                    "type": "string"
                  },
                  "isCurrent": {
                    "type": "boolean"
                  },
                  "isMerged": {
                    "type": "boolean"
                  },
                  "isQueued": {
                    "type": "boolean"
                  },
                  "name": {
                    "maxLength": 65536,
                    "type": "string"
                  },
                  "needsRebase": {
                    "type": "boolean"
                  },
                  "pr": {
                    "properties": {
                      "number": {
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991,
                        "type": "integer"
                      },
                      "state": {
                        "maxLength": 65536,
                        "type": "string"
                      },
                      "url": {
                        "format": "ace-whatwg-url",
                        "type": "string",
                        "x-ace-constraint": "Accept strings whose trimmed value is an absolute WHATWG URL. Whitespace, Unicode hosts, opaque schemes and parser-normalized URLs are allowed. x-ace-url-minLength and x-ace-url-maxLength apply after trimming whitespace and removing ASCII tab, CR and LF characters, using UTF-16 code units. Install the ace-whatwg-url format validator or enforce this rule in application code.",
                        "x-ace-url-maxLength": 4096
                      }
                    },
                    "required": [
                      "number",
                      "url",
                      "state"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "name",
                  "head",
                  "base",
                  "isCurrent",
                  "isMerged",
                  "isQueued",
                  "needsRebase"
                ],
                "type": "object"
              },
              "maxItems": 100,
              "type": "array"
            },
            "currentBranch": {
              "maxLength": 65536,
              "type": "string"
            },
            "trunk": {
              "maxLength": 65536,
              "type": "string"
            }
          },
          "required": [
            "trunk",
            "currentBranch",
            "branches"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "trunk": {
      "maxLength": 65536,
      "type": "string"
    }
  },
  "required": [
    "id",
    "trunk",
    "layers",
    "local"
  ],
  "type": "object"
}
