{
  "$id": "https://ace.local/protocol/v1/SourceControlResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "result": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "readiness",
              "type": "string"
            },
            "readiness": {
              "$ref": "https://ace.local/protocol/v1/SourceControlReadiness.json"
            }
          },
          "required": [
            "kind",
            "readiness"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "maxLength": 100,
              "type": "string"
            },
            "kind": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "code"
          ],
          "type": "object"
        }
      ]
    },
    "type": {
      "const": "source-control.result",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "result"
  ],
  "type": "object"
}
