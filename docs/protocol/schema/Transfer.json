{
  "$id": "https://ace.local/protocol/v1/Transfer.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "commandId": {
      "$ref": "https://ace.local/protocol/v1/CommandId.json"
    },
    "error": {
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "message": {
          "maxLength": 512,
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ignoredFiles": {
      "$ref": "https://ace.local/protocol/v1/TransferIgnoredFiles.json"
    },
    "kind": {
      "enum": [
        "project",
        "thread"
      ],
      "type": "string"
    },
    "method": {
      "$ref": "https://ace.local/protocol/v1/TransferMethod.json"
    },
    "phase": {
      "$ref": "https://ace.local/protocol/v1/TransferPhase.json"
    },
    "result": {
      "properties": {
        "branch": {
          "maxLength": 1024,
          "type": "string"
        },
        "ignoredSkipped": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        },
        "workspaceId": {
          "$ref": "https://ace.local/protocol/v1/WorkspaceId.json"
        }
      },
      "required": [
        "workspaceId",
        "path"
      ],
      "type": "object"
    },
    "sentBytes": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "startedAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "target": {
      "properties": {
        "hostId": {
          "$ref": "https://ace.local/protocol/v1/HostId.json"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "hostId",
        "name"
      ],
      "type": "object"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "totalBytes": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "transferId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "updatedAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "workspaceId": {
      "$ref": "https://ace.local/protocol/v1/WorkspaceId.json"
    }
  },
  "required": [
    "transferId",
    "commandId",
    "kind",
    "workspaceId",
    "target",
    "phase",
    "sentBytes",
    "startedAt",
    "updatedAt"
  ],
  "type": "object"
}
