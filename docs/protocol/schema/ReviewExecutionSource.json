{
  "$id": "https://ace.local/protocol/v1/ReviewExecutionSource.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "from": {
      "$ref": "https://ace.local/protocol/v1/ReviewRevision.json"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "to": {
      "$ref": "https://ace.local/protocol/v1/ReviewRevision.json"
    },
    "workspaceId": {
      "$ref": "https://ace.local/protocol/v1/WorkspaceId.json"
    },
    "worktree": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "workspaceId",
    "from",
    "to",
    "worktree"
  ],
  "type": "object"
}
