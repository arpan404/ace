{
  "$id": "https://ace.local/protocol/v1/ForgeCheckRun.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "annotations": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/ForgeCheckAnnotation.json"
      },
      "maxItems": 100,
      "type": "array"
    },
    "annotationsTruncated": {
      "type": "boolean"
    },
    "conclusion": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "log": {
      "anyOf": [
        {
          "$ref": "https://ace.local/protocol/v1/ForgeCheckLog.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "logUnavailable": {
      "type": "boolean"
    },
    "name": {
      "maxLength": 65536,
      "type": "string"
    },
    "output": {
      "properties": {
        "summary": {
          "anyOf": [
            {
              "maxLength": 65536,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 65536,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 65536,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "summary",
        "text"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "pending",
        "success",
        "failure",
        "cancelled",
        "unknown"
      ],
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "workflow": {
      "anyOf": [
        {
          "properties": {
            "attempt": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "jobId": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "runId": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "steps": {
              "items": {
                "$ref": "https://ace.local/protocol/v1/ForgeCheckStep.json"
              },
              "maxItems": 1000,
              "type": "array"
            }
          },
          "required": [
            "runId",
            "attempt",
            "jobId",
            "steps"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "status",
    "conclusion",
    "url",
    "output",
    "workflow",
    "log",
    "logUnavailable",
    "annotations",
    "annotationsTruncated"
  ],
  "type": "object"
}
