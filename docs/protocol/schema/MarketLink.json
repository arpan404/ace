{
  "$id": "https://ace.local/protocol/v1/MarketLink.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "label": {
      "maxLength": 40,
      "minLength": 1,
      "type": "string",
      "x-ace-constraint": "Leading and trailing whitespace is removed before the length limits apply."
    },
    "url": {
      "maxLength": 2048,
      "pattern": "^https:\\/\\/[^\\s/?#@]+(?:[/?#][^\\s]*)?$",
      "type": "string"
    }
  },
  "required": [
    "label",
    "url"
  ],
  "type": "object"
}
