{
  "$id": "https://ace.local/protocol/v1/OffshiftPlaybookStep.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    },
    "kinds": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/OffshiftEvidenceKind.json"
      },
      "maxItems": 5,
      "minItems": 1,
      "type": "array"
    },
    "phase": {
      "$ref": "https://ace.local/protocol/v1/OffshiftPhase.json"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "phase"
  ],
  "type": "object"
}
