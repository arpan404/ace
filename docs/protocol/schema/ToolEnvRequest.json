{
  "$id": "https://ace.local/protocol/v1/ToolEnvRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/ToolEnvEntry.json"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        },
        "type": {
          "const": "provider.toolEnv.submit",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "threadId",
        "entries"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        },
        "type": {
          "const": "provider.toolEnv.clear",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "threadId"
      ],
      "type": "object"
    }
  ]
}
