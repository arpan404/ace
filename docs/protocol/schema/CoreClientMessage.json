{
  "$id": "https://ace.local/protocol/v1/CoreClientMessage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "channel": {
          "enum": [
            "files",
            "devices",
            "browser",
            "screen",
            "provider_auth",
            "media",
            "machine"
          ],
          "type": "string"
        },
        "compression": {
          "items": {
            "maxLength": 32,
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        },
        "deviceId": {
          "$ref": "https://ace.local/protocol/v1/DeviceId.json"
        },
        "flowControl": {
          "items": {
            "maxLength": 32,
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        },
        "framing": {
          "items": {
            "maxLength": 32,
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        },
        "grant": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "installId": {
          "$ref": "https://ace.local/protocol/v1/InstallId.json"
        },
        "lastClose": {
          "anyOf": [
            {
              "$ref": "https://ace.local/protocol/v1/ClientCloseReport.json"
            },
            {
              "$ref": "https://ace.local/protocol/v1/ClientCloseReport.json",
              "x-ace-constraint": "A report that doesn't parse is read as none; the hello still stands."
            }
          ]
        },
        "link": {
          "$ref": "https://ace.local/protocol/v1/PairingLinkProof.json"
        },
        "machineCode": {
          "$ref": "https://ace.local/protocol/v1/MachineCode.json"
        },
        "mediaTicket": {
          "$ref": "https://ace.local/protocol/v1/MediaTicket.json"
        },
        "nextTicket": {
          "const": true,
          "type": "boolean"
        },
        "protocolVersion": {
          "const": 1,
          "type": "number"
        },
        "ticket": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "trims": {
          "items": {
            "maxLength": 32,
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "type": {
          "const": "hello",
          "type": "string"
        }
      },
      "required": [
        "type",
        "protocolVersion",
        "deviceId"
      ],
      "type": "object",
      "x-ace-constraint": "Exactly one of token, ticket and grant is required; machineCode and link only with grant."
    },
    {
      "properties": {
        "afterSeq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "paced": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "https://ace.local/protocol/v1/SubscriptionScope.json"
        },
        "subscriptionId": {
          "minLength": 1,
          "type": "string"
        },
        "tail": {
          "properties": {
            "bytes": {
              "maximum": 1048576,
              "minimum": 1024,
              "type": "integer"
            },
            "items": {
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "items",
            "bytes"
          ],
          "type": "object"
        },
        "type": {
          "const": "subscribe",
          "type": "string"
        }
      },
      "required": [
        "type",
        "subscriptionId",
        "scope"
      ],
      "type": "object"
    },
    {
      "properties": {
        "subscriptionId": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "unsubscribe",
          "type": "string"
        }
      },
      "required": [
        "type",
        "subscriptionId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "$ref": "https://ace.local/protocol/v1/Command.json"
        },
        "type": {
          "const": "command",
          "type": "string"
        }
      },
      "required": [
        "type",
        "command"
      ],
      "type": "object"
    },
    {
      "properties": {
        "limit": {
          "exclusiveMinimum": 0,
          "maximum": 262144,
          "type": "integer"
        },
        "offset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "requestId": {
          "minLength": 1,
          "type": "string"
        },
        "streamId": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "output.read",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "streamId",
        "offset",
        "limit"
      ],
      "type": "object"
    },
    {
      "properties": {
        "interactionId": {
          "$ref": "https://ace.local/protocol/v1/InteractionId.json"
        },
        "offset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "requestId": {
          "minLength": 1,
          "type": "string"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        },
        "type": {
          "const": "interaction.read",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "threadId",
        "interactionId",
        "offset"
      ],
      "type": "object"
    },
    {
      "properties": {
        "before": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "limit": {
          "exclusiveMinimum": 0,
          "maximum": 200,
          "type": "integer"
        },
        "requestId": {
          "minLength": 1,
          "type": "string"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        },
        "type": {
          "const": "items.page",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "threadId",
        "before",
        "limit"
      ],
      "type": "object"
    },
    {
      "properties": {
        "before": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "collection": {
          "$ref": "https://ace.local/protocol/v1/EntityCollection.json"
        },
        "limit": {
          "exclusiveMinimum": 0,
          "maximum": 200,
          "type": "integer"
        },
        "maxBytes": {
          "maximum": 131072,
          "minimum": 16384,
          "type": "integer"
        },
        "requestId": {
          "minLength": 1,
          "type": "string"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        },
        "type": {
          "const": "entities.page",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "threadId",
        "collection",
        "before",
        "limit"
      ],
      "type": "object"
    },
    {
      "properties": {
        "before": {
          "$ref": "https://ace.local/protocol/v1/ThreadListCursor.json"
        },
        "requestId": {
          "minLength": 1,
          "type": "string"
        },
        "subscriptionId": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "threads.page",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "subscriptionId",
        "before"
      ],
      "type": "object"
    },
    {
      "properties": {
        "commandIds": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/CommandId.json"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "requestId": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "command.status",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "commandIds"
      ],
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "ping",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "grant": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "account.grant.refresh",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "grant"
      ],
      "type": "object"
    },
    {
      "properties": {
        "grant": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "proof": {
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "account.standing",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "grant",
        "proof"
      ],
      "type": "object"
    },
    {
      "properties": {
        "proof": {
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "device.standing",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "proof"
      ],
      "type": "object"
    },
    {
      "properties": {
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "account.owner.release",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId"
      ],
      "type": "object"
    }
  ]
}
