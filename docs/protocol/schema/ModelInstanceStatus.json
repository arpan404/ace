{
  "$id": "https://ace.local/protocol/v1/ModelInstanceStatus.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "acpAgentId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "error": {
      "enum": [
        "discovery_failed",
        "timeout",
        "persistence_failed"
      ],
      "type": "string"
    },
    "installationId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "instance": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "instanceId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "lastRefreshedAt": {
      "minimum": 0,
      "type": "number"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "refreshedAt": {
      "minimum": 0,
      "type": "number"
    },
    "refreshing": {
      "type": "boolean"
    },
    "stale": {
      "type": "boolean"
    }
  },
  "required": [
    "provider",
    "instance",
    "stale",
    "refreshing"
  ],
  "type": "object"
}
