{
  "$id": "https://ace.local/protocol/v1/StoragePlan.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "bytes": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "complete": {
      "type": "boolean"
    },
    "createdAt": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "expiresAt": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/StorageItem.json"
      },
      "maxItems": 256,
      "type": "array"
    },
    "retention": {
      "$ref": "https://ace.local/protocol/v1/StorageRetention.json"
    },
    "revision": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "id",
    "revision",
    "createdAt",
    "expiresAt",
    "retention",
    "items",
    "bytes",
    "complete"
  ],
  "type": "object"
}
