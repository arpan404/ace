{
  "$id": "https://ace.local/protocol/v1/CarriedSession.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "files": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 512,
      "type": "array"
    },
    "nativeSessionId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "sourceCwd": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "provider",
    "nativeSessionId",
    "sourceCwd",
    "files"
  ],
  "type": "object"
}
