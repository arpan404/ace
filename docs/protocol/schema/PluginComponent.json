{
  "$id": "https://ace.local/protocol/v1/PluginComponent.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "description": {
      "maxLength": 8192,
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "kind": {
      "enum": [
        "skill",
        "command",
        "agent",
        "rule"
      ],
      "type": "string"
    },
    "name": {
      "$ref": "https://ace.local/protocol/v1/PluginName.json"
    },
    "path": {
      "maxLength": 512,
      "type": "string"
    },
    "plugin": {
      "$ref": "https://ace.local/protocol/v1/PluginName.json"
    },
    "providers": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
      },
      "maxItems": 7,
      "type": "array"
    },
    "skillAvailability": {
      "$ref": "https://ace.local/protocol/v1/PluginSkillAvailability.json"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "plugin",
    "name",
    "kind",
    "path",
    "description",
    "enabled",
    "providers"
  ],
  "type": "object"
}
