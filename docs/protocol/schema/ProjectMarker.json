{
  "$id": "https://ace.local/protocol/v1/ProjectMarker.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "https://ace.local/protocol/v1/ProjectIdentityId.json"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "version",
    "id"
  ],
  "type": "object"
}
