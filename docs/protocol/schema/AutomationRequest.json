{
  "$id": "https://ace.local/protocol/v1/AutomationRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "automation": {
          "$ref": "https://ace.local/protocol/v1/Automation.json"
        },
        "requestId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "automation.put",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "automation"
      ],
      "type": "object"
    },
    {
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "requestId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "automation.remove",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "id"
      ],
      "type": "object"
    },
    {
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "requestId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "automation.run",
          "type": "string"
        },
        "variables": {
          "$ref": "https://ace.local/protocol/v1/TriggerVariables.json"
        }
      },
      "required": [
        "type",
        "requestId",
        "id",
        "variables"
      ],
      "type": "object"
    },
    {
      "properties": {
        "requestId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "automation.list",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "before": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "requestId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "automation.inbox",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "limit"
      ],
      "type": "object"
    }
  ]
}
