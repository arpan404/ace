{
  "$id": "https://ace.local/protocol/v1/automations_list.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "automationId": {
      "description": "runs: only this automation's runs.",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "before": {
      "description": "runs: the previous page's before.",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "limit": {
      "default": 20,
      "description": "runs: runs per page.",
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "runs": {
      "default": false,
      "description": "Read recent runs instead of definitions.",
      "type": "boolean"
    }
  },
  "type": "object"
}
