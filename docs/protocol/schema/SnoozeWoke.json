        "on": {
          "const": "time",
          "type": "string"
        }
      },
      "required": [
        "on",
        "at"
      ],
      "type": "object"
    },
    {
      "properties": {
        "at": {
          "$ref": "https://ace.local/protocol/v1/Timestamp.json"
        },
        "on": {
