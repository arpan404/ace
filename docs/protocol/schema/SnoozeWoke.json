          "type": "string"
        },
        "outcome": {
          "enum": [
            "finished",
            "failed",
            "asking",
            "limited"
          ],
          "type": "string"
        }
      },
      "required": [
        "on",
        "at",
        "outcome"
      ],
      "type": "object"
    },
    {
      "properties": {
        "at": {
          "$ref": "https://ace.local/protocol/v1/Timestamp.json"
        },
        "change": {
          "enum": [
            "merged",
            "closed",
            "reopened",
            "checks_passed",
            "checks_failed",
