{
  "$id": "https://ace.local/protocol/v1/PluginSpadeFile.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bytes": {
      "maximum": 1048576,
      "minimum": 0,
      "type": "integer"
    },
    "executable": {
      "type": "boolean"
    },
    "hash": {
      "$ref": "https://ace.local/protocol/v1/MarketHash.json"
    },
    "path": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "path",
    "bytes",
    "hash",
    "executable"
  ],
  "type": "object"
}
