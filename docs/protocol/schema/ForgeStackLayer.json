{
  "$id": "https://ace.local/protocol/v1/ForgeStackLayer.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "baseBranch": {
      "maxLength": 65536,
      "type": "string"
    },
    "branch": {
      "maxLength": 65536,
      "type": "string"
    },
    "checksState": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "checksTruncated": {
      "default": false,
      "type": "boolean"
    },
    "headSha": {
      "pattern": "^[a-fA-F0-9]{40,64}$",
      "type": "string"
    },
    "mergeState": {
      "maxLength": 65536,
      "type": "string"
    },
    "number": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "position": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "queueState": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "requiredChecks": {
      "default": [],
      "items": {
        "properties": {
          "name": {
            "maxLength": 65536,
            "type": "string"
          },
          "state": {
            "maxLength": 65536,
            "type": "string"
          }
        },
        "required": [
          "name",
          "state"
        ],
        "type": "object"
      },
      "maxItems": 20,
      "type": "array"
    },
    "reviewDecision": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "maxLength": 65536,
      "type": "string"
    },
    "title": {
      "maxLength": 65536,
      "type": "string"
    },
    "url": {
      "format": "ace-whatwg-url",
      "type": "string",
      "x-ace-constraint": "Accept strings whose trimmed value is an absolute WHATWG URL. Whitespace, Unicode hosts, opaque schemes and parser-normalized URLs are allowed. x-ace-url-minLength and x-ace-url-maxLength apply after trimming whitespace and removing ASCII tab, CR and LF characters, using UTF-16 code units. Install the ace-whatwg-url format validator or enforce this rule in application code.",
      "x-ace-url-maxLength": 4096
    }
  },
  "required": [
    "number",
    "position",
    "title",
    "url",
    "headSha",
    "branch",
    "baseBranch",
    "state",
    "mergeState",
    "reviewDecision",
    "checksState",
    "queueState"
  ],
  "type": "object"
}
