{
  "$id": "https://ace.local/protocol/v1/SourceControlRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "operation": {
      "oneOf": [
        {
          "properties": {
            "op": {
              "const": "readiness",
              "type": "string"
            },
            "workspaceId": {
              "$ref": "https://ace.local/protocol/v1/WorkspaceId.json"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        }
      ]
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "source-control.request",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "operation"
  ],
  "type": "object"
}
