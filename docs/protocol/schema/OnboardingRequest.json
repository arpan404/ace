{
  "$id": "https://ace.local/protocol/v1/OnboardingRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "onboarding.query",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "dismissed": {
          "type": "boolean"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "onboarding.dismiss",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "dismissed"
      ],
      "type": "object"
    }
  ]
}
