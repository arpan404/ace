{
  "$id": "https://ace.local/protocol/v1/CliOperation.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "op": {
          "const": "capabilities",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    {
      "properties": {
        "key": {
          "pattern": "^[a-zA-Z0-9_.-]{1,128}$",
          "type": "string"
        },
        "op": {
          "const": "process.kill_all",
          "type": "string"
        },
        "project": {
          "$ref": "https://ace.local/protocol/v1/WorkspaceId.json"
        },
        "provider": {
          "maxLength": 128,
          "type": "string"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        }
      },
      "required": [
        "op",
        "key"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "mcp.enroll",
          "type": "string"
        },
        "project": {
          "$ref": "https://ace.local/protocol/v1/WorkspaceId.json"
        },
        "scope": {
          "enum": [
            "read",
            "operate"
          ],
          "type": "string"
        },
        "ttlMs": {
          "exclusiveMinimum": 0,
          "maximum": 86400000,
          "type": "integer"
        }
      },
      "required": [
        "op",
        "scope",
        "ttlMs"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "mcp.list",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    {
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "op": {
          "const": "mcp.revoke",
          "type": "string"
        }
      },
      "required": [
        "op",
        "id"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "thread.tree",
          "type": "string"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        }
      },
      "required": [
        "op",
        "threadId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "task.spawn",
          "type": "string"
        },
        "parentId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        },
        "request": {
          "$ref": "https://ace.local/protocol/v1/DelegationRequest.json"
        }
      },
      "required": [
        "op",
        "parentId",
        "request"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "task.status",
          "type": "string"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        }
      },
      "required": [
        "op",
        "threadId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "type": "string"
        },
        "op": {
          "const": "task.cancel",
          "type": "string"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        }
      },
      "required": [
        "op",
        "threadId",
        "key"
      ],
      "type": "object"
    }
  ]
}
