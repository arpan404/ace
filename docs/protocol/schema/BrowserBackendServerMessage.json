{
  "$id": "https://ace.local/protocol/v1/BrowserBackendServerMessage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "backendId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "connectionId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "requestId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "browser.backend.registered",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "backendId",
        "connectionId"
      ],
      "type": "object"
    },
    {
      "$ref": "https://ace.local/protocol/v1/BrowserBackendRequest.json"
    },
    {
      "properties": {
        "backendId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "frameId": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "sessionId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "browser.backend.frameAck",
          "type": "string"
        }
      },
      "required": [
        "backendId",
        "sessionId",
        "type",
        "frameId"
      ],
      "type": "object"
    }
  ]
}
