{
  "$id": "https://ace.local/protocol/v1/PluginAvailability.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "name": {
      "$ref": "https://ace.local/protocol/v1/PluginName.json"
    },
    "providers": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
      },
      "maxItems": 6,
      "type": "array"
    }
  },
  "required": [
    "name",
    "enabled",
    "providers"
  ],
  "type": "object"
}
