{
  "$id": "https://ace.local/protocol/v1/ForgeIssueList.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "canCreate": {
      "type": "boolean"
    },
    "counts": {
      "properties": {
        "closed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "open": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "open",
        "closed"
      ],
      "type": "object"
    },
    "incomplete": {
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/ForgeIssueRow.json"
      },
      "maxItems": 25,
      "type": "array"
    },
    "nextPage": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "repository": {
      "$ref": "https://ace.local/protocol/v1/ForgeRepository.json"
    },
    "total": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "truncated": {
      "type": "boolean"
    },
    "unavailableReason": {
      "maxLength": 256,
      "type": "string"
    }
  },
  "required": [
    "repository",
    "items",
    "total",
    "counts",
    "canCreate",
    "unavailableReason",
    "incomplete",
    "truncated"
  ],
  "type": "object"
}
