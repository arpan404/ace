{
  "$id": "https://ace.local/protocol/v1/ForgeIssueRow.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assignees": {
      "items": {
        "maxLength": 65536,
        "type": "string"
      },
      "maxItems": 100,
      "type": "array"
    },
    "author": {
      "maxLength": 65536,
      "type": "string"
    },
    "authorAvatarUrl": {
      "maxLength": 65536,
      "type": "string"
    },
    "avatars": {
      "$ref": "https://ace.local/protocol/v1/ForgeAvatars.json"
    },
    "commentCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "createdAt": {
      "maxLength": 65536,
      "type": "string"
    },
    "labelColors": {
      "$ref": "https://ace.local/protocol/v1/ForgeLabelColors.json"
    },
    "labels": {
      "items": {
        "maxLength": 65536,
        "type": "string"
      },
      "maxItems": 100,
      "type": "array"
    },
    "milestone": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "raw": {},
    "ref": {
      "$ref": "https://ace.local/protocol/v1/ForgeIssueRef.json"
    },
    "state": {
      "enum": [
        "open",
        "closed"
      ],
      "type": "string"
    },
    "title": {
      "maxLength": 65536,
      "type": "string"
    },
    "updatedAt": {
      "maxLength": 65536,
      "type": "string"
    },
    "url": {
      "maxLength": 65536,
      "type": "string"
    }
  },
  "required": [
    "ref",
    "title",
    "url",
    "author",
    "state",
    "labels",
    "assignees",
    "milestone",
    "createdAt",
    "updatedAt"
  ],
  "type": "object"
}
