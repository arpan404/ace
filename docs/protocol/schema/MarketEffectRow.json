{
  "$id": "https://ace.local/protocol/v1/MarketEffectRow.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "effect": {
      "$ref": "https://ace.local/protocol/v1/PackageEffectWord.json"
    },
    "grant": {
      "$ref": "https://ace.local/protocol/v1/PackageGrant.json"
    },
    "hosts": {
      "items": {
        "maxLength": 260,
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "key": {
      "maxLength": 2100,
      "minLength": 1,
      "type": "string"
    },
    "why": {
      "maxLength": 500,
      "type": "string"
    }
  },
  "required": [
    "key",
    "effect",
    "why"
  ],
  "type": "object"
}
