{
  "$id": "https://ace.local/protocol/v1/ProviderStatus.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "accountLabel": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "actionId": {
      "const": "provider.sign_in",
      "type": "string"
    },
    "apiKey": {
      "$ref": "https://ace.local/protocol/v1/ApiKeySupport.json"
    },
    "auth": {
      "enum": [
        "logged_in",
        "logged_out",
        "unknown"
      ],
      "type": "string"
    },
    "authDetail": {
      "maxLength": 1024,
      "type": "string"
    },
    "authEvidence": {
      "const": "credentials_configured",
      "type": "string"
    },
    "authMethod": {
      "$ref": "https://ace.local/protocol/v1/AccountAuthMethod.json"
    },
    "checkedAt": {
      "minimum": 0,
      "type": "number"
    },
    "enabled": {
      "type": "boolean"
    },
    "error": {
      "maxLength": 1024,
      "type": "string"
    },
    "installCommand": {
      "maxLength": 256,
      "type": "string"
    },
    "installHint": {
      "maxLength": 1024,
      "type": "string"
    },
    "installed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "instanceId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "loginHint": {
      "maxLength": 1024,
      "type": "string"
    },
    "modelsAvailable": {
      "type": "boolean"
    },
    "path": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "permissionModes": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/NativePermissionMode.json"
      },
      "maxItems": 256,
      "type": "array"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "readiness": {
      "enum": [
        "not_installed",
        "installed_signed_out",
        "signed_in",
        "needs_attention",
        "not_configured"
      ],
      "type": "string"
    },
    "refreshing": {
      "type": "boolean"
    },
    "runtime": {
      "enum": [
        "cli",
        "cursor-sdk"
      ],
      "type": "string"
    },
    "stale": {
      "type": "boolean"
    },
    "state": {
      "const": "not_configured",
      "type": "string"
    },
    "updateAvailable": {
      "type": "boolean"
    },
    "version": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "provider",
    "runtime",
    "installed",
    "auth",
    "loginHint",
    "stale",
    "refreshing"
  ],
  "type": "object"
}
