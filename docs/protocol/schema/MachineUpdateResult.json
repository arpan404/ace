{
  "$id": "https://ace.local/protocol/v1/MachineUpdateResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "error": {
      "anyOf": [
        {
          "enum": [
            "forbidden",
            "blocked",
            "stale",
            "confirm",
            "unavailable",
            "invalid"
          ],
          "type": "string"
        },
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "machineUpdate.result",
      "type": "string"
    },
    "update": {
      "$ref": "https://ace.local/protocol/v1/MachineUpdate.json"
    }
  },
  "required": [
    "type",
    "requestId",
    "ok"
  ],
  "type": "object"
}
