{
  "$id": "https://ace.local/protocol/v1/PluginOrigin.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "name": {
      "$ref": "https://ace.local/protocol/v1/PluginName.json"
    },
    "ref": {
      "maxLength": 8192,
      "type": "string"
    },
    "repository": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "name",
    "repository",
    "ref"
  ],
  "type": "object"
}
