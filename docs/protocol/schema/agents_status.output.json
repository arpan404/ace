{
  "$id": "https://ace.local/protocol/v1/agents_status.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "unsupported",
        "forbidden",
        "not_found",
        "limit",
        "not_ready",
        "invalid",
        "unavailable"
      ],
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "children": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "ask": {
                    "maxLength": 100,
                    "type": "string"
                  },
                  "contact": {
                    "enum": [
                      "lost",
                      "unconfirmed"
                    ],
                    "type": "string"
                  },
                  "elapsedSeconds": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "failure": {
                    "additionalProperties": false,
                    "properties": {
                      "accountId": {
                        "maxLength": 256,
                        "type": "string"
                      },
                      "accountLabel": {
                        "maxLength": 256,
                        "type": "string"
                      },
                      "code": {
                        "enum": [
                          "usage_limited",
                          "provider_failed"
                        ],
                        "type": "string"
                      },
                      "message": {
                        "maxLength": 512,
                        "minLength": 1,
                        "type": "string"
                      },
                      "resetsAt": {
                        "minimum": 0,
                        "type": "number"
                      }
                    },
                    "required": [
                      "code",
                      "message"
                    ],
                    "type": "object"
                  },
                  "id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "last": {
                    "maxLength": 100,
                    "type": "string"
                  },
                  "machine": {
                    "maxLength": 64,
                    "type": "string"
                  },
                  "needs": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "notice": {
                    "maxLength": 400,
                    "type": "string"
                  },
                  "parent": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "queuePosition": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "queued": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "result": {
                    "maxLength": 4096,
                    "type": "string"
                  },
                  "role": {
                    "maxLength": 40,
                    "type": "string"
                  },
                  "slotLimit": {
                    "maximum": 64,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "slotsInUse": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "state": {
                    "enum": [
                      "working",
                      "queued",
                      "needs_you",
                      "done",
                      "failed",
                      "cancelled",
                      "unknown"
                    ],
                    "type": "string"
                  },
                  "step": {
                    "maxLength": 60,
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "role",
                  "state",
                  "elapsedSeconds"
                ],
                "type": "object"
              },
              "maxItems": 64,
              "type": "array"
            },
            "counts": {
              "additionalProperties": false,
              "properties": {
                "cancelled": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "done": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "failed": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "needs_you": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "queued": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "unknown": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "working": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "working",
                "queued",
                "needs_you",
                "unknown",
                "done",
                "failed",
                "cancelled"
              ],
              "type": "object"
            },
            "omitted": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "children",
            "counts"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {},
          "properties": {
            "outcome": {
              "additionalProperties": false,
              "properties": {
                "before": {
                  "anyOf": [
                    {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "failure": {
                  "additionalProperties": false,
                  "properties": {
                    "accountId": {
                      "maxLength": 256,
                      "type": "string"
                    },
                    "accountLabel": {
                      "maxLength": 256,
                      "type": "string"
                    },
                    "code": {
                      "enum": [
                        "usage_limited",
                        "provider_failed"
                      ],
                      "type": "string"
                    },
                    "message": {
                      "maxLength": 512,
                      "minLength": 1,
                      "type": "string"
                    },
                    "resetsAt": {
                      "minimum": 0,
                      "type": "number"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "type": "object"
                },
                "outcome": {
                  "enum": [
                    "completed",
                    "failed",
                    "cancelled"
                  ],
                  "type": "string"
                },
                "result": {
                  "maxLength": 4096,
                  "type": "string"
                },
                "threadId": {
                  "minLength": 1,
                  "type": "string"
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "threadId",
                "outcome",
                "result",
                "truncated",
                "before"
              ],
              "type": "object"
            },
            "state": {
              "type": "string"
            },
            "threadId": {
              "type": "string"
            }
          },
          "required": [
            "threadId",
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "hint": {
      "maxLength": 512,
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    }
  },
  "required": [
    "ok"
  ],
  "type": "object"
}
