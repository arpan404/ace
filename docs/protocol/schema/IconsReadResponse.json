{
  "$id": "https://ace.local/protocol/v1/IconsReadResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "data": {
      "maxLength": 65536,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$",
      "type": "string"
    },
    "mimeType": {
      "const": "image/png",
      "type": "string"
    },
    "ref": {
      "$ref": "https://ace.local/protocol/v1/IconRef.json"
    },
    "requestId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "icons.read",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "ref",
    "mimeType",
    "data"
  ],
  "type": "object"
}
