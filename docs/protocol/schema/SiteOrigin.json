{
  "$id": "https://ace.local/protocol/v1/SiteOrigin.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "maxLength": 512,
  "pattern": "^https?:\\/\\/[a-z0-9.-]+(?::\\d{1,5})?$",
  "type": "string",
  "x-ace-constraint": "http(s) origin: scheme, lowercase host and optional port only."
}
