{
  "$id": "https://ace.local/protocol/v1/GoalChange.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "properties": {
        "objective": {
          "maxLength": 4000,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "objective"
      ],
      "type": "object"
    },
    {
      "properties": {
        "status": {
          "enum": [
            "active",
            "paused"
          ],
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    }
  ]
}
