{
  "$id": "https://ace.local/protocol/v1/UsageResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "burn": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/UsageBurn.json"
      },
      "maxItems": 20,
      "type": "array"
    },
    "cursor": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "omittedEvents": {
      "default": 0,
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "priceVersion": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/UsageRow.json"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "timezone": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "cursor",
    "timezone",
    "priceVersion",
    "rows",
    "truncated"
  ],
  "type": "object"
}
