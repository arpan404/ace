{
  "$id": "https://ace.local/protocol/v1/ListingDecision.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "decision": {
      "enum": [
        "approve",
        "refuse"
      ],
      "type": "string"
    },
    "reason": {
      "maxLength": 500,
      "type": "string"
    }
  },
  "required": [
    "decision"
  ],
  "type": "object"
}
