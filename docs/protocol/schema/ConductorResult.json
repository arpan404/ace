{
  "$id": "https://ace.local/protocol/v1/ConductorResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "error": {
      "maxLength": 128,
      "type": "string"
    },
    "next": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$",
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "requestId": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$",
      "type": "string"
    },
    "run": {
      "$ref": "https://ace.local/protocol/v1/ConductorRunView.json"
    },
    "runs": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/ConductorSummary.json"
      },
      "maxItems": 32,
      "type": "array"
    },
    "type": {
      "const": "conductor.result",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "ok"
  ],
  "type": "object"
}
