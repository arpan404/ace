{
  "$id": "https://ace.local/protocol/v1/ToolEnvResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "result": {
      "oneOf": [
        {
          "properties": {
            "ok": {
              "const": true,
              "type": "boolean"
            },
            "stored": {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "ok",
            "stored"
          ],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "enum": [
                "forbidden",
                "unavailable",
                "busy",
                "not_found",
                "invalid_input"
              ],
              "type": "string"
            },
            "ok": {
              "const": false,
              "type": "boolean"
            }
          },
          "required": [
            "ok",
            "error"
          ],
          "type": "object"
        }
      ]
    },
    "type": {
      "const": "provider.toolEnv.result",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "result"
  ],
  "type": "object"
}
