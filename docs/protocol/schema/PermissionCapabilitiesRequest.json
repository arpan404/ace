{
  "$id": "https://ace.local/protocol/v1/PermissionCapabilitiesRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "backend": {
      "enum": [
        "cli",
        "acp",
        "cursor-sdk"
      ],
      "type": "string"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "permissions.capabilities",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "provider"
  ],
  "type": "object"
}
