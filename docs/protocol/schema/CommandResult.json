{
  "$id": "https://ace.local/protocol/v1/CommandResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "alive": {
      "properties": {
        "agentsRunning": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "operationsRunning": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "terminalsOpen": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "agentsRunning",
        "terminalsOpen",
        "operationsRunning"
      ],
      "type": "object"
    },
    "code": {
      "type": "string"
    },
    "commandId": {
      "$ref": "https://ace.local/protocol/v1/CommandId.json"
    },
    "commit": {
      "pattern": "^[a-f0-9]{40,64}$",
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "editor": {
      "$ref": "https://ace.local/protocol/v1/EditorLaunch.json"
    },
    "error": {
      "type": "string"
    },
    "forkThreadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "health": {
      "$ref": "https://ace.local/protocol/v1/DiagnosticsHealth.json"
    },
    "inspection": {
      "$ref": "https://ace.local/protocol/v1/ProjectInspection.json"
    },
    "issue": {
      "$ref": "https://ace.local/protocol/v1/ForgeIssueRef.json"
    },
    "issueAction": {
      "$ref": "https://ace.local/protocol/v1/ForgeIssueAction.json"
    },
    "ok": {
      "type": "boolean"
    },
    "pr": {
      "$ref": "https://ace.local/protocol/v1/ForgePrRef.json"
    },
    "prStatus": {
      "$ref": "https://ace.local/protocol/v1/ForgePrStatus.json"
    },
    "publication": {
      "$ref": "https://ace.local/protocol/v1/RepositoryPublication.json"
    },
    "review": {
      "$ref": "https://ace.local/protocol/v1/ReviewData.json"
    },
    "stackOperation": {
      "$ref": "https://ace.local/protocol/v1/ForgeStackOperation.json"
    },
    "terminalId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "title": {
      "type": "string"
    },
    "workspace": {
      "$ref": "https://ace.local/protocol/v1/Project.json"
    }
  },
  "required": [
    "commandId",
    "ok"
  ],
  "type": "object"
}
