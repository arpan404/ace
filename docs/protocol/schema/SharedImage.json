{
  "$id": "https://ace.local/protocol/v1/SharedImage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "alt": {
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
    },
    "attachment": {
      "$ref": "https://ace.local/protocol/v1/Attachment.json"
    },
    "caption": {
      "$ref": "https://ace.local/protocol/v1/SharedImageCaption.json"
    }
  },
  "required": [
    "attachment",
    "alt"
  ],
  "type": "object"
}
