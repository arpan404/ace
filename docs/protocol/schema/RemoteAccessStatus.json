{
  "$id": "https://ace.local/protocol/v1/RemoteAccessStatus.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "error": {
      "maxLength": 256,
      "type": "string"
    },
    "listenOverride": {
      "anyOf": [
        {
          "enum": [
            "local",
            "lan",
            "tailscale"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "relay": {
      "properties": {
        "fingerprint": {
          "pattern": "^[A-Z2-7]{52}$",
          "type": "string"
        },
        "hostId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "maxLength": 2048,
          "type": "string"
        }
      },
      "required": [
        "url",
        "fingerprint",
        "hostId"
      ],
      "type": "object"
    },
    "relayOverride": {
      "type": "boolean"
    },
    "transport": {
      "enum": [
        "local",
        "lan",
        "tailscale",
        "relay"
      ],
      "type": "string"
    }
  },
  "required": [
    "enabled",
    "transport",
    "listenOverride",
    "relayOverride"
  ],
  "type": "object"
}
