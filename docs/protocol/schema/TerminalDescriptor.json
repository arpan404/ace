{
  "$id": "https://ace.local/protocol/v1/TerminalDescriptor.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "exited": {
      "type": "boolean"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "maxLength": 256,
      "type": "string"
    },
    "nextOffset": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "oldestOffset": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "pid": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    }
  },
  "required": [
    "id",
    "threadId",
    "name",
    "pid",
    "exited",
    "oldestOffset",
    "nextOffset"
  ],
  "type": "object"
}
