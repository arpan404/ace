{
  "$id": "https://ace.local/protocol/v1/ThreadRunMetadata.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "account": {
      "maxLength": 256,
      "type": "string"
    },
    "asking": {
      "items": {
        "properties": {
          "id": {
            "$ref": "https://ace.local/protocol/v1/InteractionId.json"
          },
          "kind": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "type": "object"
      },
      "maxItems": 8,
      "type": "array"
    },
    "askingThreads": {
      "items": {
        "properties": {
          "id": {
            "$ref": "https://ace.local/protocol/v1/ThreadId.json"
          },
          "name": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "maxItems": 8,
      "type": "array"
    },
    "backgroundTaskCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "contextMeter": {
      "properties": {
        "at": {
          "$ref": "https://ace.local/protocol/v1/Timestamp.json"
        },
        "limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "used": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "used",
        "limit",
        "at"
      ],
      "type": "object"
    },
    "model": {
      "maxLength": 256,
      "type": "string"
    },
    "options": {
      "$ref": "https://ace.local/protocol/v1/ExecutionOptions.json"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "rootRunId": {
      "anyOf": [
        {
          "$ref": "https://ace.local/protocol/v1/RunId.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "runningSubagentCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "step": {
      "enum": [
        "tests"
      ],
      "type": "string"
    },
    "subagentCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "turnStart": {
      "properties": {
        "at": {
          "$ref": "https://ace.local/protocol/v1/Timestamp.json"
        },
        "turn": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "turn",
        "at"
      ],
      "type": "object"
    },
    "waitingOn": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "waitingSince": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "watching": {
      "items": {
        "properties": {
          "id": {
            "$ref": "https://ace.local/protocol/v1/BackgroundTaskId.json"
          },
          "title": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "type": "object"
      },
      "maxItems": 8,
      "type": "array"
    },
    "watchingCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "workingSince": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    }
  },
  "type": "object"
}
