{
  "$id": "https://ace.local/protocol/v1/ForgeInboxAction.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "action": {
      "enum": [
        "read",
        "done",
        "unsubscribe",
        "read-all"
      ],
      "type": "string"
    },
    "error": {
      "maxLength": 256,
      "type": "string"
    },
    "id": {
      "$ref": "https://ace.local/protocol/v1/CommandId.json"
    },
    "state": {
      "enum": [
        "succeeded",
        "failed",
        "uncertain"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "state",
    "action"
  ],
  "type": "object"
}
