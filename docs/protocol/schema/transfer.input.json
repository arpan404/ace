{
  "$id": "https://ace.local/protocol/v1/transfer.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "includeChanges": {
      "description": "Send uncommitted changes. Default true.",
      "type": "boolean"
    },
    "includeIgnored": {
      "description": "Send ignored files like .env. Default: the setting.",
      "type": "boolean"
    },
    "machine": {
      "description": "From machines, with transfers true.",
      "pattern": "^[a-zA-Z0-9_.-]{1,64}$",
      "type": "string"
    },
    "project": {
      "description": "A project here, by id or name.",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "thread": {
      "const": "self",
      "description": "Continue this thread there as a new thread with its history.",
      "type": "string"
    }
  },
  "required": [
    "machine"
  ],
  "type": "object"
}
