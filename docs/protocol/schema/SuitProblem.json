{
  "$id": "https://ace.local/protocol/v1/SuitProblem.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "check": {
      "type": "string"
    },
    "field": {
      "type": [
        "string",
        "null"
      ]
    },
    "line": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "message": {
      "type": "string"
    },
    "scheme": {
      "anyOf": [
        {
          "enum": [
            "light",
            "dark"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "scheme",
    "check",
    "field",
    "message"
  ],
  "type": "object"
}
