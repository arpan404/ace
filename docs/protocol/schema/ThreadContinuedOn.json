{
  "$id": "https://ace.local/protocol/v1/ThreadContinuedOn.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "at": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "hostId": {
      "$ref": "https://ace.local/protocol/v1/HostId.json"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    }
  },
  "required": [
    "hostId",
    "name",
    "threadId",
    "at"
  ],
  "type": "object"
}
