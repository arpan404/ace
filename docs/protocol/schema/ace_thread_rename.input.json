{
  "$id": "https://ace.local/protocol/v1/ace_thread_rename.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "onlyIfProvisional": {
      "type": "boolean"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "title": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "title"
  ],
  "type": "object"
}
