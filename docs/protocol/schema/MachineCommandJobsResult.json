{
  "$id": "https://ace.local/protocol/v1/MachineCommandJobsResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "jobs": {
      "items": {
        "properties": {
          "jobId": {
            "$ref": "https://ace.local/protocol/v1/CommandJobId.json"
          },
          "state": {
            "enum": [
              "running",
              "ended",
              "unknown"
            ],
            "type": "string"
          }
        },
        "required": [
          "jobId",
          "state"
        ],
        "type": "object"
      },
      "maxItems": 16,
      "type": "array"
    }
  },
  "required": [
    "jobs"
  ],
  "type": "object"
}
