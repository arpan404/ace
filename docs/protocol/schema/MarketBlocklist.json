{
  "$id": "https://ace.local/protocol/v1/MarketBlocklist.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "$ref": "https://ace.local/protocol/v1/MarketHash.json"
          }
        },
        "required": [
          "sha256",
          "reason"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "format": {
      "const": "ace-market-blocklist",
      "type": "string"
    },
    "hashes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "hash": {
            "$ref": "https://ace.local/protocol/v1/MarketHash.json"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "hash",
          "reason"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "issued": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "key": {
      "$ref": "https://ace.local/protocol/v1/MarketKeyId.json"
    },
    "patterns": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/MarketBlockedPattern.json"
      },
      "maxItems": 1000,
      "type": "array"
    }
  },
  "required": [
    "format",
    "issued",
    "hashes",
    "files",
    "patterns",
    "key"
  ],
  "type": "object"
}
