{
  "$id": "https://ace.local/protocol/v1/MediaStreamServerMessage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "connection": {
          "$ref": "https://ace.local/protocol/v1/MediaConnectionId.json"
        },
        "type": {
          "const": "media.welcome",
          "type": "string"
        }
      },
      "required": [
        "type",
        "connection"
      ],
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "pong",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  ]
}
