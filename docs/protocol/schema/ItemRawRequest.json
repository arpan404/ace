{
  "$id": "https://ace.local/protocol/v1/ItemRawRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "from": {
      "default": 0,
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "itemId": {
      "$ref": "https://ace.local/protocol/v1/ItemId.json"
    },
    "requestId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "type": {
      "const": "item.raw",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "threadId",
    "itemId"
  ],
  "type": "object"
}
