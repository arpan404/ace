{
  "$id": "https://ace.local/protocol/v1/ThreadStatus.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "interactions": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "state": {
          "const": "needs_you",
          "type": "string"
        }
      },
      "required": [
        "state",
        "interactions"
      ],
      "type": "object"
    },
    {
      "properties": {
        "agents": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "state": {
          "const": "working",
          "type": "string"
        }
      },
      "required": [
        "state",
        "agents"
      ],
      "type": "object"
    },
    {
      "properties": {
        "on": {
          "enum": [
            "background_task",
            "rate_limit",
            "network",
            "upstream",
            "queue"
          ],
          "type": "string"
        },
        "state": {
          "const": "waiting",
          "type": "string"
        }
      },
      "required": [
        "state",
        "on"
      ],
      "type": "object"
    },
    {
      "properties": {
        "state": {
          "const": "limited",
          "type": "string"
        },
        "until": {
          "$ref": "https://ace.local/protocol/v1/Timestamp.json"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    {
      "properties": {
        "state": {
          "const": "failed",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    {
      "properties": {
        "state": {
          "const": "unresponsive",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    {
      "properties": {
        "state": {
          "const": "done",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    {
      "properties": {
        "state": {
          "const": "new",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    }
  ]
}
