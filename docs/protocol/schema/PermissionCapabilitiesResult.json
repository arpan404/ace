{
  "$id": "https://ace.local/protocol/v1/PermissionCapabilitiesResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "error": {
      "maxLength": 256,
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "permissions": {
      "$ref": "https://ace.local/protocol/v1/PermissionCapabilities.json"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "permissions.capabilities.result",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "ok"
  ],
  "type": "object"
}
