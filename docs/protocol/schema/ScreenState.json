{
  "$id": "https://ace.local/protocol/v1/ScreenState.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "acceleration": {
      "$ref": "https://ace.local/protocol/v1/MediaAcceleration.json"
    },
    "agentPointer": {
      "$ref": "https://ace.local/protocol/v1/AgentPointer.json"
    },
    "capabilities": {
      "$ref": "https://ace.local/protocol/v1/ScreenCapabilities.json"
    },
    "controller": {
      "enum": [
        "agent",
        "human",
        "none"
      ],
      "type": "string"
    },
    "error": {
      "maxLength": 1024,
      "type": "string"
    },
    "holder": {
      "$ref": "https://ace.local/protocol/v1/ScreenAgentScope.json"
    },
    "indicator": {
      "type": "boolean"
    },
    "lifecycle": {
      "enum": [
        "starting",
        "live",
        "stopping",
        "stopped",
        "failed"
      ],
      "type": "string"
    },
    "mode": {
      "$ref": "https://ace.local/protocol/v1/ScreenMode.json",
      "default": "background"
    },
    "permissions": {
      "$ref": "https://ace.local/protocol/v1/DevicePermissions.json"
    },
    "personActive": {
      "type": "boolean"
    },
    "secureInputAllowed": {
      "default": false,
      "type": "boolean"
    },
    "sessionId": {
      "$ref": "https://ace.local/protocol/v1/ScreenId.json"
    },
    "sharing": {
      "$ref": "https://ace.local/protocol/v1/CoworkSharing.json"
    },
    "target": {
      "$ref": "https://ace.local/protocol/v1/ScreenTarget.json"
    },
    "threadId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "sessionId",
    "lifecycle",
    "controller",
    "indicator",
    "target",
    "permissions"
  ],
  "type": "object"
}
