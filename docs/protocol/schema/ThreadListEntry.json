{
  "$id": "https://ace.local/protocol/v1/ThreadListEntry.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "acpAgentId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "acpSupport": {
      "$ref": "https://ace.local/protocol/v1/AcpSessionSupport.json"
    },
    "archivedAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "backend": {
      "enum": [
        "acp",
        "cursor-sdk"
      ],
      "type": "string"
    },
    "capabilities": {
      "$ref": "https://ace.local/protocol/v1/Capabilities.json"
    },
    "createdAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "effectiveCapabilities": {
      "$ref": "https://ace.local/protocol/v1/Capabilities.json"
    },
    "handoff": {
      "properties": {
        "bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "sourceThreadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "sourceThreadId",
        "truncated",
        "bytes"
      ],
      "type": "object"
    },
    "id": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "imported": {
      "$ref": "https://ace.local/protocol/v1/ImportedProvenance.json"
    },
    "installationId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "instanceId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "status": {
      "$ref": "https://ace.local/protocol/v1/ThreadStatus.json"
    },
    "title": {
      "type": "string"
    },
    "updatedAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "workspaceId": {
      "$ref": "https://ace.local/protocol/v1/WorkspaceId.json"
    }
  },
  "required": [
    "id",
    "workspaceId",
    "title",
    "provider",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "type": "object"
}
