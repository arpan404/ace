{
  "$id": "https://ace.local/protocol/v1/ThreadListEntry.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "acpAgentId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "acpSupport": {
      "$ref": "https://ace.local/protocol/v1/AcpSessionSupport.json"
    },
    "activityAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "archivedAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "autoSettleAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "backend": {
      "enum": [
        "acp",
        "cursor-sdk"
      ],
      "type": "string"
    },
    "capabilities": {
      "$ref": "https://ace.local/protocol/v1/Capabilities.json"
    },
    "createdAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "deck": {
      "$ref": "https://ace.local/protocol/v1/DeckOwnership.json"
    },
    "deletedAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "details": {
      "$ref": "https://ace.local/protocol/v1/ThreadDetails.json"
    },
    "effectiveCapabilities": {
      "$ref": "https://ace.local/protocol/v1/Capabilities.json"
    },
    "execution": {
      "$ref": "https://ace.local/protocol/v1/ExecutionSelection.json"
    },
    "handoff": {
      "properties": {
        "bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "sourceThreadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "sourceThreadId",
        "truncated",
        "bytes"
      ],
      "type": "object"
    },
    "id": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    },
    "imported": {
      "$ref": "https://ace.local/protocol/v1/ImportedProvenance.json"
    },
    "installationId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "instanceId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "lineage": {
      "$ref": "https://ace.local/protocol/v1/ThreadLineage.json"
    },
    "live": {
      "$ref": "https://ace.local/protocol/v1/ThreadRunMetadata.json"
    },
    "pinned": {
      "type": "boolean"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "readAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "settledAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "settledReason": {
      "enum": [
        "manual",
        "inactivity",
        "pr_merged",
        "pr_closed"
      ],
      "type": "string"
    },
    "snoozedUntil": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "status": {
      "$ref": "https://ace.local/protocol/v1/ThreadStatus.json"
    },
    "switch": {
      "$ref": "https://ace.local/protocol/v1/ThreadSwitch.json"
    },
    "title": {
      "type": "string"
    },
    "unread": {
      "type": "boolean"
    },
    "updatedAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "workspaceId": {
      "$ref": "https://ace.local/protocol/v1/WorkspaceId.json"
    }
  },
  "required": [
    "id",
    "workspaceId",
    "title",
    "provider",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "type": "object"
}
