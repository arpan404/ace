{
  "$id": "https://ace.local/protocol/v1/MarketKeySet.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "keys": {
      "items": {
        "properties": {
          "id": {
            "$ref": "https://ace.local/protocol/v1/MarketKeyId.json"
          },
          "publicKey": {
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "publicKey"
        ],
        "type": "object"
      },
      "maxItems": 2,
      "type": "array"
    }
  },
  "required": [
    "keys"
  ],
  "type": "object"
}
