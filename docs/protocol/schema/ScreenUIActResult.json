{
  "$id": "https://ace.local/protocol/v1/ScreenUIActResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "boundsCentre": {
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "fallback": {
      "type": "boolean"
    },
    "method": {
      "maxLength": 64,
      "type": "string"
    },
    "mode": {
      "enum": [
        "background",
        "foreground"
      ],
      "type": "string"
    },
    "notes": {
      "items": {
        "maxLength": 1024,
        "type": "string"
      },
      "maxItems": 8,
      "type": "array"
    },
    "snapshot": {
      "$ref": "https://ace.local/protocol/v1/ScreenUITreeResult.json"
    },
    "warnings": {
      "items": {
        "maxLength": 1024,
        "type": "string"
      },
      "maxItems": 8,
      "type": "array"
    }
  },
  "required": [
    "fallback"
  ],
  "type": "object"
}
