{
  "$id": "https://ace.local/protocol/v1/html_render.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "height": {
      "$ref": "https://ace.local/protocol/v1/HtmlHeight.json",
      "description": "CSS pixels held while loading; the frame then fits the page."
    },
    "html": {
      "description": "A self-contained HTML document: inline CSS, JS, SVG and data: images; no network.",
      "maxLength": 16777216,
      "minLength": 1,
      "type": "string"
    },
    "mode": {
      "$ref": "https://ace.local/protocol/v1/HtmlMode.json",
      "description": "interactive runs scripts in a sandbox; static strips them. Default: inferred."
    },
    "title": {
      "description": "Caption above the page.",
      "maxLength": 160,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "title",
    "html"
  ],
  "type": "object"
}
