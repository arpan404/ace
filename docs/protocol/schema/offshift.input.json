{
  "$id": "https://ace.local/protocol/v1/offshift.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "description": "start: outcome, endpoint, criteria. Later changes: runId, version. advance: phase. revise: criterion. step: stepId, state. Note why on each.",
      "enum": [
        "start",
        "get",
        "list",
        "playbooks",
        "advance",
        "block",
        "resume",
        "evidence",
        "revise",
        "step"
      ],
      "type": "string"
    },
    "criteria": {
      "$ref": "https://ace.local/protocol/v1/OffshiftCriteria.json"
    },
    "criterion": {
      "$ref": "https://ace.local/protocol/v1/OffshiftCriterion.json"
    },
    "endpoint": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "https://ace.local/protocol/v1/OffshiftEvidenceInput.json"
        },
        {
          "$ref": "https://ace.local/protocol/v1/OffshiftEvidenceBatch.json"
        }
      ],
      "description": "A list is recorded whole or not at all."
    },
    "note": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "outcome": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "$ref": "https://ace.local/protocol/v1/OffshiftPhase.json"
    },
    "playbook": {
      "$ref": "https://ace.local/protocol/v1/OffshiftPlaybookId.json"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    },
    "runId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    },
    "runOwner": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json",
      "description": "The ancestor whose run you check."
    },
    "state": {
      "enum": [
        "done",
        "skipped"
      ],
      "type": "string"
    },
    "stepId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    },
    "steps": {
      "$ref": "https://ace.local/protocol/v1/OffshiftStepsInput.json"
    },
    "version": {
      "description": "run.version, as next names it.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "action"
  ],
  "type": "object",
  "x-ace-constraint": "start needs runId, outcome, endpoint and criteria; get needs runId; advance needs runId, version, phase and note; block and resume need runId, version and note; evidence needs runId, version and evidence; revise needs runId, version, criterion and note; step needs runId, version, stepId and state."
}
