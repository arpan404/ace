{
  "$id": "https://ace.local/protocol/v1/thread_read.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "before": {
      "description": "The previous page's itemsBefore.",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "limit": {
      "default": 10,
      "description": "Items per page, 1 to 50.",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "maxBytes": {
      "default": 8192,
      "description": "With streamId: bytes to read, up to 16384.",
      "maximum": 16384,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "With streamId: byte offset, from nextOffset.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "streamId": {
      "description": "Read a truncated part's retained output instead of the transcript.",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json",
      "description": "Default: this thread."
    }
  },
  "type": "object"
}
