{
  "$id": "https://ace.local/protocol/v1/ProjectInspection.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "defaultIcon": {
      "anyOf": [
        {
          "$ref": "https://ace.local/protocol/v1/ProjectIcon.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "git": {
      "anyOf": [
        {
          "$ref": "https://ace.local/protocol/v1/ProjectGit.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "gitUnavailable": {
      "const": "git_quarantined",
      "type": "string"
    },
    "path": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "suggestedRepoRoot": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "path",
    "git"
  ],
  "type": "object"
}
