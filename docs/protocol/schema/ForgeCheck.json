{
  "$id": "https://ace.local/protocol/v1/ForgeCheck.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "completedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "conclusion": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "maxLength": 256,
      "type": "string"
    },
    "jobId": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "maxLength": 65536,
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "success",
        "failure",
        "cancelled",
        "unknown"
      ],
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "status",
    "conclusion",
    "completedAt",
    "jobId",
    "url"
  ],
  "type": "object"
}
