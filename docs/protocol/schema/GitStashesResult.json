{
  "$id": "https://ace.local/protocol/v1/GitStashesResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "kind": {
      "const": "gitStashes",
      "type": "string"
    },
    "stashes": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/GitStashEntry.json"
      },
      "maxItems": 200,
      "type": "array"
    }
  },
  "required": [
    "kind",
    "stashes"
  ],
  "type": "object"
}
