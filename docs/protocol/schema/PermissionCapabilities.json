{
  "$id": "https://ace.local/protocol/v1/PermissionCapabilities.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "guarantees": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/PermissionGuarantee.json"
      },
      "maxItems": 4,
      "type": "array"
    },
    "modes": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/PermissionMode.json"
      },
      "maxItems": 256,
      "type": "array"
    },
    "nativeAutoReview": {
      "type": "boolean"
    },
    "permissionModes": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/NativePermissionMode.json"
      },
      "maxItems": 256,
      "type": "array"
    },
    "toolGate": {
      "type": "boolean"
    }
  },
  "required": [
    "modes",
    "nativeAutoReview",
    "toolGate"
  ],
  "type": "object"
}
