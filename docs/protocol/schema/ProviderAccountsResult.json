{
  "$id": "https://ace.local/protocol/v1/ProviderAccountsResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "result": {
      "oneOf": [
        {
          "properties": {
            "accounts": {
              "items": {
                "$ref": "https://ace.local/protocol/v1/ProviderAccountSummary.json"
              },
              "maxItems": 256,
              "type": "array"
            },
            "apiKey": {
              "$ref": "https://ace.local/protocol/v1/ApiKeySupport.json"
            },
            "ok": {
              "const": true,
              "type": "boolean"
            },
            "progress": {
              "$ref": "https://ace.local/protocol/v1/ProviderLoginProgress.json"
            }
          },
          "required": [
            "ok",
            "accounts",
            "apiKey"
          ],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "enum": [
                "forbidden",
                "unavailable",
                "busy",
                "not_found",
                "unsupported",
                "failed"
              ],
              "type": "string"
            },
            "instanceId": {
              "$ref": "https://ace.local/protocol/v1/AccountId.json"
            },
            "ok": {
              "const": false,
              "type": "boolean"
            }
          },
          "required": [
            "ok",
            "error"
          ],
          "type": "object"
        }
      ]
    },
    "type": {
      "const": "provider.accounts.result",
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "result"
  ],
  "type": "object"
}
