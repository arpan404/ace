{
  "$id": "https://ace.local/protocol/v1/BrowserCaptureViewport.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cursor": {
      "properties": {
        "fill": {
          "pattern": "^#[0-9a-f]{6}$",
          "type": "string"
        },
        "outline": {
          "pattern": "^#[0-9a-f]{6}$",
          "type": "string"
        }
      },
      "required": [
        "fill",
        "outline"
      ],
      "type": "object"
    },
    "devicePixelRatio": {
      "maximum": 4,
      "minimum": 1,
      "type": "number"
    },
    "height": {
      "maximum": 4096,
      "minimum": 100,
      "type": "integer"
    },
    "nativeShown": {
      "type": "boolean"
    },
    "width": {
      "maximum": 4096,
      "minimum": 100,
      "type": "integer"
    }
  },
  "required": [
    "width",
    "height",
    "devicePixelRatio"
  ],
  "type": "object"
}
