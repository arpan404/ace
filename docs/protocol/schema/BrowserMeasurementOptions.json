{
  "$id": "https://ace.local/protocol/v1/BrowserMeasurementOptions.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "filmstrip": {
      "default": true,
      "type": "boolean"
    },
    "interaction": {
      "$ref": "https://ace.local/protocol/v1/BrowserInteractionAction.json"
    },
    "observeMs": {
      "default": 2000,
      "maximum": 10000,
      "minimum": 1,
      "type": "integer"
    },
    "repeat": {
      "default": 1,
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    }
  },
  "type": "object"
}
