{
  "$id": "https://ace.local/protocol/v1/ForgeLifecycleSnapshot.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actions": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/ForgeLifecycleActionName.json"
      },
      "maxItems": 13,
      "type": "array"
    },
    "baseSha": {
      "pattern": "^[a-fA-F0-9]{40,64}$",
      "type": "string"
    },
    "closingIssues": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/ForgeClosingIssue.json"
      },
      "maxItems": 50,
      "type": "array"
    },
    "conversation": {
      "properties": {
        "locked": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "https://ace.local/protocol/v1/ForgeLockReason.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "viewerCanComment": {
          "type": "boolean"
        }
      },
      "required": [
        "locked",
        "reason",
        "viewerCanComment"
      ],
      "type": "object"
    },
    "editableFields": {
      "items": {
        "enum": [
          "title",
          "body",
          "baseBranch",
          "labels",
          "assignees",
          "milestone"
        ],
        "type": "string"
      },
      "maxItems": 6,
      "type": "array"
    },
    "headBranch": {
      "properties": {
        "deleteOnMerge": {
          "type": "boolean"
        },
        "exists": {
          "type": "boolean"
        },
        "isDefault": {
          "type": "boolean"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "sameRepository": {
          "type": "boolean"
        },
        "usedBy": {
          "items": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "maxItems": 10,
          "type": "array"
        }
      },
      "required": [
        "name",
        "exists",
        "sameRepository",
        "isDefault",
        "deleteOnMerge"
      ],
      "type": "object"
    },
    "headSha": {
      "pattern": "^[a-fA-F0-9]{40,64}$",
      "type": "string"
    },
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "metadata": {
      "$ref": "https://ace.local/protocol/v1/ForgePrMetadata.json"
    },
    "milestone": {
      "anyOf": [
        {
          "properties": {
            "dueOn": {
              "anyOf": [
                {
                  "maxLength": 65536,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "number": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "state": {
              "enum": [
                "open",
                "closed"
              ],
              "type": "string"
            },
            "title": {
              "maxLength": 65536,
              "type": "string"
            }
          },
          "required": [
            "number",
            "title",
            "state",
            "dueOn"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "pr": {
      "$ref": "https://ace.local/protocol/v1/ForgePrRef.json"
    },
    "state": {
      "enum": [
        "open",
        "draft",
        "closed",
        "merged"
      ],
      "type": "string"
    },
    "unsupported": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/ForgeLifecycleActionName.json"
      },
      "maxItems": 13,
      "type": "array"
    },
    "version": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "pr",
    "id",
    "version",
    "headSha",
    "baseSha",
    "state",
    "metadata",
    "editableFields",
    "actions",
    "unsupported"
  ],
  "type": "object"
}
