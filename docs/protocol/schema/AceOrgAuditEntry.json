{
  "$id": "https://ace.local/protocol/v1/AceOrgAuditEntry.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "action": {
      "pattern": "^[a-z_]+(\\.[a-z_]+){1,3}$",
      "type": "string"
    },
    "actor": {
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "type": "string"
        },
        "type": {
          "pattern": "^[a-z_]{1,32}$",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    "hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "anyOf": [
          {
            "maxLength": 500,
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_]{1,40}$",
        "type": "string"
      },
      "type": "object",
      "x-ace-constraint": "At most 49 keys."
    },
    "occurredAt": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "targets": {
      "items": {
        "properties": {
          "id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "maxLength": 256,
            "type": "string"
          },
          "type": {
            "pattern": "^[a-z_]{1,32}$",
            "type": "string"
          }
        },
        "required": [
          "type",
          "id"
        ],
        "type": "object"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "hash",
    "action",
    "occurredAt",
    "actor",
    "targets"
  ],
  "type": "object"
}
