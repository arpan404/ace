{
  "$id": "https://ace.local/protocol/v1/ThreadClientFields.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "activityAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "activitySeq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "autoSettleAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "deletedAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "details": {
      "$ref": "https://ace.local/protocol/v1/ThreadDetails.json"
    },
    "hasSentMessage": {
      "type": "boolean"
    },
    "live": {
      "$ref": "https://ace.local/protocol/v1/ThreadRunMetadata.json"
    },
    "pinOrder": {
      "description": "Place among pinned threads, higher first. Set on pin (the daemon's clock when the command names none, so a new pin leads) and cleared on unpin.",
      "type": "number"
    },
    "pinned": {
      "type": "boolean"
    },
    "readAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "settledAt": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "settledReason": {
      "enum": [
        "manual",
        "inactivity",
        "pr_merged",
        "pr_closed"
      ],
      "type": "string"
    },
    "snoozedUntil": {
      "$ref": "https://ace.local/protocol/v1/Timestamp.json"
    },
    "unread": {
      "type": "boolean"
    }
  },
  "type": "object"
}
