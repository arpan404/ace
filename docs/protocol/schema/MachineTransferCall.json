          "const": "probe",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    {
      "$ref": "https://ace.local/protocol/v1/TransferBegin.json"
    },
    {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "status",
          "type": "string"
        },
        "transferId": {
