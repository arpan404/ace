        }
      },
      "required": [
        "op",
        "transferId"
      ],
      "type": "object"
    },
    {
      "$ref": "https://ace.local/protocol/v1/TransferCommit.json"
    },
    {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "cancel",
