{
  "$id": "https://ace.local/protocol/v1/BrowserArtifact.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "bytes": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "filename": {
      "maxLength": 256,
      "type": "string"
    },
    "flags": {
      "items": {
        "enum": [
          "executable",
          "archive"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "mimeType": {
      "type": "string"
    },
    "path": {
      "type": "string"
    }
  },
  "required": [
    "path",
    "mimeType",
    "bytes"
  ],
  "type": "object"
}
