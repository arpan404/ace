{
  "$id": "https://ace.local/protocol/v1/OffshiftStep.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    },
    "note": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "$ref": "https://ace.local/protocol/v1/OffshiftPhase.json"
    },
    "state": {
      "$ref": "https://ace.local/protocol/v1/OffshiftStepState.json"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "phase",
    "state"
  ],
  "type": "object"
}
