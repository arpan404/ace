{
  "$id": "https://ace.local/protocol/v1/ace_thread_message.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "delivery": {
      "default": "queue",
      "enum": [
        "queue",
        "steer",
        "restart"
      ],
      "type": "string"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    },
    "text": {
      "$ref": "https://ace.local/protocol/v1/MessageText.json"
    },
    "threadId": {
      "$ref": "https://ace.local/protocol/v1/ThreadId.json"
    }
  },
  "required": [
    "threadId",
    "requestId",
    "text"
  ],
  "type": "object"
}
