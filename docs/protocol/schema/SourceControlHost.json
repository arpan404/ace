{
  "$id": "https://ace.local/protocol/v1/SourceControlHost.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "account": {
      "$ref": "https://ace.local/protocol/v1/ForgeAccount.json"
    },
    "forge": {
      "enum": [
        "github",
        "gitlab",
        "gitbucket",
        "bitbucket",
        "gitea",
        "forgejo",
        "origin"
      ],
      "type": "string"
    },
    "host": {
      "$ref": "https://ace.local/protocol/v1/GitHubHost.json"
    }
  },
  "required": [
    "host"
  ],
  "type": "object"
}
