{
  "$id": "https://ace.local/protocol/v1/ForgeLatestReview.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "avatarUrl": {
      "maxLength": 65536,
      "type": "string"
    },
    "id": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "login": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "state": {
      "enum": [
        "APPROVED",
        "CHANGES_REQUESTED",
        "COMMENTED",
        "DISMISSED",
        "PENDING"
      ],
      "type": "string"
    },
    "submittedAt": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "login",
    "state",
    "submittedAt"
  ],
  "type": "object"
}
