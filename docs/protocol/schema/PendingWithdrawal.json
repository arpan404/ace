{
  "$id": "https://ace.local/protocol/v1/PendingWithdrawal.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "at": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "hash": {
      "$ref": "https://ace.local/protocol/v1/MarketHash.json"
    },
    "name": {
      "$ref": "https://ace.local/protocol/v1/MarketEntryName.json"
    },
    "reason": {
      "maxLength": 500,
      "type": "string"
    },
    "type": {
      "$ref": "https://ace.local/protocol/v1/MarketEntryType.json"
    },
    "version": {
      "$ref": "https://ace.local/protocol/v1/MarketVersion.json"
    }
  },
  "required": [
    "type",
    "name",
    "version",
    "hash",
    "reason",
    "at"
  ],
  "type": "object"
}
