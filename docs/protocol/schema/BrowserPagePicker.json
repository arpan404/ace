{
  "$id": "https://ace.local/protocol/v1/BrowserPagePicker.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "kind": {
      "$ref": "https://ace.local/protocol/v1/BrowserPickerKind.json"
    },
    "max": {
      "maxLength": 64,
      "type": "string"
    },
    "min": {
      "maxLength": 64,
      "type": "string"
    },
    "options": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/BrowserPickerOption.json"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "pickerId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "rect": {
      "$ref": "https://ace.local/protocol/v1/BrowserPageRect.json"
    },
    "step": {
      "maxLength": 64,
      "type": "string"
    },
    "value": {
      "maxLength": 4096,
      "type": "string"
    }
  },
  "required": [
    "pickerId",
    "kind",
    "rect",
    "value"
  ],
  "type": "object"
}
