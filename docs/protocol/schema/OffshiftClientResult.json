{
  "$id": "https://ace.local/protocol/v1/OffshiftClientResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "error": {
      "enum": [
        "forbidden",
        "not_found",
        "conflict",
        "invalid",
        "unavailable"
      ],
      "type": "string"
    },
    "message": {
      "maxLength": 1024,
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "requestId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "offshift.result",
      "type": "string"
    },
    "view": {
      "$ref": "https://ace.local/protocol/v1/OffshiftView.json"
    }
  },
  "required": [
    "type",
    "requestId",
    "ok"
  ],
  "type": "object"
}
