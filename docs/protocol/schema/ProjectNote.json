{
  "$id": "https://ace.local/protocol/v1/ProjectNote.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "createdAt": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "text": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "threadId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "text",
    "createdAt"
  ],
  "type": "object"
}
