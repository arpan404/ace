{
  "$id": "https://ace.local/protocol/v1/ace_thread_start.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access": {
      "$ref": "https://ace.local/protocol/v1/AccessRequest.json"
    },
    "accountId": {
      "$ref": "https://ace.local/protocol/v1/AccountInstanceId.json"
    },
    "acpAgentId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "effort": {
      "anyOf": [
        {
          "const": "inherit",
          "type": "string"
        },
        {
          "$ref": "https://ace.local/protocol/v1/AgentEffort.json"
        }
      ]
    },
    "installationId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "instanceId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "model": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "options": {
      "$ref": "https://ace.local/protocol/v1/AgentServiceOptions.json"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    },
    "text": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "workspace": {
      "$ref": "https://ace.local/protocol/v1/AgentWorkspace.json"
    }
  },
  "required": [
    "requestId",
    "title",
    "text",
    "workspace",
    "provider"
  ],
  "type": "object"
}
