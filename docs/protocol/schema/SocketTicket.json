{
  "$id": "https://ace.local/protocol/v1/SocketTicket.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "expiresAt": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "ticket": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "ticket",
    "expiresAt"
  ],
  "type": "object"
}
