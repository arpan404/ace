  "additionalProperties": false,
  "properties": {
    "html": {
      "$ref": "https://ace.local/protocol/v1/HtmlDocument.json"
    },
    "mode": {
      "$ref": "https://ace.local/protocol/v1/HtmlMode.json"
    },
    "scheme": {
      "$ref": "https://ace.local/protocol/v1/HtmlColorScheme.json"
    },
    "widths": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/HtmlPreviewWidth.json"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "html"
  ],
  "type": "object"
}
