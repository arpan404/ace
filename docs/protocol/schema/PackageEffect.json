{
  "$id": "https://ace.local/protocol/v1/PackageEffect.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "effect": {
      "$ref": "https://ace.local/protocol/v1/PackageEffectWord.json"
    },
    "grant": {
      "$ref": "https://ace.local/protocol/v1/PackageGrant.json"
    },
    "hosts": {
      "items": {
        "maxLength": 260,
        "pattern": "^(?:\\*\\.)?(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?::\\d{1,5})?$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "why": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string",
      "x-ace-constraint": "Leading and trailing whitespace is removed before the length limits apply."
    }
  },
  "required": [
    "effect",
    "why"
  ],
  "type": "object"
}
