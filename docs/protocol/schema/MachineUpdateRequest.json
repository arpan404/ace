{
  "$id": "https://ace.local/protocol/v1/MachineUpdateRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agents": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "mode": {
      "enum": [
        "idle",
        "now"
      ],
      "type": "string"
    },
    "operation": {
      "enum": [
        "status",
        "check",
        "start",
        "cancel"
      ],
      "type": "string"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "machineUpdate.request",
      "type": "string"
    },
    "version": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "type",
    "requestId",
    "operation"
  ],
  "type": "object"
}
