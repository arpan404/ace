{
  "$id": "https://ace.local/protocol/v1/ConductorBrief.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "acceptance": {
      "items": {
        "maxLength": 16384,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true,
      "x-ace-constraint": "Acceptance criteria must be distinct."
    },
    "files": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string",
        "x-ace-constraint": "Must be a repository-relative path or .; no absolute path, backslash, .. segments, empty segments, . segments, C0 controls or glob characters * ? [ ]."
      },
      "maxItems": 128,
      "type": "array"
    },
    "instructions": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    },
    "objective": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    },
    "packages": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string",
        "x-ace-constraint": "Must be a repository-relative path or .; no absolute path, backslash, .. segments, empty segments, . segments, C0 controls or glob characters * ? [ ]."
      },
      "maxItems": 128,
      "type": "array"
    },
    "risks": {
      "items": {
        "maxLength": 16384,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    }
  },
  "required": [
    "objective",
    "instructions",
    "acceptance",
    "files",
    "packages",
    "risks"
  ],
  "type": "object"
}
