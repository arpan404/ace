{
  "$id": "https://ace.local/protocol/v1/SettingsDocument.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {
    "$ref": "https://ace.local/protocol/v1/JsonValue.json"
  },
  "properties": {
    "settings": {
      "additionalProperties": {
        "$ref": "https://ace.local/protocol/v1/JsonValue.json"
      },
      "properties": {
        "access.defaultMode": {
          "$ref": "https://ace.local/protocol/v1/AccessMode.json"
        },
        "access.nativeModes": {
          "additionalProperties": {
            "$ref": "https://ace.local/protocol/v1/PermissionMode.json"
          },
          "propertyNames": {
            "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
          },
          "type": "object"
        },
        "agents.maxRunningChildren": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "automations.enabled": {
          "type": "boolean"
        },
        "browser.backend": {
          "enum": [
            "auto",
            "embedded",
            "headless"
          ],
          "type": "string"
        },
        "browser.backendLoss": {
          "enum": [
            "pause",
            "headless"
          ],
          "type": "string"
        },
        "browser.downloadDefault": {
          "maxLength": 4096,
          "type": "string"
        },
        "browser.downloadDir": {
          "maxLength": 4096,
          "type": "string"
        },
        "browser.profile": {
          "enum": [
            "persistent",
            "ephemeral"
          ],
          "type": "string"
        },
        "browser.profileScope": {
          "$ref": "https://ace.local/protocol/v1/BrowserProfileScope.json"
        },
        "browser.userChrome.storageReads": {
          "type": "boolean"
        },
        "clients.keybindings": {
          "$ref": "https://ace.local/protocol/v1/JsonValue.json"
        },
        "clients.theme": {
          "$ref": "https://ace.local/protocol/v1/JsonValue.json"
        },
        "computer.blockedApps": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 200,
          "type": "array"
        },
        "computer.lockedUse": {
          "type": "boolean"
        },
        "devices.emulatorWindow": {
          "type": "boolean"
        },
        "generation.autoDraftCommits": {
          "type": "boolean"
        },
        "generation.model": {
          "anyOf": [
            {
              "$ref": "https://ace.local/protocol/v1/UtilityModelChoice.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "host.displayName": {
          "maxLength": 256,
          "type": "string"
        },
        "host.icon": {
          "$ref": "https://ace.local/protocol/v1/MachineIcon.json"
        },
        "logs.maxBytes": {
          "$ref": "https://ace.local/protocol/v1/LogMaxBytes.json"
        },
        "projects.roots": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "providers.coder.model": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "providers.coder.provider": {
          "anyOf": [
            {
              "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "providers.coder.reasoningEffort": {
          "enum": [
            "default",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "type": "string"
        },
        "providers.coder.tier": {
          "enum": [
            "default",
            "standard",
            "fast",
            "flex",
            "priority"
          ],
          "type": "string"
        },
        "providers.configuration": {
          "$ref": "https://ace.local/protocol/v1/ProviderConfigurations.json"
        },
        "providers.default": {
          "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
        },
        "providers.planner.model": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "providers.planner.provider": {
          "anyOf": [
            {
              "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "providers.planner.reasoningEffort": {
          "enum": [
            "default",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "type": "string"
        },
        "providers.planner.tier": {
          "enum": [
            "default",
            "standard",
            "fast",
            "flex",
            "priority"
          ],
          "type": "string"
        },
        "providers.reviewer.model": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "providers.reviewer.provider": {
          "anyOf": [
            {
              "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "providers.reviewer.reasoningEffort": {
          "enum": [
            "default",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "type": "string"
        },
        "providers.reviewer.tier": {
          "enum": [
            "default",
            "standard",
            "fast",
            "flex",
            "priority"
          ],
          "type": "string"
        },
        "providers.verifier.model": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "providers.verifier.provider": {
          "anyOf": [
            {
              "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "providers.verifier.reasoningEffort": {
          "enum": [
            "default",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "type": "string"
        },
        "providers.verifier.tier": {
          "enum": [
            "default",
            "standard",
            "fast",
            "flex",
            "priority"
          ],
          "type": "string"
        },
        "remote.agentAccess": {
          "enum": [
            "off",
            "read",
            "operate"
          ],
          "type": "string"
        },
        "remote.agentTransfers": {
          "type": "boolean"
        },
        "remote.enabled": {
          "type": "boolean"
        },
        "remote.hostedPairingLink": {
          "type": "boolean"
        },
        "remote.relayUrl": {
          "examples": [
            "",
            "wss://relay.example.invalid/"
          ],
          "maxLength": 2048,
          "type": "string",
          "x-ace-constraint": "Empty, or a credential-free WSS relay URL without query or fragment. WS is allowed only on 127.0.0.1."
        },
        "remote.transferIgnoredFiles": {
          "type": "boolean"
        },
        "remote.transport": {
          "enum": [
            "local",
            "lan",
            "tailscale",
            "relay"
          ],
          "type": "string"
        },
        "sourceControl.preferences": {
          "$ref": "https://ace.local/protocol/v1/SourceControlPreferences.json"
        },
        "storage.backupWorktrees": {
          "type": "boolean"
        },
        "storage.retention": {
          "$ref": "https://ace.local/protocol/v1/StorageRetention.json"
        },
        "storage.retentionDays": {
          "$ref": "https://ace.local/protocol/v1/RetentionDays.json"
        },
        "storage.scheduledCleanup": {
          "type": "boolean"
        },
        "storage.worktreeRetentionDays": {
          "anyOf": [
            {
              "$ref": "https://ace.local/protocol/v1/RetentionDays.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "threads.autoSettleAfter": {
          "enum": [
            "1d",
            "2d",
            "1w",
            "never"
          ],
          "type": "string"
        },
        "threads.followUpBehavior": {
          "enum": [
            "steer",
            "queue"
          ],
          "type": "string"
        },
        "threads.forkOnSwitch": {
          "type": "boolean"
        },
        "threads.limitPolicy": {
          "enum": [
            "manual",
            "resume_at_reset",
            "snooze_until_reset",
            "migrate_now"
          ],
          "type": "string"
        },
        "threads.settleOnClose": {
          "type": "boolean"
        },
        "threads.settleOnMerge": {
          "type": "boolean"
        },
        "threads.sortBy": {
          "enum": [
            "activity",
            "created",
            "manual"
          ],
          "type": "string"
        },
        "threads.unresponsiveAfter": {
          "enum": [
            "2m",
            "5m",
            "15m"
          ],
          "type": "string"
        },
        "threads.useWorktree": {
          "type": "boolean"
        },
        "worktree.preparationTimeoutMs": {
          "maximum": 3600000,
          "minimum": 60000,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "version": {
      "const": 2,
      "type": "number"
    }
  },
  "required": [
    "version",
    "settings"
  ],
  "type": "object"
}
