{
  "$id": "https://ace.local/protocol/v1/SettingsDocument.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {
    "$ref": "https://ace.local/protocol/v1/SharedDefinitions.json#/$defs/schema7"
  },
  "properties": {
    "settings": {
      "additionalProperties": {
        "$ref": "https://ace.local/protocol/v1/SharedDefinitions.json#/$defs/schema6"
      },
      "properties": {
        "approvals.policy": {
          "enum": [
            "ask",
            "on-failure",
            "never"
          ],
          "type": "string"
        },
        "automations.enabled": {
          "type": "boolean"
        },
        "browser.allowedOrigins": {
          "items": {
            "$ref": "https://ace.local/protocol/v1/BrowserOrigin.json"
          },
          "maxItems": 256,
          "type": "array"
        },
        "browser.backend": {
          "enum": [
            "auto",
            "embedded",
            "headless"
          ],
          "type": "string"
        },
        "browser.backendLoss": {
          "enum": [
            "pause",
            "headless"
          ],
          "type": "string"
        },
        "browser.profile": {
          "enum": [
            "persistent",
            "ephemeral"
          ],
          "type": "string"
        },
        "clients.keybindings": {
          "$ref": "https://ace.local/protocol/v1/SharedDefinitions.json#/$defs/schema5"
        },
        "clients.theme": {
          "$ref": "https://ace.local/protocol/v1/SharedDefinitions.json#/$defs/schema4"
        },
        "host.displayName": {
          "maxLength": 256,
          "type": "string"
        },
        "permissions.defaultMode": {
          "anyOf": [
            {
              "$ref": "https://ace.local/protocol/v1/PermissionMode.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions.providerModes": {
          "additionalProperties": {
            "$ref": "https://ace.local/protocol/v1/PermissionMode.json"
          },
          "propertyNames": {
            "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
          },
          "type": "object"
        },
        "projects.roots": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "providers.coder.model": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "providers.coder.provider": {
          "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
        },
        "providers.coder.reasoningEffort": {
          "enum": [
            "default",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "type": "string"
        },
        "providers.coder.tier": {
          "enum": [
            "default",
            "standard",
            "fast",
            "flex",
            "priority"
          ],
          "type": "string"
        },
        "providers.configuration": {
          "$ref": "https://ace.local/protocol/v1/ProviderConfigurations.json"
        },
        "providers.default": {
          "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
        },
        "providers.planner.model": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "providers.planner.provider": {
          "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
        },
        "providers.planner.reasoningEffort": {
          "enum": [
            "default",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "type": "string"
        },
        "providers.planner.tier": {
          "enum": [
            "default",
            "standard",
            "fast",
            "flex",
            "priority"
          ],
          "type": "string"
        },
        "providers.reviewer.model": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "providers.reviewer.provider": {
          "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
        },
        "providers.reviewer.reasoningEffort": {
          "enum": [
            "default",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "type": "string"
        },
        "providers.reviewer.tier": {
          "enum": [
            "default",
            "standard",
            "fast",
            "flex",
            "priority"
          ],
          "type": "string"
        },
        "remote.enabled": {
          "type": "boolean"
        },
        "remote.transport": {
          "enum": [
            "local",
            "lan",
            "tailscale",
            "relay"
          ],
          "type": "string"
        },
        "threads.autoSettleAfter": {
          "enum": [
            "1d",
            "2d",
            "1w",
            "never"
          ],
          "type": "string"
        },
        "threads.continueAfterRestart": {
          "type": "boolean"
        },
        "threads.followUpBehavior": {
          "enum": [
            "steer",
            "queue"
          ],
          "type": "string"
        },
        "threads.limitPolicy": {
          "enum": [
            "manual",
            "resume_at_reset",
            "snooze_until_reset",
            "migrate_now"
          ],
          "type": "string"
        },
        "threads.settleOnClose": {
          "type": "boolean"
        },
        "threads.settleOnMerge": {
          "type": "boolean"
        },
        "threads.unresponsiveAfter": {
          "enum": [
            "2m",
            "5m",
            "15m"
          ],
          "type": "string"
        },
        "threads.useWorktree": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "version": {
      "const": 2,
      "type": "number"
    }
  },
  "required": [
    "version",
    "settings"
  ],
  "type": "object"
}
