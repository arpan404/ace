{
  "$id": "https://ace.local/protocol/v1/agent_cancel.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "description": "Any stable id; repeating a call with it runs once.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "type": "string"
    },
    "threadId": {
      "description": "A child's threadId, from delegate or agents_status.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "requestId"
  ],
  "type": "object"
}
