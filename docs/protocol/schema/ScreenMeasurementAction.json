{
  "$id": "https://ace.local/protocol/v1/ScreenMeasurementAction.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "button": {
          "default": "left",
          "enum": [
            "left",
            "right"
          ],
          "type": "string"
        },
        "kind": {
          "const": "pointer.click",
          "type": "string"
        },
        "x": {
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "x",
        "y"
      ],
      "type": "object"
    },
    {
      "properties": {
        "button": {
          "default": "left",
          "enum": [
            "left",
            "right"
          ],
          "type": "string"
        },
        "durationMs": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "const": "pointer.drag",
          "type": "string"
        },
        "toX": {
          "minimum": 0,
          "type": "number"
        },
        "toY": {
          "minimum": 0,
          "type": "number"
        },
        "x": {
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "x",
        "y",
        "toX",
        "toY"
      ],
      "type": "object"
    },
    {
      "properties": {
        "key": {
          "$ref": "https://ace.local/protocol/v1/ScreenKey.json"
        },
        "kind": {
          "const": "key.press",
          "type": "string"
        },
        "modifiers": {
          "$ref": "https://ace.local/protocol/v1/ScreenKeyModifiers.json"
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "text.type",
          "type": "string"
        },
        "text": {
          "maxLength": 4096,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "type": "object"
    },
    {
      "properties": {
        "dx": {
          "maximum": 1000,
          "minimum": -1000,
          "type": "integer"
        },
        "dy": {
          "maximum": 1000,
          "minimum": -1000,
          "type": "integer"
        },
        "kind": {
          "const": "scroll",
          "type": "string"
        },
        "x": {
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "dx",
        "dy"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "text.paste",
          "type": "string"
        },
        "text": {
          "maxLength": 4096,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "type": "object"
    }
  ]
}
