{
  "$id": "https://ace.local/protocol/v1/NativeRef.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "acpAgentId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "aliases": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "forkedFromNativeId": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "installationId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "instanceId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "nativeId": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    }
  },
  "required": [
    "provider"
  ],
  "type": "object"
}
