{
  "$id": "https://ace.local/protocol/v1/BrowserInteractionAction.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "click",
          "type": "string"
        },
        "ref": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "action",
        "ref"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "type",
          "type": "string"
        },
        "ref": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "text": {
          "maxLength": 65536,
          "type": "string"
        }
      },
      "required": [
        "action",
        "ref",
        "text"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "press",
          "type": "string"
        },
        "key": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "ref": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "action",
        "key"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "scroll",
          "type": "string"
        },
        "x": {
          "maximum": 100000,
          "minimum": -100000,
          "type": "number"
        },
        "y": {
          "maximum": 100000,
          "minimum": -100000,
          "type": "number"
        }
      },
      "required": [
        "action",
        "x",
        "y"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "drag",
          "type": "string"
        },
        "ref": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "toRef": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "action",
        "ref",
        "toRef"
      ],
      "type": "object"
    }
  ]
}
