{
  "$id": "https://ace.local/protocol/v1/MarketBotUpdate.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asksMore": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    },
    "bot": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
    },
    "plan": {
      "$ref": "https://ace.local/protocol/v1/PackagePlan.json"
    },
    "rollback": {
      "type": "boolean"
    }
  },
  "required": [
    "bot",
    "rollback",
    "plan",
    "asksMore"
  ],
  "type": "object"
}
