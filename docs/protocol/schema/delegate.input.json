{
  "$id": "https://ace.local/protocol/v1/delegate.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "tasks": {
      "description": "One per child.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "access": {
            "$ref": "https://ace.local/protocol/v1/AccessRequest.json",
            "description": "Default inherit; never above yours."
          },
          "accountId": {
            "description": "Account id or label.",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "effort": {
            "description": "e.g. low, high, xhigh. Default: yours on the same model.",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "machine": {
            "$ref": "https://ace.local/protocol/v1/MachineName.json",
            "description": "From machines; needs project."
          },
          "model": {
            "description": "Id or name, e.g. \"opus 5.5\".",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "project": {
            "description": "Its project in machines.",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "provider": {
            "$ref": "https://ace.local/protocol/v1/ProviderKind.json",
            "description": "Default: yours, or the one serving model."
          },
          "requestId": {
            "description": "Any stable id; a repeat with it runs once.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "type": "string"
          },
          "role": {
            "description": "Unique name saying what and where: 'Fix-869-toast', never 'Implementer'.",
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "runRole": {
            "$ref": "https://ace.local/protocol/v1/RunRole.json",
            "description": "A role from your Roles line."
          },
          "task": {
            "description": "Goal, files, constraints, how to verify: the child sees none of your conversation.",
            "maxLength": 262144,
            "minLength": 1,
            "type": "string"
          },
          "workspace": {
            "$ref": "https://ace.local/protocol/v1/AgentWorkspace.json"
          }
        },
        "required": [
          "requestId",
          "task",
          "role"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "waitFor": {
      "$ref": "https://ace.local/protocol/v1/WaitMode.json",
      "default": "all",
      "description": "any returns on the first."
    },
    "waitSeconds": {
      "$ref": "https://ace.local/protocol/v1/WaitTimeoutSeconds.json",
      "description": "Wait for results, as wait does. Omit to return at once."
    }
  },
  "required": [
    "tasks"
  ],
  "type": "object"
}
