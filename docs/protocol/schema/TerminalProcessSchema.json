{
  "$id": "https://ace.local/protocol/v1/TerminalProcessSchema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "group": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "owner": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "pid": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "state": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "pid",
    "group",
    "state",
    "owner"
  ],
  "type": "object"
}
