{
  "$id": "https://ace.local/protocol/v1/PublishAccepted.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "hash": {
      "$ref": "https://ace.local/protocol/v1/MarketHash.json"
    },
    "held": {
      "type": "boolean"
    },
    "name": {
      "$ref": "https://ace.local/protocol/v1/MarketEntryName.json"
    },
    "scan": {
      "$ref": "https://ace.local/protocol/v1/MarketScanReport.json"
    },
    "status": {
      "const": "pending",
      "type": "string"
    },
    "type": {
      "$ref": "https://ace.local/protocol/v1/MarketEntryType.json"
    },
    "version": {
      "$ref": "https://ace.local/protocol/v1/MarketVersion.json"
    }
  },
  "required": [
    "status",
    "type",
    "name",
    "version",
    "hash"
  ],
  "type": "object"
}
