{
  "$id": "https://ace.local/protocol/v1/TodoEntry.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "content": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "required": [
    "content",
    "status"
  ],
  "type": "object"
}
