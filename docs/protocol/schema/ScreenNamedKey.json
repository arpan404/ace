{
  "$id": "https://ace.local/protocol/v1/ScreenNamedKey.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "key": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "modifiers": {
      "default": [],
      "items": {
        "enum": [
          "control",
          "shift",
          "alt",
          "meta",
          "super",
          "command",
          "option"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "type": "array"
    }
  },
  "required": [
    "key"
  ],
  "type": "object"
}
