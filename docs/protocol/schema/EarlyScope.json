{
  "$id": "https://ace.local/protocol/v1/EarlyScope.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "thread",
          "type": "string"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        }
      },
      "required": [
        "kind",
        "threadId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "threads",
          "type": "string"
        },
        "window": {
          "additionalProperties": false,
          "properties": {
            "archived": {
              "type": "boolean"
            },
            "limit": {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            "project": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "limit"
          ],
          "type": "object"
        }
      },
      "required": [
        "kind",
        "window"
      ],
      "type": "object"
    }
  ]
}
