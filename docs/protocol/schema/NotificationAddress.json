{
  "$id": "https://ace.local/protocol/v1/NotificationAddress.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "channel": {
          "const": "websocket",
          "type": "string"
        },
        "platform": {
          "enum": [
            "desktop",
            "web",
            "phone"
          ],
          "type": "string"
        }
      },
      "required": [
        "channel",
        "platform"
      ],
      "type": "object"
    },
    {
      "properties": {
        "channel": {
          "const": "webpush",
          "type": "string"
        },
        "platform": {
          "enum": [
            "web",
            "phone"
          ],
          "type": "string"
        },
        "subscription": {
          "$ref": "https://ace.local/protocol/v1/WebPushSubscription.json"
        }
      },
      "required": [
        "channel",
        "platform",
        "subscription"
      ],
      "type": "object"
    },
    {
      "properties": {
        "channel": {
          "const": "apns",
          "type": "string"
        },
        "platform": {
          "const": "phone",
          "type": "string"
        },
        "token": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "platform",
        "token"
      ],
      "type": "object"
    },
    {
      "properties": {
        "auth": {
          "pattern": "^[A-Za-z0-9_-]{22}$",
          "type": "string"
        },
        "channel": {
          "const": "push",
          "type": "string"
        },
        "environment": {
          "enum": [
            "sandbox",
            "production"
          ],
          "type": "string"
        },
        "p256dh": {
          "pattern": "^[A-Za-z0-9_-]{87}$",
          "type": "string"
        },
        "platform": {
          "const": "phone",
          "type": "string"
        },
        "token": {
          "pattern": "^[a-fA-F0-9]{16,400}$",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "platform",
        "token",
        "environment",
        "p256dh",
        "auth"
      ],
      "type": "object"
    },
    {
      "properties": {
        "channel": {
          "const": "fcm",
          "type": "string"
        },
        "platform": {
          "const": "phone",
          "type": "string"
        },
        "token": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "channel",
        "platform",
        "token"
      ],
      "type": "object"
    }
  ]
}
