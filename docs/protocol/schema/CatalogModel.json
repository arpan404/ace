{
  "$id": "https://ace.local/protocol/v1/CatalogModel.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "acpAgentId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "aliases": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "contextWindow": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "custom": {
      "type": "boolean"
    },
    "defaultEffort": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "defaultSource": {
      "enum": [
        "built-in",
        "user"
      ],
      "type": "string"
    },
    "defaultTier": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "deprecated": {
      "type": "boolean"
    },
    "displayName": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "favourite": {
      "type": "boolean"
    },
    "group": {
      "enum": [
        "current",
        "legacy"
      ],
      "type": "string"
    },
    "hidden": {
      "type": "boolean"
    },
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "inputModalities": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "installationId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "instance": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "instanceId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "isDefault": {
      "type": "boolean"
    },
    "isNew": {
      "type": "boolean"
    },
    "legacy": {
      "type": "boolean"
    },
    "modelConfigId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "nativeModelId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "nativeProviderId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "provider": {
      "$ref": "https://ace.local/protocol/v1/ProviderKind.json"
    },
    "providerEnabled": {
      "type": "boolean"
    },
    "raw": {
      "properties": {
        "json": {
          "maxLength": 2048,
          "type": "string",
          "x-ace-constraint": "UTF-8 encoding must be at most 2048 bytes."
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "json",
        "truncated"
      ],
      "type": "object"
    },
    "reasoningEfforts": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "resolvedModelId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "selectorMethod": {
      "enum": [
        "session/set_config_option",
        "session/set_model"
      ],
      "type": "string"
    },
    "serviceTiers": {
      "items": {
        "$ref": "https://ace.local/protocol/v1/ModelTier.json"
      },
      "maxItems": 32,
      "type": "array"
    },
    "visibilityReason": {
      "enum": [
        "provider_disabled",
        "group_hidden",
        "model_hidden",
        "deprecated",
        "not_favourite",
        "provider_hidden"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "displayName",
    "provider",
    "instance",
    "nativeModelId",
    "reasoningEfforts",
    "serviceTiers",
    "inputModalities",
    "isDefault",
    "hidden",
    "deprecated",
    "raw"
  ],
  "type": "object",
  "x-ace-constraint": "The parsed model with defaults filled and unknown fields stripped must serialize to at most 8192 UTF-8 bytes of compact JSON."
}
