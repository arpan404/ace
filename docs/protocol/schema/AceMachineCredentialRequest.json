{
  "$id": "https://ace.local/protocol/v1/AceMachineCredentialRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "credential": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "exposed": {
      "type": "boolean"
    },
    "hostId": {
      "pattern": "^[A-Z2-7]{52}$",
      "type": "string"
    },
    "hostKey": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "proof": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "sole": {
      "type": "boolean"
    },
    "ticket": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    }
  },
  "required": [
    "hostId",
    "hostKey",
    "credential",
    "proof"
  ],
  "type": "object"
}
