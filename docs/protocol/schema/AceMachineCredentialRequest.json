{
  "$id": "https://ace.local/protocol/v1/AceMachineCredentialRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "exposed": {
      "type": "boolean"
    },
    "hostId": {
      "pattern": "^[A-Z2-7]{52}$",
      "type": "string"
    },
    "sole": {
      "type": "boolean"
    }
  },
  "required": [
    "hostId"
  ],
  "type": "object"
}
