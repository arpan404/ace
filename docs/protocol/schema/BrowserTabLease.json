{
  "$id": "https://ace.local/protocol/v1/BrowserTabLease.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "controller": {
      "enum": [
        "agent",
        "human",
        "none"
      ],
      "type": "string"
    },
    "mode": {
      "enum": [
        "shared",
        "private"
      ],
      "type": "string"
    },
    "owner": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "controller",
    "mode"
  ],
  "type": "object"
}
