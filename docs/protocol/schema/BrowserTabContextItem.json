{
  "$id": "https://ace.local/protocol/v1/BrowserTabContextItem.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "tabId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "maxLength": 1024,
      "type": "string"
    },
    "type": {
      "const": "browser_tab",
      "type": "string"
    },
    "url": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "type",
    "tabId",
    "url",
    "title"
  ],
  "type": "object"
}
