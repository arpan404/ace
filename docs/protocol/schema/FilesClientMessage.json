{
  "$id": "https://ace.local/protocol/v1/FilesClientMessage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "sourceRequestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "files.abort",
          "type": "string"
        }
      },
      "required": [
        "type",
        "sourceRequestId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "channel": {
          "exclusiveMinimum": 0,
          "maximum": 4294967295,
          "type": "integer"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "files.pull",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "channel"
      ],
      "type": "object"
    },
    {
      "properties": {
        "channel": {
          "exclusiveMinimum": 0,
          "maximum": 4294967295,
          "type": "integer"
        },
        "data": {
          "maxLength": 87384,
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "type": "string"
        },
        "offset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "files.chunk",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "channel",
        "offset",
        "data"
      ],
      "type": "object"
    },
    {
      "properties": {
        "operation": {
          "$ref": "https://ace.local/protocol/v1/FileOperation.json"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "threadId": {
          "$ref": "https://ace.local/protocol/v1/ThreadId.json"
        },
        "type": {
          "const": "files.request",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "operation"
      ],
      "type": "object"
    },
    {
      "properties": {
        "channel": {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "credits": {
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "files.credit",
          "type": "string"
        }
      },
      "required": [
        "type",
        "channel",
        "credits"
      ],
      "type": "object"
    },
    {
      "properties": {
        "channel": {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "files.cancel",
          "type": "string"
        }
      },
      "required": [
        "type",
        "channel"
      ],
      "type": "object"
    }
  ]
}
