{
  "$id": "https://ace.local/protocol/v1/MachineAccountStatus.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "account": {
      "$ref": "https://ace.local/protocol/v1/AceAccount.json"
    },
    "expiresAt": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "login": {
      "properties": {
        "expiresAt": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "url": {
          "format": "ace-whatwg-url",
          "type": "string",
          "x-ace-constraint": "Accept strings whose trimmed value is an absolute WHATWG URL. Whitespace, Unicode hosts, opaque schemes and parser-normalized URLs are allowed. x-ace-url-minLength and x-ace-url-maxLength apply after trimming whitespace and removing ASCII tab, CR and LF characters, using UTF-16 code units. Install the ace-whatwg-url format validator or enforce this rule in application code."
        }
      },
      "required": [
        "url",
        "expiresAt"
      ],
      "type": "object"
    },
    "machineCode": {
      "properties": {
        "lockedUntil": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "set": {
          "type": "boolean"
        }
      },
      "required": [
        "set"
      ],
      "type": "object"
    },
    "origin": {
      "maxLength": 2048,
      "type": "string"
    },
    "signedIn": {
      "type": "boolean"
    }
  },
  "required": [
    "signedIn",
    "machineCode"
  ],
  "type": "object"
}
