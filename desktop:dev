#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT="${ACE_PORT:-3773}"
HOST="127.0.0.1"
BACKEND_PID=""
STARTED_BACKEND=0

cleanup() {
  if [[ "${STARTED_BACKEND}" == "1" && -n "${BACKEND_PID}" ]]; then
    kill "${BACKEND_PID}" >/dev/null 2>&1 || true
    wait "${BACKEND_PID}" >/dev/null 2>&1 || true
  fi
}

trap cleanup EXIT INT TERM

cd "${ROOT_DIR}"

if nc -z "${HOST}" "${PORT}" >/dev/null 2>&1; then
  echo "ace backend already listening on ${HOST}:${PORT}"
else
  backend_args=(--port "${PORT}")
  if [[ "${ACE_LAN:-}" == "1" || "${ACE_LAN:-}" == "true" ]]; then
    backend_args+=(--lan)
  fi

  CARGO_INCREMENTAL=0 cargo run -p ace-backend -- "${backend_args[@]}" &
  BACKEND_PID="$!"
  STARTED_BACKEND=1

  for _ in {1..100}; do
    if nc -z "${HOST}" "${PORT}" >/dev/null 2>&1; then
      break
    fi
    if ! kill -0 "${BACKEND_PID}" >/dev/null 2>&1; then
      wait "${BACKEND_PID}"
    fi
    sleep 0.1
  done
fi

swift run --package-path apps/desktop AceDesktop
