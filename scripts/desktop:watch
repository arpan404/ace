#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT_DIR}"

if ! command -v cargo-watch >/dev/null 2>&1; then
  echo "cargo-watch is required for desktop:watch." >&2
  echo "Install it with: cargo install cargo-watch" >&2
  exit 127
fi

echo "watching Ace Desktop (Rust GPUI)"
cargo watch \
  --watch Cargo.toml \
  --watch Cargo.lock \
  --watch apps \
  --watch crates \
  --ignore target \
  --shell ./desktop:dev
