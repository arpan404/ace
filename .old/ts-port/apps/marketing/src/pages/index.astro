---
import Layout from "../layouts/Layout.astro";
import MarketingNav from "../components/MarketingNav.astro";
import ProviderIcon from "../components/ProviderIcon.astro";

const providers = [
  { label: "Codex", kind: "codex", url: "https://openai.com/codex" },
  { label: "Claude", kind: "claude", url: "https://claude.ai" },
  { label: "Gemini", kind: "gemini", url: "https://gemini.google.com" },
  { label: "Cursor", kind: "cursor", url: "https://cursor.com" },
  { label: "Pi Coding Agent", kind: "pi", url: "https://pi.dev" },
  { label: "GitHub Copilot", kind: "githubCopilot", url: "https://github.com/features/copilot" },
  { label: "OpenCode", kind: "opencode", url: "https://opencode.ai" },
] as const;

const productHighlights = [
  {
    tag: "Your subscriptions",
    title: "Use the agents you already pay for",
    body: "Connect Codex, Claude, Gemini, Cursor, Pi, GitHub Copilot, and OpenCode. Add personal, work, or extra accounts for the same provider, then switch when one account hits a limit.",
    image: "/product/multiple-providers.webp",
  },
  {
    tag: "Browser & editor",
    title: "Point at what needs fixing",
    body: "Click the UI in the built-in browser and leave a note for the agent. Highlight code in the editor and send that comment into the chat. Less screenshotting, less explaining, fewer repeat instructions.",
    image: "/product/design-mode.webp",
  },
  {
    tag: "Switch agents",
    title: "Move the same thread to another model",
    body: "If Codex is rate-limited, or Claude/Gemini is better for the next step, hand the thread over without starting again. Bring it back later when you want to continue with the original agent.",
    image: "/product/handoff.webp",
  },
  {
    tag: "Parallel work",
    title: "Solve issues and PRs in separate worktrees",
    body: "Open issues or PRs, send each one to its own worktree, and let agents work in parallel. Ace stays responsive while you review diffs, jump between threads, and move fixes forward.",
    image: "/product/parallel-issues.webp",
  },
  {
    tag: "Split chats",
    title: "Keep more than one thread in view",
    body: "Open multiple chat windows and place them side by side. Follow different agents, compare approaches, or keep a long-running task visible while you handle something smaller.",
    image: "/product/split-windows.webp",
  },
  {
    tag: "Codex tools",
    title: "Use Codex plugins, skills, browser-use, and image generation",
    body: "Ace supports Codex plugins and skills, including browser automation and image generation. Agents can control the built-in browser. Similar tools for other providers are coming later.",
    image: "/product/codex-skills-plugins.webp",
  },
  {
    tag: "Tools",
    title: "The basics are built in",
    body: "Review diffs, read AI-generated summaries, use the terminal, and move with keyboard shortcuts. The everyday pieces are in the same place as the agent conversation.",
    image: "/product/summary.webp",
  },
] as const;

const continuityRows = [
  [
    "Connection drops",
    "Reconnect and keep the thread moving.",
  ],
  [
    "State gets messy",
    "Go back to a clean snapshot.",
  ],
  [
    "A turn went wrong",
    "Restore a checkpoint instead of untangling files by hand.",
  ],
] as const;

const faqItems = [
  {
    q: "Which providers does ace support?",
    a: "Codex, Claude, Gemini, Cursor, Pi Coding Agent, GitHub Copilot, and OpenCode. You can sign into more than one account for each provider.",
  },
  {
    q: "Does ace sell model access?",
    a: "No. Bring the accounts, API keys, and CLIs you already use. Ace is the desktop workspace around them.",
  },
  {
    q: "What data does ace collect?",
    a: "We do not track your code, prompts, or files for ads or resale. We may collect anonymous usage stats, like which providers are used most, so we know what to improve first.",
  },
  {
    q: "How is remote access protected?",
    a: "Remote viewing is end-to-end encrypted between the host and the viewer. Use the managed relay or self-host it.",
  },
  {
    q: "Is there a mobile app?",
    a: "Not yet. A mobile app is in active development.",
  },
  {
    q: "Do all providers get Codex plugins and browser control?",
    a: "Today, Codex has the deepest tool support: plugins, skills, browser-use, image generation, and browser control. We plan to bring more of that to other providers over time.",
  },
] as const;

const faqColA = faqItems.slice(0, 3);
const faqColB = faqItems.slice(3);
---

<Layout
  title="ace — multi-provider agent workspace with handoff, browser review, and parallel PRs"
  description="Desktop workspace for Codex, Claude, Gemini, Cursor, Pi, Copilot, and OpenCode. Multiple accounts per provider, handoff between models, browser and editor review, parallel PRs in worktrees, E2E encryption, no prompt tracking."
>
  <div class="home">
    <span class="home__noise" aria-hidden="true"></span>
    <div class="home__grid-ambient" aria-hidden="true"></div>
    <MarketingNav variant="home" />

    <section class="home__hero" aria-labelledby="hero-heading">
      <div class="home__hero-inner">
        <div class="home__hero-copy">
          <p class="home__kicker" data-reveal>
            <span class="home__kicker-dot" aria-hidden="true"></span>
            Open source workspace for your AI coding agents
          </p>
          <h1 id="hero-heading" class="home__title" data-reveal>
            Harness every <span class="home__word home__word--agent">coding agent,</span> <span class="home__word home__word--review">review every change,</span> and ship PRs in <span class="home__word home__word--parallel">parallel.</span>
          </h1>
          <p class="home__subtitle" data-reveal>
            Bring your own Codex, Claude, Gemini, Cursor, GitHub Copilot, Pi, and OpenCode
            subscriptions. Ace gives them one fast workspace.
          </p>
          <div class="home__hero-actions" data-reveal>
            <a id="download-btn" class="home__btn home__btn--primary" href="/download" data-interactive>
              <svg
                class="home__cta-icon home__cta-icon--apple"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 814 1000"
                aria-hidden="true"
              >
                <path
                  fill="currentColor"
                  d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
                />
              </svg>
              <svg
                class="home__cta-icon home__cta-icon--windows"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 88 88"
                aria-hidden="true"
              >
                <path
                  fill="currentColor"
                  d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"
                />
              </svg>
              <span class="home__cta-icon home__cta-icon--linux" aria-hidden="true">Lx</span>
              <span id="download-label">Download ace</span>
            </a>
            <a class="home__btn home__btn--ghost" href="#features">What it does</a>
          </div>
        </div>

        <div class="home__hero-visual" data-scroll-3d data-scroll-strength="0.55" data-reveal>
          <div class="home__frame">
            <div class="home__frame-chrome" aria-hidden="true"></div>
            <img
              src="/product/app-screenshot.webp"
              alt="ace desktop workspace showing a project thread, agent conversation, terminal, browser preview, editor context, and review surfaces together"
              width="3456"
              height="2168"
              loading="eager"
              decoding="async"
              class="home__shot"
            />
          </div>
          <p class="home__frame-caption">
            Seven providers, split chats, browser review, editor comments, worktrees, terminal, and diffs.
          </p>
        </div>
      </div>
    </section>

    <section class="home__stack" aria-labelledby="stack-heading" data-reveal>
      <div class="home__stack-inner">
        <div class="home__stack-copy">
          <h2 id="stack-heading" class="home__stack-title">Use the providers you already have</h2>
        </div>
      </div>
      <div class="home__stack-marquee" aria-label="Compatible providers">
        <div class="home__stack-marquee-track">
          {[...providers, ...providers, ...providers, ...providers].map((p, i) => (
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="home__stack-chip" aria-hidden={i >= providers.length ? "true" : undefined}>
              <span class="home__stack-chip-icon" aria-hidden="true">
                <ProviderIcon kind={p.kind} />
              </span>
              <span class="home__stack-chip-label">{p.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="features" class="home__panel home__panel--features" aria-labelledby="features-heading">
      <div class="home__panel-head" data-reveal>
        <p class="home__label">Product</p>
        <h2 id="features-heading" class="home__h2 home__h2--wide">
          Built for real agentic workloads.
        </h2>
        <p class="home__dek">
          The browser, editor, terminal, diffs, accounts, and PRs stay together, so you spend less
          time wiring tools around the chat.
        </p>
      </div>
      <div class="home__features-list">
        {productHighlights.map((item, index) => (
          <article class={`home__feature-row ${index % 2 === 1 ? 'home__feature-row--reverse' : ''}`} data-reveal>
            <div class="home__feature-visual" aria-hidden="true" data-scroll-3d data-scroll-strength="0.45">
              <img src={item.image} alt="" class="home__feature-img" loading="lazy" decoding="async" />
            </div>
            <div class="home__feature-content">
              <span class="home__highlight-tag">{item.tag}</span>
              <h3 class="home__highlight-title">{item.title}</h3>
              <p class="home__highlight-body">{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="home__handoff-band" aria-label="Example handoff flow" data-reveal>
      <div class="home__handoff-band-inner" data-scroll-3d data-scroll-strength="0.4">
        <p class="home__handoff-band-label">Switch agents when needed</p>
        <p class="home__handoff-band-dek">
          Keep the same thread when one provider is rate-limited or another agent is better for the
          next step.
        </p>
        <div class="home__handoff-row">
          <span><ProviderIcon kind="codex" /><small>Codex</small></span>
          <span class="home__handoff-connector" aria-hidden="true"></span>
          <span><ProviderIcon kind="claude" /><small>Claude</small></span>
          <span class="home__handoff-connector" aria-hidden="true"></span>
          <span><ProviderIcon kind="gemini" /><small>Gemini</small></span>
          <span class="home__handoff-connector" aria-hidden="true"></span>
          <span><ProviderIcon kind="codex" /><small>Back to Codex</small></span>
        </div>
      </div>
    </section>

    <section id="continuity" class="home__panel home__panel--dark" aria-labelledby="continuity-heading">
      <div class="home__reliability-inner">
        <div class="home__panel-head" data-reveal>
          <p class="home__label home__label--on-dark">Recovery</p>
          <h2 id="continuity-heading" class="home__h2 home__h2--on-dark home__h2--wide">
            Pick up where you left off.
          </h2>
          <p class="home__dek home__dek--on-dark">
            If the network drops or a run goes sideways, reconnect and restore without rebuilding
            the whole thread from memory.
          </p>
        </div>
        <ul class="home__ledger" data-reveal>
          {continuityRows.map(([situation, response]) => (
            <li class="home__ledger-row">
              <span class="home__ledger-situation">{situation}</span>
              <span class="home__ledger-arrow" aria-hidden="true"></span>
              <span class="home__ledger-fix">{response}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="trust" class="home__panel home__panel--trust" aria-labelledby="trust-heading">
      <div class="home__trust-top" data-reveal data-scroll-3d data-scroll-strength="0.35">
        <div>
          <p class="home__label">Security & privacy</p>
          <h2 id="trust-heading" class="home__h2 home__h2--wide">
            Private by default, remote when you need it.
          </h2>
          <p class="home__dek">
            Remote viewing is end-to-end encrypted between your machine and the viewer. Use our relay
            or self-host your own. A mobile app is on the way.
          </p>
          <div class="home__trust-privacy">
            <h3 class="home__trust-sub">Privacy</h3>
            <p class="home__dek">
              We do not track your prompts, code, or files for ads or resale. We only use anonymous
              usage stats, like provider usage, to decide what to improve next.
            </p>
          </div>
        </div>
        <div class="home__remote-visual" aria-hidden="true">
          <span>Host & repo</span>
          <i class="home__remote-line"></i>
          <span class="home__remote-pill">E2E encrypted</span>
          <i class="home__remote-line"></i>
          <span>Remote viewers</span>
        </div>
      </div>
    </section>

    <section class="home__panel home__panel--faq" aria-labelledby="faq-heading">
      <div class="home__panel-head" data-reveal>
        <p class="home__label">FAQ</p>
        <h2 id="faq-heading" class="home__h2 home__h2--wide">A few quick answers.</h2>
      </div>
      <div class="home__faq-cols">
        <div class="home__faq-col">
          {faqColA.map((item) => (
            <details data-reveal class="home__faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
        <div class="home__faq-col">
          {faqColB.map((item) => (
            <details data-reveal class="home__faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="home__closing" aria-labelledby="closing-heading">
      <div class="home__closing-inner" data-reveal data-scroll-3d data-scroll-strength="0.45">
        <p class="home__label home__label--on-dark">Get started</p>
        <h2 id="closing-heading" class="home__closing-title">Try ace with the agents you already use.</h2>
        <p class="home__closing-dek">
          Install the app, connect your provider accounts, and keep chat, review, terminal, diffs,
          and PR work in one place.
        </p>
        <div class="home__closing-points" aria-label="Product highlights">
          <span>Open source</span>
          <span>BYO subscriptions</span>
          <span>No prompt tracking</span>
        </div>
        <div class="home__closing-actions">
          <a class="home__btn home__btn--dark" href="/download">
            <span id="download-label-bottom">Download ace</span>
          </a>
          <a
            class="home__btn home__btn--outline-light"
            href="https://github.com/arpan404/ace"
            target="_blank"
            rel="noopener noreferrer"
          >
            Star on GitHub
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  type Platform = { os: "mac" | "win" | "linux"; label: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Download for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Download for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Download for Linux" };
    return null;
  }

  const platform = detectPlatform();
  if (platform) {
    document.documentElement.dataset.platform = platform.os;
    const topLabel = document.getElementById("download-label");
    const bottomLabel = document.getElementById("download-label-bottom");
    if (topLabel) topLabel.textContent = platform.label;
    if (bottomLabel) bottomLabel.textContent = platform.label;
  }
</script>

<style>
  .home {
    --home-pad: var(--site-pad, clamp(1.25rem, 5vw, 2.5rem));
    --home-max: var(--site-max, 1200px);
    position: relative;
    isolation: isolate;
  }

  .home > * {
    position: relative;
    z-index: 1;
  }

  .home strong {
    font-weight: 600;
    color: var(--fg);
  }

  /* —— Hero —— */
  .home__hero {
    padding: clamp(4rem, 10vw, 8rem) var(--home-pad) clamp(3rem, 8vw, 6rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .home__hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: var(--home-max);
    gap: 2.5rem;
    margin: 0 auto;
  }

  .home__hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .home__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
  }

  .home__kicker-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fg);
  }

  .home__title {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-wrap: balance;
    color: var(--fg);
  }

  .home__title-em {
    color: var(--fg-muted);
  }

  .home__word {
    position: relative;
    display: inline-block;
    color: var(--fg);
    white-space: nowrap;
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .home__word--agent {
    animation: word-lift 7s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .home__word--review::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0.02em;
    width: 100%;
    height: 0.055em;
    border-radius: 999px;
    background: currentColor;
    transform: scaleX(0.18);
    transform-origin: left;
    opacity: 0.22;
    animation: word-underline 7s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .home__word--parallel {
    animation: word-track 7s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes word-lift {
    0%,
    78%,
    100% {
      opacity: 1;
      transform: translateY(0);
    }
    12% {
      opacity: 0.88;
      transform: translateY(-0.025em);
    }
  }

  @keyframes word-underline {
    0%,
    66%,
    100% {
      transform: scaleX(0.18);
      opacity: 0.2;
    }
    24%,
    42% {
      transform: scaleX(1);
      opacity: 0.34;
    }
  }

  @keyframes word-track {
    0%,
    100% {
      letter-spacing: inherit;
      transform: translateY(0);
    }
    58% {
      letter-spacing: -0.015em;
      transform: translateY(-0.015em);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home__word,
    .home__word::after {
      animation: none;
    }
  }

  .home__subtitle {
    max-width: 42rem;
    margin-top: 1.25rem;
    color: var(--fg-muted);
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: 1.55;
    text-align: center;
    text-wrap: balance;
  }

  .home__hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .home__btn {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 999px;
    padding: 0.85rem 1.6rem;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1;
    transition:
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .home__btn--primary {
    background: var(--fg);
    color: var(--ink);
    border: 1px solid transparent;
  }

  .home__btn--primary:hover {
    transform: translateY(-1px);
    background: #e0e0e0;
  }

  .home__btn--ghost {
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.03);
    color: var(--fg);
  }

  .home__btn--ghost:hover {
    border-color: var(--fg-muted);
    background: rgba(255, 255, 255, 0.08);
  }

  .home__cta-icon {
    display: none;
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }

  .home__cta-icon--linux {
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
  }

  :global([data-platform="mac"]) .home__cta-icon--apple,
  :global([data-platform="win"]) .home__cta-icon--windows {
    display: block;
  }

  :global([data-platform="linux"]) .home__cta-icon--linux {
    display: inline-grid;
  }

  .home__hero-visual {
    position: relative;
    width: 100%;
    max-width: 1080px;
    margin-top: 2rem;
  }

  .home__frame {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    border: 1px solid var(--line-strong);
    background: #050505;
    padding: 0.6rem;
    box-shadow:
      0 28px 80px rgba(0, 0, 0, 0.72),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .home__frame::after {
    content: "";
    position: absolute;
    inset: 0.6rem;
    border-radius: 16px;
    pointer-events: none;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      inset 0 -80px 120px rgba(0, 0, 0, 0.38);
  }

  .home__shot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    background: var(--surface);
  }

  .home__frame-caption {
    margin-top: 1.5rem;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* —— Stack —— */
  .home__stack {
    position: relative;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg-elevated);
    padding: clamp(3rem, 6vw, 4.5rem) var(--home-pad);
  }

  .home__stack-inner {
    display: flex;
