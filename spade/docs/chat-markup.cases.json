{
  "about": "ADR 0212: how a bot's text splits into chat messages. Both parsers run this table: spade_core::chat_markup (Rust) and @ace/ui-core/spade-chat chat-markup.ts. `live` cases parse text still streaming. A segment's `reply`, `title`, `to` and `open` are absent when unset (open: false). A `react` segment (`<react to=\"m12\">👍</react>`) has the emoji as `text` and the message id as `to`; it takes no message id itself, so ids count only `msg` and `doc` segments.",
  "cases": [
    {
      "name": "text with no tags is one message, as before",
      "text": "Found 3 flights under €100.\n\nThe cheapest leaves at 9:10.",
      "segments": [
        {
          "kind": "msg",
          "text": "Found 3 flights under €100.\n\nThe cheapest leaves at 9:10."
        }
      ]
    },
    {
      "name": "several messages are several bubbles, in order",
      "text": "<msg>Found 3 flights under €100.</msg>\n<msg>The cheapest leaves Tuesday at 9:10.</msg>\n<msg>Want me to hold it?</msg>",
      "segments": [
        {
          "kind": "msg",
          "text": "Found 3 flights under €100."
        },
        {
          "kind": "msg",
          "text": "The cheapest leaves Tuesday at 9:10."
        },
        {
          "kind": "msg",
          "text": "Want me to hold it?"
        }
      ]
    },
    {
      "name": "a reply id is kept",
      "text": "<msg reply=\"m7\">Yes, Tuesday works.</msg>",
      "segments": [
        {
          "kind": "msg",
          "text": "Yes, Tuesday works.",
          "reply": "m7"
        }
      ]
    },
    {
      "name": "a reply id to a later message of a step is kept",
      "text": "<msg reply='m12.3'>That one.</msg>",
      "segments": [
        {
          "kind": "msg",
          "text": "That one.",
          "reply": "m12.3"
        }
      ]
    },
    {
      "name": "a reply that is not an id is dropped",
      "text": "<msg reply=\"the flights one\">Yes.</msg>",
      "segments": [
        {
          "kind": "msg",
          "text": "Yes."
        }
      ]
    },
    {
      "name": "unquoted attributes and unknown attributes are read leniently",
      "text": "<msg id=\"m40\" reply=m3 tone=\"warm\">Sure.</msg>",
      "segments": [
        {
          "kind": "msg",
          "text": "Sure.",
          "reply": "m3"
        }
      ]
    },
    {
      "name": "a document keeps its title and its text",
      "text": "<msg>Here's the plan.</msg>\n<doc title=\"Lisbon trip plan\">\n# Day 1\n\n- Alfama\n- Belém\n</doc>",
      "segments": [
        {
          "kind": "msg",
          "text": "Here's the plan."
        },
        {
          "kind": "doc",
          "text": "# Day 1\n\n- Alfama\n- Belém",
          "title": "Lisbon trip plan"
        }
      ]
    },
    {
      "name": "a document with no title has none",
