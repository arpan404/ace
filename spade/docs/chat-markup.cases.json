      "segments": [
        {
          "kind": "doc",
          "text": "Long words."
        }
      ]
    },
    {
      "name": "text outside the tags becomes its own message",
      "text": "On it.\n<msg>Found two.</msg>\nAnd one more thing.",
      "segments": [
