{
  "license": "Apache-2.0",
  "part": "code",
  "about": "The code part's cases: a package's WebAssembly components as bot.json names them under `code` (ADR 0203): the world, the imports Spade's world allows and the manifest must list as the binary does, the file, the bounds and the limits. Each case is the base manifest with `with` merged over it at the top level. A case without `refused` is accepted; with it, a reader refuses the manifest and one of its problems contains those words. A component's bytes are checked by a reader that parses WebAssembly (`spade --code-check`); these cases hold the manifest's side. Spade's reader (spade_core::package::read) and the marketplace's (readRecipe in @ace/marketplace) both run every case. `id` names the case in reports and never changes.",
  "base": {
    "format": "spade-bot",
    "version": 3,
    "requires": {
      "runtime": "1"
    },
    "name": "Flight watcher",
    "blurb": "Watches fares.",
    "task": "You watch flight fares for the person.",
    "model": "fast",
    "effects": [
      {
        "effect": "network",
        "hosts": ["api.example-fares.com"],
        "why": "Reads fares."
      }
    ],
    "pricing": {
      "kind": "free"
    }
  },
  "cases": [
    {
      "id": "code/a-component-that-calls-spades-tools-and-reads-the-clock",
      "name": "a component that calls Spade's tools and reads the clock",
      "with": {
        "code": [
          {
            "name": "fares",
            "file": "code/fares.wasm",
            "world": "spade:package/bot-tools@1.0.0",
            "imports": ["spade:package/tools", "wasi:clocks/wall-clock@0.2"],
            "why": "Parses fare tables and picks the cheapest."
          }
        ]
      }
    },
    {
      "id": "code/a-component-with-http-which-the-packages-network-hosts-allow",
      "name": "a component with http, which the package's network hosts allow",
      "with": {
        "code": [
          {
            "name": "fares",
            "file": "code/fares.wasm",
            "world": "spade:package/bot-tools@1.0.0",
            "imports": [
              "spade:package/http",
              "spade:package/log",
              "spade:package/kv",
              "wasi:random/random@0.2",
              "wasi:clocks/monotonic-clock@0.2"
            ],
            "why": "Parses fare tables and picks the cheapest.",
            "timeout_s": 300,
            "memory_mb": 512
          }
        ]
      }
    },
    {
      "id": "code/a-component-that-imports-wasi-filesystem",
      "name": "a component that imports wasi:filesystem",
      "with": {
        "code": [
          {
            "name": "fares",
            "file": "code/fares.wasm",
            "world": "spade:package/bot-tools@1.0.0",
            "imports": ["wasi:filesystem/types@0.2"],
            "why": "Parses fare tables and picks the cheapest."
          }
        ]
      },
      "refused": "no file system or sockets"
    },
