{
  "license": "Apache-2.0",
  "part": "surfaces",
  "about": "The surfaces part's cases: cards and panels declared in the manifest, a panel's state and its actions. Each case is the base manifest with `with` merged over it at the top level, and `files` the package's other files by path (a contract's schema file is written into its contract before the manifest is read). A case without `rule` is accepted; with it, a reader refuses the manifest with a problem naming that rule (`rules.json`), whatever its words. Spade's reader (spade_core::package::read) and the marketplace's (readRecipe in @ace/marketplace) both run every case. `id` names the case in reports and never changes.",
  "base": {
    "format": "spade-bot",
    "version": 3,
    "requires": {
      "runtime": "1"
    },
    "name": "Flight watcher",
    "blurb": "Watches fares.",
    "task": "You watch flight fares for the person.",
    "model": "fast",
    "effects": [
      {
        "effect": "network",
        "hosts": ["api.example-fares.com"],
        "why": "Reads fares."
      }
    ],
    "pricing": {
      "kind": "free"
    }
  },
  "cases": [
    {
      "id": "surfaces/panel-with-its-state-and-actions",
      "name": "a panel with its state and actions",
      "with": {
        "surfaces": [
          {
            "id": "watchlist",
            "kind": "panel",
            "file": "panels/watchlist/index.html",
            "title": "Watched trips",
            "state": {
              "type": "object",
              "properties": {
                "trips": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "properties": {
                      "route": {
                        "type": "string",
                        "maxLength": 40
                      },
                      "fare": {
                        "type": "number",
                        "minimum": 0
                      },
                      "cabin": {
                        "enum": ["economy", "business"]
                      },
                      "booked": {
                        "type": "boolean"
                      }
                    },
                    "required": ["route"]
                  }
                }
              },
              "required": ["trips"]
            },
            "actions": [
              {
                "name": "stop_watching",
                "label": "Stop watching",
                "value": {
                  "type": "string",
                  "maxLength": 40
                }
              },
              {
                "name": "check_now"
              },
              {
                "name": "book_fare",
                "label": "Book this fare",
                "value": {
                  "type": "string",
                  "maxLength": 40
                },
                "confirm": true
              }
            ]
          }
        ]
      }
    },
    {
      "id": "surfaces/card-and-a-panel-with-no-state-as-the-adrs-example-has-them",
      "name": "a card and a panel with no state, as the ADR's example has them",
      "with": {
        "surfaces": [
          {
            "id": "fare-drop",
            "kind": "card",
            "file": "cards/fare-drop.json"
          },
          {
            "id": "watchlist",
            "kind": "panel",
            "file": "panels/watchlist/index.html",
            "title": "Watched trips"
          }
        ]
      }
    },
    {
      "id": "surfaces/surfaces-as-an-object",
      "name": "surfaces as an object",
      "with": {
        "surfaces": {}
      },
      "rule": "surfaces.list"
