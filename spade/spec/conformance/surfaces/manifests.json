    {
      "id": "surfaces/state-with-a-keyword-this-build-doesnt-enforce",
      "name": "state with a keyword this build doesn't enforce",
      "with": {
        "surfaces": [
          {
            "id": "watchlist",
            "kind": "panel",
            "file": "panels/watchlist/index.html",
            "title": "Watched trips",
            "state": {
              "type": "string",
              "maxLength": 9,
              "pattern": "^[A-Z]+$"
            },
            "actions": [
              {
                "name": "stop_watching",
                "label": "Stop watching",
                "value": {
                  "type": "string",
                  "maxLength": 40
                }
              },
              {
                "name": "check_now"
              }
            ]
          }
        ]
      },
