{
  "license": "Apache-2.0",
  "part": "contracts",
  "about": "The contracts part's cases: a contract's declaration, its effects, examples and schema files. Each case is the base manifest with `with` merged over it at the top level, and `files` the package's other files by path (a contract's schema file is written into its contract before the manifest is read). A case without `refused` is accepted; with it, a reader refuses the manifest and one of its problems contains those words. Spade's reader (spade_core::package::read) and the marketplace's (readRecipe in @ace/marketplace) both run every case. `id` names the case in reports and never changes.",
  "base": {
    "format": "spade-bot",
    "version": 3,
    "requires": {
      "runtime": "1"
    },
    "name": "Flight watcher",
    "blurb": "Watches fares.",
    "task": "You watch flight fares for the person.",
    "model": "fast",
    "effects": [
      {
        "effect": "network",
        "hosts": ["api.example-fares.com"],
        "why": "Reads fares."
      }
    ],
    "pricing": {
      "kind": "free"
    }
  },
  "cases": [
    {
      "id": "contracts/contract-with-an-example",
      "name": "a contract with an example",
      "with": {
        "contracts": [
          {
            "name": "cheapest_fare",
            "summary": "The cheapest fare seen for a route this week.",
            "input": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 3
                },
                "to": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 3
                },
                "month": {
                  "type": "string",
                  "maxLength": 7
                }
              },
              "required": ["from", "to", "month"]
            },
            "output": {
              "type": "object",
              "properties": {
                "fare": {
                  "type": "number",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "maxLength": 3
                },
                "carrier": {
                  "type": "string",
                  "maxLength": 80
                },
                "seen_at": {
                  "type": "string",
                  "maxLength": 40
                },
                "link": {
                  "type": "string",
                  "maxLength": 2048
                }
              },
              "required": ["fare", "currency"]
            },
            "effects": [],
            "examples": [
              {
                "input": {
                  "from": "KTM",
                  "to": "DEL",
                  "month": "2027-01"
                },
                "output": {
                  "fare": 182,
                  "currency": "USD"
                }
              }
            ]
          }
        ]
      }
    },
