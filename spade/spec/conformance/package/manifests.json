{
  "license": "Apache-2.0",
  "part": "package",
  "about": "The package part's cases: the manifest's fields, its runtime and build, what identity and executions it may not carry, its modules and triggers. Each case is the base manifest with `with` merged over it at the top level, and `files` the package's other files by path (a contract's schema file is written into its contract before the manifest is read). A case without `rule` is accepted; with it, a reader refuses the manifest with a problem naming that rule (`rules.json`), whatever its words. Spade's reader (spade_core::package::read) and the marketplace's (readRecipe in @ace/marketplace) both run every case. `id` names the case in reports and never changes.",
  "base": {
    "format": "spade-bot",
    "version": 3,
    "requires": {
      "runtime": "1"
    },
    "name": "Flight watcher",
    "blurb": "Watches fares.",
    "task": "You watch flight fares for the person.",
    "model": "fast",
    "effects": [
      {
        "effect": "network",
        "hosts": ["api.example-fares.com"],
        "why": "Reads fares."
      }
    ],
    "pricing": {
      "kind": "free"
    }
  },
  "cases": [
    {
      "id": "package/base-manifest",
      "name": "the base manifest",
      "with": {}
    },
    {
      "id": "package/spec-of-this-version",
      "name": "the spec version it was written for",
      "with": {
        "spec": "1.0"
      }
    },
    {
      "id": "package/spec-of-a-later-minor-version",
      "name": "a later minor version of the spec, which a reader of its major reads",
      "with": {
        "spec": "1.4"
      }
    },
    {
      "id": "package/spec-of-another-major-version",
      "name": "another major version of the spec",
      "with": {
        "spec": "2.0"
      },
      "rule": "package.spec"
    },
    {
      "id": "package/spec-as-a-number",
      "name": "the spec version as a number",
      "with": {
        "spec": 1.0
      },
      "rule": "package.spec"
    },
    {
      "id": "package/schema-address",
      "name": "the address of the format's JSON Schema, for editors",
      "with": {
        "$schema": "https://spec.acehq.dev/1.0/bot.schema.json"
      }
    },
    {
      "id": "package/runtime-as-a-number",
      "name": "runtime as a number",
      "with": {
        "requires": {
          "runtime": 1
        }
      },
      "rule": "package.runtime-type"
    },
    {
      "id": "package/runtime-this-build-doesnt-serve",
      "name": "a runtime this build doesn't serve",
      "with": {
        "requires": {
          "runtime": "2"
        }
      },
      "rule": "package.runtime-unserved"
    },
    {
      "id": "package/publisher-in-the-file",
      "name": "a publisher in the file",
      "with": {
        "publisher": "acme"
      },
      "rule": "package.identity"
    },
    {
      "id": "package/price",
      "name": "a price",
      "with": {
        "pricing": {
          "kind": "paid"
        }
      },
      "rule": "package.price"
    },
    {
      "id": "package/server",
      "name": "a server",
      "with": {
        "mcpServers": {}
      },
      "rule": "package.execution"
    },
    {
      "id": "package/module-this-build-doesnt-have",
      "name": "a module this build doesn't have",
      "with": {
        "uses": ["task", "telepathy"]
      },
      "rule": "package.module"
    },
    {
      "id": "package/triggers-as-an-object",
      "name": "triggers as an object",
      "with": {
        "triggers": {}
      },
      "rule": "package.triggers"
    },
    {
      "id": "package/uses-as-a-word",
      "name": "uses as a word",
      "with": {
        "uses": "task"
      },
      "rule": "package.uses"
    }
  ]
}
