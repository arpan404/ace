# Address the Spade server listens on. Keep loopback behind the reverse proxy on the VM.
SPADE_LISTEN=127.0.0.1:3000
# Log filter (tracing EnvFilter syntax).
RUST_LOG=info
# Model gateway: openrouter (production), opencode-go (development only), or anthropic.
SPADE_MODEL_GATEWAY=opencode-go
# The key for the gateway above. Only the one for the chosen gateway is read.
OPENCODE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Model catalogue file (read at startup).
SPADE_MODEL_CATALOG=config/models.json
