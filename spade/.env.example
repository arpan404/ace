# Address the Spade server listens on (loopback only).
SPADE_LISTEN=127.0.0.1:3000
# Log filter (tracing EnvFilter syntax).
RUST_LOG=info
# Model catalogue file (read at startup): endpoints, their models, and the role defaults.
SPADE_MODEL_CATALOG=config/models.json
# Keys for the endpoints you use. Each endpoint in the catalogue names its own variable;
# only the ones your roles and models call need to be set.
OPENCODE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
# Brave Search key, if not added in the app (the app keeps it in the OS keychain).
BRAVE_API_KEY=
