{
  "about": "What a version 3 bot.json is accepted or refused for: one rule set, run through Spade's reader (spade_core::package::read, package/tests.rs) and the marketplace's (readRecipe, packages/marketplace/src/package.test.ts). Panels' state and action schemas are a bounded JSON Schema subset (spade_core::schema; data-schema.ts). Each case is the base manifest with `with` merged over it; `refused` says a problem is expected and a word it contains.",
  "base": {
    "format": "spade-bot",
    "version": 3,
    "requires": {
      "runtime": "1"
    },
    "name": "Flight watcher",
    "blurb": "Watches fares.",
    "task": "You watch flight fares for the person.",
    "model": "fast",
    "effects": [
      {
        "effect": "network",
        "hosts": ["api.example-fares.com"],
        "why": "Reads fares."
      }
    ],
    "pricing": {
      "kind": "free"
    }
  },
  "cases": [
    {
      "name": "the base manifest",
      "with": {}
    },
    {
      "name": "read and write_local declared, which every bot has",
      "with": {
        "effects": [
          {
            "effect": "read",
            "why": "Reads its notes."
          },
          {
            "effect": "write_local",
            "why": "Keeps its watch list."
          }
        ]
      }
    },
    {
      "name": "driving one site under network",
      "with": {
        "effects": [
          {
            "effect": "network",
            "grant": {
              "kind": "drive_site",
              "host": "book.example-air.com"
            },
            "why": "Checks a fare page."
          }
        ]
      }
    },
    {
      "name": "a declared send, which goes to the person each time",
      "with": {
        "effects": [
          {
            "effect": "send_as_person",
            "why": "Drafts a mail."
          }
        ]
      }
    },
    {
      "name": "runtime as a number",
      "with": {
        "requires": {
          "runtime": 1
        }
      },
      "refused": "requires.runtime is a string"
    },
    {
