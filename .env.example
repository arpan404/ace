# Example environment variables for local development
# Copy this to .env and edit as needed (do NOT commit secrets to git)

# Host server overrides
#ACE_HOST=192.168.1.100
#ACE_PORT=3777

# Development toggles
#ACE_NO_BROWSER=0
#ACE_LOG_WS_EVENTS=0
# Optional: path-delimited list of unpacked Chromium extension directories to
# load into the persistent in-app browser session. Known password-manager
# extensions are also auto-discovered from local Chromium profiles when Electron
# can load them. Electron supports only a subset of Chrome extension APIs.
#ACE_DESKTOP_BROWSER_EXTENSION_DIRS=/absolute/path/to/extension

# Local macOS desktop signing
# Use these only for signed desktop release builds. Keep real values in
# .env.local or your shell environment; do not commit secrets.
#ACE_DESKTOP_SIGNED=true
#CSC_LINK=base64-encoded-developer-id-application-p12
#CSC_KEY_PASSWORD=p12-export-password
# Or use CSC_NAME when the Developer ID identity is already installed in Keychain.
#CSC_NAME=Developer ID Application certificate common name
#APPLE_API_KEY=/absolute/path/to/AuthKey_KEYID.p8
#APPLE_API_KEY_ID=KEYID
#APPLE_API_ISSUER=issuer-id-uuid
# Required for macOS in-app browser Touch ID passkeys. Prefer APPLE_TEAM_ID;
# use ACE_DESKTOP_MAC_WEBAUTHN_KEYCHAIN_ACCESS_GROUP to override the generated
# <TEAM_ID>.com.ace.ace.webauthn keychain group.
#APPLE_TEAM_ID=TEAMID1234
#ACE_DESKTOP_MAC_WEBAUTHN_KEYCHAIN_ACCESS_GROUP=TEAMID1234.com.ace.ace.webauthn
#ACE_DESKTOP_MAC_TIMESTAMP=none
#ACE_DESKTOP_MAC_NOTARIZE=false
