{
  "type": "object",
  "properties": {
    "mcp": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "object",
          "properties": {
            "startup": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "catalog": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "execution": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "servers": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/Mcp.LocalConfigEncoded"
              },
              {
                "$ref": "#/$defs/Mcp.RemoteConfigEncoded"
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "mcp"
  ],
  "$defs": {
    "Mcp.LocalConfigEncoded": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "local"
          ]
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "disabled": {
          "type": "boolean"
        },
        "codemode": {
          "type": "boolean"
        },
        "timeout": {
          "type": "object",
          "properties": {
            "startup": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "catalog": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "execution": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "protocol": {
          "$ref": "#/$defs/Mcp.Protocol"
        }
      },
      "required": [
        "type",
        "command"
      ],
      "additionalProperties": false
    },
    "Mcp.RemoteConfigEncoded": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "remote"
          ]
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mcp.OAuthConfigEncoded"
            },
            {
              "type": "boolean",
              "enum": [
                false
              ]
            }
          ]
        },
        "disabled": {
          "type": "boolean"
        },
        "codemode": {
          "type": "boolean"
        },
        "timeout": {
          "type": "object",
          "properties": {
            "startup": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "catalog": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "execution": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "protocol": {
          "$ref": "#/$defs/Mcp.Protocol"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "additionalProperties": false
    },
    "Mcp.Protocol": {
      "type": "string",
      "enum": [
        "legacy",
        "auto",
        "2026-07-28"
      ],
      "description": "MCP protocol negotiation. \"legacy\" (default) opens with the initialize handshake and speaks protocol revisions up to 2025-11-25. \"auto\" probes for the 2026-07-28 revision and falls back to legacy when the server does not support it. \"2026-07-28\" requires that revision and fails otherwise."
    },
    "Mcp.OAuthConfigEncoded": {
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string"
        },
        "client_secret": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "callback_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "redirect_uri": {
          "type": "string"
        },
        "auth_server_metadata_url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
