{
 "cases": [
  {
   "name": "scroll regions move only their rows and keep history clean",
   "columns": 20,
   "rows": 5,
   "scrollback": 100,
   "steps": [
    {
     "feed": "1\r\n2\r\n3\r\n4\r\n5\u001b[2;4r\u001b[4;1H\nX"
    }
   ],
   "expect": {
    "lines": [
     "1",
     "3",
     "4",
     "X",
     "5"
    ],
    "history": 0
   }
  },
  {
   "name": "reverse index at the top margin scrolls the region down",
   "columns": 20,
   "rows": 3,
   "scrollback": 100,
   "steps": [
    {
     "feed": "1\r\n2\r\n3\u001b[1;3r\u001b[1;1H\u001bMY"
    }
   ],
   "expect": {
    "lines": [
     "Y",
     "1",
     "2"
    ]
   }
  },
  {
   "name": "lines scrolled off the top are kept in bounded history",
   "columns": 20,
   "rows": 3,
   "scrollback": 4,
   "steps": [
    {
     "feed": "line 1\r\nline 2\r\nline 3\r\nline 4\r\nline 5\r\nline 6\r\nline 7\r\nline 8\r\nline 9\r\nline 10"
    }
   ],
   "expect": {
    "history": 4,
    "text": "line 4\nline 5\nline 6\nline 7\nline 8\nline 9\nline 10"
   }
  },
  {
   "name": "erase scrollback clears history",
   "columns": 20,
   "rows": 3,
   "scrollback": 100,
   "steps": [
    {
     "feed": "line 1\r\nline 2\r\nline 3\r\nline 4\r\nline 5\r\nline 6\r\nline 7\r\nline 8\r\nline 9\r\nline 10"
    },
    {
     "feed": "\u001b[3J"
    }
   ],
   "expect": {
    "history": 0
   }
  },
  {
   "name": "inserting and deleting lines shifts the rest",
   "columns": 20,
   "rows": 3,
   "scrollback": 100,
   "steps": [
    {
     "feed": "1\r\n2\r\n3\u001b[2;1H\u001b[L"
    }
   ],
   "expect": {
    "lines": [
     "1",
     "",
     "2"
    ]
   }
  },
  {
   "name": "deleting a line pulls the rest up",
   "columns": 20,
   "rows": 3,
   "scrollback": 100,
   "steps": [
    {
     "feed": "1\r\n2\r\n3\u001b[1;1H\u001b[M"
    }
   ],
   "expect": {
    "lines": [
     "2",
     "3",
     ""
    ]
   }
  },
  {
   "name": "huge scroll and line counts stay within the region",
   "columns": 20,
   "rows": 5,
   "scrollback": 100,
   "steps": [
    {
     "feed": "1\r\n2\r\n3\r\n4\r\n5\u001b[2;4r\u001b[65535S\u001b[2;1H\u001b[65535L\u001b[65535M\u001b[65535T"
    }
   ],
   "expect": {
    "lines": [
     "1",
     "",
     "",
     "",
     "5"
    ],
    "history": 0
   }
  },
  {
   "name": "repeat fills at most what is left of the region",
   "columns": 20,
   "rows": 5,
   "scrollback": 100,
   "steps": [
    {
     "feed": "x\u001b[65535b"
    }
   ],
   "expect": {
    "history": 0,
    "lines": [
     "xxxxxxxxxxxxxxxxxxxx",
     "xxxxxxxxxxxxxxxxxxxx",
     "xxxxxxxxxxxxxxxxxxxx",
     "xxxxxxxxxxxxxxxxxxxx",
     "xxxxxxxxxxxxxxxxxxxx"
    ]
   }
  }
 ]
}
