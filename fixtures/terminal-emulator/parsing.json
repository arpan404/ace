{
 "cases": [
  {
   "name": "sequences split across output chunks still apply",
   "columns": 20,
   "rows": 5,
   "scrollback": 100,
   "steps": [
    {
     "feed": "\u001b[3"
    },
    {
     "feed": "1mX\u001b"
    },
    {
     "feed": "[0mY\u001b]0;ti"
    },
    {
     "feed": "tle\u0007Z"
    }
   ],
   "expect": {
    "lines": [
     "XYZ",
     "",
     "",
     "",
     ""
    ],
    "title": "title",
    "cells": [
     {
      "row": 0,
      "column": 0,
      "fg": "idx:1"
     },
     {
      "row": 0,
      "column": 1,
      "fg": "default",
      "flags": []
     }
    ]
   }
  },
  {
   "name": "strings and private sequences never print",
   "columns": 20,
   "rows": 5,
   "scrollback": 100,
   "steps": [
    {
     "feed": "a\u001bP1;2qpayload\u001b\\b\u001b]8;;https://x\u001b\\c\u001b[?2004hd\u001b_apc\u0007e"
    }
   ],
   "expect": {
    "lines": [
     "abcde",
     "",
     "",
     "",
     ""
    ],
    "modes": {
     "bracketedPaste": true
    }
   }
  },
  {
   "name": "cursor key mode follows the program",
   "columns": 20,
   "rows": 5,
   "scrollback": 100,
   "steps": [
    {
     "feed": "\u001b[?1h"
    }
   ],
   "expect": {
    "modes": {
     "applicationCursor": true
    }
   }
  },
  {
   "name": "a full reset clears cursor key mode",
   "columns": 20,
   "rows": 5,
   "scrollback": 100,
   "steps": [
    {
     "feed": "\u001b[?1h\u001bc"
    }
   ],
   "expect": {
    "modes": {
     "applicationCursor": false
    }
   }
  },
  {
   "name": "hiding the cursor is a mode",
   "columns": 20,
   "rows": 5,
   "scrollback": 100,
   "steps": [
    {
     "feed": "\u001b[?25l"
    }
   ],
   "expect": {
    "modes": {
     "cursorVisible": false
    }
   }
  },
  {
   "name": "a long OSC title is kept to its bound and what follows prints",
   "columns": 20,
   "rows": 5,
   "scrollback": 100,
   "steps": [
    {
     "feed": "\u001b]0;\u0007ok"
    }
   ],
   "expect": {
    "lines": [
     "ok",
     "",
     "",
     "",
     ""
    ],
    "titleLength": 256
   }
  }
 ]
}
