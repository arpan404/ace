{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ace cloud (ADR 0141). The script keeps the name `ace-relay`: its relay Durable Objects
  // live under that name, and renaming the script would leave them behind.
  "name": "ace-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  // node:net for the shared IP normalization.
  // node:net for the shared IP normalization; request.signal so a caller leaving cancels the
  // daemon's work on forwarded HTTP.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "RelayObject" },
      // Spade's connector sign-ins in progress, one object per account (ADR 0141).
      { "name": "SIGN_INS", "class_name": "SignInObject" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayObject"] },
    { "tag": "v2", "new_sqlite_classes": ["SignInObject"] },
  ],
  // Accounts, pending sign-ins and the machine directory (ADR 0111). Replace database_id with
  // the id `wrangler d1 create ace-accounts` prints; see docs/relay/accounts.md.
  "d1_databases": [
    {
      "binding": "ACCOUNTS",
      "database_name": "ace-accounts",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    { "name": "UPGRADES", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    {
      "name": "ACCOUNT_REQUESTS",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 },
    },
    // Forwarded HTTP to a machine (ADR 0122): per caller address, then per host id.
    { "name": "HTTP_REQUESTS", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } },
    {
      "name": "HTTP_HOST_REQUESTS",
      "namespace_id": "1004",
      "simple": { "limit": 600, "period": 60 },
    },
    // Spade's sign-in broker (ADR 0141): per caller address, then per account. Spade polls a
    // sign-in every three seconds.
    {
      "name": "BROKER_ADDRESS_REQUESTS",
      "namespace_id": "1005",
      "simple": { "limit": 240, "period": 60 },
    },
    {
      "name": "BROKER_ACCOUNT_REQUESTS",
      "namespace_id": "1006",
      "simple": { "limit": 120, "period": 60 },
    },
    // Org grant standing checks (ADR 0206 §6): per member account, after the grant verifies.
    {
      "name": "STANDING_REQUESTS",
      "namespace_id": "1007",
      "simple": { "limit": 600, "period": 60 },
    },
    // WorkOS lookups by the standing route, all callers together.
    {
      "name": "STANDING_WORKOS",
      "namespace_id": "1008",
      "simple": { "limit": 1200, "period": 60 },
    },
    // ace search (ADR 0210 §4): the tight burst per account after authentication, then a coarse
    // one per caller address before it. The daily and monthly limits are counted in D1, since
    // these count per Cloudflare location.
    {
      "name": "SEARCH_ACCOUNT_BURST",
      "namespace_id": "1009",
      "simple": { "limit": 10, "period": 60 },
    },
    // Coarse, before authentication, so unauthenticated noise can't lock out a shared network.
    {
      "name": "SEARCH_ADDRESS_REQUESTS",
      "namespace_id": "1010",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  // Workers AI (ace search, ADR 0210) is bound in production only: locally it would reach
  // Cloudflare, so local runs and tests answer search_unavailable or use a fake.
  // Expired sign-ins and sessions are also dropped whenever a sign-in starts.
  "triggers": { "crons": ["17 * * * *", "* * * * *"] },
  // Request logs would record join tickets in URLs. Account secrets, grants and tokens are
  // never logged either.
  "observability": { "enabled": false },
  // ace cloud at cloud.acehq.dev, and at relay.acehq.dev for apps released before the rename:
  // deploy with `--env production`. The top level above is for local development and tests.
  "env": {
    "production": {
      "name": "ace-relay",
      "routes": [
        { "pattern": "cloud.acehq.dev", "custom_domain": true },
        { "pattern": "relay.acehq.dev", "custom_domain": true },
      ],
      "vars": {
        // Canonical broker callbacks, and the exact origins serving account sign-in.
        "ACE_ACCOUNT_PUBLIC_URL": "https://cloud.acehq.dev",
        "ACE_ACCOUNT_PUBLIC_ORIGINS": "https://cloud.acehq.dev,https://relay.acehq.dev",
        "ACE_ACCOUNT_ALLOWED_ORIGINS": "https://app.acehq.dev,https://beta.app.acehq.dev,app://ace",
        // ace search (ADR 0210 §4). The gateway must exist, with logs, Logpush and caching off.
        // The Worker reads those settings with the ACE_SEARCH_CF_ACCOUNT_ID and
        // ACE_SEARCH_CF_API_TOKEN secrets (AI Gateway Read) and searches only while they hold.
        // Without them it searches only if ACE_SEARCH_GATEWAY_VERIFIED is "logs-off-cache-off",
        // the owner's word that they checked by hand. The limits are the defaults written out.
        "ACE_SEARCH_GATEWAY": "ace-search",
        "ACE_SEARCH_MONTHLY": "1000",
        "ACE_SEARCH_NEW_ACCOUNT_MONTHLY": "100",
        "ACE_SEARCH_NEW_ACCOUNT_DAYS": "7",
        "ACE_SEARCH_DAILY": "100",
        "ACE_SEARCH_MACHINE_MONTHLY": "500",
        "ACE_SEARCH_MACHINE_DAILY": "60",
        "ACE_SEARCH_ADDRESS_DAILY": "300",
        "ACE_SEARCH_DAILY_DOLLARS": "5",
      },
      "durable_objects": {
        "bindings": [
          { "name": "RELAY", "class_name": "RelayObject" },
          { "name": "SIGN_INS", "class_name": "SignInObject" },
        ],
      },
      "d1_databases": [
        {
          "binding": "ACCOUNTS",
          "database_name": "ace-accounts",
          "database_id": "9a611912-4571-46f4-9020-1b95ec8823fc",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [
        { "name": "UPGRADES", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
        {
          "name": "ACCOUNT_REQUESTS",
          "namespace_id": "1002",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "HTTP_REQUESTS",
          "namespace_id": "1003",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "HTTP_HOST_REQUESTS",
          "namespace_id": "1004",
          "simple": { "limit": 600, "period": 60 },
        },
        {
          "name": "BROKER_ADDRESS_REQUESTS",
          "namespace_id": "1005",
          "simple": { "limit": 240, "period": 60 },
        },
        {
          "name": "BROKER_ACCOUNT_REQUESTS",
          "namespace_id": "1006",
          "simple": { "limit": 120, "period": 60 },
        },
        // Org grant standing checks (ADR 0206 §6): per member account, after the grant verifies.
        {
          "name": "STANDING_REQUESTS",
          "namespace_id": "1007",
          "simple": { "limit": 600, "period": 60 },
        },
        // WorkOS lookups by the standing route, all callers together.
        {
          "name": "STANDING_WORKOS",
          "namespace_id": "1008",
          "simple": { "limit": 1200, "period": 60 },
        },
        // ace search (ADR 0210 §4): per account after authentication, per address before it.
        {
          "name": "SEARCH_ACCOUNT_BURST",
          "namespace_id": "1009",
          "simple": { "limit": 10, "period": 60 },
        },
        // Coarse, before authentication, so unauthenticated noise can't lock out a network.
        {
          "name": "SEARCH_ADDRESS_REQUESTS",
          "namespace_id": "1010",
          "simple": { "limit": 300, "period": 60 },
        },
      ],
      // ace search: Ceramic through the AI Gateway named in ACE_SEARCH_GATEWAY (ADR 0210 §2).
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["17 * * * *", "* * * * *"] },
      "observability": { "enabled": false },
    },
  },
}
