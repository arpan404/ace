{
  "name": "@ace/desktop",
  "version": "0.3.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "bun run --parallel dev:bundle dev:electron",
    "dev:bundle": "node node_modules/.bin/tsdown --watch",
    "dev:electron": "bun run scripts/dev-electron.mjs",
    "build": "node node_modules/.bin/tsdown",
    "start": "bun run scripts/start-electron.mjs",
    "typecheck": "node node_modules/.bin/tsc --noEmit",
    "test": "node node_modules/.bin/vitest run --passWithNoTests",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "effect": "catalog:",
    "electron": "41.5.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@ace/contracts": "workspace:*",
    "@ace/shared": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "productName": "ace"
}
