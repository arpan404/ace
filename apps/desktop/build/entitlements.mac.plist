<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 needs JIT under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- The daemon (on the bundled Bun runtime, which inherits these) loads descriptor.node and
       other native addons, and bun:ffi opens system libraries; their signatures can differ
       from the app's team. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
