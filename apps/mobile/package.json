    "expo-constants": "~56.0.17",
    "expo-glass-effect": "~0.1.10",
    "expo-linking": "~56.0.13",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~56.0.4",
