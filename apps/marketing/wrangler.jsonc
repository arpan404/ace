// Hosts the marketing site at acehq.dev as a static Cloudflare Worker.
// acehq.dev and www are proxied DNS records in the zone, so the Worker takes them by route.
// Deploy: `bun run --cwd apps/marketing deploy`.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "ace-marketing",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [
    { "pattern": "acehq.dev/*", "zone_name": "acehq.dev" },
    { "pattern": "www.acehq.dev/*", "zone_name": "acehq.dev" }
  ],
  "workers_dev": false
}
