---
import Closing from "../../components/Closing.astro";
import Faq from "../../components/Faq.astro";
import FeatureStory from "../../components/features/FeatureStory.astro";
import FeatureTools from "../../components/features/FeatureTools.astro";
import LinkRows from "../../components/features/LinkRows.astro";
import PageIntro from "../../components/site/PageIntro.astro";
import { features, type Feature } from "../../content/features.ts";
import Page from "../../layouts/Page.astro";
import { faqPage, schemaFor } from "../../seo/schema.ts";

export function getStaticPaths() {
  return features.map((feature) => ({ params: { slug: feature.slug }, props: { feature } }));
}

interface Props {
  feature: Feature;
}

const { feature } = Astro.props;
const path = `/features/${feature.slug}/`;
const others = features
  .filter((entry) => entry.slug !== feature.slug)
  .map((entry) => ({
    href: `/features/${entry.slug}/`,
    name: entry.name,
    body: entry.points[0] ?? entry.intro,
  }));
---

<Page
  path={path}
  title={feature.title}
  description={feature.description}
  schema={[faqPage(schemaFor(Astro.site), path, feature.questions)]}
>
  <PageIntro
    headline={feature.headline}
    intro={feature.intro}
    points={feature.points}
    secondary={{ href: "/features/", label: "All features" }}
  />
  <FeatureStory feature={feature} />
  <FeatureTools tools={feature.tools} />
  <Faq items={feature.questions} heading={`Questions about ${feature.name.toLowerCase()}`} />
  <LinkRows
    heading="More of ace."
    lede={`The other ${others.length} things ace gives every agent, each with a page of its own.`}
    items={others}
  />
  <Closing />
</Page>

