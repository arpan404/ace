---
/*
 * An agent's page: how to run it in ace and what it gets there. The mark and headline, three
 * setup steps, what ace adds (each a feature page), the agent drawn in ace, its questions, the
 * other agents, and the closing download.
 */
import Closing from "../../components/Closing.astro";
import Faq from "../../components/Faq.astro";
import AgentHero from "../../components/agents/AgentHero.astro";
import AgentInApp from "../../components/agents/AgentInApp.astro";
import AgentSetup from "../../components/agents/AgentSetup.astro";
import OtherAgents from "../../components/agents/OtherAgents.astro";
import LinkRows from "../../components/features/LinkRows.astro";
import { agentGuides, agentQuestions, type AgentGuide } from "../../content/agent-guides.ts";
import { features } from "../../content/features.ts";
import Page from "../../layouts/Page.astro";
import { agentMeta } from "../../seo/meta.ts";
import { faqPage, schemaFor } from "../../seo/schema.ts";

export function getStaticPaths() {
  return agentGuides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

interface Props {
  guide: AgentGuide;
}

const { guide } = Astro.props;
const name = guide.label;
const path = `/agents/${guide.slug}/`;
const questions = agentQuestions(guide);
const adds = features.map((feature) => ({
  href: `/features/${feature.slug}/`,
  name: feature.name,
  body: feature.points[0] ?? feature.intro,
}));
---

<Page
  path={path}
  title={agentMeta(guide).title}
  description={agentMeta(guide).description}
  schema={[faqPage(schemaFor(Astro.site), path, questions)]}
>
  <AgentHero guide={guide} />
  <AgentSetup guide={guide} />
  <LinkRows heading={`What ${name} gets in ace.`} lede={guide.notes.join(" ")} items={adds} />
  <AgentInApp guide={guide} />
  <Faq items={questions} heading={`Questions about ${name} in ace`} />
  <OtherAgents guide={guide} />
  <Closing />
</Page>
