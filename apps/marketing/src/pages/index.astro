---
import Agents from "../components/Agents.astro";
import Closing from "../components/Closing.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Nav from "../components/Nav.astro";
import Review from "../components/Review.astro";
import Status from "../components/Status.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="ace: all your coding agents, one window"
  description="ace drives Claude Code, Codex, Cursor and the other coding-agent CLIs you already use, and tells you which one needs you."
>
  <Nav />
  <main>
    <Hero />
    <Agents />
    <Status />
    <Review />
    <Features />
    <Closing />
  </main>
  <Footer />
</Base>
