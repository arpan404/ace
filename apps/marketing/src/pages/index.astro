---
import Agents from "../components/Agents.astro";
import Closing from "../components/Closing.astro";
import Fleet from "../components/Fleet.astro";
import Hero from "../components/Hero.astro";
import Review from "../components/Review.astro";
import LinkCards from "../components/site/LinkCards.astro";
import Status from "../components/Status.astro";
import Work from "../components/Work.astro";
import { product } from "../content/product.ts";
import { route } from "../content/routes.ts";
import Page from "../layouts/Page.astro";
import { schemaFor, softwareApplication, sourceCode } from "../seo/schema.ts";

const schema = schemaFor(Astro.site);
/*
 * The home page is an overview: what ace is, the features people come for, then a way onward.
 * Anything with a page of its own (MCP tools, security, every feature, the FAQ) is linked here,
 * never repeated.
 */
const onward = ["/features/", "/mcp/", "/security/", "/faq/"].map((path) => {
  const page = route(path);
  return { href: page.path, title: page.name, body: page.summary };
});
---

<Page
  path="/"
  title={product.title}
  description={product.description}
  schema={[softwareApplication(schema), sourceCode(schema)]}
>
  <Hero />
  <Agents />
  <Status />
  <Work />
  <Fleet />
  <Review />
  <LinkCards heading="There's more to ace" cards={onward} />
  <Closing />
</Page>
