---
import Closing from "../components/Closing.astro";
import AgentStrip from "../components/AgentStrip.astro";
import Parts from "../components/home/Parts.astro";
import Showcase from "../components/home/Showcase.astro";
import Yours from "../components/home/Yours.astro";
import ZoomStory from "../components/zoom/ZoomStory.astro";
import Spade from "../components/Spade.astro";
import Page from "../layouts/Page.astro";
import { homeMeta } from "../seo/meta.ts";
import { schemaFor, softwareApplication, sourceCode } from "../seo/schema.ts";

const schema = schemaFor(Astro.site);
---

<Page
  path="/"
  title={homeMeta.title}
  description={homeMeta.description}
  schema={[softwareApplication(schema), sourceCode(schema)]}
>
  <ZoomStory />
  <AgentStrip />
  <Showcase />
  <Parts />
  <Yours />
  <Spade />
  <Closing />
</Page>
