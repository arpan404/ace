---
import Layout from "../layouts/Layout.astro";
import ProviderIcon from "../components/ProviderIcon.astro";

const providers = [
  { label: "Codex", kind: "codex" },
  { label: "Claude", kind: "claude" },
  { label: "Gemini", kind: "gemini" },
  { label: "Cursor", kind: "cursor" },
  { label: "Pi Coding Agent", kind: "pi" },
  { label: "GitHub Copilot", kind: "githubCopilot" },
  { label: "OpenCode", kind: "opencode" },
] as const;

const surfaces = ["threads", "terminal", "browser", "editor", "diffs", "approvals", "checkpoints"];

const runRows = [
  ["Start in the repo", "Project, branch, worktree, provider instance, model, and plan stay attached to the thread."],
  ["Watch the work", "Conversation, terminal, browser, editor, and diffs stay in one workspace while the agent runs."],
  ["Control the turn", "Approve, reject, queue, interrupt, switch modes, or hand the task to another provider."],
  ["Recover state", "Replay after reconnects, reload snapshots, inspect failures, and revert checkpoints."],
] as const;

const accountRows = [
  ["multi-account", "personal, work, sandbox, or dedicated CLI instances"],
  ["bring your own", "no ace agent subscription; use the accounts and CLIs you already have"],
  ["handoff", "Codex -> Claude -> Cursor or Pi -> Copilot or OpenCode as an example workflow"],
] as const;

const browserRows = [
  ["browser control", "The browser that agents can control: navigate, inspect DOM, screenshot, click, type, and read console logs."],
  ["image generation", "Codex image generation opens a live placeholder in the thread before the result arrives."],
] as const;

const recoveryRows = [
  ["reconnect", "replay transport events"],
  ["snapshot", "reload authoritative state"],
  ["checkpoint", "capture filesystem and diff state"],
  ["revert", "restore a previous checkpoint"],
  ["failure state", "show errors, stale approvals, missing diffs, and interrupted sessions"],
] as const;

const remoteRows = [
  ["local", "direct desktop/web connection when the code is on this machine"],
  ["pair", "link or QR setup for remote hosts"],
  ["relay", "end-to-end encrypted payload traffic between viewer and host"],
  ["self-host", "managed relay or your own relay endpoint"],
] as const;
---

<Layout
  title="ace - Operator console for coding agents"
  description="ace is a local-first operator console for coding agents: provider CLIs, terminal, browser, diffs, approvals, checkpoints, and remote pairing in one workspace."
>
  <nav class="site-nav" aria-label="Primary">
    <a href="/" class="brand" aria-label="ace home">
      <img src="/logo.png" alt="" class="brand-icon" />
      <span>ace</span>
    </a>
    <div class="nav-links">
      <a href="#console">Console</a>
      <a href="#providers">Providers</a>
      <a href="#browser">Browser</a>
      <a href="#recovery">Recovery</a>
      <a href="#remote">Remote</a>
      <a href="/download" class="nav-download">Download</a>
      <a href="https://github.com/arpan404/ace" target="_blank" rel="noopener noreferrer"
        >GitHub</a
      >
    </div>
  </nav>

  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">Operator console for coding agents</p>
      <h1 id="hero-heading">Keep agent runs under control.</h1>
      <p class="hero-intro">
        ace runs the provider CLIs you already use and keeps each run tied to the project,
        terminal, browser, diffs, approvals, and checkpoints.
      </p>
      <div class="hero-actions" aria-label="Primary actions">
        <a id="download-btn" href="/download" class="button button-primary" data-interactive>
          <svg
            class="cta-icon cta-icon--apple"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 814 1000"
            aria-hidden="true"
          >
            <path
              fill="currentColor"
              d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
            />
          </svg>
          <svg
            class="cta-icon cta-icon--windows"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 88 88"
            aria-hidden="true"
          >
            <path
              fill="currentColor"
              d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"
            />
          </svg>
          <span class="cta-icon cta-icon--linux" aria-hidden="true">Lx</span>
          <span id="download-label">Download ace</span>
        </a>
        <a href="#console" class="button button-secondary" data-interactive>See the console</a>
      </div>
      <div class="hero-facts" aria-label="ace facts">
        <span>No ace agent subscription</span>
        <span>Multi-provider, multi-account</span>
        <span>Local-first, remote when paired</span>
      </div>
    </div>

    <div class="hero-product" data-scroll-3d data-scroll-strength="0.55">
      <figure class="product-frame">
        <img
          src="/screenshot.png"
          alt="ace desktop workspace showing coding agent threads, terminal output, browser review, and project context"
          width="3456"
          height="2168"
          loading="eager"
          decoding="async"
        />
      </figure>
      <div class="surface-bar" aria-label="ace workspace surfaces">
        {surfaces.map((surface) => <span>{surface}</span>)}
      </div>
    </div>
  </section>

  <section id="console" class="section console-section" aria-labelledby="console-heading">
    <header class="section-heading" data-reveal>
      <p class="eyebrow">Console</p>
      <h2 id="console-heading">One thread keeps the run readable.</h2>
    </header>
    <div class="run-grid">
      {runRows.map(([label, text]) => (
        <article data-reveal>
          <h3>{label}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="providers" class="section providers-section" aria-labelledby="providers-heading">
    <header class="section-heading" data-reveal>
      <p class="eyebrow">Providers</p>
      <h2 id="providers-heading">Use your own accounts.</h2>
      <p>
        Codex, Claude, Gemini, Cursor, Pi Coding Agent, GitHub Copilot, and OpenCode sit behind the
        same workspace.
      </p>
    </header>
    <div class="provider-lineup" aria-label="Supported providers" data-reveal>
      {providers.map((provider) => (
        <span>
          <ProviderIcon kind={provider.kind} />
          {provider.label}
        </span>
      ))}
    </div>
    <div class="account-ledger">
      {accountRows.map(([label, text]) => (
        <p data-reveal><span>{label}</span>{text}</p>
      ))}
    </div>
  </section>

  <section id="browser" class="section browser-section" aria-labelledby="browser-heading">
    <header class="section-heading" data-reveal>
      <p class="eyebrow">Browser and Codex</p>
      <h2 id="browser-heading">The browser that agents can control.</h2>
    </header>
    <div class="browser-ledger">
      {browserRows.map(([label, text]) => (
        <article data-reveal>
          <h3>{label}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="recovery" class="section split-section" aria-labelledby="recovery-heading">
    <header class="section-heading" data-reveal>
      <p class="eyebrow">Recovery</p>
      <h2 id="recovery-heading">Designed for long runs.</h2>
      <p>Streams break. Machines sleep. Approvals get stale. ace keeps the state inspectable.</p>
    </header>
    <div class="compact-ledger">
      {recoveryRows.map(([label, text]) => (
        <p data-reveal><span>{label}</span>{text}</p>
      ))}
    </div>
  </section>

  <section id="remote" class="section split-section" aria-labelledby="remote-heading">
    <header class="section-heading" data-reveal>
      <p class="eyebrow">Remote</p>
      <h2 id="remote-heading">Run where the code lives.</h2>
      <p>Use local mode when the repo is here. Use pairing and relay when it is not.</p>
    </header>
    <div class="compact-ledger">
      {remoteRows.map(([label, text]) => (
        <p data-reveal><span>{label}</span>{text}</p>
      ))}
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-heading">
    <div data-reveal>
      <p class="eyebrow">Download</p>
      <h2 id="final-heading">Stop running agents from scattered windows.</h2>
    </div>
    <div class="final-actions" data-reveal>
      <a href="/download" class="button button-primary" data-interactive>Download ace</a>
      <a
        href="https://github.com/arpan404/ace"
        class="button button-secondary"
        target="_blank"
        rel="noopener noreferrer"
        data-interactive
      >
        View GitHub
      </a>
    </div>
  </section>
</Layout>

<script>
  type Platform = { os: "mac" | "win" | "linux"; label: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Download for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Download for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Download for Linux" };
    return null;
  }

  const btn = document.getElementById("download-btn") as HTMLAnchorElement | null;
  const label = document.getElementById("download-label");
  const platform = detectPlatform();

  if (btn && label && platform) {
    document.documentElement.dataset.platform = platform.os;
    label.textContent = platform.label;
  }
</script>

<style>
  .site-nav,
  .hero,
  .section,
  .final-cta {
    width: min(100% - 2rem, 1180px);
    margin: 0 auto;
  }

  .site-nav {
    display: flex;
    min-height: 4.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .brand,
  .nav-links,
  .button,
  .hero-actions,
  .surface-bar,
  .provider-lineup,
  .final-actions {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 0.72rem;
    font-size: 1rem;
    font-weight: 800;
  }

  .brand-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 0.7rem;
  }

  .nav-links {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.55rem 1rem;
    color: var(--fg-muted);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .nav-links a {
    border-radius: 999px;
    transition: color 150ms ease;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--fg);
  }

  .nav-download {
    border: 1px solid var(--line-strong);
    padding: 0.48rem 0.82rem;
    color: var(--fg);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(20rem, 0.42fr) minmax(0, 0.58fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
    padding: clamp(2.4rem, 6vw, 5rem) 0 clamp(2.5rem, 5vw, 4rem);
  }

  .hero-copy,
  .section-heading,
  .final-cta > div:first-child {
    display: grid;
    gap: 1rem;
  }

  .eyebrow,
  .surface-bar,
  .account-ledger span,
  .compact-ledger span {
    color: #73d7ff;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    text-wrap: balance;
  }

  .hero h1 {
    max-width: 10.5ch;
    font-size: clamp(3.4rem, 6.7vw, 6.45rem);
    line-height: 0.92;
    letter-spacing: -0.054em;
  }

  .section-heading h2,
  .final-cta h2 {
    max-width: 15ch;
    font-size: clamp(2.2rem, 4.4vw, 4.2rem);
    line-height: 0.98;
    letter-spacing: -0.052em;
  }

  .hero-intro,
  .section-heading p,
  .run-grid p,
  .browser-ledger p,
  .account-ledger p,
  .compact-ledger p {
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.58;
  }

  .hero-intro {
    max-width: 35rem;
  }

  .hero-actions {
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .button {
    min-height: 3rem;
    justify-content: center;
    gap: 0.58rem;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0.82rem 1.08rem;
    font-size: 0.94rem;
    font-weight: 800;
    line-height: 1;
    transition:
      transform 150ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 150ms ease,
      background 150ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(135deg, #f5f8fc, #bdc9d8);
    color: #0c121a;
  }

  .button-secondary {
    border-color: var(--line-strong);
    background: rgba(255, 255, 255, 0.028);
    color: var(--fg);
  }

  .cta-icon {
    display: none;
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  .cta-icon--linux {
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
    line-height: 1;
  }

  :global([data-platform="mac"]) .cta-icon--apple,
  :global([data-platform="win"]) .cta-icon--windows {
    display: block;
  }

  :global([data-platform="linux"]) .cta-icon--linux {
    display: inline-grid;
  }

  .hero-facts {
    display: grid;
    gap: 0.45rem;
    padding-top: 0.15rem;
  }

  .hero-facts span {
    width: fit-content;
    border-bottom: 1px solid var(--line);
    color: var(--fg-muted);
    padding-bottom: 0.24rem;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .hero-product {
    min-width: 0;
  }

  .product-frame {
    margin: 0;
  }

  .product-frame img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 12px;
    background: #07080d;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 calc(18px + 14px * var(--scroll-shadow, 1))
        calc(48px + 22px * var(--scroll-shadow, 1)) rgba(0, 0, 0, 0.34);
  }

  .surface-bar {
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    border-bottom: 1px solid var(--line);
    padding: 0.72rem 0;
    color: var(--fg-dim);
  }

  .section {
    display: grid;
    gap: clamp(1.35rem, 3vw, 2rem);
    padding: clamp(3.5rem, 6vw, 5.4rem) 0 0;
  }

  .section-heading {
    max-width: 48rem;
  }

  .run-grid,
  .browser-ledger {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .run-grid article,
  .browser-ledger article {
    min-width: 0;
    border-bottom: 1px solid var(--line);
    padding: 1rem 1rem 1.1rem 0;
  }

  .run-grid h3,
  .browser-ledger h3 {
    font-size: clamp(1.12rem, 1.5vw, 1.35rem);
    line-height: 1.1;
  }

  .run-grid p,
  .browser-ledger p {
    margin-top: 0.55rem;
    font-size: 0.94rem;
  }

  .provider-lineup {
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 0.9rem 0;
  }

  .provider-lineup span {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    color: var(--fg);
    font-size: 0.96rem;
    font-weight: 700;
  }

  .provider-lineup :global(.provider-icon) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .account-ledger,
  .compact-ledger {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .account-ledger p,
  .compact-ledger p {
    display: grid;
    grid-template-columns: minmax(8rem, 0.2fr) minmax(0, 1fr);
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding: 0.95rem 0;
  }

  .account-ledger span,
  .compact-ledger span {
    color: var(--fg-dim);
  }

  .browser-ledger {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .split-section {
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
    align-items: start;
  }

  .final-cta {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(3.8rem, 6vw, 5.2rem) 0 clamp(4rem, 7vw, 6rem);
  }

  .final-cta > div:first-child {
    max-width: 36rem;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  .final-actions {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.8rem;
  }

  @media (max-width: 1080px) {
    .hero,
    .split-section {
      grid-template-columns: 1fr;
    }

    .hero h1 {
      max-width: 12ch;
    }

    .run-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .site-nav {
      align-items: flex-start;
      flex-direction: column;
      padding: 1rem 0;
    }

    .nav-links {
      justify-content: flex-start;
      width: 100%;
    }

    .nav-links a:nth-child(2),
    .nav-links a:nth-child(4),
    .nav-links a:nth-child(5) {
      display: none;
    }

    .hero {
      padding-top: 1.4rem;
    }

    .final-cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .site-nav,
    .hero,
    .section,
    .final-cta {
      width: min(100% - 1.25rem, 1180px);
    }

    .button {
      width: 100%;
      min-width: 0;
    }

    .hero h1 {
      font-size: clamp(2.72rem, 14vw, 3.5rem);
      line-height: 0.94;
    }

    .hero-intro,
    .section-heading p {
      font-size: 0.94rem;
    }

    .hero-facts span {
      width: auto;
      font-size: 0.82rem;
    }

    .run-grid,
    .browser-ledger {
      grid-template-columns: 1fr;
    }

    .provider-lineup {
      display: grid;
      grid-template-columns: 1fr;
    }

    .account-ledger p,
    .compact-ledger p {
      grid-template-columns: 1fr;
      gap: 0.24rem;
    }

    .final-actions {
      width: 100%;
    }
  }
</style>
