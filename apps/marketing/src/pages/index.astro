---
import Agents from "../components/Agents.astro";
import Boundary from "../components/Boundary.astro";
import Closing from "../components/Closing.astro";
import Faq from "../components/Faq.astro";
import Features from "../components/Features.astro";
import Fleet from "../components/Fleet.astro";
import Hero from "../components/Hero.astro";
import Platforms from "../components/Platforms.astro";
import Review from "../components/Review.astro";
import Status from "../components/Status.astro";
import Tools from "../components/Tools.astro";
import Work from "../components/Work.astro";
import { faq, product } from "../content/product.ts";
import Page from "../layouts/Page.astro";
import { faqPage, schemaFor, softwareApplication, sourceCode } from "../seo/schema.ts";

const schema = schemaFor(Astro.site);
/* The home page answers the first questions; /faq/ has every one. */
const questions = faq.slice(0, 5);
---

<Page
  path="/"
  title={product.title}
  description={product.description}
  schema={[softwareApplication(schema), sourceCode(schema), faqPage(schema, "/", questions)]}
>
  <Hero />
  <Platforms />
  <Agents />
  <Status />
  <Work />
  <Fleet />
  <Review />
  <Tools />
  <Features />
  <Boundary />
  <Faq id="faq" items={questions} moreHref="/faq/" />
  <Closing />
</Page>
