---
import Agents from "../components/Agents.astro";
import Capabilities from "../components/Capabilities.astro";
import Closing from "../components/Closing.astro";
import Faq from "../components/Faq.astro";
import Features from "../components/Features.astro";
import Fleet from "../components/Fleet.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Nav from "../components/Nav.astro";
import Review from "../components/Review.astro";
import Status from "../components/Status.astro";
import Tools from "../components/Tools.astro";
import { product } from "../content/product.ts";
import Base from "../layouts/Base.astro";
import { structuredData } from "../seo/structured-data.ts";
---

<Base
  title={product.title}
  description={product.description}
  structuredData={structuredData(Astro.site)}
>
  <Nav />
  <main>
    <Hero />
    <Agents />
    <Status />
    <Capabilities />
    <Review />
    <Fleet />
    <Tools />
    <Features />
    <Faq />
    <Closing />
  </main>
  <Footer />
</Base>
