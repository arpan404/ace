---
/*
 * Every question the site answers, on one page, by topic (content/questions.ts). The page's
 * FAQPage data lists the same questions in the same order.
 */
import Closing from "../components/Closing.astro";
import Topics from "../components/faq/Topics.astro";
import { allQuestions, questionTopics } from "../content/questions.ts";
import Page from "../layouts/Page.astro";
import { faqPage, schemaFor } from "../seo/schema.ts";
import { links } from "../site.ts";

const path = "/faq/";
---

<Page
  path={path}
  title="FAQ: agents, machines, privacy and pricing: ace"
  description="Answers about ace: which coding agents it runs, API keys, your machines and phone, where your code goes, Spade, and what it costs."
  schema={[faqPage(schemaFor(Astro.site), path, allQuestions)]}
>
  <header class="page intro">
    <h1>Questions, answered.</h1>
    <p class="lead">
      What people ask before trying ace. Missing one?{" "}
      <a class="text-link" href={`${links.source}/issues`}>Ask on GitHub</a>.
    </p>
  </header>
  <Topics topics={questionTopics} />
  <Closing />
</Page>

<style>
  .intro {
    padding-top: clamp(40px, 6vw, 80px);
  }

  h1 {
    max-width: 13em;
    font-size: clamp(44px, 7.2vw, 96px);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .lead {
    margin-top: clamp(18px, 2.4vw, 28px);
    max-width: 34em;
    color: var(--muted);
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.5;
  }
</style>
