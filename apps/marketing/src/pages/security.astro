---
/*
 * Security and privacy: one heading and one sentence, a drawing of where things live, where ace
 * stops in four groups, the records to check it against, and the questions. Words in
 * content/security.ts; the questions are product.ts's, which the page's Markdown copy shares.
 */
import Closing from "../components/Closing.astro";
import DownloadButton from "../components/DownloadButton.astro";
import Faq from "../components/Faq.astro";
import Boundaries from "../components/security/Boundaries.astro";
import Records from "../components/security/Records.astro";
import TrustMap from "../components/security/TrustMap.astro";
import { securityQuestions } from "../content/product.ts";
import { securityPage } from "../content/security.ts";
import Page from "../layouts/Page.astro";
import { faqPage, schemaFor } from "../seo/schema.ts";

const path = "/security/";
---

<Page
  path={path}
  title={securityPage.title}
  description={securityPage.description}
  schema={[faqPage(schemaFor(Astro.site), path, securityQuestions)]}
>
  <section class="page opening">
    <h1>{securityPage.headline}</h1>
    <p class="lead">{securityPage.intro}</p>
    <div class="actions">
      <DownloadButton />
      <a class="button button-secondary" href="/privacy-policy/">Privacy policy</a>
    </div>
  </section>

  <TrustMap />
  <Boundaries />
  <Records />
  <Faq items={securityQuestions} heading={securityPage.questionsHeading} moreHref="/faq/" />
  <Closing />
</Page>

<style>
  .opening {
    padding-top: clamp(32px, 5vw, 64px);
  }

  h1 {
    max-width: 12em;
    font-size: clamp(44px, 7vw, 96px);
    letter-spacing: -0.055em;
    line-height: 0.96;
  }

  .lead {
    margin-top: clamp(18px, 2.4vw, 28px);
    max-width: 34em;
    color: var(--muted);
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
</style>
