---
import Boundary from "../components/Boundary.astro";
import Closing from "../components/Closing.astro";
import Faq from "../components/Faq.astro";
import PageIntro from "../components/site/PageIntro.astro";
import { securityQuestions } from "../content/product.ts";
import Page from "../layouts/Page.astro";
import { faqPage, schemaFor } from "../seo/schema.ts";

const path = "/security/";
const questions = securityQuestions;
---

<Page
  path={path}
  title="Security and privacy: where your code goes with ace"
  description="Agents run on your machines, credentials stay with each CLI, remote access is end-to-end encrypted, and every line of ace is open source."
  schema={[faqPage(schemaFor(Astro.site), path, questions)]}
>
  <PageIntro
    headline="Your code, your machines, your keys"
    intro="ace is an app you run, not a service you send code to. It sits around your agents, never between you and your providers."
    secondary={{ href: "/privacy-policy/", label: "Privacy policy" }}
  />
  <Boundary />
  <Faq items={questions} heading="Questions about security" moreHref="/faq/" />
  <Closing />
</Page>
