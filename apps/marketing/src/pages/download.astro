---
import Layout from "../layouts/Layout.astro";
import MarketingNav from "../components/MarketingNav.astro";
---

<Layout
  title="Download — ace"
  description="Download ace for macOS, Windows, or Linux. Local multi-provider agent workspace with handoff and parallel PRs."
>
  <div class="inner-page">
    <span class="inner-page__noise" aria-hidden="true"></span>
    <MarketingNav variant="inner" backLabel="Home" backHref="/" />

    <section class="inner-hero" aria-labelledby="download-heading">
      <div class="inner-hero__grid">
        <div class="inner-hero__copy">
          <h1 id="download-heading" class="inner-hero__title">Get ace on your machine.</h1>
        </div>

        <aside
          class="inner-card inner-card--highlight"
          aria-labelledby="recommended-heading"
        >
          <div class="inner-card__top">
            <span id="version-label" class="inner-card__meta">Checking latest release...</span>
            <h2 id="recommended-heading" class="inner-card__h">Recommended build</h2>
            <p id="recommended-copy" class="inner-card__sub">Detecting your platform.</p>
          </div>
          <a
            id="recommended-download"
            class="inner-btn inner-btn--primary is-disabled"
            href="#downloads"
            aria-disabled="true"
          >
            <svg class="inner-btn__icon inner-btn__icon--apple" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true">
              <path
                fill="currentColor"
                d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
              />
            </svg>
            <svg class="inner-btn__icon inner-btn__icon--windows" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 88 88" aria-hidden="true">
              <path
                fill="currentColor"
                d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"
              />
            </svg>
            <span class="inner-btn__icon inner-btn__icon--linux" aria-hidden="true">Lx</span>
            <span class="inner-btn__label">Loading download</span>
          </a>
        </aside>
      </div>
    </section>

    <section
      id="downloads"
      class="inner-platforms"
      aria-label="All downloads"
    >
      <article class="inner-platform">
        <div class="inner-platform__head">
          <svg class="inner-platform__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
            /></svg
          >
          <h2>macOS</h2>
        </div>
        <a
          class="inner-asset"
          data-download-card
          data-key="mac-arm64"
          data-patterns="arm64.dmg,aarch64.dmg"
          href="#downloads"
          aria-disabled="true"
        >
          <strong>Apple Silicon</strong>
          <span>.dmg for M-series Macs</span>
        </a>
        <a
          class="inner-asset"
          data-download-card
          data-key="mac-x64"
          data-patterns="x64.dmg,x86_64.dmg,amd64.dmg"
          href="#downloads"
          aria-disabled="true"
        >
          <strong>Intel Mac</strong>
          <span>.dmg for x64 Macs</span>
        </a>
      </article>

      <article class="inner-platform">
        <div class="inner-platform__head">
          <svg class="inner-platform__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 88 88" aria-hidden="true"
            ><path
              fill="currentColor"
              d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"
            /></svg
          >
          <h2>Windows</h2>
        </div>
        <a
          class="inner-asset"
          data-download-card
          data-key="windows-x64"
          data-patterns="x64.exe,x86_64.exe,amd64.exe"
          href="#downloads"
          aria-disabled="true"
        >
          <strong>Windows 10, 11</strong>
          <span>.exe installer for x64 PCs</span>
        </a>
      </article>

      <article class="inner-platform">
        <div class="inner-platform__head">
          <span class="inner-platform__linux" aria-hidden="true">Lx</span>
          <h2>Linux</h2>
        </div>
        <a
          class="inner-asset"
          data-download-card
          data-key="linux-x64"
          data-patterns="x86_64.AppImage,x64.AppImage,amd64.AppImage,.AppImage"
          href="#downloads"
          aria-disabled="true"
        >
          <strong>x86_64</strong>
          <span>AppImage build</span>
        </a>
      </article>
    </section>

    <p class="inner-note">
      Need release notes?
      <a href="/changelog">View the changelog <span aria-hidden="true">→</span></a>
    </p>
  </div>
</Layout>

<script>
  import { fetchLatestRelease } from "../lib/releases";

  type PlatformKey = "mac-arm64" | "mac-x64" | "windows-x64" | "linux-x64";
  type Recommendation =
    | {
        kind: "asset";
        key: PlatformKey;
        heading: string;
        copy: string;
        buttonLabel: string;
      }
    | {
        kind: "section";
        heading: string;
        copy: string;
        buttonLabel: string;
        href: string;
      };
  type UserAgentDataValues = {
    architecture?: string;
    platform?: string;
  };
  type UserAgentData = {
    architecture?: string;
    platform?: string;
    getHighEntropyValues?: (hints: string[]) => Promise<UserAgentDataValues>;
  };

  const PLATFORM_LABELS: Record<PlatformKey, string> = {
    "mac-arm64": "Download for Apple Silicon",
    "mac-x64": "Download for Intel Mac",
    "windows-x64": "Download for Windows",
    "linux-x64": "Download for Linux",
  };

  function assetRecommendation(key: PlatformKey): Recommendation {
    return {
      kind: "asset",
      key,
      heading: "Recommended build",
      copy: PLATFORM_LABELS[key],
      buttonLabel: PLATFORM_LABELS[key],
    };
  }

  function chooseBuildRecommendation(): Recommendation {
    return {
      kind: "section",
      heading: "Choose your build",
      copy: "Select the build for your operating system below.",
      buttonLabel: "View all downloads",
      href: "#downloads",
    };
  }

  function normalizeMacArchitecture(value: string | undefined): "arm64" | "x64" | null {
    const normalized = value?.toLowerCase() ?? "";
    if (/(^|[^a-z0-9])(arm|arm64|aarch64)([^a-z0-9]|$)/i.test(normalized)) {
      return "arm64";
    }
    if (/(^|[^a-z0-9])(x86|x64|x86_64|amd64)([^a-z0-9]|$)/i.test(normalized)) {
      return "x64";
    }
    return null;
  }

  function resolvePlatform(value: string | undefined): "mac" | "windows" | "linux" | null {
    const normalized = value?.toLowerCase() ?? "";
    if (normalized.includes("mac")) return "mac";
    if (normalized.includes("win")) return "windows";
    if (normalized.includes("linux") || normalized.includes("chrome os")) return "linux";
    return null;
  }

  async function readUserAgentData(): Promise<UserAgentDataValues | null> {
    const userAgentData = (navigator as Navigator & { userAgentData?: UserAgentData }).userAgentData;
    if (!userAgentData) {
      return null;
    }

    if (typeof userAgentData.getHighEntropyValues === "function") {
      try {
        return await userAgentData.getHighEntropyValues(["architecture", "platform"]);
      } catch {
        return {
          architecture: userAgentData.architecture,
          platform: userAgentData.platform,
        };
      }
    }

    return {
      architecture: userAgentData.architecture,
      platform: userAgentData.platform,
    };
  }

  async function detectRecommendation(): Promise<Recommendation> {
    const userAgentData = await readUserAgentData();
    const clientHintsPlatform = resolvePlatform(userAgentData?.platform);
    if (clientHintsPlatform === "windows") return assetRecommendation("windows-x64");
    if (clientHintsPlatform === "linux") return assetRecommendation("linux-x64");
    if (clientHintsPlatform === "mac") {
      const architecture = normalizeMacArchitecture(userAgentData?.architecture);
      if (architecture === "arm64") return assetRecommendation("mac-arm64");
      if (architecture === "x64") return assetRecommendation("mac-x64");
      return assetRecommendation("mac-arm64");
    }

    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return assetRecommendation("windows-x64");
    if (/Linux/i.test(ua)) return assetRecommendation("linux-x64");
    if (/Mac/i.test(ua)) return assetRecommendation("mac-arm64");
    return chooseBuildRecommendation();
  }

  function findAsset(
    assets: Array<{ name: string; browser_download_url: string }>,
    patterns: string[],
  ) {
    return patterns
      .map((pattern) =>
        assets.find((asset) => asset.name.toLowerCase().endsWith(pattern.toLowerCase())),
      )
      .find(Boolean);
  }

  function setCardEnabled(card: HTMLAnchorElement, href: string) {
    card.href = href;
    card.removeAttribute("aria-disabled");
    card.classList.remove("is-disabled");
  }

  function setCardUnavailable(card: HTMLAnchorElement) {
    card.href = "#downloads";
    card.setAttribute("aria-disabled", "true");
    card.classList.add("is-disabled");
  }

  function platformForKey(key: PlatformKey) {
    if (key.startsWith("mac")) return "mac";
    if (key.startsWith("windows")) return "windows";
    return "linux";
  }

  function setRecommendedButton(button: HTMLAnchorElement, label: string, platform?: string) {
    const labelEl = button.querySelector<HTMLElement>(".inner-btn__label");
    if (labelEl) labelEl.textContent = label;
    if (platform) {
      button.dataset.platform = platform;
    } else {
      delete button.dataset.platform;
    }
  }

  async function initDownloadPage() {
    const recommendation = await detectRecommendation();
    const recommendedButton = document.getElementById("recommended-download") as HTMLAnchorElement | null;
    const recommendedHeading = document.getElementById("recommended-heading");
    const recommendedCopy = document.getElementById("recommended-copy");
    const versionLabel = document.getElementById("version-label");
    const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-download-card]"));

    if (recommendedHeading) {
      recommendedHeading.textContent = recommendation.heading;
    }
    if (recommendedCopy) {
      recommendedCopy.textContent = recommendation.copy;
    }

    try {
      const release = await fetchLatestRelease();
      const assets = release.assets ?? [];

      if (versionLabel) {
        versionLabel.textContent = release.tag_name ? `Latest release ${release.tag_name}` : "Latest release";
      }
      cards.forEach((card) => {
        const patterns = (card.dataset.patterns ?? "").split(",").filter(Boolean);
        const match = findAsset(assets, patterns);
        if (match) {
          setCardEnabled(card, match.browser_download_url);
        } else {
          setCardUnavailable(card);
        }
      });

      if (recommendedButton && recommendation.kind === "section") {
        recommendedButton.href = recommendation.href;
        recommendedButton.classList.remove("is-disabled");
        recommendedButton.removeAttribute("aria-disabled");
        setRecommendedButton(recommendedButton, recommendation.buttonLabel);
        return;
      }

      if (recommendation.kind !== "asset") {
        if (recommendedButton) {
          setRecommendedButton(recommendedButton, "Download unavailable");
        }
        return;
      }

      const recommendedCard = cards.find((card) => card.dataset.key === recommendation.key);
      if (recommendedButton && recommendedCard?.href && recommendedCard.getAttribute("aria-disabled") !== "true") {
        recommendedButton.href = recommendedCard.href;
        recommendedButton.classList.remove("is-disabled");
        recommendedButton.removeAttribute("aria-disabled");
        setRecommendedButton(recommendedButton, recommendation.buttonLabel, platformForKey(recommendation.key));
      } else if (recommendedButton) {
        setRecommendedButton(recommendedButton, "Download unavailable");
      }
    } catch {
      if (versionLabel) {
        versionLabel.textContent = "Release information unavailable";
      }
      if (recommendedButton) {
        setRecommendedButton(recommendedButton, "Download unavailable");
      }
      cards.forEach(setCardUnavailable);
    }
  }

  initDownloadPage();
</script>

<style>
  .inner-page {
    --ip-pad: var(--site-pad, clamp(1rem, 4vw, 2rem));
    --ip-max: var(--site-max, 1200px);
    position: relative;
    width: min(100% - 2rem, var(--ip-max));
    margin: 0 auto;
    padding: 0 0 clamp(3.5rem, 9vw, 7rem);
    isolation: isolate;
  }

  .inner-page__noise {
    display: none;
  }

  .inner-page > :not(.inner-page__noise) {
    position: relative;
    z-index: 1;
  }

  .inner-hero {
    padding: clamp(1rem, 2vw, 1.5rem) 0 clamp(2rem, 5vw, 3rem);
  }

  .inner-hero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
    align-items: end;
  }

  @media (min-width: 960px) {
    .inner-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.62fr);
      align-items: center;
      gap: 3rem 3.5rem;
    }
  }

  .inner-hero__copy {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }

  .inner-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4vw, 3.1rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-wrap: balance;
    max-width: 16ch;
  }

  .inner-card {
    border-radius: 16px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    padding: 1.35rem;
  }

  .inner-card--highlight:hover {
    border-color: var(--fg-dim);
  }

  .inner-card__top {
    display: grid;
    gap: 0.45rem;
  }

  .inner-card__meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--fg-muted);
    letter-spacing: 0.04em;
  }

  .inner-card__h {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .inner-card__sub {
    color: var(--fg-muted);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .inner-btn {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    margin-top: 1.25rem;
    width: 100%;
    border-radius: 12px;
    padding: 0.78rem 1rem;
    font-weight: 700;
    font-size: 0.92rem;
  }

  .inner-btn--primary {
    background: var(--fg);
    color: var(--ink);
    border: 1px solid transparent;
  }

  .inner-btn--primary:not(.is-disabled):hover {
    background: #e0e0e0;
  }

  .inner-btn__icon {
    display: none;
    width: 1rem;
    height: 1rem;
    flex: 0 0 1rem;
  }

  .inner-btn__icon--linux {
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
  }

  .inner-btn[data-platform="mac"] .inner-btn__icon--apple,
  .inner-btn[data-platform="windows"] .inner-btn__icon--windows {
    display: block;
  }

  .inner-btn[data-platform="linux"] .inner-btn__icon--linux {
    display: inline-grid;
  }

  .inner-platforms {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .inner-platform {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    min-height: 14rem;
    padding: 1.25rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .inner-platform:hover {
    border-color: var(--line-strong);
  }

  .inner-platform__head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.2rem;
  }

  .inner-platform__head h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .inner-platform__icon {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--fg);
  }

  .inner-platform__linux {
    display: inline-grid;
    place-items: center;
    width: 1.2rem;
    height: 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
  }

  .inner-asset {
    display: grid;
    gap: 0.2rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--bg);
    padding: 0.9rem;
    font-size: 0.88rem;
  }

  .inner-asset:hover {
    border-color: var(--line-strong);
    background: rgba(255, 255, 255, 0.05);
  }

  .inner-asset strong {
    color: var(--fg);
    font-size: 0.98rem;
  }

  .inner-asset span {
    color: var(--fg-muted);
  }

  .is-disabled {
    cursor: not-allowed;
    opacity: 0.48;
  }

  .inner-note {
    margin-top: 1.5rem;
    color: var(--fg-dim);
    font-size: 0.94rem;
  }

  .inner-note a {
    color: var(--fg);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .inner-platforms {
      grid-template-columns: 1fr;
    }

    .inner-platform {
      min-height: auto;
    }

    .inner-hero__grid {
      min-height: auto;
    }
  }

  @media (max-width: 640px) {
    .inner-page {
      width: min(100% - 1rem, var(--ip-max));
    }
  }
</style>
