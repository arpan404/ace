---
import AceMark from "../components/AceMark.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Page not found: ace" description="This page doesn't exist on the ace site." noindex>
  <main class="missing">
    <AceMark size={44} />
    <h1>Page not found</h1>
    <p>This address doesn't match a page. The home page has everything about ace.</p>
    <a class="button button-primary" href="/">Go to the home page</a>
  </main>
</Base>

<style>
  .missing {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 16px;
    min-height: 100dvh;
    padding: 24px;
    text-align: center;
  }

  h1 {
    font-size: 32px;
  }

  p {
    color: var(--muted);
    max-width: 30em;
  }
</style>
