---
import AceMark from "../components/AceMark.astro";
import { routes } from "../content/routes.ts";
import Base from "../layouts/Base.astro";

/* The top-level pages, so a broken link still leads somewhere useful. */
const sections = routes.filter((entry) => entry.parent === "/");
---

<Base title="Page not found: ace" description="This page doesn't exist on the ace site." noindex>
  <main class="missing">
    <AceMark size={44} />
    <h1>Page not found</h1>
    <p>This address doesn't match a page. One of these may be what you were after.</p>
    <a class="button button-primary" href="/">Go to the home page</a>
    <ul>
      {
        sections.map((entry) => (
          <li>
            <a class="text-link" href={entry.path}>
              {entry.name}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .missing {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 16px;
    min-height: 100dvh;
    padding: 24px;
    text-align: center;
  }

  h1 {
    font-size: 32px;
  }

  p {
    color: var(--muted);
    max-width: 30em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 20px;
    margin-top: 16px;
    font-size: 14px;
  }
</style>
