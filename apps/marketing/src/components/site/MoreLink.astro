---
/* "Learn more →": a plain text link onward to the page that covers a section in full. */
import Icon from "../Icon.astro";

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<p class="more">
  <a class="text-link" href={href}>{label}</a>
  <Icon name="arrow-right" size={14} />
</p>

<style>
  .more {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    color: var(--muted);
    font-size: 14px;
  }
</style>
