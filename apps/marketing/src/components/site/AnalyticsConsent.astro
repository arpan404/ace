---
import { analyticsConsent, privacyPolicy } from "../../content/legal.ts";

const projectKey = import.meta.env.PUBLIC_POSTHOG_KEY?.trim();
const region = import.meta.env.PUBLIC_POSTHOG_REGION?.trim().toLowerCase();
const host = region === "eu" ? "https://eu.i.posthog.com" : "https://us.i.posthog.com";
---

{
  projectKey?.startsWith("phc_") && (region === "eu" || !region || region === "us") && (
    <section
      id="analytics-consent"
      class="ph-no-capture"
      aria-labelledby="analytics-consent-title"
      data-project-key={projectKey}
      data-api-host={host}
      hidden
    >
      <div class="page consent-inner">
        <div>
          <h2 id="analytics-consent-title" tabindex="-1">{analyticsConsent.title}</h2>
          <p>
            {analyticsConsent.description}{" "}
            <a href={privacyPolicy.path}>{analyticsConsent.privacyLink}</a>
          </p>
        </div>
        <div class="choices">
          <button class="button button-secondary" type="button" data-analytics-choice="off">
            {analyticsConsent.decline}
          </button>
          <button class="button button-primary" type="button" data-analytics-choice="on">
            {analyticsConsent.accept}
          </button>
        </div>
      </div>
    </section>
  )
}

<style>
  section {
    position: fixed;
    z-index: 50;
    inset-inline: 0;
    inset-block-end: 0;
    padding-block: 16px calc(16px + env(safe-area-inset-bottom));
    border-block-start: 1px solid var(--border-strong);
    background: var(--surface);
  }

  .consent-inner {
    display: grid;
    gap: 12px;
    align-items: center;
  }

  h2 {
    font-size: 15px;
    font-weight: 600;
  }

  p {
    margin-block-start: 4px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.45;
    text-wrap: pretty;
  }

  a {
    color: var(--foreground);
    white-space: nowrap;
  }

  .choices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  button {
    cursor: pointer;
    box-shadow: none;
    block-size: auto;
    min-block-size: 42px;
    padding: 8px 12px;
    white-space: normal;
  }

  @media (min-width: 768px) {
    .consent-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 24px;
    }

    button {
      padding-inline: 20px;
    }
  }
</style>

<script>
  import { setupMarketingAnalytics } from "../../scripts/marketing-analytics.ts";

  setupMarketingAnalytics();
</script>
