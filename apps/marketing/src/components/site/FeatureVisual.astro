---
/* The picture for each feature page: the home page's Mac playing that feature's scene. */
import type { FeatureSlug } from "../../content/features.ts";
import { featureScenes } from "../../content/stage.ts";
import MacStory from "../mac/MacStory.astro";

interface Props {
  slug: FeatureSlug;
}

const { slug } = Astro.props;
---

<div class="page visual reveal">
  <MacStory only={featureScenes[slug]} />
</div>

<style>
  .visual {
    margin-top: 64px;
  }
</style>
