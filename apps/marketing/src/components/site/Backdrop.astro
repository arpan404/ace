---
/*
 * What stands behind every page: ace's mark, set in the letters of its own name
 * (scripts/ascii-mark.ts) and printed so faintly it reads as the ground's grain rather than a
 * picture. It prints itself row by row the first time a visitor sees it, then stays put while
 * the page scrolls over it. Here and there a letter quietly changes to another letter of the
 * name and back; every so often a ring of light spreads through the letters from the diamond
 * at the mark's heart; and the letters near the pointer come up a little, as
 * if a lamp were held to them. Decoration only: it is hidden from assistive technology and takes no
 * clicks, and with reduced motion it is a still print.
 */
import { aceMarkBox, aceWing } from "../../brand/mark.ts";
import { markRows } from "../../scripts/ascii-mark.ts";

/* Geist Mono's letters are 0.6em wide; the rows are set 1.15em apart. */
const advance = 0.6;
const leading = 1.15;
/* Two settings of the same mark: fewer, larger letters for a narrow screen, where finer ones
   would blur into a texture, and more for a wide one. */
const word = "ace";
const settings = [
  { name: "coarse", columns: 96 },
  { name: "fine", columns: 150 },
].map(({ name, columns }) => ({
  name,
  width: columns * advance,
  rows: markRows({
    wing: aceWing,
    box: aceMarkBox,
    columns,
    cell: advance / leading,
    word,
  }),
}));
---

<div class="backdrop" aria-hidden="true" data-backdrop data-word={word}>
  <div class="layer base">
    {
      settings.map((setting) => (
        <pre class={setting.name} style={`--columns:${setting.width}`}>{setting.rows.map((row) => <span>{row || " "}</span>)}</pre>
      ))
    }
  </div>
</div>
<script is:inline>
  /* The mark prints itself once per visit, not on every page: later pages open with it there. */
  try {
    if (sessionStorage.getItem("ace-backdrop")) document.currentScript.previousElementSibling.dataset.seen = "";
    else sessionStorage.setItem("ace-backdrop", "1");
  } catch {}
</script>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    /* The mark's width; each setting sizes its type so its columns fill it. */
    --mark: min(150vw, 128vh);
    /* Where the mark's heart is. It stands to the right, running off the page's edge, and from
       tablet width up far enough over to leave the text column clear. */
    --cx: 60%;
    --cy: 56%;
    /* It fades toward the side the words are read from, and is at full strength only near the
       far edge, so even a headline that runs the page's width has little printed under it. */
    mask-image: linear-gradient(to right, transparent 34%, #000 92%);
  }

  .layer {
    position: absolute;
    inset: 0;
    color: color-mix(in srgb, var(--foreground) 5.5%, transparent);
  }

  /* Printing: the rows appear from the top down, a few at a time, as a line printer lays them. */
  :global(html.motion) .backdrop:not([data-seen]) .base {
    animation: print 1.5s steps(36) 0.25s both;
  }

  @keyframes print {
    from {
      clip-path: inset(0 0 100% 0);
    }

    to {
      clip-path: inset(0);
    }
  }

  /* The lamp and the ring are the same letters again, brighter, each seen only through an
     opening. The script makes these layers; they are not in the page without it. */
  .layer:global(.lamp) {
    color: color-mix(in srgb, var(--foreground) 22%, transparent);
    opacity: 0;
    mask-image: radial-gradient(circle 240px at var(--mx, 50%) var(--my, 50%), #000, transparent);
    transition: opacity 0.6s var(--ease-out);
  }

  :global(html[data-theme="light"]) .layer:global(.lamp) {
    color: color-mix(in srgb, var(--foreground) 15%, transparent);
  }

  .backdrop[data-lit] .layer:global(.lamp) {
    opacity: 1;
  }

  /*
   * The ring: an opening in the shape of a ring, sharp at its leading edge and trailing off
   * behind, that grows from the mark's heart until it has left the screen, then rests. It moves
   * in steps, a dozen a second, which suits letters and costs little to draw.
   */
  .layer:global(.ring) {
    --at: 0%;
    color: color-mix(in srgb, var(--foreground) 17%, transparent);
    opacity: 0;
    mask-image: radial-gradient(
      circle farthest-corner at var(--cx) var(--cy),
      transparent calc(var(--at) - 26%),
      #000 var(--at),
      transparent calc(var(--at) + 3%)
    );
    animation: ring 10s steps(120) 2.2s infinite;
  }

  :global(html[data-theme="light"]) .layer:global(.ring) {
    color: color-mix(in srgb, var(--foreground) 12%, transparent);
  }

  @property --at {
    syntax: "<percentage>";
    inherits: false;
    initial-value: 0%;
  }

  @keyframes ring {
    0% {
      --at: 0%;
      opacity: 0;
    }

    6% {
      opacity: 1;
    }

    40% {
      opacity: 0.7;
    }

    62%,
    100% {
      --at: 128%;
      opacity: 0;
    }
  }

  pre {
    position: absolute;
    top: var(--cy);
    left: var(--cx);
    margin: 0;
    translate: -50% -50%;
    font-family: var(--font-mono);
    font-size: calc(var(--mark) / var(--columns));
    font-weight: 500;
    line-height: 1.15;
  }

  /* A row to an element, so a letter that changes redraws its own row and nothing else. */
  pre span {
    display: block;
    height: 1.15em;
  }

  .fine {
    display: none;
  }

  @media (min-width: 760px) {
    .backdrop {
      --cx: 82%;
      --cy: 52%;
    }

    .coarse {
      display: none;
    }

    .fine {
      display: block;
    }
  }

  /* The mark drifts a little against the page as it scrolls, where the browser can tie an
     animation to scrolling. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      pre {
        animation: drift linear both;
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes drift {
    from {
      translate: -50% calc(-50% + 6vh);
    }

    to {
      translate: -50% calc(-50% - 6vh);
    }
  }
</style>

<script>
  import { pickCell } from "../../scripts/ascii-mark.ts";

  /*
   * What moves in the backdrop. Where motion is on: the ring, a brighter copy of the letters,
   * and the flips, a few letters at a time that each change to another letter of the name, hold,
   * and change back, in cells chosen at random. On devices with a pointer: the lamp, another
   * brighter copy, made the first time the pointer moves.
   */
  const flipsAtOnce = 10;
  const backdrop = document.querySelector<HTMLElement>("[data-backdrop]");
  const base = backdrop?.querySelector<HTMLElement>(".base");

  if (backdrop && base) {
    /* Every copy of the letters, so a letter that changes changes in all of them. */
    const layers = [base];
    const copy = (name: string) => {
      const layer = base.cloneNode(true) as HTMLElement;
      layer.className = `${base.className.replace("base", "").trim()} ${name}`;
      backdrop.append(layer);
      layers.push(layer);
      return layer;
    };

    if (document.documentElement.classList.contains("motion")) {
      copy("ring");
      const word = backdrop.dataset.word ?? "";
      const settings = [...base.querySelectorAll("pre")].map((pre, index) => ({
        pre,
        index,
        rows: [...pre.children].map((row) => row.textContent ?? ""),
      }));
      const write = (setting: number, row: number, column: number, letter: string) => {
        for (const layer of layers) {
          const text = layer.querySelectorAll("pre")[setting]?.children[row]?.firstChild;
          if (text instanceof Text) text.replaceData(column, 1, letter);
        }
      };
      /** One flip, over and over: a cell changes, holds, changes back, and another is chosen. */
      const keepFlipping = () => {
        // Only the setting on show flips; the other is not displayed at this width.
        const shown = settings.find((setting) => setting.pre.offsetParent);
        const cell = shown && pickCell(shown.rows, word, Math.random);
        if (!shown || !cell) return void setTimeout(keepFlipping, 4000);
        write(shown.index, cell.row, cell.column, cell.other);
        setTimeout(
          () => {
            write(shown.index, cell.row, cell.column, cell.letter);
            setTimeout(keepFlipping, 300 + Math.random() * 2400);
          },
          900 + Math.random() * 1500,
        );
      };
      for (let at = 0; at < flipsAtOnce; at++) setTimeout(keepFlipping, 2400 + at * 350);
    }

    if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
      let lamp: HTMLElement | undefined;
      let x = 0;
      let y = 0;
      let waiting = false;
      const light = () => {
        waiting = false;
        lamp ??= copy("lamp");
        lamp.style.setProperty("--mx", `${x}px`);
        lamp.style.setProperty("--my", `${y}px`);
        backdrop.dataset.lit = "";
      };
      addEventListener(
        "pointermove",
        (event) => {
          x = event.clientX;
          y = event.clientY;
          if (waiting) return;
          waiting = true;
          requestAnimationFrame(light);
        },
        { passive: true },
      );
      document.documentElement.addEventListener("pointerleave", () => delete backdrop.dataset.lit);
    }
  }
</script>
