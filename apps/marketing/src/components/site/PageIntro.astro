---
/* The top of an inner page: its one H1, an intro, the download button and optional points. */
import DownloadButton from "../DownloadButton.astro";

interface Props {
  headline: string;
  intro: string;
  points?: string[];
  /** A second action beside Download, such as a link further into the site. */
  secondary?: { href: string; label: string };
}

const { headline, intro, points = [], secondary } = Astro.props;
---

<header class="page intro">
  <h1>{headline}</h1>
  <p class="lead">{intro}</p>
  <div class="actions">
    <DownloadButton />
    {
      secondary && (
        <a class="button button-secondary" href={secondary.href}>
          {secondary.label}
        </a>
      )
    }
  </div>
  {
    points.length > 0 && (
      <ul class="points">
        {points.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    )
  }
</header>

<style>
  .intro {
    padding-top: 48px;
  }

  h1 {
    max-width: 14em;
    font-size: clamp(36px, 4.6vw, 54px);
    letter-spacing: -0.045em;
  }

  .lead {
    margin-top: 20px;
    max-width: 36em;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 40px;
    max-width: 760px;
    margin-top: 40px;
    color: var(--muted);
    font-size: 14.5px;
  }

  .points li {
    display: flex;
    gap: 12px;
  }

  .points li::before {
    content: "";
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    margin-top: 0.62em;
    border-radius: 50%;
    background: var(--faint);
  }

  @media (max-width: 640px) {
    .points {
      grid-template-columns: 1fr;
    }
  }
</style>
