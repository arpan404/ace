---
/*
 * A legal document as a page: its heading, the date it took effect and a plain summary, then
 * the sections in a readable measure beside a table of contents. Each section has an anchor
 * made from its heading. Printed, it is the document alone.
 */
import { legalDocuments, type LegalDocument } from "../../content/legal.ts";
import Page from "../../layouts/Page.astro";
import { anchorIds } from "../../scripts/legal-outline.ts";
import { textRuns } from "../../scripts/legal-text.ts";
import { contact } from "../../site.ts";
import Contents from "../legal/Contents.astro";

interface Props {
  document: LegalDocument;
  /** The page's <title> and description, when they differ from the document's own. */
  title?: string;
  description?: string;
}

const { document, title = document.title, description = document.description } = Astro.props;
const others = legalDocuments.filter((entry) => entry.path !== document.path);
const ids = anchorIds(document.sections.map((section) => section.heading));
const sections = document.sections.map(({ heading, body }, index) => ({
  heading,
  body,
  id: ids[index] ?? "",
}));
---

<Page path={document.path} title={title} description={description}>
  <header class="page intro">
    <h1>{document.headline}</h1>
    <p class="effect">
      In effect from <time datetime={document.updatedIso}>{document.updated}</time>
    </p>
    <p class="lead">{document.intro}</p>
  </header>

  <section class="section page body">
    <aside class="side">
      <Contents entries={sections} />
    </aside>
    <article class="doc">
      {
        sections.map((section) => (
          <section class="part" id={section.id} aria-labelledby={`${section.id}-title`}>
            <h2 id={`${section.id}-title`}>
              <a href={`#${section.id}`}>{section.heading}</a>
            </h2>
            {section.body.map((block) =>
              typeof block === "string" ? (
                <p>
                  {textRuns(block, contact.email).map((run) =>
                    run.kind === "code" ? (
                      <code>{run.text}</code>
                    ) : run.kind === "email" ? (
                      <a class="text-link" href={`mailto:${run.text}`}>
                        {run.text}
                      </a>
                    ) : (
                      run.text
                    ),
                  )}
                </p>
              ) : (
                <ul>
                  {block.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ),
            )}
          </section>
        ))
      }
      <nav class="others" aria-label="Legal">
        {
          others.map((entry) => (
            <a class="text-link" href={entry.path}>
              {entry.headline}
            </a>
          ))
        }
        <a class="text-link" href="/security/">Security and privacy</a>
      </nav>
    </article>
  </section>
</Page>

<style>
  .intro {
    padding-top: clamp(40px, 6vw, 80px);
  }

  h1 {
    max-width: 13em;
    font-size: clamp(44px, 7.2vw, 96px);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .effect {
    margin-top: 18px;
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .lead {
    margin-top: clamp(18px, 2.4vw, 28px);
    max-width: 36em;
    color: var(--muted);
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.55;
  }

  .body {
    display: grid;
    gap: 32px clamp(40px, 6vw, 88px);
    align-items: start;
  }

  @media (min-width: 1000px) {
    .body {
      grid-template-columns: 232px minmax(0, 1fr);
    }

    .side {
      position: sticky;
      top: 96px;
      max-height: calc(100vh - 120px);
      overflow-y: auto;
      scrollbar-width: none;
    }
  }

  /* The text: about 68 characters a line, sections apart on hairlines. */
  .doc {
    max-width: 68ch;
    font-size: 16px;
  }

  .part {
    padding-block: 36px;
    scroll-margin-top: 96px;
  }

  .part:first-child {
    padding-top: 0;
  }

  .part + .part {
    border-top: 1px solid var(--border);
  }

  h2 {
    font-size: clamp(22px, 2.4vw, 28px);
    letter-spacing: -0.035em;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--faint);
    text-underline-offset: 5px;
  }

  .part p,
  .part ul {
    margin-top: 14px;
    color: var(--muted);
    line-height: 1.75;
  }

  .part ul {
    display: grid;
    gap: 8px;
    padding-left: 1.2em;
    list-style: disc;
  }

  .part li::marker {
    color: var(--faint);
  }

  code {
    font-size: 0.9em;
    color: var(--foreground);
  }

  .others {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    font-size: 15px;
  }

  /* On paper: the document alone, in black on white, with the site's frame left off. */
  @media print {
    :global(.nav, .backdrop, .footer, .crumbs, .closing) {
      display: none !important;
    }

    :global(body) {
      background: #fff !important;
      color: #000;
    }

    .section::before,
    .side,
    .others {
      display: none;
    }

    .intro,
    .body {
      padding: 0;
      max-width: none;
    }

    .body {
      display: block;
      margin-top: 24pt;
    }

    h1 {
      font-size: 28pt;
    }

    .lead,
    .effect,
    .part p,
    .part ul {
      color: #000;
    }

    .doc {
      max-width: none;
      font-size: 11pt;
    }

    .part {
      padding-block: 14pt;
      border-color: #ccc;
      break-inside: avoid-page;
    }

    h2 {
      font-size: 15pt;
      break-after: avoid;
    }
  }
</style>
