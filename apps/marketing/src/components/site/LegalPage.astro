---
/*
 * A legal document as a page: its heading, the date it took effect, the sections, and links to
 * the other legal pages. `code` in the copy is written with backticks and shown as code.
 */
import { legalDocuments, type LegalDocument } from "../../content/legal.ts";
import Page from "../../layouts/Page.astro";

interface Props {
  document: LegalDocument;
}

const { document } = Astro.props;
const others = legalDocuments.filter((entry) => entry.path !== document.path);
/** Text and code runs: odd pieces of a backtick split are code. */
const runs = (text: string) =>
  text.split("`").map((piece, index) => ({ text: piece, code: index % 2 === 1 }));
---

<Page path={document.path} title={document.title} description={document.description}>
  <div class="page">
    <article class="legal">
      <header>
        <h1>{document.headline}</h1>
        <p class="updated">
          Last updated <time datetime={document.updatedIso}>{document.updated}</time>
        </p>
        <p class="lead">{document.intro}</p>
      </header>
      {
        document.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.body.map((block) =>
              typeof block === "string" ? (
                <p>{runs(block).map((run) => (run.code ? <code>{run.text}</code> : run.text))}</p>
              ) : (
                <ul>
                  {block.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ),
            )}
          </section>
        ))
      }
      <nav class="others" aria-label="Legal">
        {
          others.map((entry) => (
            <a class="text-link" href={entry.path}>
              {entry.headline}
            </a>
          ))
        }
        <a class="text-link" href="/security/">Security and privacy</a>
      </nav>
    </article>
  </div>
</Page>

<style>
  .legal {
    display: grid;
    gap: 44px;
    max-width: 760px;
    padding-block: 48px 112px;
  }

  h1 {
    font-size: clamp(36px, 5vw, 52px);
  }

  .updated {
    margin-top: 12px;
    color: var(--subtle);
    font-size: 14px;
  }

  .lead {
    margin-top: 24px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.65;
  }

  h2 {
    font-size: clamp(20px, 2.2vw, 24px);
  }

  section p,
  section ul {
    margin-top: 14px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.75;
  }

  section ul {
    display: grid;
    gap: 8px;
    padding-left: 1.2em;
    list-style: disc;
  }

  section li::marker {
    color: var(--subtle);
  }

  code {
    font-size: 0.92em;
  }

  .others {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 15px;
  }
</style>
