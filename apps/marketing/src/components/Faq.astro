---
import { faq } from "../content/product.ts";
---

<section id="faq" class="section page faq">
  <div class="reveal">
    <h2 class="section-title">Questions, answered.</h2>
  </div>
  <div class="list reveal">
    {
      faq.map((entry) => (
        <details>
          <summary>
            <h3>{entry.question}</h3>
            <span class="sign" aria-hidden="true" />
          </summary>
          <p>{entry.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    max-width: calc(760px + var(--gutter) * 2);
  }

  .faq > div:first-child {
    text-align: center;
  }

  .list {
    margin-top: 48px;
    border-top: 1px solid var(--border);
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  h3 {
    font-size: 16px;
  }

  /* A plus that turns into a minus when the answer is open. */
  .sign {
    position: relative;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    color: var(--subtle);
  }

  .sign::before,
  .sign::after {
    content: "";
    position: absolute;
    inset: 5.5px 0 auto;
    height: 1px;
    background: currentColor;
    transition: transform var(--motion-base) var(--ease-out);
  }

  .sign::after {
    transform: rotate(90deg);
  }

  details[open] .sign::after {
    transform: rotate(0deg);
  }

  details p {
    max-width: 40em;
    padding-bottom: 24px;
    color: var(--muted);
    line-height: 1.7;
  }

</style>
