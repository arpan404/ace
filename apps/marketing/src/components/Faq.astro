---
/*
 * Questions with answers that open in place: the heading on one side, the questions as ruled
 * rows in a card on the other, as the site's other lists are laid out. Answers stay in the HTML when closed, so search
 * engines read them, and the page's FAQPage data (schema.ts) lists the same entries.
 */

interface Props {
  items: { question: string; answer: string }[];
  heading?: string;
  /** A link to every question, when this shows only some. */
  moreHref?: string;
  /** An anchor id, for the one question list a page links to. */
  id?: string;
}

const { items, heading = "Questions, answered.", moreHref, id } = Astro.props;
---

<section id={id} class="section page faq">
  <div class="say reveal">
    <h2 class="section-title">{heading}</h2>
    {
      moreHref && (
        <a class="text-link" href={moreHref}>
          All questions
        </a>
      )
    }
  </div>
  <div class="card list reveal">
    {
      items.map((entry) => (
        <details>
          <summary>
            <h3>{entry.question}</h3>
            <span class="sign" aria-hidden="true" />
          </summary>
          <p>{entry.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 28px clamp(40px, 7vw, 96px);
    align-items: start;
  }

  @media (min-width: 900px) {
    .faq {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .say h2 {
    max-width: 10em;
    font-size: clamp(32px, 4.4vw, 56px);
  }

  .say .text-link {
    display: inline-block;
    margin-top: 20px;
  }

  /* The questions: flat rows ruled with hairlines, as the app rules a list. */
  .list {
    padding: 6px;
  }

  details + details {
    border-top: 1px solid var(--border);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 17px 14px;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color var(--motion-fast) var(--ease-out);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    background: var(--wash);
  }

  h3 {
    font-size: 16px;
    font-weight: 500;
  }

  /* A plus that turns into a minus when the answer is open. */
  .sign {
    position: relative;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    color: var(--subtle);
  }

  .sign::before,
  .sign::after {
    content: "";
    position: absolute;
    inset: 5.5px 0 auto;
    height: 1px;
    background: currentColor;
    transition: transform var(--motion-base) var(--ease-out);
  }

  .sign::after {
    transform: rotate(90deg);
  }

  details[open] .sign::after {
    transform: rotate(0deg);
  }

  details p {
    max-width: 40em;
    padding: 0 14px 20px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }

</style>
