---
/*
 * The agents ace runs, on a dial beside ace's composer: the reader turns it by clicking a chip
 * or with the arrow keys, the chosen agent shows in the composer's model picker, and a card
 * beside the dial says what it is and links to its page. A switch moves between the built-in
 * agents and the ones that come through the Agent Client Protocol. Where there is no room beside
 * the composer, or without the script, the chips stand in a grid instead. Words come from
 * content/roster.ts and each built-in agent's guide.
 */
import { providerIcon } from "@ace/ui-core/provider-icons";
import { agentGuides } from "../content/agent-guides.ts";
import { acpAgents } from "../content/agents.ts";
import { acpLine, roster, rosterFacts } from "../content/roster.ts";
import BrandMark from "./BrandMark.astro";
import Icon from "./Icon.astro";
import AppIcon from "./mac/AppIcon.astro";
import "./mac/ace-window.css";

const claude = providerIcon({ provider: "claude" }).brand;
const groups = [
  {
    id: "built-in",
    name: roster.builtIn,
    agents: agentGuides.map((guide) => ({
      brand: guide.brand,
      label: guide.label,
      line: guide.what,
      href: `/agents/${guide.slug}/`,
    })),
  },
  {
    id: "acp",
    name: roster.acp,
    agents: acpAgents.map((agent) => ({
      brand: agent.brand,
      label: agent.label,
      line: acpLine(agent.label),
      href: undefined,
    })),
  },
];
---

<section class="section page" id="agents">
  <header class="head reveal">
    <h2 class="section-title">{roster.heading}</h2>
    <p class="lede">{roster.lede}</p>
  </header>

  <div class="roster reveal" data-roster>
    <div class="turn">
      <div class="groups" role="tablist" aria-label={roster.dialLabel}>
        {
          groups.map((group, index) => (
            <button
              type="button"
              role="tab"
              id={`roster-tab-${group.id}`}
              aria-controls={`roster-ring-${group.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
              data-roster-group={index}
            >
              {group.name}
              <span class="count">{group.agents.length}</span>
            </button>
          ))
        }
      </div>

      <div class="stage" data-roster-stage>
        <svg class="lines" width="1" height="1" aria-hidden="true">
          <path class="track" data-roster-track></path>
          <path class="reach" data-roster-reach pathLength="1"></path>
        </svg>

        <div class="ace drawn" aria-hidden="true">
          <div class="composer" data-roster-composer>
            <span class="placeholder">{roster.prompt}</span>
            <div class="composer-foot">
              <AppIcon name="plus" size={18} />
              <span class="access"><AppIcon name="shield-check" size={16} />Auto review</span>
              <span class="model" data-roster-model>
                {claude && <BrandMark brand={claude} size={15} />}Claude Code
                <AppIcon name="caret-down" size={12} />
              </span>
              <span class="send"><AppIcon name="arrow-up" size={16} /></span>
            </div>
          </div>
        </div>

        {
          groups.map((group, index) => (
            <div
              class="ring"
              role="tabpanel"
              id={`roster-ring-${group.id}`}
              aria-labelledby={`roster-tab-${group.id}`}
              hidden={index !== 0}
              data-roster-ring={index}
            >
              {group.agents.map((agent, at) => (
                <button
                  type="button"
                  class="seat"
                  aria-pressed={at === 0 ? "true" : "false"}
                  tabindex={at === 0 ? 0 : -1}
                  data-roster-seat={at}
                >
                  <BrandMark brand={agent.brand} size={18} />
                  <span>{agent.label}</span>
                </button>
              ))}
            </div>
          ))
        }

        <div class="chosen" aria-live="polite">
          {
            groups.map((group, index) =>
              group.agents.map((agent, at) => (
                <article
                  class="card"
                  hidden={index !== 0 || at !== 0}
                  data-roster-card={`${index}-${at}`}
                >
                  <span class="tile">
                    <BrandMark brand={agent.brand} size={26} />
                  </span>
                  <p class="kicker">{index === 0 ? roster.builtIn : roster.acpLong}</p>
                  <h3>{agent.label}</h3>
                  <p class="line">{agent.line}</p>
                  {agent.href && (
                    <a class="button button-secondary button-small" href={agent.href}>
                      {roster.open(agent.label)}
                      <Icon name="arrow-right" size={14} />
                    </a>
                  )}
                </article>
              )),
            )
          }
        </div>
      </div>
    </div>

    <div class="tiers">
      {
        groups.map((group, index) => (
          <div class="tier">
            <h3 class="kicker">{index === 0 ? group.name : roster.acpLong}</h3>
            <ul class:list={["chips", { light: index > 0 }]} aria-label={group.name}>
              {group.agents.map((agent) => (
                <li>
                  {agent.href ? (
                    <a class="chip" href={agent.href}>
                      <BrandMark brand={agent.brand} size={18} />
                      {agent.label}
                      <Icon name="arrow-right" size={14} />
                    </a>
                  ) : (
                    <span class="chip">
                      <BrandMark brand={agent.brand} size={15} />
                      {agent.label}
                    </span>
                  )}
                </li>
              ))}
            </ul>
            {index > 0 && <p class="more">{roster.acpMore}</p>}
          </div>
        ))
      }
    </div>
  </div>

  <ul class="facts reveal" data-stagger>
    {
      rosterFacts.map((fact) => (
        <li class="card">
          <h3>{fact.title}</h3>
          <p>{fact.body}</p>
          {fact.href && (
            <a class="text-link" href={fact.href}>
              More
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .head h2 {
    font-size: clamp(36px, 5.6vw, 72px);
  }

  .roster {
    margin-top: clamp(36px, 5vw, 64px);
  }

  /* The dial needs room beside the composer and the script to turn it; until then, the grid. */
  .turn {
    display: none;
  }

  @media (min-width: 1040px) {
    .roster[data-live] .turn {
      display: block;
    }

    .roster[data-live] .tiers {
      display: none;
    }
  }

  /* The two groups as one segmented control, as the home page's parts are switched. */
  .groups {
    display: inline-grid;
    grid-auto-flow: column;
    gap: 2px;
    padding: 5px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
  }

  .groups button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: 14.5px;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--motion-base) var(--ease-out),
      color var(--motion-fast) var(--ease-out);
  }

  .groups button:hover {
    color: var(--foreground);
  }

  .groups button[aria-selected="true"] {
    background: var(--ink);
    color: var(--ink-foreground);
  }

  .count {
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.6;
  }

  /*
   * The composer on the left, the dial's seats in the middle (placed by the script), the chosen
   * agent's card on the right.
   */
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 400px) 290px minmax(240px, 1fr);
    align-items: center;
    min-height: 470px;
    margin-top: 24px;
  }

  .drawn {
    position: relative;
    inset: auto;
    overflow: visible;
    background: none;
  }

  .drawn .composer {
    background: var(--a-canvas);
    box-shadow: 0 24px 60px -30px var(--frame-shadow);
  }

  /* Where the composer is narrow, its access control gives way to the picker. */
  @media (max-width: 1239px) {
    .drawn .access {
      display: none;
    }
  }

  .lines {
    position: absolute;
    left: 0;
    top: 0;
    overflow: visible;
    pointer-events: none;
  }

  .lines path {
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .track {
    stroke: var(--border-strong);
  }

  .reach {
    stroke: var(--line);
    stroke-dasharray: 1;
  }

  .ring {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ring[hidden] {
    display: none;
  }

  .seat {
    position: absolute;
    left: 0;
    top: 0;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    width: 184px;
    height: 40px;
    padding: 0 14px 0 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: 0 10px 24px -16px var(--frame-shadow);
    color: var(--foreground);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    pointer-events: auto;
    transform-origin: 0 50%;
    transition:
      translate 0.6s var(--ease-out),
      scale 0.6s var(--ease-out),
      opacity 0.4s var(--ease-out),
      background-color var(--motion-base) var(--ease-out),
      color var(--motion-base) var(--ease-out);
  }

  .seat span {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .seat:hover {
    border-color: var(--border-strong);
  }

  .seat[aria-pressed="true"] {
    border-color: transparent;
    background: var(--ink);
    color: var(--ink-foreground);
  }

  .seat[data-out] {
    visibility: hidden;
    pointer-events: none;
  }

  .chosen {
    grid-column: 3;
  }

  .chosen .card {
    display: grid;
    justify-items: start;
    gap: 10px;
    padding: clamp(24px, 2.4vw, 32px);
  }

  .chosen .card[hidden] {
    display: none;
  }

  .chosen .tile {
    width: 52px;
    height: 52px;
    margin-bottom: 8px;
    border-radius: 14px;
  }

  .chosen h3 {
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .chosen .line {
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.55;
  }

  .chosen .button {
    margin-top: 8px;
  }

  /* Played once as the roster comes into view: the reach draws out of the composer, then the
     dial's chips arrive on their seats. */
  :global(html.motion) .reach {
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.8s var(--ease-out) 0.3s;
  }

  :global(html.motion) .ring,
  :global(html.motion) .track {
    opacity: 0;
    transition: opacity 0.7s var(--ease-out) 0.7s;
  }

  :global(html.motion) .roster:global(.is-in) .reach {
    stroke-dashoffset: 0;
  }

  :global(html.motion) .roster:global(.is-in) :is(.ring, .track) {
    opacity: 1;
  }

  :global(html.motion) .chosen .card {
    animation: settle 0.45s var(--ease-out) both;
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seat {
      transition: none;
    }
  }

  /* The grid: built-in agents as links to their pages, then the protocol's agents, lighter. */
  .tier + .tier {
    margin-top: 36px;
  }

  .chips {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 168px), 1fr));
    gap: 10px;
    margin-top: 14px;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 9px;
    height: 44px;
    padding: 0 14px 0 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 14.5px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }

  a.chip:hover {
    border-color: var(--border-strong);
  }

  .chip :global(svg:last-child:not(:first-child)) {
    margin-left: auto;
    color: var(--faint);
  }

  .light {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .light .chip {
    height: 34px;
    padding: 0 12px 0 10px;
    background: none;
    color: var(--muted);
    font-size: 13.5px;
  }

  .more {
    margin-top: 12px;
    color: var(--subtle);
    font-size: 13px;
  }

  /* Three facts every agent shares, as cards. */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
    margin-top: clamp(56px, 7vw, 96px);
  }

  .facts li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: clamp(22px, 2.6vw, 30px);
  }

  .facts h3 {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .facts p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .facts a {
    justify-self: start;
    font-size: 14px;
  }
</style>

<script>
  import { startRoster } from "../scripts/roster.ts";

  for (const root of document.querySelectorAll<HTMLElement>("[data-roster]")) startRoster(root);
</script>
