---
import { agentGuides as providers } from "../content/agent-guides.ts";
import { acpAgents as acp } from "../content/agents.ts";
import Icon from "./Icon.astro";
import BrandMark from "./BrandMark.astro";
---

<section id="agents" class="section page">
  <div class="reveal">
    <h2 class="section-title">Keep the agents you already pay for.</h2>
    <p class="lede">
      ace starts each CLI the way you would in a terminal. Logins, models and subscriptions stay
      with the CLI; ace never asks for or stores a key.
    </p>
  </div>

  <ul class="rule-grid providers reveal" aria-label="Built-in agents">
    {
      providers.map((provider) => (
        <li>
          <a href={`/agents/${provider.slug}/`}>
            <span class="tile">
              <BrandMark brand={provider.brand} size={20} />
            </span>
            <span class="name">{provider.label}</span>
            <span class="kind">
              Built in
              <Icon name="arrow-right" size={14} />
            </span>
          </a>
        </li>
      ))
    }
    <li class="acp">
      <div class="acp-head">
        <span class="name">Any ACP agent</span>
        <span class="kind">Agent Client Protocol</span>
      </div>
      <ul aria-label="ACP agents">
        {
          acp.map((agent) => (
            <li>
              <BrandMark brand={agent.brand} size={15} />
              {agent.label}
            </li>
          ))
        }
      </ul>
    </li>
  </ul>
</section>

<style>
  .providers {
    margin-top: 56px;
    grid-template-columns: repeat(3, 1fr);
  }

  .providers > li > a,
  .providers > .acp {
    padding: 24px;
  }

  .providers > li > a {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    text-decoration: none;
    transition: background-color var(--motion-fast) var(--ease-out);
  }

  .providers > li > a:hover {
    background: var(--wash);
  }

  .name {
    font-size: 16px;
    font-weight: 500;
  }

  .kind {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    color: var(--subtle);
    font-size: 13px;
  }

  .providers > .acp {
    grid-column: 1 / -1;
    display: grid;
    gap: 18px;
  }

  .acp-head {
    display: flex;
    align-items: center;
  }

  .acp ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .acp ul li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding-inline: 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .providers {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .providers {
      grid-template-columns: 1fr;
    }

    .providers > li > a,
    .providers > .acp {
      padding: 18px 20px;
    }
  }
</style>
