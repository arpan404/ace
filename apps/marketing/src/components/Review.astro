---
import reviewDark from "../assets/shots/review-dark.png";
import reviewLight from "../assets/shots/review-light.png";
import Shot from "./Shot.astro";
import MoreLink from "./site/MoreLink.astro";
import Stage from "./Stage.astro";
import { feature } from "../content/features.ts";

const { headline, intro } = feature("review");
---

<section id="review" class="section page">
  <div class="head reveal">
    <h2 class="section-title">{headline}</h2>
    <p class="lede">{intro}</p>
    <MoreLink href="/features/review/" label="More on worktrees and review" />
  </div>
  <div class="frame reveal">
    <Stage mood="rose" bleed>
      <div class="crop">
        <Shot
          dark={reviewDark}
        light={reviewLight}
          alt="A thread with its Changes panel open beside the conversation: a file tree with added and removed line counts, the diff of two files, and Commit & push."
          sizes="(min-width: 1232px) 1700px, 150vw"
          widths={[1440, 2880]}
        />
      </div>
    </Stage>
  </div>
</section>

<style>
  .head {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .head .lede {
    margin-inline: auto;
  }

  .frame {
    margin-top: 56px;
  }

  /* Hide the sidebar: show the conversation and the diff with its unsent comment. */
  .crop {
    width: 100%;
    max-height: 620px;
    overflow: hidden;
    border-top-left-radius: 10px;
    border: 1px solid var(--edge);
    border-right: 0;
    border-bottom: 0;
    box-shadow: 0 30px 80px -30px var(--shadow-deep);
  }

  .crop :global(img) {
    width: 124%;
    max-width: none;
    margin-left: -29%;
  }

  @media (max-width: 767px) {
    .crop :global(img) {
      width: 260%;
      margin-left: -158%;
    }
  }
</style>
