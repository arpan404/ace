---
import reviewDark from "../assets/shots/review-dark.png";
import reviewLight from "../assets/shots/review-light.png";
import ThemeShot from "./ThemeShot.astro";
---

<section id="review" class="review page">
  <div class="review-copy reveal">
    <h2 class="section-title">Review the diff next to the conversation.</h2>
    <p class="lede">
      Every thread works in its own git worktree. Comment on a line, send the comment to the
      agent, then commit and push from the same panel.
    </p>
  </div>
  <div class="window reveal">
    <ThemeShot
      light={reviewLight}
      dark={reviewDark}
      alt="A thread with its Changes panel open: a file tree with added and removed line counts, a diff, and a line comment ready to send to the agent."
      sizes="(min-width: 1280px) 1200px, calc(100vw - 48px)"
      widths={[720, 1200, 1800, 2400]}
    />
  </div>
</section>

<style>
  .review {
    display: grid;
    gap: 48px;
    padding-block: 120px;
  }

  .review-copy {
    display: grid;
    gap: 20px;
    max-width: 760px;
  }

  .window {
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--border-strong);
    box-shadow:
      0 1px 2px rgb(var(--shadow) / 0.06),
      0 24px 64px -24px rgb(var(--shadow) / 0.22);
  }

  @media (max-width: 767px) {
    .review {
      padding-block: 72px;
      gap: 32px;
    }

    .window {
      border-radius: 8px;
    }
  }
</style>
