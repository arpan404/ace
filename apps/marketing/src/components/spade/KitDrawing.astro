---
/*
 * One small drawing per thing a bot has, inside the Kit card: its notes, its routines, a skill it
 * proposes, its apps and its computer, drawn as the bot's profile and chat draw them.
 */
import { bots, kitDrawings as draw } from "../../content/spade.ts";
import BotFace from "./BotFace.astro";

interface Props {
  which: "memory" | "routines" | "skills" | "apps" | "computer";
}

const { which } = Astro.props;
---

{
  which === "memory" && (
    <ul class="rows">
      {draw.memory.notes.map((note) => (
        <li>
          <span class="main">{note.text}</span>
          <span class="side">{note.scope}</span>
        </li>
      ))}
      <li class="suggested">
        <span class="main">{draw.memory.suggested.text}</span>
        <span class="side">
          {draw.memory.suggested.dismiss}
          <span class="strong">{draw.memory.suggested.keep}</span>
        </span>
      </li>
    </ul>
  )
}

{
  which === "routines" && (
    <ul class="rows">
      {draw.routines.map((routine) => (
        <li>
          <span class="main">{routine.name}</span>
          <span class="side">{routine.when}</span>
        </li>
      ))}
    </ul>
  )
}

{
  which === "skills" && (
    <div class="skill">
      <p class="bubble">{draw.skill.say}</p>
      <div class="proposal">
        <code>{draw.skill.name}</code>
        <span>{draw.skill.description}</span>
      </div>
      <p class="words">
        <span>{draw.skill.discard}</span>
        <span class="strong">{draw.skill.save}</span>
      </p>
    </div>
  )
}

{
  which === "apps" && (
    <ul class="rows">
      {draw.apps.map((app) => (
        <li class:list={{ off: app.state !== "Signed in" }}>
          <span class="main">{app.name}</span>
          <span class="side">{app.state}</span>
        </li>
      ))}
    </ul>
  )
}

{
  which === "computer" && (
    <div class="computer">
      <div class="surfaces">
        {draw.computer.surfaces.map((surface, index) => (
          <span class:list={{ on: index === 0 }}>{surface}</span>
        ))}
      </div>
      <div class="screen">
        <span class="url">{draw.computer.url}</span>
        <div class="form">
          {draw.computer.fields.map((field) => (
            <span class="field">{field}</span>
          ))}
          <span class="field" />
        </div>
      </div>
      <div class="activity">
        <BotFace face={bots.flights.face} size={24} uid="sp-kit-pc" state="working" />
        <span>{draw.computer.activity}</span>
        <span class="take">{draw.computer.takeOver}</span>
      </div>
    </div>
  )
}

<style>
  .rows li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 13px 14px;
  }

  .rows li + li {
    border-top: 1px solid var(--border);
  }

  .main {
    min-width: 0;
  }

  .side {
    flex: none;
    color: var(--subtle);
    font-size: 13px;
  }

  .suggested .main {
    color: var(--muted);
  }

  .suggested .side {
    display: flex;
    gap: 14px;
  }

  .off .main {
    color: var(--subtle);
  }

  .skill {
    display: grid;
    justify-items: start;
    gap: 8px;
    padding: 10px;
  }

  .bubble {
    max-width: 88%;
    padding: 9px 16px;
    border-radius: 18px;
    background: color-mix(in srgb, var(--foreground) 7%, transparent);
  }

  .proposal {
    display: grid;
    gap: 2px;
    width: min(100%, 360px);
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--muted);
    font-size: 13px;
  }

  .proposal code {
    color: var(--foreground);
    font-size: 13px;
  }

  .words {
    display: flex;
    gap: 18px;
    padding-left: 4px;
    color: var(--muted);
    font-size: 13px;
  }

  .strong {
    color: var(--foreground);
    font-weight: 500;
  }

  .computer {
    display: grid;
    gap: 10px;
    padding: 8px;
  }

  .surfaces {
    display: flex;
    gap: 4px;
  }

  .surfaces span {
    padding: 4px 11px;
    border-radius: 999px;
    color: var(--subtle);
    font-size: 12px;
  }

  .surfaces .on {
    background: var(--active);
    color: var(--foreground);
  }

  .screen {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--background);
  }

  .url {
    display: block;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .form {
    display: grid;
    gap: 8px;
    padding: 14px 12px 16px;
  }

  .field {
    height: 28px;
    padding: 0 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--muted);
    font-size: 12px;
    line-height: 26px;
  }

  .activity {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 2px 4px;
    color: var(--muted);
    font-size: 13px;
  }

  .take {
    margin-left: auto;
    padding: 5px 13px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--ink-foreground);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }
</style>
