---
/*
 * A bot's character face, drawn by the app's own geometry (@ace/ui-core/bot-face) from its eight
 * fields, in one of the poses the page shows. `live` faces blink and glance at the pointer
 * (scripts/spade-cast.ts); `rest` is where one looks while the pointer is away, as "x,y" from -1
 * to 1, so a bot can look at what it is explaining. Faces keep their own colours in both themes.
 */
import { botFaceColourVars, botFaceMarkup, faceTier, type BotFace } from "@ace/ui-core/bot-face";
import { readGaze } from "../../scripts/spade-gaze.ts";
import "./bot-face.css";

export type FacePose = "idle" | "working" | "needs-you" | "done";

interface Props {
  face: BotFace;
  size: number;
  /** Unique on the page: the face's clip paths are named from it. */
  uid: string;
  state?: FacePose;
  live?: boolean;
  rest?: string;
  /** A story's poses by step ("0:idle 2:working"), for scripts/spade-scene.ts. */
  poses?: string;
  class?: string;
}

const { face, size, uid, state = "idle", live = false, rest, poses, class: className } = Astro.props;
const gaze = readGaze(rest);
const vars = { ...botFaceColourVars(face), ...(gaze ? { "--lx": gaze.x, "--ly": gaze.y } : {}) };
const style = Object.entries(vars)
  .map(([name, value]) => `${name}:${value}`)
  .join(";");
---

<svg
  class:list={["bot-face", className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  overflow="visible"
  aria-hidden="true"
  data-state={state}
  data-poses={poses}
  data-tier={faceTier(size)}
  data-live={live ? "" : undefined}
  data-rest={gaze ? rest : undefined}
  data-look={gaze ? "" : undefined}
  style={style}
  set:html={botFaceMarkup(face, size, uid)}
/>

<script>
  import { startCast } from "../../scripts/spade-cast.ts";

  // Live faces blink and glance at the pointer once motion is on.
  startCast();
</script>
