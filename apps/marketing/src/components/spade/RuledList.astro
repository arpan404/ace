---
/*
 * Rows ruled with hairlines inside one card, as the app rules a list: a name and a line under
 * it. `numbered` puts each row's place before it, for steps.
 */
interface Props {
  rows: readonly { name: string; body: string }[];
  numbered?: boolean;
}

const { rows, numbered = false } = Astro.props;
const List = numbered ? "ol" : "ul";
---

<List class="card ruled" data-stagger>
  {
    rows.map((row, index) => (
      <li>
        {numbered && <span class="place">{String(index + 1).padStart(2, "0")}</span>}
        <span class="text">
          <span class="name">{row.name}</span>
          <span class="body">{row.body}</span>
        </span>
      </li>
    ))
  }
</List>

<style>
  .ruled {
    padding: 6px;
  }

  li {
    display: flex;
    gap: 16px;
    padding: 14px 14px 15px;
  }

  li + li {
    border-top: 1px solid var(--border);
  }

  .place {
    padding-top: 2px;
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .text {
    display: grid;
    gap: 3px;
  }

  .name {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .body {
    max-width: 34em;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
</style>
