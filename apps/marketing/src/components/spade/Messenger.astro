---
/*
 * The page's big drawing: Spade's window as the app draws it (docs/design/spade.md). The list
 * (Spade's head, one row per bot, the person at the foot), the conversation (Chat.astro) and,
 * on a wide screen, the bot's profile on Details. A phone shows the conversation alone, as
 * Spade does in a narrow window.
 */
import { bots, conversation as talk } from "../../content/spade.ts";
import SpadeFace from "../mac/SpadeFace.astro";
import BotFace from "./BotFace.astro";
import Chat from "./Chat.astro";
import Glyph from "./Glyph.astro";

const rows = [
  { bot: bots.flights, line: talk.list.flights, state: "needs-you", open: true },
  { bot: bots.inbox, line: talk.list.inbox, state: "working" },
  { bot: bots.papers, line: talk.list.papers, state: "unseen" },
  { bot: bots.builds, line: talk.list.builds, state: "idle" },
] as const;
---

<section class="section page messenger">
  <header class="head reveal">
    <h2 class="section-title">{talk.heading}</h2>
    <p class="lede">{talk.lede}</p>
  </header>

  <div class="window reveal frame" aria-hidden="true">
    <div class="inside">
      <aside class="list">
        <div class="list-head">
          <SpadeFace size={36} />
          <span class="title">Spade</span>
          <span class="round"><Glyph name="search" size={15} /></span>
          <span class="round"><Glyph name="plus" size={15} /></span>
        </div>
        <ul>
          {
            rows.map((row, index) => (
              <li class:list={[row.state, { open: "open" in row }]}>
                <span class="face">
                  <BotFace
                    face={row.bot.face}
                    size={36}
                    uid={`sp-row${index}`}
                    state={row.state === "needs-you" || row.state === "working" ? row.state : "idle"}
                  />
                  {row.state === "needs-you" && <span class="dot" />}
                </span>
                <span class="text">
                  <span class="name">{row.bot.name}</span>
                  <span class="line">{row.line}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <div class="list-foot">
          <span class="me">Y</span>
          <span>{talk.list.you}</span>
          <span class="gear"><Glyph name="gear" size={16} /></span>
        </div>
      </aside>

      <Chat />

      <aside class="profile">
        <div class="strip">
          <span class="round"><Glyph name="share" size={15} /></span>
          <span class="round"><Glyph name="close" size={15} /></span>
        </div>
        <div class="who">
          <BotFace face={bots.flights.face} size={72} uid="sp-profile" state="needs-you" />
          <span class="title">{bots.flights.name}</span>
        </div>
        <div class="segments">
          {talk.profile.tabs.map((tab, index) => <span class:list={{ on: index === 0 }}>{tab}</span>)}
        </div>
        <dl>
          {
            talk.profile.rows.map((row) => (
              <div>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>
</section>

<style>
  .head h2 {
    max-width: 12em;
    font-size: clamp(36px, 5vw, 64px);
  }

  .head .lede {
    max-width: 32em;
    font-size: 17px;
  }

  .window {
    --clip-r: 16px;
    margin-top: clamp(28px, 4vw, 48px);
  }

  /* The window: one flat frame, hairlines between its places. */
  .inside {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    height: 600px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--background);
    font-size: 13px;
    line-height: 1.4;
  }

  .list,
  .profile {
    display: none;
  }

  @media (min-width: 760px) {
    .inside {
      grid-template-columns: 250px minmax(0, 1fr);
    }

    .list {
      display: flex;
      flex-direction: column;
      border-right: 1px solid var(--border);
      background: var(--surface);
    }
  }

  @media (min-width: 1180px) {
    .inside {
      grid-template-columns: 260px minmax(0, 1fr) 280px;
    }

    .profile {
      display: flex;
      flex-direction: column;
      border-left: 1px solid var(--border);
      background: var(--surface);
    }
  }

  .round {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 50%;
    background: var(--wash);
    color: var(--muted);
  }

  .list-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 16px 12px 12px 14px;
    color: var(--foreground);
  }

  .title {
    flex: 1;
    margin-left: 6px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  ul {
    flex: 1;
    padding: 0 6px;
  }

  li {
    display: flex;
    align-items: center;
    gap: 11px;
    height: 60px;
    padding: 0 10px;
    border-radius: 8px;
  }

  li.open {
    background: var(--active);
  }

  .face {
    position: relative;
    flex: none;
  }

  /* The needs-you dot, ringed in the list's own colour. */
  .face .dot {
    position: absolute;
    right: -2px;
    bottom: -1px;
    width: 12px;
    height: 12px;
    border: 2.5px solid var(--active);
    border-radius: 50%;
    background: var(--status-needs-you);
  }

  .text {
    display: grid;
    min-width: 0;
  }

  .name {
    font-size: 14px;
    font-weight: 500;
  }

  .line {
    overflow: hidden;
    color: var(--subtle);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .needs-you .line {
    color: var(--status-needs-you);
  }

  .working .line {
    color: var(--muted);
  }

  .unseen .line {
    color: var(--foreground);
  }

  .list-foot {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  .me {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--active);
    color: var(--foreground);
    font-size: 11px;
    font-weight: 600;
  }

  .gear {
    margin-left: auto;
    color: var(--subtle);
  }

  .strip {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    padding: 12px;
  }

  .who {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 4px 0 16px;
  }

  .who .title {
    margin: 0;
    font-size: 19px;
  }

  .segments {
    display: flex;
    margin: 0 16px;
    padding: 3px;
    border-radius: 999px;
    background: var(--wash);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .segments span {
    flex: 1;
    padding: 5px 0;
    border-radius: 999px;
    color: var(--muted);
    font-size: 12px;
    text-align: center;
  }

  .segments .on {
    background: var(--active);
    color: var(--foreground);
  }

  dl {
    margin: 14px 16px 0;
  }

  dl div {
    display: grid;
    gap: 2px;
    padding: 11px 2px;
  }

  dl div + div {
    border-top: 1px solid var(--border);
  }

  dt {
    color: var(--subtle);
    font-size: 12px;
  }

  dd {
    color: var(--foreground);
  }

  @media (max-width: 759px) {
    .inside {
      height: 580px;
    }
  }
</style>
