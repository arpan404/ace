---
/*
 * A two-column section of the Spade page: the heading and a sentence or two on the left, one
 * drawing or ruled list (the slot) on the right; stacked on a narrow screen. A `below` slot
 * holds an action under the words.
 */
interface Props {
  heading: string;
  lede: string;
  id?: string;
}

const { heading, lede, id } = Astro.props;
---

<section id={id} class="section page split">
  <div class="say reveal">
    <h2 class="section-title">{heading}</h2>
    <p class="lede">{lede}</p>
    <slot name="below" />
  </div>
  <div class="side reveal">
    <slot />
  </div>
</section>

<style>
  .split {
    display: grid;
    gap: 28px clamp(40px, 7vw, 96px);
    align-items: start;
  }

  @media (min-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  h2 {
    max-width: 10em;
    font-size: clamp(36px, 5vw, 64px);
  }

  .lede {
    max-width: 30em;
    font-size: 17px;
  }
</style>
