---
/* Phosphor icons, regular weight, as the app uses them. Inlined so they take currentColor. */
import appleLogo from "@phosphor-icons/core/regular/apple-logo.svg?raw";
import browser from "@phosphor-icons/core/regular/browser.svg?raw";
import chartBar from "@phosphor-icons/core/regular/chart-bar.svg?raw";
import clockCountdown from "@phosphor-icons/core/regular/clock-countdown.svg?raw";
import cursorClick from "@phosphor-icons/core/regular/cursor-click.svg?raw";
import deviceMobile from "@phosphor-icons/core/regular/device-mobile.svg?raw";
import gitPullRequest from "@phosphor-icons/core/regular/git-pull-request.svg?raw";
import githubLogo from "@phosphor-icons/core/regular/github-logo.svg?raw";
import lock from "@phosphor-icons/core/regular/lock.svg?raw";
import terminalWindow from "@phosphor-icons/core/regular/terminal-window.svg?raw";
import treeStructure from "@phosphor-icons/core/regular/tree-structure.svg?raw";

const icons = {
  "apple-logo": appleLogo,
  browser,
  "chart-bar": chartBar,
  "clock-countdown": clockCountdown,
  "cursor-click": cursorClick,
  "device-mobile": deviceMobile,
  "git-pull-request": gitPullRequest,
  "github-logo": githubLogo,
  lock,
  "terminal-window": terminalWindow,
  "tree-structure": treeStructure,
};

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 16 } = Astro.props;
const svg = icons[name].replace(
  "<svg ",
  `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" `,
);
---

<Fragment set:html={svg} />
