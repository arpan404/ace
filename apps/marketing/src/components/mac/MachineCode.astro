---
/*
 * The prompt a machine with a machine code shows a device on the account before it opens: the
 * code is typed here and checked by that machine alone.
 */
---

<div class="code-scrim" data-code-dialog>
  <div class="code-dialog" role="presentation">
    <b>Enter workstation's machine code</b>
    <p>This machine asks every device on your account for its code before it opens.</p>
    <span class="code-pin" data-pin><i></i><i></i><i></i><i></i><i></i><i></i></span>
    <span class="code-actions">
      <span>Cancel</span>
      <span class="allow" data-target="unlock">Open</span>
    </span>
  </div>
</div>
