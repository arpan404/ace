---
/*
 * An iPhone with ace on its Lock Screen: a Live Activity for a thread that ends only when every
 * agent in it has finished, and an approval arriving as a notification with its Allow and Deny.
 * The phone is drawn as hardware (titanium band, side buttons, Dynamic Island) and the screen as
 * iOS lays a Lock Screen out. The story flips `data-activity` from waiting to done and brings
 * the notification in with `.on`.
 */
import AceMark from "../AceMark.astro";
import AppIcon from "./AppIcon.astro";
---

<div class="lock" data-phone data-activity="waiting" aria-hidden="true">
  <i class="key action"></i><i class="key up"></i><i class="key down"></i><i class="key power"></i>
  <div class="lock-screen">
    <div class="lock-status">
      <span class="lock-island"><i></i></span>
      <span class="lock-tray">
        <svg width="18" height="12" viewBox="0 0 18 12" fill="currentColor"
          ><rect x="0" y="8" width="3" height="4" rx="1"></rect><rect x="5" y="5.5" width="3" height="6.5" rx="1"
          ></rect><rect x="10" y="3" width="3" height="9" rx="1"></rect><rect x="15" y="0" width="3" height="12" rx="1"
          ></rect></svg
        >
        <svg width="16" height="12" viewBox="0 0 16 12" fill="currentColor"
          ><path
            d="M8 2.3c2.2 0 4.2.9 5.7 2.3l1.2-1.3A10 10 0 0 0 8 .5 10 10 0 0 0 1.1 3.3L2.3 4.6A8.3 8.3 0 0 1 8 2.3Z"
           ></path><path
            d="M8 6c1.2 0 2.3.5 3.1 1.2l1.2-1.3A6.3 6.3 0 0 0 8 4.2c-1.7 0-3.2.6-4.3 1.7l1.2 1.3C5.7 6.5 6.8 6 8 6Z"
          ></path><path d="M8 9.6c-.5 0-.9.2-1.2.5L8 11.5l1.2-1.4c-.3-.3-.7-.5-1.2-.5Z"></path></svg
        >
        <svg width="26" height="12" viewBox="0 0 26 12" fill="none"
          ><rect x=".5" y=".5" width="22" height="11" rx="3.5" stroke="currentColor" opacity=".45"></rect><rect
            x="2"
            y="2"
            width="16"
            height="8"
            rx="2"
            fill="currentColor"></rect><rect x="23.5" y="4" width="2" height="4" rx="1" fill="currentColor" opacity=".45"
          ></rect></svg
        >
      </span>
    </div>
    <span class="lock-date">Tuesday 3 November</span>
    <span class="lock-time">9:41</span>

    <div class="lock-stack">
      <div class="lock-card activity">
        <span class="lock-icon"><AceMark size={36} /></span>
        <span class="lock-text">
          <b>Cap cold-start replay at 200 events</b>
          <span class="activity-state waiting-state"
            ><AppIcon name="circle-dashed" size={14} />Waiting on 2 agents</span
          >
          <span class="activity-state done-state"
            ><AppIcon name="check-circle" size={14} />Done. Every agent finished</span
          >
        </span>
        <span class="activity-bar"><i></i></span>
      </div>

      <div class="lock-card note-card" data-phone-note>
        <span class="lock-icon"><AceMark size={36} /></span>
        <span class="lock-text">
          <span class="lock-head"><b>Fix flaky checkout test</b><time>now</time></span>
          <span>Wants to run rm -rf node_modules/.cache/vitest</span>
        </span>
        <span class="lock-actions"><span>Deny</span><span class="allow">Allow</span></span>
      </div>
    </div>

    <span class="lock-quick torch">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"
        ><path d="M6.5 2h7v2.5L11.8 7.5V16a1.5 1.5 0 0 1-1.5 1.5h-.6A1.5 1.5 0 0 1 8.2 16V7.5L6.5 4.5Z"
        ></path></svg
      >
    </span>
    <span class="lock-quick camera">
      <svg width="21" height="21" viewBox="0 0 21 21" fill="currentColor"
        ><path
          d="M7.3 4 8.3 2.5h4.4L13.7 4H16a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm3.2 9.5a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z"
        ></path></svg
      >
    </span>
    <span class="lock-home"></span>
  </div>
</div>

<style>
  /* The body: a brushed titanium band around a black bezel. */
  .lock {
    position: absolute;
    right: 120px;
    top: 70px;
    z-index: 6;
    width: 330px;
    height: 700px;
    padding: 4px;
    border-radius: 58px;
    background: linear-gradient(
      105deg,
      #8d8f94 0%,
      #4a4b4f 9%,
      #77797e 22%,
      #3c3d41 46%,
      #6c6e73 70%,
      #36373a 88%,
      #7f8186 100%
    );
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.28),
      0 1px 0 rgb(255 255 255 / 0.12),
      0 50px 90px -30px rgb(0 0 0 / 0.65),
      0 20px 40px -24px rgb(0 0 0 / 0.5);
    color: #fff;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "SF Pro Text",
      system-ui,
      sans-serif;
    opacity: 0;
    transform: translateY(40px) scale(0.97);
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global([data-phone-shown]) .lock {
    opacity: 1;
    transform: none;
  }

  /* The Action button and volume keys on the left edge, the side button on the right. */
  .key {
    position: absolute;
    width: 4px;
    border-radius: 2px;
    background: linear-gradient(to right, #2f3033, #7a7c81 55%, #55575b);
  }

  .action {
    left: -3px;
    top: 122px;
    height: 26px;
  }

  .up {
    left: -3px;
    top: 172px;
    height: 48px;
  }

  .down {
    left: -3px;
    top: 232px;
    height: 48px;
  }

  .power {
    right: -3px;
    top: 196px;
    height: 78px;
    background: linear-gradient(to left, #2f3033, #7a7c81 55%, #55575b);
  }

  .lock-screen {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    justify-items: center;
    height: 100%;
    overflow: hidden;
    border: 7px solid #050506;
    border-radius: 54px;
    /*
     * The wallpaper: a dark sky over the curve of a horizon, lit along its edge in the site's
     * orange. Three layers: the ground below the horizon, the light along it, the sky.
     */
    background:
      radial-gradient(220% 120% at 50% 117%, #050403 0 50%, #140c07 57.6%, transparent 58%),
      radial-gradient(
        220% 120% at 50% 117%,
        transparent 57.4%,
        #ffe2c8 58.1%,
        rgb(255 150 70 / 0.72) 59.4%,
        rgb(232 96 24 / 0.34) 63%,
        rgb(150 60 12 / 0.14) 70%,
        transparent 82%
      ),
      linear-gradient(to bottom, #050505 0%, #0a0807 46%, #150d08 100%);
  }

  .lock-status {
    position: relative;
    width: 100%;
    height: 52px;
  }

  .lock-island {
    position: absolute;
    left: 50%;
    top: 10px;
    width: 96px;
    height: 28px;
    margin-left: -48px;
    border-radius: 20px;
    background: #000;
  }

  /* The front camera's lens, inside the island. */
  .lock-island i {
    position: absolute;
    right: 9px;
    top: 9px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #26304f, #05060a 70%);
  }

  .lock-tray {
    position: absolute;
    right: 26px;
    top: 18px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .lock-date {
    margin-top: 16px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    opacity: 0.92;
  }

  .lock-time {
    margin-top: -6px;
    font-size: 106px;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    opacity: 0.94;
  }

  /* Notifications gather at the bottom of a Lock Screen, newest lowest. */
  .lock-stack {
    align-self: end;
    display: grid;
    gap: 8px;
    width: calc(100% - 20px);
    margin-bottom: 96px;
  }

  .lock-card {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 10px 10px;
    align-items: center;
    padding: 12px 14px 12px 12px;
    border-radius: 24px;
    background: rgb(28 28 34 / 0.56);
    box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.16);
    backdrop-filter: blur(24px) saturate(1.6);
    -webkit-backdrop-filter: blur(24px) saturate(1.6);
    font-size: 13.5px;
    line-height: 1.3;
  }

  .lock-icon :global(.ace-logo) {
    display: block;
    border-radius: 9px;
    background: #fff;
    color: #101014;
  }

  .lock-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .lock-card b {
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .lock-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .lock-head time {
    font-size: 12.5px;
    opacity: 0.6;
  }

  .lock-text > span:last-child {
    color: rgb(255 255 255 / 0.82);
  }

  .activity-state {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #d6d8dc;
  }

  .done-state {
    display: none;
    color: #7fe0bc;
  }

  .lock[data-activity="done"] .waiting-state {
    display: none;
  }

  .lock[data-activity="done"] .done-state {
    display: flex;
  }

  .activity-bar {
    grid-column: 1 / -1;
    height: 4px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.16);
    overflow: hidden;
  }

  .activity-bar i {
    display: block;
    width: 62%;
    height: 100%;
    border-radius: 2px;
    background: #d6d8dc;
    transition:
      width 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.4s;
  }

  .lock[data-activity="done"] .activity-bar i {
    width: 100%;
    background: #57bd9b;
  }

  /* The approval's two answers, as an opened notification shows them. */
  .lock-actions {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .lock-actions span {
    display: grid;
    place-items: center;
    height: 34px;
    border-radius: 17px;
    background: rgb(255 255 255 / 0.14);
    font-size: 14px;
    font-weight: 600;
  }

  .lock-actions .allow {
    background: #fff;
    color: #101014;
  }

  .note-card {
    opacity: 0;
    transform: translateY(14px) scale(0.96);
    transition:
      opacity 0.4s,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .note-card:global(.on) {
    opacity: 1;
    transform: none;
  }

  /* The torch and the camera, in the bottom corners. */
  .lock-quick {
    position: absolute;
    bottom: 34px;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgb(28 28 34 / 0.5);
    box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.16);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .torch {
    left: 40px;
  }

  .camera {
    right: 40px;
  }

  .lock-home {
    position: absolute;
    left: 50%;
    bottom: 8px;
    width: 124px;
    height: 5px;
    margin-left: -62px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.9);
  }

  @media (prefers-reduced-motion: reduce) {
    .lock,
    .note-card,
    .activity-bar i {
      transition: none;
    }
  }
</style>
