---
/*
 * What a Mac's screen shows while a scene plays: the desktop with ace open, the Simulator
 * waiting off to the side until a scene brings it forward, and the pointer the scenes move
 * (scripts/stage-act.ts). Drawn at the screen's own 1352 × 880 points; whatever holds it
 * (devices/MacBook) gives it that box.
 */
import MacDesktop from "./MacDesktop.astro";
import Pebble from "./Pebble.astro";
import SimulatorWindow from "./SimulatorWindow.astro";
---

<div class="desktop" data-desktop>
  <MacDesktop />
  <SimulatorWindow />
  <span class="pointer" data-pointer aria-hidden="true"><Pebble size={34} /></span>
</div>

<style>
  .desktop {
    position: absolute;
    inset: 0;
    width: 1352px;
    height: 880px;
  }

  /* The Simulator sits off to the right until a scene brings it forward. */
  .desktop :global([data-sim]) {
    right: 32px;
    top: 74px;
    z-index: 6;
    opacity: 0;
    transform: translateX(60px) scale(0.96);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.6s var(--ease-out);
  }

  .desktop:global([data-sim-shown]) :global([data-sim]) {
    opacity: 1;
    transform: none;
  }

  /* Side by side, as you'd arrange them: ace narrows to make room for the Simulator. */
  .desktop:global([data-sim-shown]) :global(.window) {
    width: 930px;
  }

  .pointer {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 9;
    opacity: 0;
    transform: translate(var(--x, 900px), var(--y, 600px));
    transition:
      transform 0.85s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.3));
    pointer-events: none;
  }

  .pointer:global(.shown) {
    opacity: 1;
  }

  .pointer :global(svg) {
    transition: transform 0.12s;
  }

  .pointer:global(.press) :global(svg) {
    transform: scale(0.86);
  }

  @media (prefers-reduced-motion: reduce) {
    .pointer,
    .desktop :global(.window),
    .desktop :global([data-sim]) {
      transition: none;
    }
  }
</style>
