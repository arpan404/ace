---
/*
 * The home page's walk through ace: a Mac pinned while the visitor scrolls, with one caption
 * per scene above it. The desktop is drawn at a fixed logical size (1352 × 880) and scaled
 * as one piece, so the window, the Simulator, the phone and the pointer share one
 * coordinate space. scripts/stage-story.ts plays each scene as its marker crosses the middle.
 * With `only`, a feature page shows that one scene, unpinned, played once it is in view.
 */
import { siApple } from "simple-icons";
import { scenes, type SceneId } from "../../content/stage.ts";
import AceWindow from "./AceWindow.astro";
import Pebble from "./Pebble.astro";
import PhoneLockScreen from "./PhoneLockScreen.astro";
import SimulatorWindow from "./SimulatorWindow.astro";

interface Props {
  only?: SceneId;
}

const { only } = Astro.props;
const shown = only ? [] : scenes;
/** One marker per scene to play: every home scene, or the feature page's one. */
const played: SceneId[] = only ? [only] : scenes.map((scene) => scene.id);
---

<section
  class:list={["story", { single: only }]}
  style={`--scenes: ${played.length}`}
  data-story-root
>
  <div class="pin">
    <ol class="captions page">
      {
        shown.map((scene, index) => (
          <li class:list={["caption", { on: index === 0 }]} data-caption={index}>
            <span class="n">{String(index + 1).padStart(2, "0")}</span>
            <h2>{scene.title}</h2>
            <p>
              {scene.body}{" "}
              <a href={scene.href}>More</a>
            </p>
          </li>
        ))
      }
    </ol>

    <div class="mac-wrap">
      <div class="mac" data-mac>
        <div class="desktop" data-desktop>
          <div class="wallpaper"></div>
          <div class="menubar">
            <svg class="apple" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={siApple.path}></path>
            </svg>
            <b>ace</b><span>File</span><span>Edit</span><span>View</span><span>Window</span><span
              >Help</span
            >
            <span class="tray">
              <svg width="17" height="12" viewBox="0 0 15 11" fill="currentColor" aria-hidden="true"
                ><path
                  d="M7.5 2.2c2 0 3.8.8 5.2 2l1.1-1.2A9.2 9.2 0 0 0 7.5.5 9.2 9.2 0 0 0 1.2 3l1.1 1.2a7.6 7.6 0 0 1 5.2-2Zm0 3.2c1.1 0 2.1.4 2.9 1.1l1.1-1.2A5.8 5.8 0 0 0 7.5 3.7c-1.5 0-2.9.6-4 1.6l1.1 1.2c.8-.7 1.8-1.1 2.9-1.1Zm0 3.2c-.4 0-.8.2-1.1.4L7.5 10.5l1.1-1.5c-.3-.2-.7-.4-1.1-.4Z"
                ></path></svg
              >
              <svg width="27" height="12" viewBox="0 0 24 11" fill="none" aria-hidden="true"
                ><rect x=".5" y=".5" width="20" height="10" rx="3" stroke="currentColor" opacity=".5"
                ></rect><rect x="2" y="2" width="14" height="7" rx="1.6" fill="currentColor"
                ></rect><rect
                  x="21.5"
                  y="3.5"
                  width="1.6"
                  height="4"
                  rx=".8"
                  fill="currentColor"
                  opacity=".5"></rect></svg
              >
              <span>Tue 9:41 AM</span>
            </span>
          </div>

          <div class="window" data-window>
            <span class="lights"><i></i><i></i><i></i></span>
            <AceWindow />
          </div>

          <SimulatorWindow />
          <PhoneLockScreen />

          <span class="pointer" data-pointer aria-hidden="true"><Pebble size={34} /></span>
        </div>
      </div>
    </div>
  </div>
  {played.map((id, index) => <span class="marker" data-scene={id} style={`--i: ${index}`} />)}
</section>

<style>
  .story {
    position: relative;
    height: calc(var(--scenes) * 100vh + 100vh);
  }

  .single {
    height: auto;
  }

  .single .pin {
    position: static;
    height: auto;
    display: block;
    padding: 0;
  }

  .single .marker {
    top: 0;
    height: 100%;
  }

  .pin {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 24px;
    padding: 84px 0 28px;
  }

  .captions {
    position: relative;
    display: grid;
    width: 100%;
  }

  .caption {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: 34px minmax(0, 38em);
    gap: 4px 0;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
  }

  .caption.on {
    opacity: 1;
    transform: none;
  }

  .n {
    grid-row: span 2;
    padding-top: 9px;
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .caption h2 {
    font-size: clamp(24px, 2.6vw, 32px);
    letter-spacing: -0.03em;
  }

  .caption p {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .caption a {
    color: var(--foreground);
    text-underline-offset: 3px;
  }

  .mac-wrap {
    display: grid;
    place-items: start center;
    min-height: 0;
    padding: 0 var(--gutter);
  }

  /* The display: its height follows the scaled desktop (set by the story script). */
  .mac {
    position: relative;
    width: min(1240px, 100%, calc((100vh - 240px) * 1.536));
    aspect-ratio: 1352 / 880;
    overflow: hidden;
    border-radius: 16px;
    box-shadow:
      0 0 0 1px var(--edge),
      0 50px 120px -40px var(--shadow-deep);
  }

  .desktop {
    position: absolute;
    left: 0;
    top: 0;
    width: 1352px;
    height: 880px;
    transform: scale(var(--desk-scale, 0.7));
    transform-origin: 0 0;
  }

  .wallpaper {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 90% at 12% 110%, #34323d 0%, transparent 60%),
      radial-gradient(60% 75% at 92% -12%, #463c33 0%, transparent 62%),
      radial-gradient(90% 100% at 55% 55%, #202024 0%, #121214 72%);
  }

  :global(html[data-theme="light"]) .wallpaper {
    background:
      radial-gradient(70% 90% at 12% 110%, #d9d6e4 0%, transparent 60%),
      radial-gradient(60% 75% at 92% -12%, #eadfd2 0%, transparent 62%),
      radial-gradient(90% 100% at 55% 55%, #ecebef 0%, #dcdbe0 72%);
  }

  .menubar {
    position: relative;
    z-index: 4;
    height: 28px;
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 0 18px;
    background: rgb(18 18 22 / 0.42);
    backdrop-filter: blur(30px) saturate(1.4);
    color: rgb(255 255 255 / 0.94);
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "SF Pro Text",
      system-ui,
      sans-serif;
    font-size: 14px;
  }

  :global(html[data-theme="light"]) .menubar {
    background: rgb(255 255 255 / 0.5);
    color: rgb(0 0 0 / 0.86);
  }

  .apple {
    width: 15px;
    height: 17px;
    margin-right: -2px;
  }

  .tray {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .window {
    position: absolute;
    left: 36px;
    top: 52px;
    width: 1280px;
    height: 800px;
    overflow: hidden;
    border-radius: 12px;
    box-shadow:
      0 0 0 0.5px rgb(255 255 255 / 0.16),
      0 0 0 1px rgb(0 0 0 / 0.55),
      0 34px 80px -16px rgb(0 0 0 / 0.7);
    transition: width 0.6s var(--ease-out);
  }

  :global(html[data-theme="light"]) .window {
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.22),
      0 34px 80px -20px rgb(0 0 0 / 0.3);
  }

  .lights {
    position: absolute;
    left: 20px;
    top: 16px;
    z-index: 5;
    display: flex;
    gap: 8px;
  }

  .lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.2);
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  /* The Simulator sits off to the right until the computer-use scene brings it forward. */
  .desktop :global([data-sim]) {
    right: 32px;
    top: 74px;
    z-index: 6;
    opacity: 0;
    transform: translateX(60px) scale(0.96);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.6s var(--ease-out);
  }

  .desktop:global([data-sim-shown]) :global([data-sim]) {
    opacity: 1;
    transform: none;
  }

  /* Side by side, as you'd arrange them: ace narrows to make room for the Simulator. */
  .desktop:global([data-sim-shown]) .window {
    width: 930px;
  }

  .pointer {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 9;
    opacity: 0;
    transform: translate(var(--x, 900px), var(--y, 600px));
    transition:
      transform 0.85s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.3));
    pointer-events: none;
  }

  .pointer:global(.shown) {
    opacity: 1;
  }

  .pointer :global(svg) {
    transition: transform 0.12s;
  }

  .pointer:global(.press) :global(svg) {
    transform: scale(0.86);
  }

  .marker {
    position: absolute;
    left: 0;
    top: calc(var(--i) * 100vh + 20vh);
    width: 1px;
    height: 100vh;
  }

  @media (max-width: 760px) {
    .pin {
      padding-top: 72px;
    }

    .mac-wrap {
      place-items: center;
    }

    .caption {
      grid-template-columns: minmax(0, 1fr);
    }

    .n {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caption,
    .pointer,
    .window {
      transition: none;
    }
  }
</style>

<script>
  import { startStageStory } from "../../scripts/stage-story.ts";

  for (const root of document.querySelectorAll<HTMLElement>("[data-story-root]")) {
    startStageStory(root);
  }
</script>
