---
import { links } from "../site.ts";
import AceMark from "./AceMark.astro";
---

<footer class="footer">
  <div class="page inner">
    <a class="brand" href="/" aria-label="ace home">
      <AceMark size={20} />
      <span>ace</span>
    </a>
    <nav aria-label="Footer">
      <a href={links.source}>GitHub</a>
      <a href={links.releases}>Releases</a>
      <a href="/llms.txt">llms.txt</a>
      <a href={links.license}>Apache-2.0</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    font-size: 14px;
  }

  nav a {
    color: var(--subtle);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  nav a:hover {
    color: var(--foreground);
  }
</style>
