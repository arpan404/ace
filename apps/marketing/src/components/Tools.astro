---
import { builtInAgents } from "../content/agents.ts";
import { toolFamilies } from "../content/product.ts";
import BrandMark from "./BrandMark.astro";
---

<section id="mcp" class="tools page">
  <div class="intro reveal">
    <h2 class="section-title">One MCP toolset, every agent.</h2>
    <p class="lede">
      ace runs an MCP server for each agent session. Whichever CLI runs the agent, it gets the
      same tools, and your CLI's own permission mode decides what runs.
    </p>
    <ul class="marks" aria-label="Agents that get ace's tools">
      {
        builtInAgents.map((agent) => (
          <li title={agent.label}>
            <BrandMark brand={agent.brand} size={22} />
            <span class="sr-only">{agent.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="table reveal" role="table" aria-label="ace's MCP tools by family">
    {
      toolFamilies.map((family) => (
        <div class="row" role="row">
          <div class="family" role="rowheader">
            <h3>{family.family}</h3>
            <p>{family.purpose}</p>
          </div>
          <div class="names" role="cell">
            {family.tools.map((tool) => (
              <code>{tool}</code>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .tools {
    display: grid;
    gap: 56px;
    padding-block: 120px;
  }

  .intro {
    display: grid;
    gap: 20px;
    align-content: start;
  }

  .marks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .marks li {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .table {
    border-top: 1px solid var(--border);
  }

  .row {
    display: grid;
    gap: 12px;
    padding-block: 20px;
    border-bottom: 1px solid var(--border);
  }

  .family {
    display: grid;
    gap: 2px;
  }

  .family p {
    color: var(--subtle);
    font-size: 14px;
  }

  .names {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    gap: 6px;
  }

  .names code {
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--foreground);
    font-size: 13px;
  }

  @media (min-width: 768px) {
    .row {
      grid-template-columns: 260px 1fr;
      gap: 32px;
    }
  }

  @media (min-width: 1100px) {
    .tools {
      grid-template-columns: 400px 1fr;
      gap: 80px;
      align-items: start;
    }

    .intro {
      position: sticky;
      top: 96px;
    }
  }

  @media (max-width: 767px) {
    .tools {
      padding-block: 72px;
      gap: 32px;
    }
  }
</style>
