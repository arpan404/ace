---
import { builtInAgents } from "../content/agents.ts";
import { toolFamilies } from "../content/product.ts";
import BrandMark from "./BrandMark.astro";
import MoreLink from "./site/MoreLink.astro";
---

<section id="mcp" class="section page">
  <div class="intro reveal">
    <div>
      <h2 class="section-title">One toolset, every agent.</h2>
      <p class="lede">
        ace runs an MCP server for each agent session. Whichever CLI runs the agent, it gets the
        same tools, and your CLI's own permission mode decides what runs.
      </p>
      <MoreLink href="/mcp/" label="Every tool, described" />
    </div>
    <ul class="marks" aria-label="Agents that get ace's tools">
      {
        builtInAgents.map((agent) => (
          <li class="tile" title={agent.label}>
            <BrandMark brand={agent.brand} size={18} />
            <span class="sr-only">{agent.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="table reveal" role="table" aria-label="ace's MCP tools by family">
    {
      toolFamilies.map((family) => (
        <div class="row" role="row">
          <h3 role="rowheader">{family.family}</h3>
          <p role="cell">{family.purpose}</p>
          <div class="names" role="cell">
            {family.tools.map((tool) => (
              <code>{tool}</code>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
  }

  .marks {
    display: flex;
    gap: 8px;
  }

  .table {
    margin-top: 56px;
    border-top: 1px solid var(--border);
  }

  .row {
    display: grid;
    grid-template-columns: 160px 1fr 1.3fr;
    gap: 24px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }

  .row p {
    color: var(--muted);
    font-size: 14px;
  }

  .names {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
  }

  code {
    color: var(--subtle);
    font-size: 12.5px;
  }

  @media (max-width: 800px) {
    .row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
