---
import { feature } from "../content/features.ts";
import { statuses as states } from "../content/product.ts";
import StatusBoard from "./panels/StatusBoard.astro";
import MoreLink from "./site/MoreLink.astro";

const { headline, intro } = feature("status");
---

<section id="status" class="section page">
  <div class="split">
    <div class="copy reveal">
      <h2 class="section-title">{headline}</h2>
      <p class="lede">{intro}</p>
      <dl class="states">
        {
          states.map((state) => (
            <div class="state" data-tone={state.tone}>
              <dt>
                <span class="status-dot" aria-hidden="true" />
                <span class="status-word">{state.word}</span>
              </dt>
              <dd>{state.meaning}</dd>
            </div>
          ))
        }
      </dl>
      <MoreLink href="/features/status/" label="More on thread status" />
    </div>

    <div class="reveal"><StatusBoard /></div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 72px;
    align-items: center;
  }

  .states {
    display: grid;
    gap: 14px;
    margin-top: 36px;
  }

  .state {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: 16px;
    font-size: 14px;
  }

  .state dt {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .state dd {
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .split {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
