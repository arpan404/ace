---
import sidebarDark from "../assets/shots/sidebar-dark.png";
import sidebarLight from "../assets/shots/sidebar-light.png";
import { statuses as states } from "../content/product.ts";
import ThemeShot from "./ThemeShot.astro";
---

<section id="status" class="status">
  <div class="page status-grid">
    <div class="status-copy reveal">
      <h2 class="section-title">Done means the whole tree is done.</h2>
      <p class="lede">
        A thread's status covers every subagent and background command it started. If a subagent
        still runs, the thread says Waiting, not Done.
      </p>
      <dl class="states">
        {
          states.map((state) => (
            <div class="state">
              <dt style={`--tone: var(--status-${state.tone})`}>
                <span class="glyph" data-tone={state.tone} aria-hidden="true" />
                {state.word}
              </dt>
              <dd>{state.meaning}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="sidebar-shot reveal">
      <ThemeShot
        light={sidebarLight}
        dark={sidebarDark}
        alt="The ace task list: threads across projects, each with its status word and elapsed time, branch, pull request and agent."
        sizes="(min-width: 1024px) 400px, 90vw"
        widths={[400, 670]}
      />
    </div>
  </div>
</section>

<style>
  .status {
    background: var(--sidebar);
    border-block: 1px solid var(--border);
  }

  .status-grid {
    display: grid;
    gap: 56px;
    padding-block: 112px;
  }

  .status-copy {
    display: grid;
    gap: 20px;
    align-content: start;
  }

  .states {
    display: grid;
    gap: 0;
    margin: 24px 0 0;
    border-top: 1px solid var(--border);
  }

  .state {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 16px;
    padding: 14px 0;
  }

  dt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--tone);
    font-weight: 500;
  }

  dd {
    margin: 0;
    color: var(--muted);
  }

  /* Ring for live states, solid disc for the ones that need or settle. */
  .glyph {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }

  .glyph[data-tone="needs-you"],
  .glyph[data-tone="failed"],
  .glyph[data-tone="done"] {
    background: currentColor;
  }

  .glyph[data-tone="working"] {
    border-right-color: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .glyph[data-tone="working"] {
      animation: spin 1.1s linear infinite;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  .sidebar-shot {
    justify-self: center;
    width: min(100%, 400px);
    overflow: hidden;
    border-radius: 12px;
    background: var(--sidebar);
    /* The list keeps going above and below; the edges fade rather than cut. */
    mask-image: linear-gradient(to bottom, transparent, #000 10%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 10%, #000 88%, transparent);
  }

  @media (min-width: 1024px) {
    .status-grid {
      grid-template-columns: 1fr 400px;
      gap: 96px;
      align-items: center;
    }
  }

  @media (max-width: 767px) {
    .status-grid {
      padding-block: 72px;
    }

    .state {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
