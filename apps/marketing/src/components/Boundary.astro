---
import { boundary } from "../content/product.ts";
import { links } from "../site.ts";
import Icon from "./Icon.astro";
---

<section id="privacy" class="section page">
  <div class="split">
    <div class="head reveal">
      <h2 class="section-title">Know where your code goes.</h2>
      <p class="lede">
        ace sits around your agents, not between you and your providers. Here is what it holds, and
        what it never touches.
      </p>
      <p class="more">
        <a class="text-link" href={links.source}>Read the source</a>
        <Icon name="arrow-right" size={14} />
      </p>
    </div>
    <ol class="list reveal">
      {
        boundary.map((item) => (
          <li>
            <span class="tile">
              <Icon name={item.icon} size={17} />
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 72px;
    align-items: start;
  }

  /* The heading stays in view while the list scrolls past it. */
  .head {
    position: sticky;
    top: 112px;
  }

  .more {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    color: var(--muted);
    font-size: 14px;
  }

  .list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
    padding: 28px 0;
    border-top: 1px solid var(--border);
  }

  .list li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  h3 {
    font-size: 18px;
    letter-spacing: -0.02em;
  }

  .list p {
    margin-top: 8px;
    max-width: 34em;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .head {
      position: static;
    }
  }
</style>
