---
import { links } from "../site.ts";
import AceMark from "./AceMark.astro";
import DownloadButton from "./DownloadButton.astro";
import Icon from "./Icon.astro";

const sections = [
  { path: "/features/", name: "Features" },
  { path: "/agents/", name: "Agents" },
  { path: "/mcp/", name: "MCP" },
  { path: "/download/", name: "Download" },
  { path: "/faq/", name: "FAQ" },
];
/* The section the current page belongs to, so its link reads as current. */
const here = Astro.url.pathname;
const current = (path: string) => here === path || here.startsWith(path);
---

<header class="nav">
  <div class="page nav-inner">
    <a class="brand" href="/" aria-label="ace home">
      <AceMark size={22} />
      <span>ace</span>
    </a>
    <nav class="nav-links" aria-label="Main">
      {
        sections.map((section) => (
          <a href={section.path} aria-current={current(section.path) ? "page" : undefined}>
            {section.name}
          </a>
        ))
      }
    </nav>
    <div class="nav-actions">
      <button class="icon-link theme" type="button" data-theme-toggle aria-label="Switch to light theme">
        <span class="when-dark"><Icon name="sun" size={18} /></span>
        <span class="when-light"><Icon name="moon" size={18} /></span>
      </button>
      <a class="icon-link" href={links.source} aria-label="ace on GitHub">
        <Icon name="github-logo" size={18} />
      </a>
      <DownloadButton small />
    </div>
  </div>
</header>

<style>
  .nav {
    /* Stays put while pages cross-fade (styles/motion.css). */
    view-transition-name: site-nav;
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--background) 78%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  /* The bottom edge appears once the page scrolls under the header. */
  @supports (animation-timeline: scroll()) {
    .nav {
      border-bottom: 1px solid transparent;
      animation: edge linear both;
      animation-timeline: scroll();
      animation-range: 0 96px;
    }
  }

  @keyframes edge {
    to {
      border-bottom-color: var(--border);
    }
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    font-size: 14px;
  }

  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .nav-links a:hover,
  .nav-links a[aria-current] {
    color: var(--foreground);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    justify-self: end;
  }

  .icon-link {
    display: inline-grid;
    place-items: center;
    color: var(--muted);
    transition: color var(--motion-fast) var(--ease-out);
  }

  .theme {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* The toggle shows the theme it switches to. */
  :global(html[data-theme="light"]) .when-dark,
  :global(html:not([data-theme="light"])) .when-light {
    display: none;
  }

  .icon-link:hover {
    color: var(--foreground);
  }

  @media (max-width: 860px) {
    .nav-inner {
      grid-template-columns: 1fr auto;
    }

    .nav-links {
      display: none;
    }
  }
</style>

<script>
  /* Flip the theme and remember the choice; from then on the system setting no longer applies. */
  const root = document.documentElement;
  const label = (button: HTMLElement) => {
    const next = root.dataset.theme === "light" ? "dark" : "light";
    button.setAttribute("aria-label", `Switch to ${next} theme`);
  };
  for (const button of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) {
    label(button);
    button.addEventListener("click", () => {
      const next = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = next;
      try {
        localStorage.setItem("ace-theme", next);
      } catch {
        // Private browsing may refuse storage; the switch still applies to this page.
      }
      label(button);
    });
  }
</script>
