---
import { links } from "../site.ts";
import AceMark from "./AceMark.astro";
import DownloadButton from "./DownloadButton.astro";
import Icon from "./Icon.astro";

/* The site's sections: the name in the bar, and the line under it in the small-screen menu. */
const sections = [
  { path: "/features/", name: "Features", line: "What ace adds to your agents" },
  { path: "/agents/", name: "Agents", line: "Claude Code, Codex and the rest" },
  { path: "/spade/", name: "Spade", line: "ace's own assistant, in beta" },
  { path: "/mcp/", name: "MCP", line: "The tools every agent gets" },
  { path: "/download/", name: "Download", line: "Mac, Windows, Linux and iPhone" },
  { path: "/faq/", name: "FAQ", line: "Questions, answered" },
];
/* The section the current page belongs to, so its link reads as current. */
const here = Astro.url.pathname;
const current = (path: string) => here === path || here.startsWith(path);
---

<header class="nav">
  <div class="page nav-inner">
    <a class="brand" href="/" aria-label="ace home">
      <AceMark size={22} />
      <span>ace</span>
    </a>
    <nav class="nav-links" aria-label="Main">
      {
        sections.map((section) => (
          <a href={section.path} aria-current={current(section.path) ? "page" : undefined}>
            {section.name}
          </a>
        ))
      }
    </nav>
    <div class="nav-actions">
      <button class="icon-link theme" type="button" data-theme-toggle aria-label="Switch to light theme">
        <span class="when-dark"><Icon name="sun" size={18} /></span>
        <span class="when-light"><Icon name="moon" size={18} /></span>
      </button>
      <a class="icon-link github" href={links.source} aria-label="ace on GitHub">
        <Icon name="github-logo" size={18} />
      </a>
      <DownloadButton small />
      <button class="menu" type="button" popovertarget="site-menu" aria-label="Open the menu">
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <!--
    The small-screen menu. It is a popover, so it opens, closes on Escape or a tap outside, and
    traps nothing, all without script. It lies exactly over the bar and unfolds downward from
    it, so the bar itself seems to open.
  -->
  <div class="sheet" id="site-menu" popover>
    <div class="sheet-head">
      <a class="brand" href="/" aria-label="ace home">
        <AceMark size={22} />
        <span>ace</span>
      </a>
      <button
        class="menu"
        type="button"
        popovertarget="site-menu"
        popovertargetaction="hide"
        aria-label="Close the menu"
      >
        <span class="bars cross" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
    <nav class="sheet-links" aria-label="Main">
      {
        sections.map((section, index) => (
          <a
            href={section.path}
            aria-current={current(section.path) ? "page" : undefined}
            style={`--i:${index}`}
          >
            <span class="no">{String(index + 1).padStart(2, "0")}</span>
            <span class="name">{section.name}</span>
            <span class="line">{section.line}</span>
          </a>
        ))
      }
    </nav>
    <div class="sheet-foot" style={`--i:${sections.length}`}>
      <DownloadButton />
    </div>
  </div>
</header>

<style>
  /* The header floats over the page as one rounded bar. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: 10px var(--gutter) 0;
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: var(--page);
    height: 54px;
    padding-inline: 18px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    /* Stays put while pages cross-fade (styles/motion.css). The name sits on the bar itself: on
       its parent it cut the bar off from the page behind, and the blur had nothing to blur. */
    view-transition-name: site-nav;
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    box-shadow: 0 14px 30px -22px var(--frame-shadow);
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    font-size: 14px;
  }

  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .nav-links a:hover,
  .nav-links a[aria-current] {
    color: var(--foreground);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    justify-self: end;
  }

  .icon-link {
    display: inline-grid;
    place-items: center;
    color: var(--muted);
    transition: color var(--motion-fast) var(--ease-out);
  }

  .theme {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* The toggle shows the theme it switches to. */
  :global(html[data-theme="light"]) .when-dark,
  :global(html:not([data-theme="light"])) .when-light {
    display: none;
  }

  .icon-link:hover {
    color: var(--foreground);
  }

  /* Six links fit beside the actions only on a wide bar; a narrower one drops FAQ (still in the
     footer) and closes the gaps. */
  @media (max-width: 1080px) {
    .nav-links {
      gap: 20px;
    }

    .nav-links a[href="/faq/"] {
      display: none;
    }
  }

  /* The menu button: two bars. It shows only where the links don't fit. */
  .menu {
    display: none;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--foreground);
    cursor: pointer;
  }

  .menu:hover {
    background: var(--wash);
  }

  .bars {
    position: relative;
    width: 18px;
    height: 18px;
  }

  .bars i {
    position: absolute;
    left: 0;
    width: 18px;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition:
      translate 0.36s var(--ease-out),
      rotate 0.36s var(--ease-out);
  }

  .bars i:first-child {
    top: 5px;
  }

  .bars i:last-child {
    top: 11.5px;
  }

  /* In the open menu the same two bars cross, turning from where the button's lay. */
  .sheet:popover-open .cross i:first-child {
    translate: 0 3.25px;
    rotate: 45deg;
  }

  .sheet:popover-open .cross i:last-child {
    translate: 0 -3.25px;
    rotate: -45deg;
  }

  @starting-style {
    .sheet:popover-open .cross i {
      translate: 0 0;
      rotate: 0deg;
    }
  }

  /* The sheet is not part of the page until a small screen opens it. */
  .sheet {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-inner {
      grid-template-columns: 1fr auto;
    }

    .nav-links {
      display: none;
    }

    /* The theme switch, GitHub and Download stay in the bar; the gaps close to fit the button. */
    .nav-actions {
      gap: 12px;
    }

    .menu {
      margin-left: -4px;
    }

    .menu {
      display: grid;
    }

    /*
     * The sheet lies over the bar, edge for edge, and is cut down to the bar's own shape until
     * it opens; opening lets the cut go, so the bar grows into the menu.
     */
    .sheet {
      position: fixed;
      inset: 10px var(--gutter) auto;
      width: auto;
      max-height: calc(100dvh - 20px);
      margin: 0;
      padding: 0;
      overflow: hidden auto;
      border: 1px solid var(--border);
      border-radius: 27px;
      background: color-mix(in srgb, var(--surface) 86%, transparent);
      color: var(--foreground);
      clip-path: inset(0 0 calc(100% - 54px) 0 round 27px);
      opacity: 0;
      backdrop-filter: blur(22px) saturate(160%);
      -webkit-backdrop-filter: blur(22px) saturate(160%);
      transition:
        clip-path 0.42s var(--ease-out),
        opacity 0.16s linear,
        display 0.42s allow-discrete,
        overlay 0.42s allow-discrete;
    }

    .sheet:popover-open {
      display: block;
      clip-path: inset(0 0 0 0 round 27px);
      opacity: 1;
    }

    @starting-style {
      .sheet:popover-open {
        clip-path: inset(0 0 calc(100% - 54px) 0 round 27px);
        opacity: 0;
      }
    }

    /* The page behind steps back while the menu is open. */
    .sheet::backdrop {
      background: color-mix(in srgb, var(--background) 0%, transparent);
      backdrop-filter: blur(0);
      transition:
        background-color 0.3s linear,
        backdrop-filter 0.3s linear,
        display 0.3s allow-discrete,
        overlay 0.3s allow-discrete;
    }

    .sheet:popover-open::backdrop {
      background: color-mix(in srgb, var(--background) 62%, transparent);
      backdrop-filter: blur(6px);
    }

    @starting-style {
      .sheet:popover-open::backdrop {
        background: color-mix(in srgb, var(--background) 0%, transparent);
        backdrop-filter: blur(0);
      }
    }

    :global(html:has(#site-menu:popover-open)) {
      overflow: hidden;
    }
  }

  /* The sheet's first row is the bar again, so nothing moves as it opens. */
  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding-inline: 18px 10px;
  }

  .sheet-links {
    display: grid;
    padding: 6px 8px 0;
    border-top: 1px solid var(--border);
  }

  /* A section: its number, its name set large, and one line saying what is there. */
  .sheet-links a {
    display: grid;
    grid-template-columns: 30px 1fr;
    align-items: baseline;
    gap: 0 6px;
    position: relative;
    padding: 13px 10px 14px;
    border-radius: 12px;
    text-decoration: none;
  }

  /* A straight hairline between rows; the row's own rounded corners belong to its wash only. */
  .sheet-links a + a::before {
    content: "";
    position: absolute;
    top: 0;
    right: 10px;
    left: 10px;
    height: 1px;
    background: var(--border);
  }

  .sheet-links a:hover,
  .sheet-links a[aria-current] {
    background: var(--wash);
  }

  .no {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .name {
    font-size: clamp(26px, 8vw, 34px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .line {
    grid-column: 2;
    margin-top: 3px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.35;
  }

  .sheet-foot {
    padding: 16px 18px 18px;
    border-top: 1px solid var(--border);
  }

  .sheet-foot :global(.button) {
    justify-content: center;
    width: 100%;
  }

  /* The rows come in one after another as the sheet unfolds over them. */
  .sheet:popover-open :is(.sheet-links a, .sheet-foot) {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.3s linear calc(60ms + var(--i) * 34ms),
      translate 0.5s var(--ease-out) calc(60ms + var(--i) * 34ms);
  }

  @starting-style {
    .sheet:popover-open :is(.sheet-links a, .sheet-foot) {
      opacity: 0;
      translate: 0 -10px;
    }
  }

  /* On a narrow phone the bar's pieces sit closer and GitHub gives way (the footer has it); on
     the narrowest, Download does too (the menu and every page's opening have it). */
  @media (max-width: 380px) {
    .nav-inner,
    .sheet-head {
      padding-inline: 14px 6px;
    }

    .nav-actions {
      gap: 10px;
    }

    .github {
      display: none;
    }
  }

  @media (max-width: 340px) {
    .nav-actions :global(.button) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet,
    .sheet::backdrop,
    .sheet :is(.sheet-links a, .sheet-foot),
    .bars i {
      transition: none;
    }
  }

  /* A browser without popovers can't open the sheet, so the links stay in the bar and scroll
     sideways there. */
  @supports not selector(:popover-open) {
    @media (max-width: 860px) {
      .nav-inner {
        grid-template-columns: auto 1fr;
        gap: 16px;
      }

      .nav-links {
        display: flex;
        overflow-x: auto;
        scrollbar-width: none;
      }

      .nav-links a {
        flex: none;
      }

      .nav-actions,
      .sheet {
        display: none;
      }
    }
  }
</style>

<script>
  /* A page brought back by the Back button comes back with its menu shut. */
  addEventListener("pageshow", () => {
    const menu = document.getElementById("site-menu");
    if (menu?.matches(":popover-open")) menu.hidePopover();
  });

  /* Flip the theme and remember the choice; from then on the system setting no longer applies. */
  const root = document.documentElement;
  const label = (button: HTMLElement) => {
    const next = root.dataset.theme === "light" ? "dark" : "light";
    button.setAttribute("aria-label", `Switch to ${next} theme`);
  };
  for (const button of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) {
    label(button);
    button.addEventListener("click", () => {
      const next = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = next;
      try {
        localStorage.setItem("ace-theme", next);
      } catch {
        // Private browsing may refuse storage; the switch still applies to this page.
      }
      label(button);
    });
  }
</script>
