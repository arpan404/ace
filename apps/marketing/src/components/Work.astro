---
import { capabilities } from "../content/product.ts";
import BrowserPanel from "./panels/BrowserPanel.astro";
import ComputerPanel from "./panels/ComputerPanel.astro";
import DevicesPanel from "./panels/DevicesPanel.astro";
import MoreLink from "./site/MoreLink.astro";
import Stage from "./Stage.astro";

const [browser, computer, devices] = capabilities;
if (!browser || !computer || !devices) throw new Error("The page expects three capabilities.");
---

<section id="work" class="section page">
  <div class="intro reveal">
    <h2 class="section-title">Agents that can see what they build.</h2>
    <p class="lede">
      Every agent gets your desktop apps, a browser and phone simulators through ace's own tools.
      You watch each one live, with a hand on the controls.
    </p>
  </div>

  <div class="bento">
    <article id="machine" class="cell wide reveal">
      <div class="copy">
        <h3>Computer use: agents work your apps, not just your terminal</h3>
        <p>{computer.body}</p>
        <ul class="details">{computer.details.map((detail) => <li>{detail}</li>)}</ul>
        <p class="tools">{computer.tools.map((tool) => <code>{tool}</code>)}</p>
        <MoreLink href="/features/computer-use/" label="More on computer use" />
      </div>
      <Stage mood="plum">
        <ComputerPanel />
      </Stage>
    </article>

    <article id="browser" class="cell reveal">
      <Stage mood="ember">
        <BrowserPanel />
      </Stage>
      <div class="copy">
        <h3>A real browser they can drive</h3>
        <p>{browser.body}</p>
        <p class="tools">{browser.tools.map((tool) => <code>{tool}</code>)}</p>
        <MoreLink href="/features/browser/" label="More on browser use" />
      </div>
    </article>

    <article id="devices" class="cell reveal">
      <Stage mood="amber">
        <DevicesPanel />
      </Stage>
      <div class="copy">
        <h3>Simulators and emulators in one hub</h3>
        <p>{devices.body}</p>
        <p class="tools">{devices.tools.map((tool) => <code>{tool}</code>)}</p>
        <MoreLink href="/features/devices/" label="More on devices" />
      </div>
    </article>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 56px;
  }

  /* A tile is a quiet surface with its visual inset by 8px, so the corners nest (20 - 8 = 12). */
  .cell {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 8px;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: var(--card);
    box-shadow: inset 0 1px 0 var(--sheen);
  }

  .cell :global(.stage) {
    border-radius: 12px;
  }

  .cell:not(.wide) :global(.stage-inner) {
    min-height: 320px;
  }

  .cell.wide {
    grid-column: 1 / -1;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
  }

  .copy {
    padding: 20px 20px 22px;
  }

  .wide .copy {
    padding: 32px;
  }

  h3 {
    font-size: 19px;
    letter-spacing: -0.02em;
  }

  .wide h3 {
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .copy p {
    margin-top: 10px;
    max-width: 34em;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.65;
  }

  .details {
    display: grid;
    gap: 8px;
    margin-top: 18px;
    color: var(--foreground);
    font-size: 14px;
  }

  .details li {
    display: flex;
    gap: 12px;
  }

  .details li::before {
    content: "";
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    margin-top: 0.62em;
    border-radius: 50%;
    background: var(--faint);
  }

  .copy .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: 18px;
    color: var(--subtle);
  }

  .tools code {
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .bento,
    .cell.wide {
      grid-template-columns: 1fr;
    }

    .wide .copy {
      order: 1;
      padding: 20px 20px 22px;
    }
  }
</style>
