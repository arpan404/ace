---
import { features } from "../content/product.ts";
import Icon from "./Icon.astro";
---

<section id="features" class="features page">
  <h2 class="section-title reveal">Everything else in the workbench.</h2>
  <div class="grid">
    {
      features.map((feature) => (
        <article class="feature reveal">
          <span class="icon">
            <Icon name={feature.icon} size={20} />
          </span>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .features {
    display: grid;
    gap: 48px;
    padding-block: 120px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 48px;
  }

  .feature {
    display: grid;
    grid-template-columns: 20px 1fr;
    column-gap: 16px;
    row-gap: 6px;
    padding-block: 28px;
    border-top: 1px solid var(--border);
  }

  .icon {
    grid-row: 1;
    color: var(--muted);
    padding-top: 2px;
  }

  .feature p {
    grid-column: 2;
    color: var(--muted);
    max-width: 36em;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 767px) {
    .features {
      padding-block: 72px;
      gap: 32px;
    }
  }
</style>
