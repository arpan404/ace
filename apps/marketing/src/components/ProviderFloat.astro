---
import ProviderIcon from "./ProviderIcon.astro";

type ProviderKind =
  | "codex"
  | "claude"
  | "gemini"
  | "cursor"
  | "pi"
  | "githubCopilot"
  | "opencode";

type ProviderCard = {
  label: string;
  kind: ProviderKind;
};

const providers = [
  { label: "Codex", kind: "codex" },
  { label: "Claude", kind: "claude" },
  { label: "Gemini", kind: "gemini" },
  { label: "Cursor", kind: "cursor" },
  { label: "Pi Coding Agent", kind: "pi" },
  { label: "GitHub Copilot", kind: "githubCopilot" },
  { label: "OpenCode", kind: "opencode" },
] satisfies ReadonlyArray<ProviderCard>;
---

<div class="provider-float-container">
  <div class="provider-track" aria-hidden="true">
    <div class="provider-row">
      {[...providers, ...providers].map((provider) => (
        <div class="provider-card">
          <ProviderIcon kind={provider.kind} />
          <span>{provider.label}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .provider-float-container {
    width: 100%;
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding: 0.7rem 0;
    mask-image: linear-gradient(to right, transparent, black 20%, black 80%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 20%, black 80%, transparent);
  }

  .provider-track {
    display: flex;
  }

  .provider-row {
    display: flex;
    gap: 1.5rem;
    animation: scroll 32s linear infinite;
    width: max-content;
  }

  .provider-card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-right: 1.5rem;
    border-right: 1px solid var(--line);
    transition:
      transform 0.3s ease,
      color 0.3s ease;
    cursor: default;
  }

  .provider-card:hover {
    color: var(--fg);
    transform: translateY(-2px);
  }

  .provider-card span {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .provider-row {
      animation-duration: 18s;
    }
  }
</style>
