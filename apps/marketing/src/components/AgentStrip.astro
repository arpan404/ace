---
/*
 * The agents ace runs, right after the story that shows them at work: the statement on one side
 * and, on the other, the list as ace's own Agents settings would show it on a machine where
 * every CLI is signed in: mark, name, the model its CLI offers first, and that it is signed in.
 * Each row opens the agent's page; /agents/ has the rest.
 */
import { agentGuides } from "../content/agent-guides.ts";
import { currentModels } from "../content/agents.ts";
import BrandMark from "./BrandMark.astro";
import AppIcon from "./mac/AppIcon.astro";
---

<section class="section page agents" aria-label="Agents ace runs">
  <div class="say reveal">
    <h2 class="section-title">It runs the agents you already pay for.</h2>
    <p class="lede">
      Each one signs in through its own CLI, on the subscription you have. ace never asks for a key.
    </p>
    <a class="text-link" href="/agents/">All agents, and any that speaks ACP</a>
  </div>
  <ul class="card reveal" data-stagger>
    {
      agentGuides.map((guide) => (
        <li>
          <a href={`/agents/${guide.slug}/`}>
            <BrandMark brand={guide.brand} size={22} />
            <span class="name">{guide.label}</span>
            <span class="model">{currentModels[guide.label]?.model}</span>
            <span class="in">
              <AppIcon name="check-circle" size={14} />
              Signed in
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .agents {
    display: grid;
    gap: 32px clamp(40px, 7vw, 96px);
    align-items: start;
  }

  @media (min-width: 900px) {
    .agents {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .say h2 {
    max-width: 10em;
    font-size: clamp(36px, 5vw, 64px);
  }

  .say .text-link {
    display: inline-block;
    margin-top: 20px;
  }

  /* The list: flat rows ruled with hairlines, as the app rules a list. */
  ul {
    padding: 6px;
  }

  li + li {
    border-top: 1px solid var(--border);
  }

  li a {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 0 14px;
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--motion-fast) var(--ease-out);
  }

  li a:hover {
    background: var(--wash);
  }

  .name {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .model {
    color: var(--muted);
    font-size: 14px;
  }

  .in {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 92px;
    color: var(--status-done);
    font-size: 13px;
  }

  @media (max-width: 519px) {
    .in {
      display: none;
    }
  }
</style>
