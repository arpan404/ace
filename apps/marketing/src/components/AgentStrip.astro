---
/* The agents ace runs, named right after the story that shows them at work; /agents/ has the full list. */
import { agentGuides } from "../content/agent-guides.ts";
import BrandMark from "./BrandMark.astro";
import Icon from "./Icon.astro";
---

<section class="page strip reveal" aria-label="Agents ace runs">
  <h2 class="label">It runs the agents you already pay for, through their own CLIs.</h2>
  <ul data-stagger>
    {
      agentGuides.map((guide) => (
        <li>
          <a href={`/agents/${guide.slug}/`}>
            <BrandMark brand={guide.brand} size={20} />
            {guide.label}
          </a>
        </li>
      ))
    }
    <li>
      <a href="/agents/" class="any">
        and any ACP agent
        <Icon name="arrow-right" size={14} />
      </a>
    </li>
  </ul>
</section>

<style>
  .strip {
    display: grid;
    gap: 20px;
    padding-top: var(--section);
  }

  .label {
    max-width: 16em;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 36px;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  a:hover {
    color: var(--foreground);
  }

  .any {
    color: var(--subtle);
    font-weight: 400;
  }
</style>
