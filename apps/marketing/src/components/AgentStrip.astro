---
/*
 * The agents ace runs, right after the story that shows them at work: the statement on one side
 * and, on the other, every agent in one ruled grid, each with its mark. The six built in come
 * first and open their pages; the rest are the agents ace runs through the Agent Client
 * Protocol, from the app's own registry (content/agents.ts). The last cell stands for any other.
 */
import { agentGuides } from "../content/agent-guides.ts";
import { acpAgents, builtInAgents } from "../content/agents.ts";
import BrandMark from "./BrandMark.astro";

const page = (label: string) => {
  const guide = agentGuides.find((entry) => entry.label === label);
  return guide ? `/agents/${guide.slug}/` : undefined;
};
const agents = [...builtInAgents, ...acpAgents].map((agent) => ({
  brand: agent.brand,
  label: agent.label,
  href: page(agent.label),
}));
---

<section class="section page agents" aria-label="Agents ace runs">
  <div class="say reveal">
    <h2 class="section-title">It runs the agents you already pay for.</h2>
    <p class="lede">
      {agents.length} agents today, and any other that speaks the Agent Client Protocol. Each signs in
      through its own CLI, on the subscription you have. ace never asks for a key.
    </p>
    <a class="text-link" href="/agents/">How each one runs in ace</a>
  </div>
  <ul class="card reveal">
    {
      agents.map((agent) => (
        <li>
          {agent.href ? (
            <a href={agent.href}>
              <BrandMark brand={agent.brand} size={20} />
              {agent.label}
            </a>
          ) : (
            <span>
              <BrandMark brand={agent.brand} size={20} />
              {agent.label}
            </span>
          )}
        </li>
      ))
    }
    <li class="any"><a href="/agents/">Any ACP agent</a></li>
  </ul>
</section>

<style>
  .agents {
    display: grid;
    gap: 32px clamp(40px, 7vw, 96px);
    align-items: start;
  }

  @media (min-width: 900px) {
    .agents {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .say h2 {
    max-width: 10em;
    font-size: clamp(36px, 5vw, 64px);
  }

  .say .text-link {
    display: inline-block;
    margin-top: 20px;
  }

  /* One grid ruled with hairlines: the gaps between the cells are the rules. */
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    background: var(--border);
  }

  @media (min-width: 520px) {
    ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  li {
    display: grid;
    background: var(--surface);
  }

  li > * {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 54px;
    padding: 0 16px;
    color: var(--foreground);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--motion-fast) var(--ease-out);
  }

  li > a:hover {
    background: var(--wash);
  }

  .any > a {
    color: var(--muted);
  }
</style>
