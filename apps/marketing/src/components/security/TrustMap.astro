---
/*
 * Where things live, drawn flat in the site's drawing language: your machines on one side, your
 * devices on the other, ace's relay between them on a hairline marked end-to-end encrypted, and
 * the optional account under the relay, joined by the pass it signs. Each place is outlined with
 * a mono label over its corner, as the home page labels its machines. On a narrow screen the
 * places stack, joined by upright lines. Plain HTML, so it reads without script.
 */
import { mapLinks, mapNodes, securityPage, type MapNode } from "../../content/security.ts";

const node = (id: MapNode["id"]) => {
  const found = mapNodes.find((entry) => entry.id === id);
  if (!found) throw new Error(`Describe ${id} in content/security.ts`);
  return found;
};
const places = (["machines", "relay", "devices", "account"] as const).map(node);
---

<section class="section page map">
  <header class="head reveal">
    <h2 class="section-title">{securityPage.mapHeading}</h2>
    <p class="lede">{securityPage.mapLede}</p>
  </header>

  <div class="drawing reveal">
    {
      places.map((place) => (
        <div class:list={["place", place.id]}>
          <span class="label">{place.label}</span>
          <div class="box">
            <span class="glyph" aria-hidden="true">
              {place.id === "machines" && (
                <svg viewBox="0 0 48 32">
                  <rect x="7" y="2" width="34" height="23" rx="2" />
                  <path d="M2 29h44M18 29l1-4h10l1 4" />
                </svg>
              )}
              {place.id === "relay" && (
                <svg viewBox="0 0 48 32">
                  <path d="M2 16h14M32 16h14" />
                  <rect x="16" y="6" width="16" height="20" rx="3" />
                  <path d="M21 13h6M21 19h6" />
                </svg>
              )}
              {place.id === "devices" && (
                <svg viewBox="0 0 48 32">
                  <rect x="4" y="3" width="15" height="26" rx="3" />
                  <rect x="24" y="5" width="21" height="15" rx="1.5" />
                  <path d="M22 25h25" />
                </svg>
              )}
              {place.id === "account" && (
                <svg viewBox="0 0 48 32">
                  <circle cx="24" cy="11" r="6" />
                  <path d="M13 29c1.5-6 6-9 11-9s9.5 3 11 9" />
                </svg>
              )}
            </span>
            <b>{place.name}</b>
            <ul>
              {place.facts.map((fact) => (
                <li>{fact}</li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }

    <span class="link to-relay" aria-hidden="true"><em>{mapLinks.encrypted}</em></span>
    <span class="link to-devices"><em>{mapLinks.encrypted}</em></span>
    <span class="link to-account" aria-hidden="true"><em>{mapLinks.pass}</em></span>
  </div>

  <p class="note reveal">{securityPage.mapNote}</p>
</section>

<style>
  .head h2 {
    font-size: clamp(36px, 5vw, 64px);
  }

  /*
   * The places and the lines between them share one grid. On a narrow screen: machines, a line,
   * the relay, a line, your devices, the pass, the account, one under the other.
   */
  .drawing {
    display: grid;
    grid-template-areas:
      "machines"
      "to-relay"
      "relay"
      "to-devices"
      "devices"
      "to-account"
      "account";
    margin-top: clamp(40px, 5vw, 64px);
  }

  .machines {
    grid-area: machines;
  }

  .relay {
    grid-area: relay;
  }

  .devices {
    grid-area: devices;
  }

  .account {
    grid-area: account;
  }

  .to-relay {
    grid-area: to-relay;
  }

  .to-devices {
    grid-area: to-devices;
  }

  .to-account {
    grid-area: to-account;
  }

  /* A label stands just above its place's top left corner, in the drawings' mono. */
  .place {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .label {
    padding-left: 2px;
    color: var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
  }

  .box {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 20px 20px 18px;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: var(--background);
  }

  .glyph svg {
    display: block;
    width: 48px;
    height: 32px;
    fill: none;
    stroke: var(--line);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .box b {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .box ul {
    display: grid;
    border-top: 1px solid var(--border);
  }

  .box li {
    padding: 8px 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.4;
  }

  .box li + li {
    border-top: 1px solid var(--border);
  }

  /* A line between two places: an upright hairline on a narrow screen, its words on it. */
  .link {
    position: relative;
    display: grid;
    place-items: center;
    height: 64px;
  }

  .link::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1.5px;
    background: var(--line);
    opacity: 0.6;
  }

  .link em {
    position: relative;
    padding: 5px 9px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--background);
    color: var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    font-style: normal;
    line-height: 1;
    white-space: nowrap;
  }

  /*
   * From 900px the places stand in a row (machines, relay, devices) joined by level lines at
   * the height of the relay's glyph, and the account sits under the relay on an upright line.
   */
  @media (min-width: 900px) {
    .drawing {
      grid-template-columns: minmax(0, 1fr) minmax(96px, 0.5fr) minmax(0, 1fr) minmax(96px, 0.5fr) minmax(0, 1fr);
      grid-template-rows: auto 72px auto;
      grid-template-areas:
        "machines to-relay relay to-devices devices"
        "machines . to-account . devices"
        "machines . account . devices";
      align-items: start;
    }

    /* Level with the stubs on the relay's glyph: its label, the gap, the box's padding and
       half the glyph. */
    .to-relay,
    .to-devices {
      align-self: start;
      height: 1.5px;
      margin-top: 57px;
    }

    .to-relay::before,
    .to-devices::before {
      inset: 0 -1px;
      width: auto;
    }

    /* The words stand over the level line, not on it. */
    .to-relay em,
    .to-devices em {
      position: absolute;
      bottom: 10px;
      padding: 0 6px;
      border: 0;
      white-space: normal;
      text-align: center;
      line-height: 1.4;
    }

    .to-account {
      height: 100%;
    }
  }

  .note {
    margin-top: 28px;
    color: var(--muted);
    font-size: 15px;
  }
</style>
