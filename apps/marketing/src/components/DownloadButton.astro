---
/*
 * "Download for <platform>": one link per desktop platform, of which only the visitor's shows.
 * Base.astro tags <html data-os> before first paint, so the right one appears without a flash;
 * anyone the tag doesn't match (phones, unknown systems, no script) sees the Mac link. The build
 * bakes in each system's usual installer; scripts/latest-release.ts re-points the links at the
 * newest release and the visitor's own chip.
 */
import {
  defaultArch,
  downloads,
  labelText,
  noteText,
  platformInfo,
  platforms,
  type Platform,
} from "../content/release.ts";
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  small?: boolean;
  /** Show the version, build and size under the button. */
  withNote?: boolean;
}

const { small = false, withNote = false } = Astro.props;
const marks: Record<Platform, IconName> = {
  mac: "apple-logo",
  windows: "windows-logo",
  linux: "linux-logo",
};
const { version } = downloads;
const note = (platform: Platform) =>
  noteText(version, platform, defaultArch[platform], downloads.byPlatform[platform].bytes);
const label = (platform: Platform) =>
  labelText(version, platform, defaultArch[platform], downloads.byPlatform[platform].bytes);
---

{
  platforms.map((platform) => (
    <a
      class:list={["button", "button-primary", "for-os", { "button-small": small }]}
      data-os-match={platform}
      data-download={platform}
      href={downloads.byPlatform[platform].url}
      aria-label={label(platform)}
    >
      {!small && <Icon name={marks[platform]} size={16} />}
      Download for {platformInfo[platform].name}
    </a>
  ))
}
{
  withNote && (
    <p class="download-note">
      {platforms.map((platform) => (
        <span class="for-os" data-os-match={platform} data-download-note={platform}>
          {note(platform)}
        </span>
      ))}
      <a href={downloads.notesUrl} data-release-notes>
        Release notes
      </a>
    </p>
  )
}

<style>
  /* Always last in its row of buttons, on a line of its own. */
  .download-note {
    order: 1;
    flex-basis: 100%;
    color: var(--subtle);
    font-size: 13px;
  }

  .download-note a {
    color: var(--muted);
    text-decoration: none;
  }

  .download-note a:hover {
    color: var(--foreground);
    text-decoration: underline;
  }
</style>
