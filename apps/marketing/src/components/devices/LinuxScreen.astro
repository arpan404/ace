---
/*
 * A Linux desktop, 640 × 400, with ace open on it: the top bar, and ace's own window filling
 * the rest, drawn at half size from the same drawing the Mac shows. The story script opens a
 * thread in it (scripts/stage-scenes.ts `show`).
 */
import AceWindow from "../mac/AceWindow.astro";
---

<div class="linux">
  <div class="topbar">
    <span>Activities</span>
    <b>Tue 3 Nov&nbsp;&nbsp;09:41</b>
    <span class="tray"><i></i><i></i><i class="power"></i></span>
  </div>
  <div class="app">
    <div class="half"><AceWindow /></div>
  </div>
</div>

<style>
  .linux {
    position: absolute;
    inset: 0;
    background: #0c0d0f;
    color: #e6e7ea;
    font-family: system-ui, sans-serif;
    font-size: 12px;
  }

  .topbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 26px;
    padding: 0 12px;
    background: #000;
  }

  .topbar b {
    font-weight: 600;
  }

  .tray {
    justify-self: end;
    display: flex;
    gap: 9px;
  }

  .tray i {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: #d0d2d6;
  }

  .tray .power {
    border-radius: 50%;
    background: none;
    box-shadow: inset 0 0 0 1.5px #d0d2d6;
  }

  .app {
    position: absolute;
    inset: 26px 0 0;
    overflow: hidden;
  }

  /* ace's window at its own size, shown at half. */
  .half {
    position: absolute;
    left: 0;
    top: 0;
    width: 200%;
    height: 200%;
    transform: scale(0.5);
    transform-origin: 0 0;
  }

  /* No traffic lights here, so the top bar's buttons start at the edge. */
  .half :global(.ace .nav) {
    padding-left: 18px;
  }
</style>
