---
/*
 * A matte black business laptop seen from the front, the Linux machine beside the MacBook:
 * square lid with a camera in a thicker top bezel, a taller chin, two hinge knuckles, and a
 * flat base with a straight front edge. The slot is its 640 × 400 screen; the lid carries
 * `data-lid` for the label.
 */
---

<div class="laptop">
  <div class="lid" data-lid>
    <i class="cam"></i>
    <div class="screen"><slot /></div>
  </div>
  <i class="hinge left"></i>
  <i class="hinge right"></i>
  <div class="base"></div>
</div>

<style>
  /* The plastic is near black in both themes; only its edges and the shadow follow the page. */
  .laptop {
    --shell: #141517;
    --shell-hi: #2c2e32;
    --shell-lo: #0a0a0b;
    --shell-rim: #2a2c30;
    --shell-edge: rgb(255 255 255 / 0.14);

    position: relative;
    isolation: isolate;
    width: 760px;
    height: 462px;
  }

  :global(html[data-theme="light"]) .laptop {
    --shell-rim: #3a3c41;
    --shell-edge: rgb(255 255 255 / 0.2);
  }

  .lid {
    position: absolute;
    left: 44px;
    top: 0;
    width: 672px;
    height: 442px;
    border-radius: 7px 7px 3px 3px;
    background: var(--shell);
    box-shadow:
      inset 0 1px 0 var(--shell-edge),
      inset 0 0 0 1.5px #1e1f22,
      0 0 0 1px var(--shell-rim);
  }

  /* The camera sits in the top bezel, with its small indicator beside it. */
  .cam {
    position: absolute;
    left: 50%;
    top: 9px;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 35%, #3a3b40, #050506 70%);
    box-shadow: 0 0 0 1.5px #0b0b0c;
  }

  .cam::after {
    content: "";
    position: absolute;
    left: 14px;
    top: 2px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #222326;
  }

  .screen {
    position: absolute;
    left: 16px;
    top: 24px;
    width: 640px;
    height: 400px;
    overflow: hidden;
    border-radius: 1px;
    box-shadow: 0 0 0 1px #000;
  }

  /* Two barrels join the lid to the base, standing proud of the chin's lower edge. */
  .hinge {
    position: absolute;
    top: 434px;
    z-index: 1;
    width: 86px;
    height: 12px;
    border-radius: 3px;
    background: linear-gradient(
      to bottom,
      var(--shell-hi) 0%,
      var(--shell) 40%,
      var(--shell-lo) 100%
    );
    box-shadow:
      0 0 0 1px #050506,
      inset 0 1px 0 var(--shell-edge);
  }

  .hinge.left {
    left: 128px;
  }

  .hinge.right {
    right: 128px;
  }

  /* The base: a flat slab, square at the corners, its front face a straight band. */
  .base {
    position: absolute;
    left: 6px;
    bottom: 0;
    width: 748px;
    height: 20px;
    border-radius: 2px 2px 5px 5px;
    background: linear-gradient(
      to bottom,
      var(--shell-hi) 0%,
      var(--shell) 18%,
      var(--shell) 70%,
      var(--shell-lo) 100%
    );
    box-shadow:
      inset 0 1px 0 var(--shell-edge),
      0 0 0 1px var(--shell-rim),
      0 30px 40px -22px var(--frame-shadow);
  }

  /* A seam where the top deck meets the front face, and the soft shadow on the ground. */
  .base::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 6px;
    height: 1px;
    background: rgb(0 0 0 / 0.55);
  }

  .base::after {
    content: "";
    position: absolute;
    left: 3%;
    right: 3%;
    bottom: -7px;
    height: 10px;
    border-radius: 50%;
    background: var(--frame-shadow);
    filter: blur(6px);
    opacity: 0.7;
    z-index: -1;
  }
</style>
