---
/*
 * A plain black laptop seen from the front, for a machine that isn't a Mac. The slot is its
 * 640 × 400 screen; the lid carries `data-lid` for the label.
 */
---

<div class="laptop">
  <div class="lid" data-lid>
    <i class="cam"></i>
    <div class="screen"><slot /></div>
  </div>
  <div class="body"></div>
</div>

<style>
  .laptop {
    position: relative;
    width: 760px;
    height: 462px;
  }

  .lid {
    position: absolute;
    left: 44px;
    top: 0;
    width: 672px;
    height: 436px;
    border-radius: 16px 16px 6px 6px;
    background: #0d0e10;
    box-shadow:
      inset 0 0 0 1.5px #26282c,
      0 0 0 1.5px #050506;
  }

  .cam {
    position: absolute;
    left: 50%;
    top: 7px;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: #1c2233;
  }

  .screen {
    position: absolute;
    left: 16px;
    top: 20px;
    width: 640px;
    height: 400px;
    overflow: hidden;
    border-radius: 3px;
  }

  .body {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 760px;
    height: 28px;
    border-radius: 3px 3px 16px 16px / 3px 3px 22px 22px;
    background: linear-gradient(to bottom, #3a3c41 0%, #232529 22%, #17181b 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      0 30px 44px -22px var(--frame-shadow);
  }

  .body::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    width: 120px;
    height: 7px;
    margin-left: -60px;
    border-radius: 0 0 8px 8px;
    background: #101113;
  }
</style>
