---
/*
 * A Windows desktop, 680 × 383: a terminal window over the wallpaper, and the taskbar. The home
 * story's workstation runs a nightly automation here.
 */
import { providerIcon } from "@ace/ui-core/provider-icons";
import BrandMark from "../BrandMark.astro";

interface Props {
  /** The task the agent on this machine is doing, as the terminal tab's title. */
  task: string;
}

const { task } = Astro.props;
const codex = providerIcon({ provider: "codex" }).brand;
---

<div class="windows">
  <div class="window">
    <div class="tabs">
      <span class="tab">{codex && <BrandMark brand={codex} size={13} />}{task}</span>
      <span class="plus">+</span>
      <span class="caption"><i class="min"></i><i class="max"></i><i class="close"></i></span>
    </div>
    <pre><span class="dim">PS C:\src\billing-api&gt;</span> bun run test --repeat 5
<span class="dim">started by an automation, every night</span>

checkout.spec.ts   <span class="warn">fails 1 run in 5</span>
cart.spec.ts       <span class="ok">passes</span>
webhooks.spec.ts   <span class="ok">passes</span></pre>
  </div>
  <div class="taskbar">
    <span class="apps">
      <span class="start"><i></i><i></i><i></i><i></i></span>
      <i class="app"></i><i class="app two"></i><i class="app three"></i><i class="app on"></i>
    </span>
    <span class="clock">9:41 AM<br />11/3/2026</span>
  </div>
</div>

<style>
  .windows {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 90% at 62% 78%, #5db1ff 0%, transparent 58%),
      radial-gradient(60% 80% at 30% 60%, #1f6fe0 0%, transparent 62%),
      linear-gradient(to bottom, #0a2a66, #06163c);
    color: #e9eaec;
    font-family: "Segoe UI Variable Text", "Segoe UI", system-ui, sans-serif;
    font-size: 12px;
  }

  .window {
    position: absolute;
    left: 34px;
    top: 20px;
    width: 612px;
    height: 300px;
    overflow: hidden;
    border-radius: 8px;
    background: #0c0c0c;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 22px 46px -14px rgb(0 0 0 / 0.7);
  }

  .tabs {
    display: flex;
    align-items: end;
    height: 36px;
    padding-left: 8px;
    background: #202020;
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 29px;
    padding: 0 14px 0 10px;
    border-radius: 7px 7px 0 0;
    background: #0c0c0c;
  }

  .plus {
    align-self: center;
    margin-left: 12px;
    color: #b9bbc0;
    font-size: 16px;
  }

  /* Minimise, maximise and close, at the window's right corner. */
  .caption {
    align-self: center;
    display: flex;
    gap: 26px;
    margin-left: auto;
    padding-right: 18px;
  }

  .caption i {
    width: 10px;
    height: 10px;
  }

  .min {
    border-bottom: 1px solid #d5d6d9;
  }

  .max {
    border: 1px solid #d5d6d9;
  }

  .close {
    background:
      linear-gradient(45deg, transparent 46%, #d5d6d9 46% 54%, transparent 54%),
      linear-gradient(-45deg, transparent 46%, #d5d6d9 46% 54%, transparent 54%);
  }

  pre {
    margin: 0;
    padding: 14px 16px;
    font-family: "Cascadia Mono", var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    white-space: pre-wrap;
  }

  .dim {
    color: #8a8e97;
  }

  .ok {
    color: #57bd9b;
  }

  .warn {
    color: #edc070;
  }

  .taskbar {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 42px;
    padding: 0 12px;
    background: rgb(22 28 40 / 0.78);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .apps {
    grid-column: 2;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .start {
    display: grid;
    grid-template-columns: 8px 8px;
    gap: 2px;
  }

  .start i {
    width: 8px;
    height: 8px;
    border-radius: 1.5px;
    background: #5cb8ff;
  }

  .app {
    position: relative;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: #d9dce2;
  }

  .two {
    background: #f0b556;
  }

  .three {
    background: #4f8ef7;
  }

  /* The open terminal, with the mark under it that says it is running. */
  .on {
    background: #101114;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
  }

  .on::after {
    content: "";
    position: absolute;
    left: 6px;
    bottom: -7px;
    width: 8px;
    height: 3px;
    border-radius: 2px;
    background: #5cb8ff;
  }

  .clock {
    grid-column: 3;
    justify-self: end;
    font-size: 10.5px;
    line-height: 1.3;
    text-align: right;
  }
</style>
