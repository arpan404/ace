---
/*
 * A Windows desktop, 680 × 383, with ace open on it: ace's own window at half size from the same
 * drawing the Mac shows, the window's caption buttons, and the taskbar. The story script opens a
 * thread in it (scripts/stage-scenes.ts `show`).
 */
import AceWindow from "../mac/AceWindow.astro";
---

<div class="windows">
  <div class="app">
    <div class="half"><AceWindow /></div>
    <span class="caption"><i class="min"></i><i class="max"></i><i class="close"></i></span>
  </div>
  <div class="taskbar">
    <span class="apps">
      <span class="start"><i></i><i></i><i></i><i></i></span>
      <i class="pin"></i><i class="pin"></i><i class="pin"></i><i class="pin on"></i>
    </span>
    <span class="clock">9:41 AM<br />11/3/2026</span>
  </div>
</div>

<style>
  .windows {
    position: absolute;
    inset: 0;
    background: #0c0d0f;
    color: #e9eaec;
    font-family: "Segoe UI Variable Text", "Segoe UI", system-ui, sans-serif;
    font-size: 12px;
  }

  .app {
    position: absolute;
    inset: 0 0 42px;
    overflow: hidden;
  }

  /* ace's window at its own size, shown at half. */
  .half {
    position: absolute;
    left: 0;
    top: 0;
    width: 200%;
    height: 200%;
    transform: scale(0.5);
    transform-origin: 0 0;
  }

  /* No traffic lights here; the caption buttons take the right corner instead. */
  .half :global(.ace .nav) {
    padding-left: 18px;
  }

  .half :global(.ace .actions) {
    padding-right: 232px;
  }

  /* Minimise, maximise and close. */
  .caption {
    position: absolute;
    right: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 22px;
    height: 22px;
    padding: 0 14px;
    color: var(--a-muted, #a3a3a3);
  }

  .caption i {
    width: 8px;
    height: 8px;
  }

  .min {
    border-bottom: 1px solid currentColor;
  }

  .max {
    border: 1px solid currentColor;
  }

  .close {
    background:
      linear-gradient(45deg, transparent 44%, currentColor 44% 56%, transparent 56%),
      linear-gradient(-45deg, transparent 44%, currentColor 44% 56%, transparent 56%);
  }

  .taskbar {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 42px;
    padding: 0 12px;
    background: #17181b;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.07);
  }

  .apps {
    grid-column: 2;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .start {
    display: grid;
    grid-template-columns: 8px 8px;
    gap: 2px;
  }

  .start i {
    width: 8px;
    height: 8px;
    border-radius: 1.5px;
    background: #e9eaec;
  }

  .pin {
    position: relative;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: #3a3c41;
  }

  /* ace, open, with the mark under it that says it is running. */
  .on {
    background: #f2f4f6;
  }

  .on::after {
    content: "";
    position: absolute;
    left: 6px;
    bottom: -7px;
    width: 8px;
    height: 3px;
    border-radius: 2px;
    background: #e9eaec;
  }

  .clock {
    grid-column: 3;
    justify-self: end;
    font-size: 10.5px;
    line-height: 1.3;
    text-align: right;
  }
</style>
