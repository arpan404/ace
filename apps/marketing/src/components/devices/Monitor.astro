---
/*
 * A desktop monitor on its stand, seen from the front. The slot is its 680 × 383 screen; the
 * panel carries `data-lid` for the label.
 */
---

<div class="monitor">
  <div class="panel" data-lid>
    <div class="screen"><slot /></div>
    <i class="led"></i>
  </div>
  <div class="neck"></div>
  <div class="foot"></div>
</div>

<style>
  .monitor {
    position: relative;
    width: 700px;
    height: 500px;
  }

  .panel {
    position: absolute;
    left: 0;
    top: 0;
    width: 700px;
    height: 417px;
    border-radius: 10px;
    background: #0c0d0f;
    box-shadow:
      inset 0 0 0 1.5px #25272b,
      0 0 0 1.5px #050506;
  }

  .screen {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 680px;
    height: 383px;
    overflow: hidden;
    border-radius: 2px;
  }

  /* The power light, on the chin under the screen. */
  .led {
    position: absolute;
    right: 22px;
    bottom: 9px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #8fd0ff;
  }

  .neck {
    position: absolute;
    left: 50%;
    top: 417px;
    width: 96px;
    height: 68px;
    margin-left: -48px;
    background: linear-gradient(to right, #1b1c1f, #3b3d42 45%, #2a2c30 60%, #17181b);
  }

  .foot {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 280px;
    height: 16px;
    margin-left: -140px;
    border-radius: 6px 6px 3px 3px;
    background: linear-gradient(to bottom, #45474c, #1d1e21);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.2),
      0 26px 36px -18px var(--frame-shadow);
  }
</style>
