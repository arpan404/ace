---
/*
 * Every part of ace (content/parts.ts), one group at a time, laid out as the app lays out a
 * list beside its detail: the four groups down the left, the chosen group's parts as ruled rows
 * on the right. A part with a page of its own is a link. On a narrow screen the groups run
 * across the top. Without the script every group shows, one under the other.
 */
import { partGroups } from "../../content/parts.ts";
import Icon from "../Icon.astro";
---

<section class="section page parts" data-parts>
  <header class="head reveal">
    <h2 class="section-title">Every part of ace.</h2>
    <a class="text-link" href="/features/">All features</a>
  </header>

  <div class="layout reveal">
    <div class="tabs" role="tablist" aria-label="Parts of ace" aria-orientation="vertical">
      {
        partGroups.map((group, index) => (
          <button
            type="button"
            role="tab"
            id={`parts-tab-${index}`}
            aria-controls={`parts-panel-${index}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
          >
            <span class="group">{group.name}</span>
            <span class="line">{group.line}</span>
          </button>
        ))
      }
    </div>

    <div class="panels">
      {
        partGroups.map((group, index) => (
          <div class="panel" role="tabpanel" id={`parts-panel-${index}`} aria-labelledby={`parts-tab-${index}`}>
            <h3>
              {group.name}
              <span>{group.line}</span>
            </h3>
            <ul class="card">
              {group.parts.map((part) => {
                const text = (
                  <>
                    <span class="name">
                      {part.name}
                      {part.beta && <span class="beta">Beta</span>}
                      {part.href && <Icon name="arrow-right" size={15} />}
                    </span>
                    <span class="body">{part.body}</span>
                  </>
                );
                return <li>{part.href ? <a href={part.href}>{text}</a> : <div>{text}</div>}</li>;
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .head h2 {
    font-size: clamp(36px, 5vw, 64px);
  }

  .layout {
    display: grid;
    gap: 20px clamp(40px, 7vw, 96px);
    align-items: start;
    margin-top: clamp(28px, 4vw, 48px);
  }

  @media (min-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  /* The groups. They only show once the script can switch between them. */
  .tabs {
    display: none;
  }

  .parts[data-enhanced] .tabs {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  .tabs button {
    flex: none;
    display: grid;
    gap: 3px;
    padding: 9px 14px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-out);
  }

  .tabs button:hover {
    background: var(--wash);
    color: var(--foreground);
  }

  .tabs button[aria-selected="true"] {
    background: var(--active);
    color: var(--foreground);
  }

  .group {
    font-size: 15px;
    font-weight: 500;
  }

  /* On a narrow screen the groups are a row of names; their lines show from tablet width up. */
  .line {
    display: none;
  }

  @media (min-width: 900px) {
    .parts[data-enhanced] .tabs {
      display: grid;
      overflow: visible;
    }

    .tabs button {
      padding: 14px 16px 15px;
    }

    .group {
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.035em;
    }

    .line {
      display: block;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.4;
    }
  }

  .panels {
    display: grid;
    gap: 32px;
  }

  .panel[hidden] {
    display: none;
  }

  /* Each panel names its group only where the groups' list is missing. */
  h3 {
    margin-bottom: 12px;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  h3 span {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0;
  }

  .parts[data-enhanced] h3 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* The parts: flat rows ruled with hairlines, as the app rules a list. */
  ul {
    padding: 6px;
  }

  li + li {
    border-top: 1px solid var(--border);
  }

  li > * {
    display: grid;
    gap: 3px;
    padding: 14px 14px 15px;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color var(--motion-fast) var(--ease-out);
  }

  li > a:hover {
    background: var(--wash);
  }

  .name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .name :global(svg) {
    margin-left: auto;
    color: var(--faint);
    transition:
      color var(--motion-fast) var(--ease-out),
      transform var(--motion-base) var(--ease-out);
  }

  a:hover .name :global(svg) {
    color: var(--foreground);
    transform: translateX(3px);
  }

  .beta {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--subtle);
  }

  .body {
    max-width: 34em;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
</style>

<script>
  /*
   * Tabs: one group shows at a time. A click or the arrow, Home and End keys choose it; only
   * the chosen tab takes Tab focus, as tab lists do.
   */
  for (const root of document.querySelectorAll<HTMLElement>("[data-parts]")) {
    const tabs = [...root.querySelectorAll<HTMLElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const choose = (index: number, focus = false) => {
      tabs.forEach((tab, at) => {
        tab.setAttribute("aria-selected", at === index ? "true" : "false");
        tab.tabIndex = at === index ? 0 : -1;
      });
      panels.forEach((panel, at) => {
        panel.hidden = at !== index;
      });
      if (focus) tabs[index]?.focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => choose(index));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === "ArrowRight" || event.key === "ArrowDown"
            ? (index + 1) % tabs.length
            : event.key === "ArrowLeft" || event.key === "ArrowUp"
              ? (index + last) % tabs.length
              : event.key === "Home"
                ? 0
                : event.key === "End"
                  ? last
                  : -1;
        if (next < 0) return;
        event.preventDefault();
        choose(next, true);
      });
    });
    root.dataset.enhanced = "";
    choose(0);
  }
</script>
