---
import homeDark from "../assets/shots/home-dark.png";
import { acpAgents, builtInAgents } from "../content/agents.ts";
import { product } from "../content/product.ts";
import { links } from "../site.ts";
import AsciiField from "./AsciiField.astro";
import BrandMark from "./BrandMark.astro";
import DownloadButton from "./DownloadButton.astro";
import Icon from "./Icon.astro";
import Shot from "./Shot.astro";

/* Built-in agents first, then a few ACP agents, so the row reads as "and more". */
const marks = [...builtInAgents, ...acpAgents.slice(0, 4)];
---

<section class="hero">
  <AsciiField />
  <div class="page hero-copy">
    <ul class="marks" aria-label="Agents ace runs">
      {
        marks.map((agent) => (
          <li class="tile" title={agent.label}>
            <BrandMark brand={agent.brand} size={18} />
            <span class="sr-only">{agent.label}</span>
          </li>
        ))
      }
    </ul>
    <h1>{product.headline}</h1>
    <p class="summary">{product.summary}</p>
    <div class="actions">
      <DownloadButton />
      <a class="button button-secondary" href={links.source}>
        <Icon name="github-logo" size={16} />
        Star on GitHub
      </a>
    </div>
  </div>

  <div class="page stage">
    <div class="window">
      <Shot
        image={homeDark}
        alt="ace with a thread open: the task list on the left shows which threads need an approval or an answer, and the open thread waits on two subagents and a running command."
        sizes="(min-width: 1232px) 1152px, calc(100vw - 40px)"
        widths={[720, 1152, 1728, 2304]}
        eager
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 64px;
  }

  /* The ASCII field covers only the copy band, not the screenshot. */
  .hero > :global(.ascii) {
    bottom: auto;
    height: 600px;
    mask-image: linear-gradient(to bottom, black 65%, transparent);
  }

  .hero-copy {
    position: relative;
    display: grid;
    justify-items: start;
    padding-bottom: 72px;
  }

  .marks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  h1 {
    margin-top: 36px;
    max-width: 11em;
    font-size: clamp(40px, 5.2vw, 62px);
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .summary {
    margin-top: 20px;
    max-width: 29em;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  /* A warm light behind the window, so it sits on the page instead of on a void. */
  .stage {
    position: relative;
  }

  .stage::before {
    content: "";
    position: absolute;
    inset: -80px 8% auto;
    height: 420px;
    background: radial-gradient(50% 60% at 50% 40%, rgb(255 196 140 / 0.07), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }

  .window {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgb(255 255 255 / 0.09);
    background: var(--surface);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 1px 0 rgb(255 255 255 / 0.04),
      0 50px 120px -40px rgb(0 0 0 / 0.9);
  }

  /* A faint top sheen across the window's glass. */
  .window::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.03), transparent 30%);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > *,
    .window {
      animation: arrive 800ms var(--ease-out) both;
    }

    .hero-copy > :nth-child(2) {
      animation-delay: 60ms;
    }

    .hero-copy > :nth-child(3) {
      animation-delay: 120ms;
    }

    .hero-copy > :nth-child(4) {
      animation-delay: 180ms;
    }

    .window {
      animation: rise 1100ms var(--ease-out) 260ms both;
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* The window settles from a slight tilt, like a lid opening onto the page. */
  @keyframes rise {
    from {
      opacity: 0;
      transform: perspective(1600px) rotateX(8deg) translateY(24px);
    }
  }

  /* Narrower screens put the mark under the copy, so it steps back. */
  @media (max-width: 1100px) {
    .hero > :global(.ascii) {
      opacity: 0.35;
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: 32px;
    }

    .hero > :global(.ascii) {
      opacity: 0.22;
    }

    .hero-copy {
      padding-bottom: 48px;
    }

    .window {
      border-radius: 10px;
    }
  }
</style>
