---
import homeDark from "../assets/shots/home-dark.png";
import { acpAgents, builtInAgents } from "../content/agents.ts";
import { product } from "../content/product.ts";
import { links } from "../site.ts";
import AsciiField from "./AsciiField.astro";
import BrandMark from "./BrandMark.astro";
import DownloadButton from "./DownloadButton.astro";
import Icon from "./Icon.astro";
import Shot from "./Shot.astro";

/* Built-in agents first, then a few ACP agents, so the row reads as "and more". */
const marks = [...builtInAgents, ...acpAgents.slice(0, 4)];
---

<section class="hero">
  <AsciiField />
  <div class="page hero-copy">
    <a class="pill" href={links.source}>
      Free and open source
      <Icon name="arrow-up-right" size={13} />
    </a>
    <ul class="marks" aria-label="Agents ace runs">
      {
        marks.map((agent) => (
          <li class="tile" title={agent.label}>
            <BrandMark brand={agent.brand} size={18} />
            <span class="sr-only">{agent.label}</span>
          </li>
        ))
      }
    </ul>
    <h1>{product.headline}</h1>
    <p class="summary">{product.summary}</p>
    <div class="actions">
      <DownloadButton withNote />
      <a class="button button-secondary" href={links.source}>
        <Icon name="github-logo" size={17} />
        Star on GitHub
      </a>
    </div>
  </div>

  <div class="page">
    <div class="window">
      <Shot
        image={homeDark}
        alt="ace with a thread open: the task list on the left shows which threads need an approval or an answer, and the open thread waits on two subagents and a running command."
        sizes="(min-width: 1232px) 1152px, calc(100vw - 40px)"
        widths={[720, 1152, 1728, 2304]}
        eager
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 72px;
  }

  /* The ASCII field covers only the copy band, not the screenshot. */
  .hero > :global(.ascii) {
    bottom: auto;
    height: 640px;
    mask-image: linear-gradient(to bottom, black 70%, transparent);
  }

  .hero-copy {
    position: relative;
    display: grid;
    justify-items: start;
    padding-bottom: 64px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding-inline: 12px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--background) 70%, transparent);
    color: var(--muted);
    font-size: 13px;
    text-decoration: none;
    transition:
      color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out);
  }

  .pill:hover {
    color: var(--foreground);
    border-color: var(--faint);
  }

  .marks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  h1 {
    margin-top: 32px;
    max-width: 11em;
    font-size: clamp(44px, 6.4vw, 76px);
  }

  .summary {
    margin-top: 22px;
    max-width: 30em;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .window {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    box-shadow:
      0 0 0 6px color-mix(in srgb, var(--raised) 70%, transparent),
      0 40px 120px -40px rgb(0 0 0 / 0.8);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > *,
    .window {
      animation: arrive 700ms var(--ease-out) both;
    }

    .hero-copy > :nth-child(2) {
      animation-delay: 40ms;
    }

    .hero-copy > :nth-child(3) {
      animation-delay: 80ms;
    }

    .hero-copy > :nth-child(4) {
      animation-delay: 120ms;
    }

    .hero-copy > :nth-child(5) {
      animation-delay: 160ms;
    }

    .window {
      animation-delay: 240ms;
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: 40px;
    }

    .hero > :global(.ascii) {
      opacity: 0.22;
    }

    .window {
      border-radius: 10px;
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--raised) 70%, transparent);
    }
  }
</style>
