---
import { acpAgents, builtInAgents } from "../content/agents.ts";
import { product } from "../content/product.ts";
import { links } from "../site.ts";
import AsciiField from "./AsciiField.astro";
import BrandMark from "./BrandMark.astro";
import DownloadButton from "./DownloadButton.astro";
import Icon from "./Icon.astro";

/* Built-in agents first, then a few ACP agents, so the row reads as "and more". */
const marks = [...builtInAgents, ...acpAgents.slice(0, 4)];
/* The headline arrives word by word (styles/motion.css); --w orders the words. */
const words = product.headline.split(" ");
---

<section class="hero">
  <AsciiField focus={0.79} scale={0.72} />
  <div class="page hero-copy">
    <ul class="marks" aria-label="Agents ace runs">
      {
        marks.map((agent, index) => (
          <li class="tile" tabindex="0" data-tip={agent.label} style={`--m: ${index}`}>
            <BrandMark brand={agent.brand} size={18} />
            <span class="sr-only">{agent.label}</span>
          </li>
        ))
      }
    </ul>
    <h1>
      {
        words.map((word, index) => (
          <>
            <span class="word" style={`--w: ${index}`}>
              {word}
            </span>{" "}
          </>
        ))
      }
    </h1>
    <p class="summary">{product.summary}</p>
    <div class="actions">
      <DownloadButton />
      <a class="button button-secondary" href={links.source}>
        <Icon name="github-logo" size={16} />
        Star on GitHub
      </a>
    </div>
    <p class="facts">{product.heroFacts.join(" · ")}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 64px;
  }

  /*
   * The ASCII field covers only the copy band, not the screenshot, and stays inside the page's
   * content column so the mark lines up with the copy instead of running to the window's edge.
   * Its sides fade so the drifting field has no hard edge.
   */
  .hero > :global(.ascii) {
    inset: 0 auto auto 50%;
    width: min(calc(100% - var(--gutter) * 2), var(--page));
    height: 600px;
    translate: -50% 0;
    mask-image:
      linear-gradient(to bottom, black 65%, transparent),
      linear-gradient(to right, transparent, black 4%, black 96%, transparent);
    mask-composite: intersect;
  }

  /*
   * The mark shrinks to the room beside the copy (AsciiField caps it); narrower than this it
   * would run into the summary, so it steps aside.
   */
  @media (max-width: 960px) {
    .hero > :global(.ascii) {
      display: none;
    }
  }

  .hero-copy {
    position: relative;
    display: grid;
    justify-items: start;
    padding-bottom: 72px;
  }

  .marks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Each agent's name, shown above its tile on hover or keyboard focus. */
  .tile {
    position: relative;
    outline: none;
  }

  .tile:focus-visible {
    box-shadow: 0 0 0 2px var(--focus);
  }

  .tile::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    z-index: 2;
    padding: 4px 9px;
    border-radius: 7px;
    background: var(--ink);
    color: var(--ink-foreground);
    font-size: 12.5px;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    translate: -50% 3px;
    transition:
      opacity var(--motion-fast) var(--ease-out),
      translate var(--motion-fast) var(--ease-out);
  }

  .tile:is(:hover, :focus-visible)::after {
    opacity: 1;
    translate: -50% 0;
  }

  h1 {
    margin-top: 36px;
    max-width: 11em;
    font-size: clamp(40px, 5.2vw, 62px);
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .summary {
    margin-top: 20px;
    max-width: 34em;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  .facts {
    margin-top: 18px;
    color: var(--subtle);
    font-size: 13.5px;
  }
</style>
