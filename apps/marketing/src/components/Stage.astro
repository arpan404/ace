---
/*
 * A framed backdrop for a product visual: a dim, grained colour wash with the visual floating on
 * it. `mood` picks the wash; `bleed` lets a screenshot run off the bottom-right edge.
 */
interface Props {
  mood?: "ember" | "plum" | "amber" | "rose" | "sand";
  bleed?: boolean;
}

const { mood = "ember", bleed = false } = Astro.props;
---

<div class:list={["stage", `mood-${mood}`, { bleed }]}>
  <div class="stage-inner"><slot /></div>
</div>

<style>
  .stage {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgb(255 255 255 / 0.06);
    background: var(--wash);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
    isolation: isolate;
  }

  /* Film grain over the wash, so the gradients never band. */
  .stage::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.3;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  /* One warm family: each wash is a lit corner fading into the page's near-black. */
  .mood-ember {
    --wash:
      radial-gradient(90% 110% at 100% 100%, rgb(214 110 58 / 0.75) 0%, transparent 60%),
      radial-gradient(70% 80% at 0% 0%, rgb(120 70 45 / 0.45) 0%, transparent 65%), #17110e;
  }

  .mood-plum {
    --wash:
      radial-gradient(100% 110% at 0% 100%, rgb(150 82 120 / 0.6) 0%, transparent 60%),
      radial-gradient(80% 80% at 100% 0%, rgb(90 60 110 / 0.45) 0%, transparent 65%), #151114;
  }

  .mood-amber {
    --wash:
      radial-gradient(100% 110% at 100% 0%, rgb(220 160 72 / 0.6) 0%, transparent 60%),
      radial-gradient(80% 80% at 0% 100%, rgb(130 85 40 / 0.45) 0%, transparent 65%), #16120d;
  }

  .mood-rose {
    --wash:
      radial-gradient(70% 120% at 0% 0%, rgb(205 105 95 / 0.55) 0%, transparent 60%),
      radial-gradient(70% 90% at 100% 100%, rgb(160 92 60 / 0.5) 0%, transparent 65%), #161010;
  }

  .mood-sand {
    --wash:
      radial-gradient(100% 110% at 0% 0%, rgb(200 170 130 / 0.45) 0%, transparent 60%),
      radial-gradient(80% 80% at 100% 100%, rgb(150 100 70 / 0.45) 0%, transparent 65%), #15120f;
  }

  .stage-inner {
    display: grid;
    place-items: center;
    min-height: 380px;
    padding: 40px;
  }

  .bleed .stage-inner {
    place-items: start;
    padding: 48px 0 0 48px;
  }

  @media (max-width: 640px) {
    .stage-inner {
      min-height: 0;
      padding: 24px 16px;
    }

    .bleed .stage-inner {
      padding: 24px 0 0 20px;
    }
  }
</style>
