---
/*
 * A framed backdrop for a product visual: a dim, grained colour wash with the visual floating on
 * it. `mood` picks the wash; `bleed` lets a screenshot run off the bottom-right edge.
 */
interface Props {
  mood?: "ember" | "dusk" | "moss" | "slate" | "clay";
  bleed?: boolean;
}

const { mood = "ember", bleed = false } = Astro.props;
---

<div class:list={["stage", `mood-${mood}`, { bleed }]}>
  <div class="stage-inner"><slot /></div>
</div>

<style>
  .stage {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: var(--wash);
    isolation: isolate;
  }

  /* Film grain over the wash, so the gradients never band. */
  .stage::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.22;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  .mood-ember {
    --wash:
      radial-gradient(120% 90% at 85% 110%, #8a4b2a 0%, transparent 55%),
      radial-gradient(90% 80% at 0% 0%, #3b2a20 0%, transparent 60%), #1a1512;
  }

  .mood-dusk {
    --wash:
      radial-gradient(110% 90% at 10% 110%, #4a3a6e 0%, transparent 55%),
      radial-gradient(80% 70% at 100% 0%, #2a3350 0%, transparent 60%), #141319;
  }

  .mood-moss {
    --wash:
      radial-gradient(120% 90% at 90% 0%, #3d5a3e 0%, transparent 55%),
      radial-gradient(90% 80% at 0% 100%, #2a3a2a 0%, transparent 60%), #121512;
  }

  .mood-slate {
    --wash:
      radial-gradient(120% 90% at 0% 0%, #2d4a63 0%, transparent 55%),
      radial-gradient(90% 80% at 100% 100%, #23303d 0%, transparent 60%), #111417;
  }

  .mood-clay {
    --wash:
      radial-gradient(120% 90% at 100% 0%, #7a5a3a 0%, transparent 50%),
      radial-gradient(90% 80% at 0% 100%, #4a2f2a 0%, transparent 60%), #171311;
  }

  .stage-inner {
    display: grid;
    place-items: center;
    min-height: 380px;
    padding: 40px;
  }

  .bleed .stage-inner {
    place-items: start;
    padding: 48px 0 0 48px;
  }

  @media (max-width: 640px) {
    .stage-inner {
      min-height: 0;
      padding: 24px 16px;
    }

    .bleed .stage-inner {
      padding: 24px 0 0 20px;
    }
  }
</style>
