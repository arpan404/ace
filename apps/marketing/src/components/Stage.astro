---
/*
 * A framed backdrop for a product visual: a dim, grained colour wash with the visual floating on
 * it. `mood` picks the wash; `bleed` lets a screenshot run off the bottom-right edge.
 */
interface Props {
  mood?: "ember" | "plum" | "amber" | "rose" | "sand";
  bleed?: boolean;
}

const { mood = "ember", bleed = false } = Astro.props;
---

<div class:list={["stage", `mood-${mood}`, { bleed }]}>
  <div class="stage-inner"><slot /></div>
</div>

<style>
  .stage {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--edge);
    box-shadow: inset 0 1px 0 var(--sheen);
    isolation: isolate;
  }

  /* Film grain over the wash, so the gradients never band. */
  .stage::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.3;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  /*
   * One warm family: each wash is two lit corners fading into the stage base.
   */
  .stage {
    background:
      radial-gradient(var(--at-1), rgb(var(--tint-1) / var(--a-1)) 0%, transparent 60%),
      radial-gradient(var(--at-2), rgb(var(--tint-2) / var(--a-2)) 0%, transparent 65%),
      var(--stage-base);
  }

  /*
   * On light paper, two lit corners read as stains. Light mode gets one soft glow of the mood's
   * main tint from the top edge over a clean paper gradient, and no grain.
   */
  :global(html[data-theme="light"]) .stage {
    background:
      radial-gradient(90% 75% at 50% 0%, rgb(var(--tint-1) / 0.16) 0%, transparent 70%),
      linear-gradient(to bottom, #fdfbf8, #f5f1ec);
  }

  :global(html[data-theme="light"]) .stage::before {
    opacity: 0;
  }

  .mood-ember {
    --at-1: 90% 110% at 100% 100%;
    --tint-1: 214 110 58;
    --a-1: 0.75;
    --at-2: 70% 80% at 0% 0%;
    --tint-2: 120 70 45;
    --a-2: 0.45;
  }

  .mood-plum {
    --at-1: 100% 110% at 0% 100%;
    --tint-1: 150 82 120;
    --a-1: 0.6;
    --at-2: 80% 80% at 100% 0%;
    --tint-2: 90 60 110;
    --a-2: 0.45;
  }

  .mood-amber {
    --at-1: 100% 110% at 100% 0%;
    --tint-1: 220 160 72;
    --a-1: 0.6;
    --at-2: 80% 80% at 0% 100%;
    --tint-2: 130 85 40;
    --a-2: 0.45;
  }

  .mood-rose {
    --at-1: 70% 120% at 0% 0%;
    --tint-1: 205 105 95;
    --a-1: 0.55;
    --at-2: 70% 90% at 100% 100%;
    --tint-2: 160 92 60;
    --a-2: 0.5;
  }

  .mood-sand {
    --at-1: 100% 110% at 0% 0%;
    --tint-1: 200 170 130;
    --a-1: 0.45;
    --at-2: 80% 80% at 100% 100%;
    --tint-2: 150 100 70;
    --a-2: 0.45;
  }

  .stage-inner {
    display: grid;
    place-items: center;
    min-height: 380px;
    padding: 40px;
  }

  .bleed .stage-inner {
    place-items: start;
    padding: 48px 0 0 48px;
  }

  @media (max-width: 640px) {
    .stage-inner {
      min-height: 0;
      padding: 24px 16px;
    }

    .bleed .stage-inner {
      padding: 24px 0 0 20px;
    }
  }
</style>
