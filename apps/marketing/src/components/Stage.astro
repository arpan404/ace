---
/*
 * A framed backdrop for a product visual, which floats on it. `mood` picks the tint of its glow;
 * `bleed` lets a screenshot run off the bottom-right edge.
 */
interface Props {
  mood?: "ember" | "plum" | "amber" | "rose" | "sand";
  bleed?: boolean;
}

const { mood = "ember", bleed = false } = Astro.props;
---

<div class:list={["stage", `mood-${mood}`, { bleed }]}>
  <div class="stage-inner"><slot /></div>
</div>

<style>
  /*
   * A calm surface with one faint glow of the mood's tint from the top edge, the same in both
   * themes (colours from the --stage-* tokens). No corner washes and no grain: they read as
   * stains and noise behind crisp UI.
   */
  .stage {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--edge);
    background:
      radial-gradient(90% 70% at 50% 0%, rgb(var(--tint) / var(--stage-glow)) 0%, transparent 70%),
      linear-gradient(to bottom, var(--stage-top), var(--stage-bottom));
    box-shadow: inset 0 1px 0 var(--sheen);
  }

  .mood-ember {
    --tint: 214 120 70;
  }

  .mood-plum {
    --tint: 160 100 150;
  }

  .mood-amber {
    --tint: 215 165 80;
  }

  .mood-rose {
    --tint: 205 115 105;
  }

  .mood-sand {
    --tint: 190 165 130;
  }

  .stage-inner {
    display: grid;
    place-items: center;
    min-height: 380px;
    padding: 40px;
  }

  .bleed .stage-inner {
    place-items: start;
    padding: 48px 0 0 48px;
  }

  @media (max-width: 640px) {
    .stage-inner {
      min-height: 0;
      padding: 24px 16px;
    }

    .bleed .stage-inner {
      padding: 24px 0 0 20px;
    }
  }
</style>
