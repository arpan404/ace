---
/*
 * ace for iPhone: a Live Activity for the thread you follow, the thread list across machines,
 * and an approval waiting at the bottom, which its story answers (scripts/stories.ts).
 */
const threads = [
  { title: "Ship the checkout redesign", where: "MacBook Pro", tone: "working", word: "Working" },
  { title: "Test sign-in on iPhone 17 Pro", where: "build-server", tone: "working", word: "Working" },
  { title: "Fix iOS sign-in", where: "MacBook Pro", tone: "done", word: "Done" },
];
---

<div class="phone-frame" data-story="phone">
  <div class="island" aria-hidden="true">
    <span class="status-dot" data-tone="working"></span>
    <span>2 agents working</span>
  </div>
  <div class="screen">
    <p class="title">Threads</p>
    <ul>
      {
        threads.map((thread) => (
          <li data-tone={thread.tone}>
            <span class="status-dot" aria-hidden="true" />
            <span class="text">
              <span>{thread.title}</span>
              <span class="where">{thread.where}</span>
            </span>
            <span class="status-word">{thread.word}</span>
          </li>
        ))
      }
      <li data-tone="needs-you" data-key="migrate">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="text">
          <span>Migrate orders table</span>
          <span class="where">build-server</span>
        </span>
        <span class="status-word">Approve</span>
      </li>
    </ul>
    <div class="sheet" data-key="sheet">
      <p class="ask">Run the migration on build-server?</p>
      <code>bun run db:migrate</code>
      <div class="choices">
        <span class="choice primary" data-approve>Approve</span>
        <span class="choice">Deny</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* A phone, drawn with the page's own surfaces. */
  .phone-frame {
    position: relative;
    width: 280px;
    height: 560px;
    padding: 10px;
    border-radius: 46px;
    background: var(--raised);
    box-shadow:
      inset 0 0 0 1px var(--border-strong),
      0 40px 90px -30px var(--shadow-deep);
  }

  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    padding: 64px 16px 16px;
    border-radius: 36px;
    background: var(--background);
    font-size: 13px;
  }

  .island {
    position: absolute;
    top: 20px;
    left: 50%;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 14px;
    border-radius: 999px;
    background: #0b0a09;
    color: #eceae6;
    font-size: 11.5px;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .title {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  ul {
    margin-top: 14px;
  }

  li {
    display: grid;
    grid-template-columns: 7px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border);
  }

  .text {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .text > span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .where {
    color: var(--subtle);
    font-size: 11px;
  }

  .status-word {
    font-size: 12px;
  }

  .sheet {
    position: absolute;
    inset: auto 8px 8px;
    display: grid;
    gap: 10px;
    padding: 16px;
    border-radius: 26px;
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--border-strong),
      0 -20px 40px -20px var(--shadow-deep);
    transition:
      transform 700ms var(--ease-out-expo),
      opacity 400ms var(--ease-out-quint);
  }

  .sheet.away {
    transform: translate3d(0, 120%, 0);
    opacity: 0;
  }

  .ask {
    font-weight: 500;
  }

  code {
    padding: 6px 10px;
    border-radius: 8px;
    background: var(--active);
    color: var(--muted);
    font-size: 11.5px;
  }

  .choices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .choice {
    display: grid;
    place-items: center;
    height: 36px;
    border-radius: 999px;
    background: var(--active);
    font-weight: 500;
  }

  .choice.primary {
    background: var(--ink);
    color: var(--ink-foreground);
  }
</style>
