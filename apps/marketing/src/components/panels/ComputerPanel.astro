---
/* Computer use: who holds each app, with Take over and Stop beside the one in use. */
const apps = [
  { name: "Simulator", state: "Codex is using it", active: true },
  { name: "Xcode", state: "Available" },
  { name: "Figma", state: "Available" },
  { name: "Mail", state: "Agents can't use" },
];
---

<div class="panel">
  <div class="panel-row">
    <span class="panel-label">Computer use</span>
    <span class="panel-end panel-quiet">On</span>
  </div>
  {
    apps.map((app) => (
      <div class="panel-row" data-tone={app.active ? "working" : undefined}>
        {app.active ? (
          <span class="status-dot" aria-hidden="true" />
        ) : (
          <span class="idle" aria-hidden="true" />
        )}
        <span>{app.name}</span>
        <span class="panel-quiet">{app.state}</span>
        {app.active && (
          <span class="panel-end">
            <span class="panel-action">Take over</span>
            <span class="panel-action">Stop</span>
          </span>
        )}
      </div>
    ))
  }
</div>

<style>
  .idle {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid var(--faint);
  }
</style>
