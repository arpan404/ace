---
/* The devices hub: simulators and emulators, which agent holds one, and a pending approval. */
const devices = [
  {
    name: "iPhone 17 Pro",
    os: "iOS 26",
    state: "Claude Code",
    tone: "working" as const,
    key: "iphone",
  },
  { name: "iPad Air", os: "iPadOS 26", state: "Booted", key: "ipad" },
  { name: "Pixel 9", os: "Android 16", state: "Off", key: "pixel" },
];
---

<div class="panel" data-story="devices">
  <div class="panel-row">
    <span class="panel-label">Devices</span>
  </div>
  {
    devices.map((device) => (
      <div class="panel-row" data-tone={device.tone} data-key={device.key}>
        <span class="name">{device.name}</span>
        <span class="panel-quiet">{device.os}</span>
        <span class="panel-end">
          <span class="status-dot" aria-hidden="true" />
          <span class="status-word" data-state>
            {device.state}
          </span>
        </span>
      </div>
    ))
  }
  <div class="panel-row ask" data-tone="needs-you" data-key="ask">
    <span class="status-dot" aria-hidden="true"></span>
    <span>Codex wants to use Pixel 9</span>
    <span class="panel-end">
      <span class="panel-action" data-allow>Allow</span>
      <span class="panel-quiet">Deny</span>
    </span>
  </div>
</div>

<style>
  /* Rows without a status show their state in the quiet tier, with no dot. */
  .panel-row:not([data-tone]) .status-dot {
    display: none;
  }

  .panel-row:not([data-tone]) .status-word {
    color: var(--muted);
    font-weight: 400;
  }

  .name {
    min-width: 108px;
  }

  .ask {
    background: color-mix(in srgb, var(--status-needs-you) 7%, transparent);
  }
</style>
