---
import { links } from "../site.ts";
import DownloadButton from "./DownloadButton.astro";
import Icon from "./Icon.astro";
---

<section class="closing">
  <div class="page inner reveal">
    <h2>Free, open source, and yours to run.</h2>
    <p class="lede">
      Install ace on your computer, point it at a project, and start a thread with any agent you have logged
      in.
    </p>
    <div class="actions">
      <DownloadButton withNote />
      <a class="button button-secondary" href={links.source}>
        <Icon name="github-logo" size={16} />
        Star on GitHub
      </a>
    </div>
    <a class="text-link more" href="/download/">Every download: Mac, Windows, Linux, iPhone and iPad</a>
  </div>
</section>

<style>
  .closing {
    position: relative;
    margin-top: var(--section);
    padding-block: clamp(88px, 12vw, 160px);
    overflow: hidden;
  }

  .inner {
    position: relative;
    display: grid;
    justify-items: start;
  }

  h2 {
    max-width: 10em;
    font-size: clamp(40px, 7.2vw, 96px);
    letter-spacing: -0.055em;
    line-height: 0.96;
  }

  .lede {
    margin-top: 24px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .more {
    margin-top: 22px;
    font-size: 14px;
  }

  .actions :global(.button-secondary) {
    background: var(--background);
  }

</style>
