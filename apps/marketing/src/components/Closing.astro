---
import { links } from "../site.ts";
import AsciiField from "./AsciiField.astro";
import DownloadButton from "./DownloadButton.astro";
import Icon from "./Icon.astro";
---

<section class="closing">
  <AsciiField focus={0.5} scale={0.9} />
  <div class="page inner reveal">
    <h2>Free, open source, and yours to run.</h2>
    <p class="lede">
      Install ace on your computer, point it at a project, and start a thread with any agent you have logged
      in.
    </p>
    <div class="actions">
      <DownloadButton withNote />
      <a class="button button-secondary" href={links.source}>
        <Icon name="github-logo" size={16} />
        Star on GitHub
      </a>
    </div>
  </div>
</section>

<style>
  .closing {
    position: relative;
    margin-top: var(--section);
    padding-block: 140px;
    border-top: 1px solid var(--border);
    overflow: hidden;
  }

  .closing > :global(.ascii) {
    opacity: 0.3;
    mask-image: radial-gradient(60% 70% at 50% 50%, black 30%, transparent 80%);
  }

  .inner {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
  }

  h2 {
    max-width: 12em;
    font-size: clamp(36px, 5vw, 60px);
  }

  .lede {
    margin-inline: auto;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .actions :global(.button-secondary) {
    background: var(--background);
  }

  .actions :global(.download-note) {
    text-align: center;
  }
</style>
