---
/*
 * Every ace tool (content/mcp.ts), one group at a time, laid out as the home page lays out the
 * parts of ace: the groups down the left, the chosen group's tools as ruled rows on the right,
 * each with its real name in mono. On a narrow screen the groups run across the top. Without
 * the script every group shows, one under the other.
 */
import { mcpPage, toolCount, toolReference } from "../../content/mcp.ts";

const slug = (family: string) => family.toLowerCase().replaceAll(" ", "-");
---

<section class="section page tools" id="tools" data-tools>
  <header class="head reveal">
    <h2 class="section-title">{mcpPage.toolsHeading}</h2>
    <p class="count">{toolCount} tools in {toolReference.length} groups</p>
  </header>

  <div class="layout reveal">
    <div class="tabs" role="tablist" aria-label="Tool groups">
      {
        toolReference.map((group, index) => (
          <button
            type="button"
            role="tab"
            id={`tools-tab-${index}`}
            aria-controls={`tools-panel-${index}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-tab={slug(group.family)}
          >
            <span class="group">
              {group.family}
              <span class="n">{group.tools.length}</span>
            </span>
            <span class="line">{group.purpose}</span>
          </button>
        ))
      }
    </div>

    <div class="panels">
      {
        toolReference.map((group, index) => (
          <div
            class="panel"
            role="tabpanel"
            id={`tools-panel-${index}`}
            aria-labelledby={`tools-tab-${index}`}
          >
            <h3>
              {group.family}
              <span>{group.purpose}</span>
            </h3>
            <ul class="card">
              {group.tools.map((tool) => (
                <li>
                  <code>{tool.name}</code>
                  <span>{tool.does}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .head h2 {
    font-size: clamp(36px, 5vw, 64px);
  }

  .count {
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .layout {
    display: grid;
    gap: 20px clamp(40px, 7vw, 96px);
    align-items: start;
    margin-top: clamp(28px, 4vw, 48px);
  }

  @media (min-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  /* The groups. They only show once the script can switch between them. */
  .tabs {
    display: none;
  }

  .tools[data-enhanced] .tabs {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  .tabs button {
    flex: none;
    display: grid;
    gap: 3px;
    padding: 9px 14px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-out);
  }

  .tabs button:hover {
    background: var(--wash);
    color: var(--foreground);
  }

  .tabs button[aria-selected="true"] {
    background: var(--active);
    color: var(--foreground);
  }

  .group {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
  }

  .n {
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
  }

  /* On a narrow screen the groups are a row of names; their lines show from tablet width up. */
  .line {
    display: none;
  }

  @media (min-width: 900px) {
    .tools[data-enhanced] .tabs {
      display: grid;
      overflow: visible;
    }

    .tabs button {
      padding: 11px 16px 12px;
    }

    .group {
      font-size: 20px;
      font-weight: 600;
      letter-spacing: -0.035em;
    }

    .line {
      display: block;
      color: var(--muted);
      font-size: 14.5px;
      line-height: 1.4;
    }
  }

  .panels {
    display: grid;
    gap: 32px;
  }

  .panel[hidden] {
    display: none;
  }

  /* Each panel names its group only where the groups' list is missing. */
  h3 {
    margin-bottom: 12px;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  h3 span {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0;
  }

  .tools[data-enhanced] h3 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* The tools: flat rows ruled with hairlines, the name in mono over one plain sentence. */
  ul {
    padding: 6px;
  }

  li {
    display: grid;
    gap: 4px;
    padding: 13px 14px 14px;
    border-radius: 8px;
    transition: background-color var(--motion-fast) var(--ease-out);
  }

  li + li {
    position: relative;
  }

  /* The rule between rows stands inside the rows' padding, so a hovered row's wash reads as
     one rounded shape. */
  li + li::before {
    content: "";
    position: absolute;
    top: 0;
    right: 14px;
    left: 14px;
    height: 1px;
    background: var(--border);
  }

  li:hover {
    background: var(--wash);
  }

  li:hover::before,
  li:hover + li::before {
    opacity: 0;
  }

  code {
    color: var(--foreground);
    font-size: 14px;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  li span {
    max-width: 34em;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    li {
      grid-template-columns: 11.5em minmax(0, 1fr);
      gap: 20px;
      align-items: baseline;
    }
  }
</style>

<script>
  import { startTabs } from "../../scripts/tabs.ts";

  /* The groups stand in a column on a wide screen, so the up and down arrows step through them
     as well as left and right. */
  for (const root of document.querySelectorAll<HTMLElement>("[data-tools]")) {
    startTabs(root);
    const tabs = [...root.querySelectorAll<HTMLElement>('[role="tab"]')];
    tabs.forEach((tab, index) => {
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowDown" ? 1 : event.key === "ArrowUp" ? -1 : 0;
        if (step === 0) return;
        event.preventDefault();
        const next = tabs[(index + step + tabs.length) % tabs.length];
        next?.click();
        next?.focus();
      });
    });
  }
</script>
