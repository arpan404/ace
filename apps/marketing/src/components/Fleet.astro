---
import { feature } from "../content/features.ts";
import FleetPanel from "./panels/FleetPanel.astro";
import MoreLink from "./site/MoreLink.astro";
import Stage from "./Stage.astro";

const { headline, intro } = feature("fleet");
---

<section id="fleet" class="section page">
  <div class="head reveal">
    <h2 class="section-title">{headline}</h2>
    <p class="lede">{intro}</p>
    <MoreLink href="/features/fleet/" label="More on Fleet" />
  </div>

  <div class="visual reveal">
    <Stage mood="sand">
      <FleetPanel />
    </Stage>
  </div>
</section>

<style>
  .head .section-title {
    max-width: 16em;
  }

  .visual {
    margin-top: 56px;
  }

  .visual :global(.stage-inner) {
    min-height: 460px;
    padding: 56px 40px;
  }

  @media (max-width: 800px) {

    .visual :global(.stage-inner) {
      padding: 24px 16px;
    }
  }
</style>
