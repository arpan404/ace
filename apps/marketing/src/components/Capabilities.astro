---
import { capabilities } from "../content/product.ts";
import Icon from "./Icon.astro";
---

<section id="machine" class="capabilities page">
  <div class="intro reveal">
    <h2 class="section-title">Browser use, computer use and real devices.</h2>
    <p class="lede">
      Code is half the job. Agents open the page, click through your Mac's apps and test on iOS
      and Android, while you watch and keep the controls.
    </p>
  </div>

  <div class="columns">
    {
      capabilities.map((capability) => (
        <article class="capability reveal">
          <span class="badge">
            <Icon name={capability.icon} size={22} />
          </span>
          <h3>{capability.title}</h3>
          <p class="body">{capability.body}</p>
          <ul class="details">
            {capability.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
          <p class="tools">
            <span class="sr-only">Tools: </span>
            {capability.tools.map((tool) => (
              <code>{tool}</code>
            ))}
          </p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .capabilities {
    display: grid;
    gap: 56px;
    padding-block: 120px 40px;
  }

  .intro {
    display: grid;
    gap: 20px;
    max-width: 760px;
  }

  .columns {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .capability {
    display: grid;
    align-content: start;
    gap: 14px;
    padding-block: 32px;
    border-bottom: 1px solid var(--border);
  }

  .badge {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 6px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--foreground);
  }

  h3 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .body {
    color: var(--muted);
  }

  .details {
    display: grid;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  .details li {
    display: grid;
    grid-template-columns: 12px 1fr;
    gap: 10px;
    color: var(--foreground);
  }

  .details li::before {
    content: "";
    width: 12px;
    height: 1px;
    margin-top: 0.8em;
    background: var(--faint);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  .tools code {
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--subtle);
    font-size: 12.5px;
  }

  @media (min-width: 1024px) {
    .columns {
      grid-template-columns: repeat(3, 1fr);
      border-bottom: 1px solid var(--border);
    }

    .capability {
      padding: 36px 32px 40px;
      border-bottom: none;
    }

    .capability:first-child {
      padding-left: 0;
    }

    .capability:last-child {
      padding-right: 0;
    }

    .capability + .capability {
      border-left: 1px solid var(--border);
    }
  }

  @media (max-width: 767px) {
    .capabilities {
      padding-block: 72px;
      gap: 32px;
    }
  }
</style>
