---
/*
 * Spade's announcement: Spade in 3D (public/spade.glb) looking toward the pointer and blinking
 * now and then, the name, and that it is coming soon. The flat face (the shared geometry in
 * @ace/ui-core/spade) shows until the 3D one is ready, and stays where WebGL is missing.
 */
import { spade } from "../content/product.ts";
import SpadeFace from "./mac/SpadeFace.astro";
---

<section class="section page spade" data-spade-section>
  <div class="face reveal" data-spade-3d>
    <SpadeFace size={132} />
    <canvas aria-hidden="true"></canvas>
  </div>
  <p class="status reveal">{spade.status}</p>
  <h2 class="section-title reveal">{spade.headline}</h2>
  <p class="lede reveal">{spade.body}</p>
</section>

<style>
  .spade {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .face {
    position: relative;
    display: grid;
    place-items: center;
    width: 240px;
    height: 240px;
    color: var(--foreground);
  }

  .face canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .face :global(.spade-face) {
    transition: opacity 0.3s;
  }

  .face[data-ready] canvas {
    opacity: 1;
  }

  .face[data-ready] :global(.spade-face) {
    opacity: 0;
  }

  .face :global(.eye) {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 5.2s infinite;
  }

  .face :global(.eye[data-eye="1"]) {
    animation-delay: 30ms;
  }

  @keyframes blink {
    0%,
    94% {
      transform: scaleY(1);
    }

    95.5% {
      transform: scaleY(0.08);
    }

    97% {
      transform: scaleY(1);
    }
  }

  .status {
    margin-top: 8px;
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 10px;
  }

  .lede {
    margin-top: 14px;
    max-width: 30em;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .face :global(.eye) {
      animation: none;
    }
  }
</style>

<script>
  import { spadeLook } from "../scripts/spade-look.ts";

  for (const section of document.querySelectorAll<HTMLElement>("[data-spade-section]")) {
    spadeLook(section);
    // The 3D Spade loads only as the section comes near, and not at all when the visitor asked
    // to save data; the flat face stays then.
    const host = section.querySelector<HTMLElement>("[data-spade-3d]");
    const { connection } = navigator as Navigator & { connection?: { saveData?: boolean } };
    if (!host || connection?.saveData) continue;
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void import("../scripts/spade-3d.ts").then(({ startSpade3d }) =>
          startSpade3d(host, "/spade.glb"),
        );
      },
      { rootMargin: "300px" },
    );
    observer.observe(host);
  }
</script>
