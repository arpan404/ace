---
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import { product } from "../content/product.ts";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Pages that shouldn't appear in search results, such as the 404 page. */
  noindex?: boolean;
  /** schema.org data for this page, serialized into a JSON-LD script. */
  structuredData?: object;
  /** Open Graph type: the home page is a website, every other page an article. */
  ogType?: "website" | "article";
}

const { title, description, noindex = false, structuredData, ogType = "website" } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = site ? new URL("/og.png", site).href : "/og.png";
const ogAlt = `${product.name}: ${product.headline}`;
// JSON in a script tag must not be able to close the tag early.
const jsonLd = structuredData ? JSON.stringify(structuredData).replaceAll("<", "\\u003c") : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={product.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <meta name="application-name" content={product.name} />
    <meta name="apple-mobile-web-app-title" content={product.name} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#11100f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-64.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="text/plain" title="ace for language models" href="/llms.txt" />
    {site && <link rel="sitemap" type="application/xml" href="/sitemap.xml" />}

    <!--
      Before paint: the theme (the visitor's saved choice, else their system setting, followed
      live until they choose), and their desktop OS so the matching download button shows.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const key = "ace-theme";
        const system = matchMedia("(prefers-color-scheme: light)");
        const saved = () => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };
        const apply = () => {
          root.dataset.theme = saved() ?? (system.matches ? "light" : "dark");
        };
        apply();
        system.addEventListener("change", () => {
          if (!saved()) apply();
        });
      })();
      (() => {
        const ua = navigator.userAgent;
        if (/Android|iPhone|iPad|iPod/.test(ua)) return;
        if (/Windows/.test(ua)) document.documentElement.dataset.os = "windows";
        else if (/Linux|X11|CrOS/.test(ua)) document.documentElement.dataset.os = "linux";
      })();
    </script>
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <slot />
  </body>
</html>
