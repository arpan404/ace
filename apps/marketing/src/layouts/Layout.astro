---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ace — multi-provider agent workspace with handoff and parallel PRs",
  description =
    "Desktop workspace for seven coding agents (Codex, Claude, Gemini, Cursor, Pi, Copilot, OpenCode). Multiple accounts per provider, handoff between models, browser and editor review, parallel PRs in worktrees, E2E-encrypted remote viewing when you need it.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/product/app-screenshot.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/product/app-screenshot.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="page">
      <main id="content" class="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-brand-block">
          <a href="/" class="footer-brand">
            <img src="/logo.png" alt="" />
            <span>ace</span>
          </a>
          <p class="footer-copy">
            Multi-provider agent workspace: handoff, browser and editor review, parallel PRs. Open
            source—bring your own accounts; we do not resell model access.
          </p>
        </div>
        <div class="footer-links">
          <a href="https://github.com/arpan404/ace" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="/changelog">Changelog</a>
          <a href="mailto:contact@arpan.sh">Contact</a>
        </div>
      </footer>
    </div>
  </body>
</html>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reducedMotion) {
    document.documentElement.classList.add("motion-ready");
    const revealItems = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
    const scroll3dItems = Array.from(document.querySelectorAll<HTMLElement>("[data-scroll-3d]"));

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
          } else {
            entry.target.classList.remove("is-visible");
          }
        });
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.12 },
    );

    revealItems.forEach((item, index) => {
      item.style.setProperty("--reveal-delay", `${Math.min(index * 42, 220)}ms`);
      revealObserver.observe(item);
    });

    if (scroll3dItems.length > 0) {
      let scrollFrame = 0;

      const updateScroll3d = () => {
        scrollFrame = 0;
        const viewportHeight = window.innerHeight || 1;
        const viewportCenter = viewportHeight / 2;

        scroll3dItems.forEach((item) => {
          const rect = item.getBoundingClientRect();
          if (rect.bottom < -160 || rect.top > viewportHeight + 160) return;

          const center = rect.top + rect.height / 2;
          const rawProgress = (center - viewportCenter) / viewportCenter;
          const progress = Math.max(-1, Math.min(1, rawProgress));
          const strength = Number(item.dataset.scrollStrength ?? "1");
          const rotateX = -progress * 14 * strength;
          const rotateY = progress * 8 * strength;
          const translateY = -progress * 45 * strength;
          const translateZ = Math.abs(progress) * -80 * strength;
          const scale = 1 - Math.abs(progress) * 0.04 * strength;
          const shadow = 1 - Math.abs(progress) * 0.4;

          item.style.setProperty("--scroll-rotate-x", `${rotateX.toFixed(3)}deg`);
          item.style.setProperty("--scroll-rotate-y", `${rotateY.toFixed(3)}deg`);
          item.style.setProperty("--scroll-translate-y", `${translateY.toFixed(3)}px`);
          item.style.setProperty("--scroll-translate-z", `${translateZ.toFixed(3)}px`);
          item.style.setProperty("--scroll-scale", scale.toFixed(4));
          item.style.setProperty("--scroll-shadow", shadow.toFixed(4));
        });
      };

      const requestScroll3dUpdate = () => {
        if (scrollFrame) return;
        scrollFrame = window.requestAnimationFrame(updateScroll3d);
      };

      updateScroll3d();
      window.addEventListener("scroll", requestScroll3dUpdate, { passive: true });
      window.addEventListener("resize", requestScroll3dUpdate);
    }
  }

  document.querySelectorAll<HTMLElement>("[data-interactive]").forEach((element) => {
    element.addEventListener("pointermove", (event) => {
      const rect = element.getBoundingClientRect();
      element.style.setProperty("--pointer-x", `${event.clientX - rect.left}px`);
      element.style.setProperty("--pointer-y", `${event.clientY - rect.top}px`);
    });

    element.addEventListener("pointerdown", () => {
      element.classList.add("is-pressing");
    });

    for (const eventName of ["pointerup", "pointercancel", "pointerleave", "blur"]) {
      element.addEventListener(eventName, () => {
        element.classList.remove("is-pressing");
      });
    }
  });
</script>

<style is:global>
  :root {
    --bg: #000000;
    --bg-elevated: #0a0a0a;
    --surface: #111111;
    --surface-strong: #ffffff;
    --ink: #000000;
    --fg: #ffffff;
    --fg-muted: #888888;
    --fg-dim: #555555;
    --primary: #ffffff;
    --accent: #ffffff;
    --accent-secondary: #ffffff;
    --accent-warm: #ffffff;
    --accent-deep: #444444;
    --accent-soft: rgba(255, 255, 255, 0.08);
    --accent-glow: rgba(255, 255, 255, 0.15);
    --accent-glow-strong: rgba(255, 255, 255, 0.3);
    --violet: #ffffff;
    --review: #ffffff;
    --risk: #ff453a;
    --success: #32d74b;
    --clay: #888888;
    --line: #1f1f1f;
    --line-strong: #333333;
    --border: var(--line);
    --border-bright: var(--line-strong);
    --shadow: rgba(0, 0, 0, 0.8);
    --radius: 12px;
    --site-pad: clamp(1.25rem, 5vw, 2.5rem);
    --site-max: 1200px;
    --font-display: "Outfit", system-ui, sans-serif;
    --font-sans: "DM Sans", system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    color-scheme: dark;
    scroll-behavior: smooth;
    background: var(--bg);
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
    background-color: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img,
  svg {
    display: block;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent-secondary);
    outline-offset: 4px;
  }

  .motion-ready [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 48px, 0) scale(0.98);
    filter: blur(12px);
    transition:
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform, filter;
  }

  .motion-ready [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    filter: blur(0);
  }

  .motion-ready [data-scroll-3d] {
    --scroll-rotate-x: 0deg;
    --scroll-rotate-y: 0deg;
    --scroll-translate-y: 0px;
    --scroll-translate-z: 0px;
    --scroll-scale: 1;
    --scroll-shadow: 1;
    transform: perspective(1200px) rotateX(var(--scroll-rotate-x)) rotateY(var(--scroll-rotate-y))
      translate3d(0, var(--scroll-translate-y), var(--scroll-translate-z)) scale(var(--scroll-scale));
    transform-style: preserve-3d;
    will-change: transform;
  }

  [data-interactive] {
    --pointer-x: 50%;
    --pointer-y: 50%;
    position: relative;
    overflow: hidden;
  }

  [data-interactive]::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle at var(--pointer-x) var(--pointer-y),
      rgba(94, 234, 212, 0.22),
      transparent 42%
    );
    opacity: 0;
    transition: opacity 160ms ease;
  }

  [data-interactive]:hover::before,
  [data-interactive]:focus-visible::before {
    opacity: 1;
  }

  [data-interactive].is-pressing {
    transform: translateY(1px) scale(0.992);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.001ms !important;
    }

    .motion-ready [data-reveal] {
      opacity: 1;
      transform: none;
      filter: none;
      transition: opacity 380ms ease, transform 420ms ease;
    }
  }

  .skip-link {
    position: fixed;
    left: 1rem;
    top: 1rem;
    z-index: 20;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    border-radius: 6px;
    background: var(--surface-strong);
    color: var(--ink);
    padding: 0;
    font-weight: 700;
    white-space: nowrap;
  }

  .skip-link:focus-visible {
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    clip-path: none;
    padding: 0.7rem 0.9rem;
    background: var(--accent-secondary);
    color: var(--ink);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<style>
  .page {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }

  .footer-links {
    display: flex;
    align-items: center;
  }

  .main {
    display: flex;
    flex: 1;
    width: 100%;
    max-width: 100%;
    flex-direction: column;
    overflow-x: hidden;
  }

  .footer {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) auto;
    align-items: end;
    gap: 2.5rem 2rem;
    width: min(100% - 2rem, var(--site-max, 1200px));
    margin: 0 auto;
    border-top: 1px solid var(--line);
    padding: 2.75rem 0 3.25rem;
    position: relative;
  }

  .footer::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: min(12rem, 35%);
    height: 1px;
    background: linear-gradient(90deg, var(--accent-secondary), transparent);
    opacity: 0.7;
  }

  .footer-brand-block {
    display: grid;
    gap: 0.75rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .footer-brand img {
    width: 2rem;
    height: 2rem;
    border-radius: 0.7rem;
  }

  .footer-copy {
    max-width: 32rem;
    color: var(--fg-dim);
    font-size: 0.94rem;
    line-height: 1.58;
  }

  .footer-links {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 1rem;
  }

  .footer-links a {
    color: var(--fg-muted);
    font-size: 0.94rem;
    font-weight: 700;
    transition: color 180ms ease;
  }

  .footer-links a:hover {
    color: var(--accent-secondary);
  }

  @media (max-width: 780px) {
    .footer {
      grid-template-columns: 1fr;
      align-items: flex-start;
      padding-bottom: 2rem;
    }

    .footer-links {
      justify-content: flex-start;
    }
  }
</style>
