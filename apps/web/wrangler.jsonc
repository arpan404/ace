// Hosts the web app at app.acehq.dev as a static Cloudflare Worker.
// Deploy: `bun run --cwd apps/web deploy`.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "ace-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Any path that isn't a built file opens index.html, and the app's router takes it from there.
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "app.acehq.dev", "custom_domain": true }],
  "workers_dev": false
}
