    "@ace/search": "workspace:*",
    "qrcode-generator": "2.0.4",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "jsqr": "1.4.0"
