      {
        "offered": 0
      },
      {
        "offered": 0
      },
      {
        "offered": 0
      },
      {
        "dropped": "v"
      },
      {
        "keyframe": "e"
      },
      {
        "offered": 0
      },
      {
        "counted": 0,
        "bytes": 100
      },
      {
        "id": "v",
        "playing": true
      },
      {
        "offered": 3
      },
      {
        "counted": 3,
        "bytes": 100
      },
      {
        "dropped": "v"
      },
      {
        "keyframe": "e"
      }
    ]
