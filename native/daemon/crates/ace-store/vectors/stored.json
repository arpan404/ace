{
  "items": [
    {
      "name": "a message missing its defaults",
      "input": "{\"id\":\"m0\",\"agentId\":\"root\",\"type\":\"message\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"hello\"}],\"createdAt\":1}",
      "expected": "{\"id\":\"m0\",\"agentId\":\"root\",\"createdAt\":1,\"complete\":true,\"type\":\"message\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"hello\"}],\"synthetic\":false,\"raw\":[]}"
    },
    {
      "name": "a message with a field this build strips",
      "input": "{\"id\":\"m0\",\"agentId\":\"root\",\"type\":\"message\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"hello\"}],\"createdAt\":1,\"complete\":false,\"later\":true}",
      "expected": "{\"id\":\"m0\",\"agentId\":\"root\",\"createdAt\":1,\"complete\":false,\"type\":\"message\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"hello\"}],\"synthetic\":false,\"raw\":[]}"
    },
    {
      "name": "a tool call with stripped inner fields",
      "input": "{\"id\":\"t0\",\"agentId\":\"root\",\"type\":\"tool_call\",\"createdAt\":1,\"call\":{\"id\":\"t0\",\"agentId\":\"root\",\"kind\":\"shell\",\"title\":\"ls\",\"status\":\"succeeded\",\"detail\":{\"kind\":\"shell\",\"command\":\"ls\",\"retired\":true},\"startedAt\":1,\"raw\":[{\"type\":\"message_stop\",\"data\":{\"blob\":\"A\"}}],\"unknownField\":\"dropped\"}}",
      "expected": "{\"id\":\"t0\",\"agentId\":\"root\",\"createdAt\":1,\"complete\":true,\"type\":\"tool_call\",\"call\":{\"id\":\"t0\",\"agentId\":\"root\",\"kind\":\"shell\",\"title\":\"ls\",\"status\":\"succeeded\",\"detail\":{\"kind\":\"shell\",\"command\":\"ls\"},\"startedAt\":1,\"raw\":[{\"type\":\"message_stop\",\"data\":{\"blob\":\"A\"}}]}}"
    },
    {
      "name": "an item kind this build does not know",
      "input": "{\"id\":\"x0\",\"agentId\":\"root\",\"createdAt\":2,\"type\":\"future.item\",\"detail\":{\"a\":1}}",
      "expected": "{\"id\":\"x0\",\"agentId\":\"root\",\"createdAt\":2,\"complete\":true,\"type\":\"unknown\",\"raw\":[],\"data\":{\"id\":\"x0\",\"agentId\":\"root\",\"createdAt\":2,\"type\":\"future.item\",\"detail\":{\"a\":1}}}"
    }
  ],
  "payloads": [
    {
      "name": "a created item carries the decoded item",
      "input": "{\"type\":\"item.created\",\"item\":{\"id\":\"m0\",\"agentId\":\"root\",\"type\":\"message\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"hello\"}],\"createdAt\":1}}",
      "expected": "{\"type\":\"item.created\",\"item\":{\"id\":\"m0\",\"agentId\":\"root\",\"createdAt\":1,\"complete\":true,\"type\":\"message\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"hello\"}],\"synthetic\":false,\"raw\":[]}}"
    },
    {
      "name": "an updated unknown item kind",
      "input": "{\"type\":\"item.updated\",\"item\":{\"id\":\"x0\",\"agentId\":\"root\",\"createdAt\":2,\"type\":\"future.item\",\"detail\":{\"a\":1}}}",
      "expected": "{\"type\":\"item.updated\",\"item\":{\"id\":\"x0\",\"agentId\":\"root\",\"createdAt\":2,\"complete\":true,\"type\":\"unknown\",\"raw\":[],\"data\":{\"id\":\"x0\",\"agentId\":\"root\",\"createdAt\":2,\"type\":\"future.item\",\"detail\":{\"a\":1}}}}"
    },
    {
      "name": "a thread update with a legacy switch recommendation",
      "input": "{\"type\":\"thread.updated\",\"title\":\"renamed\",\"switch\":{\"selection\":{\"provider\":\"codex\"},\"state\":\"applied\",\"lossy\":false,\"recommendation\":\"delegate_task\",\"at\":5,\"later\":\"stripped\"},\"extra\":true}",
      "expected": "{\"type\":\"thread.updated\",\"title\":\"renamed\",\"switch\":{\"selection\":{\"provider\":\"codex\",\"options\":{}},\"state\":\"applied\",\"lossy\":false,\"recommendation\":\"delegate\",\"at\":5}}"
    },
    {
      "name": "a switch keeps its place before the fields that follow it",
      "input": "{\"type\":\"thread.updated\",\"switch\":{\"selection\":{\"provider\":\"codex\"},\"state\":\"applied\",\"lossy\":false,\"recommendation\":\"delegate_task\",\"at\":5},\"execution\":{\"provider\":\"codex\"},\"status\":{\"state\":\"idle\"},\"archivedAt\":9}",
      "expected": "{\"type\":\"thread.updated\",\"execution\":{\"provider\":\"codex\",\"options\":{}},\"switch\":{\"selection\":{\"provider\":\"codex\",\"options\":{}},\"state\":\"applied\",\"lossy\":false,\"recommendation\":\"delegate\",\"at\":5},\"status\":{\"state\":\"unknown\",\"raw\":{\"state\":\"idle\"}},\"archivedAt\":9}"
    },
    {
      "name": "a thread update with a title only",
      "input": "{\"type\":\"thread.updated\",\"title\":\"plain\",\"extra\":1}",
      "expected": "{\"type\":\"thread.updated\",\"title\":\"plain\"}"
    },
    {
      "name": "a created thread with a state this build does not know",
      "input": "{\"type\":\"thread.created\",\"thread\":{\"id\":\"t1\",\"workspaceId\":\"w1\",\"title\":\"Legacy\",\"provider\":\"codex\",\"status\":{\"state\":\"idle\",\"since\":3},\"createdAt\":1,\"updatedAt\":2}}",
      "expected": "{\"type\":\"thread.created\",\"thread\":{\"id\":\"t1\",\"workspaceId\":\"w1\",\"title\":\"Legacy\",\"provider\":\"codex\",\"status\":{\"state\":\"unknown\",\"raw\":{\"state\":\"idle\",\"since\":3}},\"createdAt\":1,\"updatedAt\":2}}"
    },
    {
      "name": "an agent status keeps its own states",
      "input": "{\"type\":\"agent.status\",\"agentId\":\"a1\",\"status\":{\"state\":\"idle\"},\"completionRelevant\":true}",
      "expected": "{\"type\":\"agent.status\",\"agentId\":\"a1\",\"status\":{\"state\":\"idle\"},\"completionRelevant\":true}"
    },
    {
      "name": "an event kind this build does not know",
      "input": "{\"type\":\"future.event\",\"threadId\":\"t\",\"payload\":{\"deep\":[1,2,3]}}",
      "expected": "{\"type\":\"unknown\",\"raw\":{\"type\":\"future.event\",\"threadId\":\"t\",\"payload\":{\"deep\":[1,2,3]}}}"
    }
  ],
  "rows": [
    {
      "name": "a trusted row is its payload text in the envelope",
      "row": {
        "seq": 10,
        "id": "e10",
        "thread_id": "t1",
        "at": 1800000000000,
        "payload": "{\"type\":\"thread.updated\",\"title\":\"trusted\"}"
      },
      "trust": {
        "from": 5,
        "rejected": []
      },
      "event": "{\"seq\":10,\"id\":\"e10\",\"at\":1800000000000,\"threadId\":\"t1\",\"payload\":{\"type\":\"thread.updated\",\"title\":\"trusted\"}}",
      "bytes": 110
    },
    {
      "name": "an untrusted row is decoded",
      "row": {
        "seq": 3,
        "id": "e3",
        "thread_id": "t1",
        "at": 1800000000001,
        "payload": "{\"type\":\"thread.updated\",\"title\":\"decoded\",\"extra\":1}"
      },
      "trust": {
        "from": 5,
        "rejected": []
      },
      "event": "{\"seq\":3,\"id\":\"e3\",\"at\":1800000000001,\"threadId\":\"t1\",\"payload\":{\"type\":\"thread.updated\",\"title\":\"decoded\"}}",
      "bytes": 108
    },
    {
      "name": "a rejected sequence in the trusted range is decoded",
      "row": {
        "seq": 7,
        "id": "e7",
        "thread_id": "t1",
        "at": 1800000000002,
        "payload": "{\"type\":\"item.created\",\"item\":{\"id\":\"m0\",\"agentId\":\"root\",\"type\":\"message\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"hello\"}],\"createdAt\":1}}"
      },
      "trust": {
        "from": 5,
        "rejected": [
          7
        ]
      },
      "event": "{\"seq\":7,\"id\":\"e7\",\"at\":1800000000002,\"threadId\":\"t1\",\"payload\":{\"type\":\"item.created\",\"item\":{\"id\":\"m0\",\"agentId\":\"root\",\"createdAt\":1,\"complete\":true,\"type\":\"message\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"hello\"}],\"synthetic\":false,\"raw\":[]}}}",
      "bytes": 258
    }
  ],
  "entities": [
    {
      "name": "an agent gets its defaults and keeps the schema's order",
      "collection": "agents",
      "input": "{\"id\":\"a1\",\"threadId\":\"t1\",\"parentId\":null,\"origin\":\"root\",\"native\":{\"provider\":\"codex\"},\"fidelity\":\"full\",\"cwd\":\"/repo\",\"status\":{\"state\":\"idle\"},\"createdAt\":1,\"future\":\"dropped\"}",
      "expected": "{\"id\":\"a1\",\"threadId\":\"t1\",\"parentId\":null,\"origin\":\"root\",\"native\":{\"provider\":\"codex\"},\"fidelity\":\"full\",\"cwd\":\"/repo\",\"status\":{\"state\":\"idle\"},\"background\":false,\"createdAt\":1}"
    },
    {
      "name": "a run drops the fields this build does not know",
      "collection": "runs",
      "input": "{\"id\":\"r1\",\"threadId\":\"t1\",\"agentId\":\"a1\",\"trigger\":\"user\",\"state\":\"active\",\"startedAt\":1,\"future\":\"dropped\"}",
      "expected": "{\"id\":\"r1\",\"threadId\":\"t1\",\"agentId\":\"a1\",\"trigger\":\"user\",\"state\":\"active\",\"startedAt\":1}"
    },
    {
      "name": "an interaction keeps its request as the schema parses it",
      "collection": "interactions",
      "input": "{\"id\":\"i1\",\"threadId\":\"t1\",\"agentId\":\"a1\",\"blocking\":true,\"request\":{\"kind\":\"plan_review\",\"markdown\":\"# plan\",\"future\":\"dropped\"},\"state\":\"pending\",\"createdAt\":1,\"future\":\"dropped\"}",
      "expected": "{\"id\":\"i1\",\"threadId\":\"t1\",\"agentId\":\"a1\",\"blocking\":true,\"request\":{\"kind\":\"plan_review\",\"markdown\":\"# plan\"},\"state\":\"pending\",\"createdAt\":1,\"raw\":[]}"
    },
    {
      "name": "a background task gets its defaults",
      "collection": "backgroundTasks",
      "input": "{\"id\":\"b1\",\"agentId\":\"a1\",\"kind\":\"shell\",\"title\":\"build\",\"status\":\"running\",\"stoppable\":true,\"startedAt\":1,\"future\":\"dropped\"}",
      "expected": "{\"id\":\"b1\",\"agentId\":\"a1\",\"kind\":\"shell\",\"title\":\"build\",\"status\":\"running\",\"ambient\":false,\"stoppable\":true,\"startedAt\":1,\"raw\":[]}"
    },
    {
      "name": "a usage row is its counters",
      "collection": "usage",
      "input": "{\"type\":\"usage.updated\",\"agentId\":\"a1\",\"inputTokens\":10,\"outputTokens\":5,\"future\":\"dropped\"}",
      "expected": "{\"type\":\"usage.updated\",\"agentId\":\"a1\",\"inputTokens\":10,\"outputTokens\":5}"
    },
    {
      "name": "a usage snapshot is the same row under its other collection",
      "collection": "usageSnapshots",
      "input": "{\"type\":\"usage.updated\",\"agentId\":\"a1\",\"inputTokens\":10,\"outputTokens\":5,\"future\":\"dropped\"}",
      "expected": "{\"type\":\"usage.updated\",\"agentId\":\"a1\",\"inputTokens\":10,\"outputTokens\":5}"
    },
    {
      "name": "a context meter keeps its optional fields out",
      "collection": "contextMeters",
      "input": "{\"agentId\":\"a1\",\"epoch\":1,\"usedTokens\":100,\"windowTokens\":200,\"source\":\"provider\"}",
      "expected": "{\"agentId\":\"a1\",\"epoch\":1,\"usedTokens\":100,\"windowTokens\":200,\"source\":\"provider\"}"
    },
    {
      "name": "a queue's nested state is parsed",
      "collection": "queue",
      "input": "{\"revision\":2,\"paused\":false,\"reason\":null,\"resumeAt\":null,\"lastFailure\":{\"title\":\"stopped\",\"code\":\"stopped\"},\"future\":\"dropped\"}",
      "expected": "{\"revision\":2,\"paused\":false,\"lastFailure\":{\"title\":\"stopped\",\"code\":\"stopped\"},\"reason\":null,\"resumeAt\":null}"
    }
  ],
