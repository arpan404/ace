{
  "items": [
    {
      "name": "a message missing its defaults",
      "input": "{\"id\":\"m0\",\"agentId\":\"root\",\"type\":\"message\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"hello\"}],\"createdAt\":1}",
      "expected": "{\"id\":\"m0\",\"agentId\":\"root\",\"createdAt\":1,\"complete\":true,\"type\":\"message\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"hello\"}],\"synthetic\":false,\"raw\":[]}"
    },
    {
      "name": "a message with a field this build strips",
      "input": "{\"id\":\"m0\",\"agentId\":\"root\",\"type\":\"message\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"hello\"}],\"createdAt\":1,\"complete\":false,\"later\":true}",
      "expected": "{\"id\":\"m0\",\"agentId\":\"root\",\"createdAt\":1,\"complete\":false,\"type\":\"message\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"hello\"}],\"synthetic\":false,\"raw\":[]}"
    },
    {
      "name": "a tool call with stripped inner fields",
      "input": "{\"id\":\"t0\",\"agentId\":\"root\",\"type\":\"tool_call\",\"createdAt\":1,\"call\":{\"id\":\"t0\",\"agentId\":\"root\",\"kind\":\"shell\",\"title\":\"ls\",\"status\":\"succeeded\",\"detail\":{\"kind\":\"shell\",\"command\":\"ls\",\"retired\":true},\"startedAt\":1,\"raw\":[{\"type\":\"message_stop\",\"data\":{\"blob\":\"A\"}}],\"unknownField\":\"dropped\"}}",
      "expected": "{\"id\":\"t0\",\"agentId\":\"root\",\"createdAt\":1,\"complete\":true,\"type\":\"tool_call\",\"call\":{\"id\":\"t0\",\"agentId\":\"root\",\"kind\":\"shell\",\"title\":\"ls\",\"status\":\"succeeded\",\"detail\":{\"kind\":\"shell\",\"command\":\"ls\"},\"startedAt\":1,\"raw\":[{\"type\":\"message_stop\",\"data\":{\"blob\":\"A\"}}]}}"
    },
    {
      "name": "an item kind this build does not know",
      "input": "{\"id\":\"x0\",\"agentId\":\"root\",\"createdAt\":2,\"type\":\"future.item\",\"detail\":{\"a\":1}}",
      "expected": "{\"id\":\"x0\",\"agentId\":\"root\",\"createdAt\":2,\"complete\":true,\"type\":\"unknown\",\"raw\":[],\"data\":{\"id\":\"x0\",\"agentId\":\"root\",\"createdAt\":2,\"type\":\"future.item\",\"detail\":{\"a\":1}}}"
    }
  ],
  "payloads": [
    {
      "name": "a created item carries the decoded item",
      "input": "{\"type\":\"item.created\",\"item\":{\"id\":\"m0\",\"agentId\":\"root\",\"type\":\"message\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"hello\"}],\"createdAt\":1}}",
      "expected": "{\"type\":\"item.created\",\"item\":{\"id\":\"m0\",\"agentId\":\"root\",\"createdAt\":1,\"complete\":true,\"type\":\"message\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"hello\"}],\"synthetic\":false,\"raw\":[]}}"
    },
    {
      "name": "an updated unknown item kind",
      "input": "{\"type\":\"item.updated\",\"item\":{\"id\":\"x0\",\"agentId\":\"root\",\"createdAt\":2,\"type\":\"future.item\",\"detail\":{\"a\":1}}}",
      "expected": "{\"type\":\"item.updated\",\"item\":{\"id\":\"x0\",\"agentId\":\"root\",\"createdAt\":2,\"complete\":true,\"type\":\"unknown\",\"raw\":[],\"data\":{\"id\":\"x0\",\"agentId\":\"root\",\"createdAt\":2,\"type\":\"future.item\",\"detail\":{\"a\":1}}}}"
    },
    {
      "name": "a thread update with a legacy switch recommendation",
      "input": "{\"type\":\"thread.updated\",\"title\":\"renamed\",\"switch\":{\"selection\":{\"provider\":\"codex\"},\"state\":\"applied\",\"lossy\":false,\"recommendation\":\"delegate_task\",\"at\":5,\"later\":\"stripped\"},\"extra\":true}",
      "expected": "{\"type\":\"thread.updated\",\"title\":\"renamed\",\"switch\":{\"selection\":{\"provider\":\"codex\",\"options\":{}},\"state\":\"applied\",\"lossy\":false,\"recommendation\":\"delegate\",\"at\":5}}"
    },
    {
      "name": "a thread update with a title only",
      "input": "{\"type\":\"thread.updated\",\"title\":\"plain\",\"extra\":1}",
      "expected": "{\"type\":\"thread.updated\",\"title\":\"plain\"}"
    },
    {
      "name": "an event kind this build does not know",
      "input": "{\"type\":\"future.event\",\"threadId\":\"t\",\"payload\":{\"deep\":[1,2,3]}}",
      "expected": "{\"type\":\"unknown\",\"raw\":{\"type\":\"future.event\",\"threadId\":\"t\",\"payload\":{\"deep\":[1,2,3]}}}"
    }
  ],
