{
  "format": 1,
  "id": "arcade-cabinet",
  "name": "Arcade Cabinet",
  "description": "A pixel-art arcade menu: stage select, dialogue boxes, an inventory of steps and a starfield that clears the stage when a pull request merges.",
  "version": "1",
  "base": "midnight",
  "dark": {
    "canvas": "#120F2E",
    "sidebar": "#0D0B22",
    "surface": "#1B1842",
    "raised": "#231F55",
    "hover": "#2B2766",
    "active": "#353078",
    "code": "#0A0920",
    "border": "#3A3580",
    "borderStrong": "#6A62C8",
    "text": "#F2EFFF",
    "muted": "#CFCAF5",
    "subtle": "#ABA4E6",
    "faint": "#7D76C4",
    "accent": "#38E0D4",
    "accentHover": "#6CEDE4",
    "accentFg": "#07061A",
    "accentText": "#6CEDE4",
    "diffAdd": "#12313A",
    "diffAddFg": "#7DF0C8",
    "diffDel": "#3A1630",
    "diffDelFg": "#FF8FB0",
    "syntax": {
      "kw": "#FF9AD5",
      "fn": "#7FE7F0",
      "str": "#C6F28A",
      "num": "#FFC98A",
      "type": "#B9A8FF",
      "com": "#8C86C8",
      "punc": "#C9C4EE"
    },
    "glass": null
  },
  "fonts": {
    "ui": { "asset": "assets/fonts/PixelifySans.ttf", "family": "Arcade Pixel" },
    "prose": {
      "system": "ui-monospace, \"SF Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace"
    },
    "mono": { "asset": "assets/fonts/DepartureMono-Regular.woff2", "family": "Arcade Mono" }
  },
  "shape": { "radius": 0, "border": 2, "density": "comfortable" },
  "motion": { "speed": 0.8 },
  "layout": {
    "messages": "cards",
    "toolRows": "detailed",
    "sidebarWidth": 296
  },
  "labels": {
    "composer-placeholder": "▶ ENTER COMMAND…",
    "empty-transcript": "PRESS START: type a command below",
    "empty-sidebar": "NO STAGES YET. START A NEW ONE",
    "working-word": "LOADING",
    "send": "A"
  },
  "ornaments": [
    { "slot": "sidebar-header", "asset": "assets/ornaments/title-plate.svg" },
    { "slot": "empty-state", "asset": "assets/ornaments/press-start.svg" },
    { "slot": "corner-top-left", "asset": "assets/ornaments/corner-top-left.svg" },
    { "slot": "corner-top-right", "asset": "assets/ornaments/corner-top-right.svg" },
    { "slot": "corner-bottom-left", "asset": "assets/ornaments/corner-bottom-left.svg" },
    { "slot": "corner-bottom-right", "asset": "assets/ornaments/corner-bottom-right.svg" }
  ],
  "reveal": { "app": 0.9, "transcript": 0.35, "page": 0.3, "header": 0.5 },
  "terminal": {
    "dark": {
      "background": "#0A0920",
      "foreground": "#E9E5FF",
      "cursor": "#38E0D4",
      "cursorAccent": "#07061A",
      "selection": "#38E0D455",
      "ansi": {
        "black": "#1B1842",
        "red": "#FF6F91",
        "green": "#7DF0A8",
        "yellow": "#FFD866",
        "blue": "#7AA8FF",
        "magenta": "#D99BFF",
        "cyan": "#38E0D4",
        "white": "#CFCAF5",
        "brightBlack": "#6A62C8",
        "brightRed": "#FF9AB0",
        "brightGreen": "#B6FFD0",
        "brightYellow": "#FFE9A8",
        "brightBlue": "#A9C6FF",
        "brightMagenta": "#EBC4FF",
        "brightCyan": "#9DF5EE",
        "brightWhite": "#F2EFFF"
      }
    },
    "fontFamily": "Arcade Mono",
    "fontSize": 14,
    "lineHeight": 1.25,
    "cursorStyle": "block",
    "cursorBlink": true
  }
}
