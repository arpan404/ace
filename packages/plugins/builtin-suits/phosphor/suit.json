{
  "format": 1,
  "id": "phosphor",
  "name": "Phosphor",
  "description": "A green phosphor terminal: glowing text, scanlines, a slow rolling refresh band, the rail folded into the sidebar and a bare header. Dark only.",
  "version": "1",
  "base": "midnight",
  "dark": {
    "canvas": "#050B07",
    "sidebar": "#030805",
    "surface": "#08120B",
    "raised": "#0B170E",
    "hover": "#0D1B11",
    "active": "#122619",
    "border": "#1B3A24",
    "borderStrong": "#26502F",
    "faint": "#4F9A66",
    "subtle": "#73C68C",
    "muted": "#96E3AB",
    "text": "#C8FFD6",
    "code": "#040A05",
    "accent": "#E4F5E8",
    "accentHover": "#F4FFF6",
    "accentFg": "#050B07",
    "accentText": "#E4F5E8",
    "diffAdd": "#0C2614",
    "diffAddFg": "#9CF5B4",
    "diffDel": "#2A1410",
    "diffDelFg": "#FFB8A8",
    "syntax": {
      "kw": "#E8D7A0",
      "fn": "#C8FFD6",
      "str": "#9CF5B4",
      "num": "#F4E6B8",
      "type": "#B4F0C6",
      "com": "#5FA977",
      "punc": "#73C68C"
    },
    "glass": null
  },
  "fonts": {
    "ui": { "system": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace" },
    "prose": { "system": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace" },
    "mono": { "system": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace" }
  },
  "shape": { "radius": 0, "border": 1, "density": "compact" },
  "motion": { "speed": 0.7 },
  "layout": {
    "sidebar": "left",
    "rail": "merged",
    "composer": "docked",
    "header": "minimal",
    "messages": "flat",
    "toolRows": "terminal"
  },
  "scenes": { "app": "scene.js" },
  "reveal": { "app": 0.35, "sidebar": 0.25 },
  "labels": {
    "composer-placeholder": "> type a task_",
    "empty-transcript": "READY.",
    "empty-sidebar": "NO SESSIONS",
    "working-word": "Processing",
    "send": "Enter"
  },
  "ornaments": [
    { "slot": "sidebar-header", "asset": "assets/boot-banner.svg" },
    { "slot": "composer-top", "asset": "assets/prompt-rule.svg" },
    { "slot": "empty-state", "asset": "assets/cursor-block.svg" }
  ]
}
