      "family": "Journal Sans"
    },
    "prose": {
      "asset": "assets/fonts/Alegreya.ttf",
      "family": "Journal Serif"
    },
    "mono": {
      "system": "ui-monospace, \"SF Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace"
    }
  },
  "shape": {
    "radius": 0.5,
    "border": 1,
    "density": "comfortable"
  },
  "motion": {
    "speed": 1.2
  },
  "layout": {
    "messages": "flat",
    "toolRows": "detailed",
    "sidebarWidth": 300
  },
  "labels": {
    "composer-placeholder": "Jot down what to look into…",
    "empty-transcript": "A blank page. What shall we look into?",
    "empty-sidebar": "No entries yet. Begin a new page.",
    "working-word": "Observing",
    "send": "Note it"
  },
  "ornaments": [
    {
      "slot": "sidebar-header",
      "asset": "assets/ornaments/journal-plate.svg"
    },
    {
      "slot": "empty-state",
      "asset": "assets/ornaments/hand-lens.svg"
    }
  ],
  "scenes": {
    "app": "scene.js",
    "celebration": "celebration.js"
  },
  "reveal": {
    "app": 0.9,
    "rail": 0.5,
    "header": 0.55,
    "transcript": 0.4,
    "page": 0.35,
    "sidebar": 0.25
