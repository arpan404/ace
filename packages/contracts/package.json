{
  "name": "@ace/contracts",
  "version": "0.6.3",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    "./settings": {
      "types": "./src/settings.ts",
      "import": "./src/settings.ts",
      "require": "./src/settings.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "node node_modules/.bin/tsdown src/index.ts --format esm,cjs --dts --watch --clean",
    "build": "node node_modules/.bin/tsdown src/index.ts --format esm,cjs --dts --clean",
    "prepare": "node node_modules/.bin/effect-language-service patch",
    "typecheck": "node node_modules/.bin/tsc --noEmit",
    "test": "node node_modules/.bin/vitest run"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
