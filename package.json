{
  "name": "@ace/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "effect": "4.0.0-beta.43",
      "@effect/atom-react": "4.0.0-beta.43",
      "@effect/platform-bun": "4.0.0-beta.43",
      "@effect/platform-node": "4.0.0-beta.43",
      "@effect/sql-sqlite-bun": "4.0.0-beta.43",
      "@effect/vitest": "4.0.0-beta.43",
      "@vitest/browser-playwright": "4.1.5",
      "@effect/language-service": "0.84.2",
      "@types/bun": "^1.3.13",
      "@types/node": "^25.6.0",
      "tsdown": "^0.21.10",
      "typescript": "^6.0.3",
      "vitest": "4.1.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-runner.ts dev",
    "dev:server": "node scripts/dev-runner.ts dev:server",
    "dev:web": "node scripts/dev-runner.ts dev:web",
    "dev:mobile": "node scripts/dev-runner.ts dev:mobile",
    "dev:relay": "node node_modules/.bin/turbo run dev --filter=@ace/relay",
    "dev:marketing": "node node_modules/.bin/turbo run dev --filter=@ace/marketing",
    "dev:desktop": "node scripts/dev-runner.ts dev:desktop",
    "start": "node node_modules/.bin/turbo run start --filter=ace",
    "start:desktop": "node node_modules/.bin/turbo run start --filter=@ace/desktop",
    "start:marketing": "node node_modules/.bin/turbo run preview --filter=@ace/marketing",
    "start:mock-update-server": "bun run scripts/mock-update-server.ts",
    "build": "node node_modules/.bin/turbo run build",
    "build:marketing": "node node_modules/.bin/turbo run build --filter=@ace/marketing",
    "build:desktop": "node node_modules/.bin/turbo run build --filter=@ace/desktop --filter=ace",
    "typecheck": "node node_modules/.bin/turbo run typecheck",
    "lint": "node node_modules/.bin/oxlint --report-unused-disable-directives",
    "test": "node node_modules/.bin/turbo run test",
    "set-version": "bun run scripts/set-version.ts",
    "test:desktop-smoke": "node node_modules/.bin/turbo run smoke-test --filter=@ace/desktop",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build:contracts": "node node_modules/.bin/turbo run build --filter=@ace/contracts",
    "dist:desktop:artifact": "node scripts/build-desktop-artifact.ts",
    "dist:desktop:dmg": "node scripts/build-desktop-artifact.ts --platform mac --target dmg",
    "dist:desktop:dmg:arm64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64",
    "dist:desktop:dmg:x64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch x64",
    "dist:desktop:linux": "node scripts/build-desktop-artifact.ts --platform linux --target AppImage --arch x64",
    "dist:desktop:linux:arm64": "node scripts/build-desktop-artifact.ts --platform linux --target AppImage --arch arm64",
    "dist:desktop:linux:docker": "bash scripts/docker-desktop-linux.sh",
    "dist:desktop:win": "node scripts/build-desktop-artifact.ts --platform win --target nsis --arch x64",
    "dist:desktop:win:arm64": "node scripts/build-desktop-artifact.ts --platform win --target nsis --arch arm64",
    "dist:desktop:all": "bash scripts/local-desktop-release.sh",
    "release": "bash scripts/local-desktop-release.sh --publish",
    "release:desktop": "bash scripts/local-desktop-release.sh --publish",
    "release:desktop:build": "bash scripts/local-desktop-release.sh",
    "release:desktop:local": "bash scripts/local-desktop-release.sh",
    "release:smoke": "node scripts/release-smoke.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .turbo apps/*/.turbo packages/*/.turbo",
    "sync:vscode-icons": "node scripts/sync-vscode-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "dotenv": "^17.4.2",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "turbo": "^2.10.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.43"
  },
  "engines": {
    "bun": "^1.3.9",
    "node": "^24.13.1"
  },
  "packageManager": "bun@1.3.9",
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  },
  "trustedDependencies": [
    "node-pty",
    "electron"
  ]
}
