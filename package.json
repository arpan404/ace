{
  "name": "@ace/monorepo",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "check": "bun run fmt:check && bun run docs:protocol --check && bun run lint && bun run check:size && bun run typecheck && bun run test",
    "record": "bun run --filter @ace/recorder record",
    "check:size": "node scripts/check-file-size.ts",
    "web:dev": "bun run --filter @ace/web dev",
    "web:dev:fake": "bun run --filter @ace/web dev:fake",
    "web:build": "bun run --filter @ace/web build",
    "web:e2e": "bun run --filter @ace/web-e2e e2e",
    "web:screens": "bun run --filter @ace/web-e2e screens",
    "ace": "node apps/daemon/src/cli.ts",
    "postinstall": "bun run --filter @ace/workspace build:native && bun run --filter @ace/terminal prepare-native",
    "docs:protocol": "bun tools/protocol-docs/src/cli.ts",
    "docs:protocol:compat": "bun tools/protocol-docs/src/cli.ts --compat",
    "docs:protocol:snapshot": "bun tools/protocol-docs/src/cli.ts --snapshot"
  },
  "devDependencies": {
    "@ace/provider-kit": "workspace:*",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "node-pty"
  ]
}
