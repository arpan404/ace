{
  "name": "@ace/monorepo",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "check": "bun run fmt:check && bun run docs:protocol --check && bun run lint && bun run check:size && bun run check:deps && bun run typecheck && bun run test && bun run check:perf",
    "record": "bun run --filter @ace/recorder record",
    "record:cursor-sdk": "node tools/recorder/src/record-cursor-sdk.ts",
    "check:size": "node scripts/check-file-size.ts",
    "icons:providers": "node scripts/provider-icons.ts",
    "check:deps": "depcruise apps/web/src packages/client/src packages/client-worker/src packages/client-react/src packages/fake-daemon/src packages/ui-core/src --config .dependency-cruiser.cjs --output-type err",
    "check:perf": "bun run --filter @ace/web-perf check",
    "web:dev": "bun run --filter @ace/web dev",
    "web:dev:fake": "bun run --filter @ace/web dev:fake",
    "web:build": "bun run --filter @ace/web build",
    "web:e2e": "bun run --filter @ace/web-e2e e2e",
    "web:screens": "bun run --filter @ace/web-e2e screens",
    "ace": "node apps/daemon/src/cli.ts",
    "postinstall": "bun run --filter @ace/workspace build:native && bun run --filter @ace/terminal prepare-native",
    "docs:protocol": "bun tools/protocol-docs/src/cli.ts",
    "docs:protocol:compat": "bun tools/protocol-docs/src/cli.ts --compat",
    "docs:protocol:snapshot": "bun tools/protocol-docs/src/cli.ts --snapshot",
    "dev": "node tools/dev/src/cli.ts dev",
    "dev:web": "node tools/dev/src/cli.ts dev:web",
    "dev:fake": "node tools/dev/src/cli.ts dev:fake",
    "dev:desktop:fake": "node tools/dev/src/cli.ts dev:desktop:fake",
    "daemon": "node tools/dev/src/cli.ts daemon",
    "doctor": "node tools/dev/src/cli.ts doctor",
    "desktop:build": "node apps/desktop/scripts/package.ts",
    "desktop:package": "node apps/desktop/scripts/package.ts --full",
    "desktop:rebuild-native": "node apps/desktop/scripts/rebuild-native.ts",
    "desktop:e2e": "node apps/desktop/scripts/e2e.ts"
  },
  "devDependencies": {
    "@ace/provider-kit": "workspace:*",
    "@lobehub/icons-static-svg": "1.95.1",
    "@swc/core": "^1.16.13",
    "@types/node": "^26.6.4",
    "dependency-cruiser": "^18.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "node-pty",
    "electron"
  ]
}
