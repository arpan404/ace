{
  "name": "@ace/monorepo",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "check": "bun run fmt:check && bun run lint && bun run check:size && bun run typecheck && bun run test",
    "record": "bun run --filter @ace/recorder record",
    "check:size": "node scripts/check-file-size.ts",
    "postinstall": "bun run --filter @ace/terminal prepare-native"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "node-pty"
  ]
}
